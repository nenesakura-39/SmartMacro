<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        SmartMacro Studio X — Design System Tokens ("Obsidian Neon")
        Spacing scale, corner radii, typography ramp, elevation shadows, and signature brand gradients.
    -->

    <!-- ============ Spacing Scale (4 / 8 / 12 / 16 / 24 / 32) ============ -->
    <sys:Double x:Key="SpaceXS">4</sys:Double>
    <sys:Double x:Key="SpaceSM">8</sys:Double>
    <sys:Double x:Key="SpaceMD">12</sys:Double>
    <sys:Double x:Key="SpaceLG">16</sys:Double>
    <sys:Double x:Key="SpaceXL">24</sys:Double>
    <sys:Double x:Key="Space2XL">32</sys:Double>

    <Thickness x:Key="PadCard">14,12</Thickness>
    <Thickness x:Key="PadPopover">14,12</Thickness>
    <Thickness x:Key="StepRowPadding">10,8,12,8</Thickness>

    <!-- ============ Corner Radius Scale (4 / 6 / 8 / 12) ============ -->
    <CornerRadius x:Key="RadiusSM">4</CornerRadius>
    <CornerRadius x:Key="RadiusMD">6</CornerRadius>
    <CornerRadius x:Key="RadiusLG">8</CornerRadius>
    <CornerRadius x:Key="RadiusXL">12</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <!-- ============ Typography Ramp ============ -->
    <sys:Double x:Key="FontMicro">10</sys:Double>
    <sys:Double x:Key="FontCaption">11</sys:Double>
    <sys:Double x:Key="FontBodySm">12</sys:Double>
    <sys:Double x:Key="FontBody">13</sys:Double>
    <sys:Double x:Key="FontSubtitle">15</sys:Double>
    <sys:Double x:Key="FontTitle">20</sys:Double>
    <sys:Double x:Key="FontDisplay">28</sys:Double>

    <!-- ============ Motion Durations ============ -->
    <Duration x:Key="MotionFast">0:0:0.12</Duration>
    <Duration x:Key="MotionNormal">0:0:0.16</Duration>
    <Duration x:Key="MotionExpressive">0:0:0.22</Duration>

    <!-- ============ Obsidian Neon Signature Gradients ============ -->
    <!-- Brand gradient (#22D3EE → #818CF8 → #A855F7): active nav pill, running sweep, hero accents -->
    <LinearGradientBrush x:Key="BrandNeonGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#22D3EE" Offset="0" />
        <GradientStop Color="#818CF8" Offset="0.52" />
        <GradientStop Color="#A855F7" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrandNeonHorizontalBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#22D3EE" Offset="0" />
        <GradientStop Color="#6366F1" Offset="0.5" />
        <GradientStop Color="#A855F7" Offset="1" />
    </LinearGradientBrush>

    <!-- Primary Play CTA gradient -->
    <LinearGradientBrush x:Key="BrandPlayGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0EA5E9" Offset="0" />
        <GradientStop Color="#3B82F6" Offset="0.5" />
        <GradientStop Color="#6366F1" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrandPlayHoverGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#22D3EE" Offset="0" />
        <GradientStop Color="#60A5FA" Offset="0.5" />
        <GradientStop Color="#818CF8" Offset="1" />
    </LinearGradientBrush>

    <!-- Subtle top-edge inner glass rim for elevated cards & popovers -->
    <LinearGradientBrush x:Key="GlassRimBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3894A3B8" Offset="0" />
        <GradientStop Color="#1A64748B" Offset="0.35" />
        <GradientStop Color="#14475569" Offset="1" />
    </LinearGradientBrush>

    <!-- ============ Elevation Shadows (3 tiers) ============ -->
    <DropShadowEffect x:Key="ShadowCard" BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.28" Color="#000000" />
    <DropShadowEffect x:Key="ShadowPopover" BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.52" Color="#000000" />
    <DropShadowEffect x:Key="ShadowModal" BlurRadius="40" ShadowDepth="12" Direction="270" Opacity="0.68" Color="#000000" />
    <DropShadowEffect x:Key="GlowRunningStep" BlurRadius="16" ShadowDepth="0" Opacity="0.45" Color="#22D3EE" />
    <DropShadowEffect x:Key="GlowSelectedStep" BlurRadius="12" ShadowDepth="0" Opacity="0.30" Color="#3B82F6" />

    <!-- ============ Typography Styles ============ -->
    <Style x:Key="TextCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>

    <Style x:Key="TextMicroCaps" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontMicro}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
    </Style>

    <Style x:Key="TextMonoBadge" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

</ResourceDictionary>
