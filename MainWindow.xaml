<Window x:Class="SmartMacro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SmartMacro.ViewModels"
        xmlns:views="clr-namespace:SmartMacro.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding WindowTitle}"
        Icon="pack://application:,,,/Assets/SmartMacro.ico"
        Width="1340" Height="860" MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Each page view model is shown with its view. -->
        <DataTemplate DataType="{x:Type vm:LibraryViewModel}">
            <views:LibraryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EditorViewModel}">
            <views:EditorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogViewModel}">
            <views:LogView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding Editor.SaveCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ Sidebar ============ -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,22,20,26">
                    <Border Width="36" Height="36" CornerRadius="9" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="SmartMacro" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Desktop automation" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock DockPanel.Dock="Top" Text="WORKSPACE" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedTextBrush}" Margin="22,0,0,6" />

                <RadioButton DockPanel.Dock="Top" Style="{StaticResource NavButton}" Content="Macro Library" Tag="&#xE8F1;"
                             GroupName="Nav" AutomationProperties.Name="Macro Library"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource PageToBool}, ConverterParameter=Library}" />
                <RadioButton DockPanel.Dock="Top" Style="{StaticResource NavButton}" Tag="&#xE70F;"
                             GroupName="Nav" AutomationProperties.Name="Workflow Editor"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource PageToBool}, ConverterParameter=Editor}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Workflow Editor" />
                        <Ellipse Width="7" Height="7" Fill="{StaticResource WarningBrush}" Margin="8,1,0,0" VerticalAlignment="Center"
                                 ToolTip="Unsaved changes"
                                 Visibility="{Binding Editor.IsDirty, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </RadioButton>

                <TextBlock DockPanel.Dock="Top" Text="APP" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedTextBrush}" Margin="22,18,0,6" />

                <RadioButton DockPanel.Dock="Top" Style="{StaticResource NavButton}" Content="Logs" Tag="&#xE8A5;"
                             GroupName="Nav" AutomationProperties.Name="Logs"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource PageToBool}, ConverterParameter=Logs}" />
                <RadioButton DockPanel.Dock="Top" Style="{StaticResource NavButton}" Content="Settings" Tag="&#xE713;"
                             GroupName="Nav" AutomationProperties.Name="Settings"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource PageToBool}, ConverterParameter=Settings}" />

                <Border DockPanel.Dock="Bottom" Margin="14,0,14,16" Padding="12" CornerRadius="8"
                        Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{Binding VersionText}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding OwnerText}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0"
                                   Text="{Binding Automation.EmergencyHint}" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- ============ Main area ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ContentControl Grid.Row="0" Content="{Binding CurrentPageViewModel}" Focusable="False" Margin="20,14,20,8" />

            <!-- Automation bar: record / play / pause / stop -->
            <Border Grid.Row="1" Margin="20,0,20,8" Style="{StaticResource Card}" Padding="12,6" DataContext="{Binding Automation}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border VerticalAlignment="Center" CornerRadius="12" Padding="10,4" MinWidth="96">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Mode}" Value="Recording">
                                        <Setter Property="Background" Value="{StaticResource ErrorSoftBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Mode}" Value="Playing">
                                        <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Mode}" Value="Paused">
                                        <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Mode}" Value="Stopping">
                                        <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource MutedTextBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Mode}" Value="Recording">
                                                <Setter Property="Fill" Value="{StaticResource ErrorBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Mode}" Value="Playing">
                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Mode}" Value="Paused">
                                                <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Mode}" Value="Stopping">
                                                <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding StateText}" FontWeight="SemiBold" Margin="7,0,0,0" FontSize="12" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TargetText}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedTextBrush}"
                                   Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding ProgressText}" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                        <ProgressBar Margin="0,6,0,0" Minimum="0" Maximum="1" Value="{Binding ProgressValue, Mode=OneWay}"
                                     IsIndeterminate="{Binding IsProgressIndeterminate}"
                                     Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Quick toggles for single-monitor gamers (saved in Settings straight away). -->
                        <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                            <CheckBox Content="Show mini status overlay while playing" FontSize="11"
                                      IsChecked="{Binding DataContext.ShowMiniOverlay, RelativeSource={RelativeSource AncestorType=Window}}"
                                      ToolTip="Shows a small click-through pill in the top-right corner while a macro plays: which step runs and what it's doing (e.g. &quot;Step 2/5 — Finding image…&quot;). It never takes focus from your game and closes when playback ends."
                                      AutomationProperties.Name="Show mini status overlay while playing" />
                            <CheckBox Content="Minimize main window while playing" FontSize="11" Margin="0,2,0,0"
                                      IsChecked="{Binding DataContext.MinimizeWhilePlaying, RelativeSource={RelativeSource AncestorType=Window}}"
                                      ToolTip="Minimizes SmartMacro while recording or playing, so it isn't in the way on a single monitor. It comes back when playback ends."
                                      AutomationProperties.Name="Minimize main window while playing" />
                        </StackPanel>
                        <Button Command="{Binding RecordCommand}" Margin="0,0,8,0"
                                ToolTip="{Binding RecordTooltip}"
                                Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Fill="{StaticResource ErrorBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Record" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DangerButton}" Command="{Binding StopRecordingCommand}" Margin="0,0,8,0"
                                ToolTip="{Binding StopRecordingTooltip}"
                                Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71A;" Style="{StaticResource IconText}" />
                                <TextBlock Text="Stop recording" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding PlayCommand}"
                                ToolTip="{Binding PlayTooltip}"
                                Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" Style="{StaticResource IconText}" />
                                <TextBlock Text="Play" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding PauseResumeCommand}" Margin="0,0,8,0" ToolTip="{Binding PauseTooltip}"
                                Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE769;" Style="{StaticResource IconText}" />
                                <TextBlock Text="{Binding PauseButtonText}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DangerButton}" Command="{Binding StopCommand}" ToolTip="{Binding StopTooltip}"
                                Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71A;" Style="{StaticResource IconText}" />
                                <TextBlock Text="Stop" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Compact activity log -->
            <!-- Small by default (~110 px); drag the grip on its top edge to make it taller (up to 420 px). -->
            <Border Grid.Row="2" Margin="20,0,20,8" Style="{StaticResource Card}" Padding="12,0,12,6"
                    Visibility="{Binding ShowLogPanel, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Thumb DockPanel.Dock="Top" Height="8" Cursor="SizeNS" DragDelta="ActivityGrip_DragDelta"
                           ToolTip="Drag to make the Activity panel taller or shorter" AutomationProperties.Name="Resize the Activity panel">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border Background="Transparent">
                                    <Border x:Name="Grip" Width="36" Height="3" CornerRadius="2" Background="{StaticResource BorderBrush}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Grip" Property="Background" Value="{StaticResource AccentBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                    <DockPanel DockPanel.Dock="Top" Margin="2,0,0,2">
                        <TextBlock Text="Activity" Style="{StaticResource SectionTitle}" FontSize="12" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource GhostButton}" Padding="8,0"
                                FontSize="12" Content="Open full log" Command="{Binding ShowLogsCommand}" />
                    </DockPanel>
                    <ListBox x:Name="ActivityList" ItemsSource="{Binding Logs.Entries}" Height="72" ItemContainerStyle="{StaticResource PlainListItem}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Level, Converter={StaticResource LevelToGlyph}}" Style="{StaticResource IconText}"
                                               FontSize="12" Foreground="{Binding Level, Converter={StaticResource LevelToBrush}}" />
                                    <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource MutedTextBrush}" Margin="8,0,10,0" FontSize="12" />
                                    <TextBlock Text="{Binding Message}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Status bar -->
            <Border Grid.Row="3" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                    Padding="16,6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                               Text="{Binding Library.CountText}" VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,18,0" VerticalAlignment="Center"
                                Visibility="{Binding Editor.IsDirty, Converter={StaticResource BoolToVisibility}}">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource WarningBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Unsaved changes" Foreground="{StaticResource WarningBrush}" FontSize="12" Margin="6,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusKind, Converter={StaticResource LevelToGlyph}}" Style="{StaticResource IconText}"
                                   FontSize="13" Foreground="{Binding StatusKind, Converter={StaticResource LevelToBrush}}" />
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
