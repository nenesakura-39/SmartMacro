<Window x:Class="SmartMacro.Views.MissionControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SmartMacro.ViewModels"
        xmlns:ctrl="clr-namespace:SmartMacro.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="SmartMacro — Mission Control"
        Icon="pack://application:,,,/Assets/SmartMacro.ico"
        Width="430" Height="515" MinWidth="360" MinHeight="380"
        WindowStartupLocation="Manual"
        Topmost="True"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="-1"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding Automation.StopCommand}" />
    </Window.InputBindings>

    <Border BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1.2" Background="{DynamicResource BackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Custom 38px Studio Pod Header v3 -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#14182E" Offset="0" />
                        <GradientStop Color="#0D0F1C" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <!-- Top specular neon line -->
                    <Border Height="1.5" VerticalAlignment="Top">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#0022D3EE" Offset="0" />
                                <GradientStop Color="#CC6366F1" Offset="0.5" />
                                <GradientStop Color="#00A855F7" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Width="40" Height="38" Style="{StaticResource CaptionCloseButton}"
                                Click="CloseButton_Click" ToolTip="Close Mission Control" AutomationProperties.Name="Close Mission Control">
                            <ctrl:StudioIcon Kind="Close" Size="12" />
                        </Button>
                        <ToggleButton x:Name="PinTopmostToggle" DockPanel.Dock="Right"
                                      IsChecked="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                      Style="{StaticResource GhostToggle}" Padding="8,4" Margin="0,4,4,4"
                                      WindowChrome.IsHitTestVisibleInChrome="True"
                                      ToolTip="Keep Mission Control always on top of other windows"
                                      AutomationProperties.Name="Always on top">
                            <StackPanel Orientation="Horizontal">
                                <ctrl:StudioIcon Kind="Pin" Size="12" />
                                <TextBlock Text="Pin" FontSize="11" Margin="5,0,0,0" />
                            </StackPanel>
                        </ToggleButton>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <ctrl:StudioIcon Kind="MissionControl" Size="15" Foreground="{DynamicResource AccentHoverBrush}" />
                            <TextBlock Text="MISSION CONTROL · LIVE TELEMETRY" FontFamily="{StaticResource MonoFont}" FontSize="10.5" FontWeight="Bold" Margin="8,0,0,0"
                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- Live Telemetry Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,12">
                <StackPanel>
                    <!-- Macro Target & Live State Badge -->
                    <Border Style="{StaticResource GlassCard}" Padding="14,12">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" CornerRadius="10" Padding="9,3" VerticalAlignment="Center"
                                        Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource MutedTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Automation.Mode}" Value="Playing">
                                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Automation.Mode}" Value="Paused">
                                                            <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Automation.Mode}" Value="Recording">
                                                            <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding Automation.StateText}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" FontWeight="SemiBold" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding Automation.RunningMacroTitle}" FontSize="14.5" FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />
                            </DockPanel>

                            <!-- Big Neon Run Counter + Elapsed Clock -->
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="{DynamicResource InputBrush}" CornerRadius="8" Padding="12,8"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="CURRENT RUN" FontFamily="{StaticResource MonoFont}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource SubtleTextBrush}" />
                                        <TextBlock FontSize="18" FontWeight="Bold" FontFamily="{StaticResource MonoFont}" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource AccentHoverBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding Automation.RunCounterText}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Automation.HasRunCounter}" Value="False">
                                                            <Setter Property="Text" Value="Standby" />
                                                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" MinWidth="122" Background="{DynamicResource InputBrush}" CornerRadius="8" Padding="12,8"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="ELAPSED TIME" FontFamily="{StaticResource MonoFont}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource SubtleTextBrush}" />
                                        <TextBlock Text="{Binding Automation.ElapsedText}" FontSize="18" FontWeight="Bold"
                                                   FontFamily="{StaticResource MonoFont}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Active Step Card -->
                    <Border Style="{StaticResource GlassCard}" Padding="14,12" Margin="0,10,0,0">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Automation.VisionTelemetryText}"
                                           FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{DynamicResource VisionAccentBrush}"
                                           Visibility="{Binding Automation.HasVisionTelemetry, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="ACTIVE STEP TELEMETRY" FontFamily="{StaticResource MonoFont}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SubtleTextBrush}" />
                            </DockPanel>

                            <TextBlock Text="{Binding Automation.StepCounterText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentHoverBrush}" Margin="0,6,0,0"
                                       Visibility="{Binding Automation.IsPlaying, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding Automation.ActiveStepDetailText}" FontSize="12.5" Margin="0,3,0,8" TextWrapping="Wrap" />

                            <ProgressBar Height="5" Minimum="0" Maximum="1"
                                         Value="{Binding Automation.ProgressValue, Mode=OneWay}"
                                         IsIndeterminate="{Binding Automation.IsProgressIndeterminate}" />
                        </StackPanel>
                    </Border>

                    <!-- Live Variables Readout (v1.2 Brain) -->
                    <Border Style="{StaticResource GlassCard}" Padding="14,12" Margin="0,10,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource MemoryAccentBrush}" FontFamily="{StaticResource MonoFont}">
                                    <Run Text="{Binding Editor.Watchers.Count, Mode=OneWay}" /><Run Text=" watcher(s)" />
                                </TextBlock>
                                <StackPanel Orientation="Horizontal">
                                    <ctrl:StudioIcon Kind="Variable" Size="13" Foreground="{DynamicResource MemoryAccentBrush}" />
                                    <TextBlock Text="LIVE BRAIN VARIABLES" FontFamily="{StaticResource MonoFont}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SubtleTextBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>

                            <TextBlock Text="Open a macro with variables to monitor live counters and OCR values here."
                                       FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Editor.Variables.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ItemsControl ItemsSource="{Binding Editor.Variables}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,5" Margin="0,0,0,4" CornerRadius="6" Background="{DynamicResource InputBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource MemoryAccentBrush}" />
                                                    <TextBlock Text="{Binding Type}" FontSize="10" Foreground="{DynamicResource SubtleTextBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="SemiBold"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding LiveValue}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding LiveValue}" Value="—">
                                                                    <Setter Property="Text" Value="{Binding DefaultValue}" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Transport Footer -->
            <Border Grid.Row="2" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                    Padding="14,10">
                <DockPanel DataContext="{Binding Automation}">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding EmergencyHint}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="190" />

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource NeonPlayButton}" Command="{Binding PlayCommand}" ToolTip="{Binding PlayTooltip}"
                                Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                            <StackPanel Orientation="Horizontal">
                                <ctrl:StudioIcon Kind="Play" Size="12" />
                                <TextBlock Text="Play" Margin="6,0,0,0" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TransportButton}" Command="{Binding PauseResumeCommand}" Margin="0,0,6,0"
                                ToolTip="{Binding PauseTooltip}"
                                Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <ctrl:StudioIcon Kind="Pause" Size="12" />
                                <TextBlock Text="{Binding PauseButtonText}" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DangerButton}" Height="28" Padding="10,0" Command="{Binding StopCommand}"
                                ToolTip="{Binding StopTooltip}"
                                Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <ctrl:StudioIcon Kind="Stop" Size="12" />
                                <TextBlock Text="Stop" Margin="6,0,0,0" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
