<UserControl x:Class="SmartMacro.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SmartMacro.ViewModels"
             xmlns:steps="clr-namespace:SmartMacro.ViewModels.Steps"
             xmlns:conv="clr-namespace:SmartMacro.Converters"
             xmlns:core="clr-namespace:SmartMacro.Core.Validation;assembly=SmartMacro.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:EditorViewModel}"
             d:DesignWidth="1100" d:DesignHeight="680">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="StepEditorTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:StepCategoryBrushConverter x:Key="CategoryBrush" />
            <conv:StepTypeFilterConverter x:Key="StepTypeFilter" />
            <conv:IndentLevelConverter x:Key="IndentLevel" />
            <conv:CountToVisibilityConverter x:Key="CountToVisibility" />

            <!-- Step rows: hidden while folded away by a collapsed If / Repeat or outside the active filter pill (the step
                 keeps its number, index and indentation); tighter spacing in Compact view. -->
            <Style x:Key="StudioStepCardItem" TargetType="ListBoxItem" BasedOn="{StaticResource StepCardItem}">
                <Setter Property="Visibility" Value="{Binding IsVisibleInList, Converter={StaticResource BoolToVisibility}}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding DataContext.IsCompactView, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                        <Setter Property="Margin" Value="0,0,0,2" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Faint dot grid behind the workflow cards ("studio" canvas). -->
            <DrawingBrush x:Key="DotGridTile" TileMode="Tile" Viewport="0,0,18,18" ViewportUnits="Absolute" Stretch="None">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="Transparent">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,18,18" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="{StaticResource DotGridBrush}">
                            <GeometryDrawing.Geometry>
                                <EllipseGeometry Center="1,1" RadiusX="1" RadiusY="1" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>

            <!-- Vertical guide lines for steps inside If / Repeat blocks: one line every 24 px (one per level). -->
            <DrawingBrush x:Key="IndentGuideTile" TileMode="Tile" Viewport="0,0,24,8" ViewportUnits="Absolute" Stretch="None">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="Transparent">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,24,8" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="{StaticResource IndentGuideBrush}">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="11,0,1.5,8" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>

            <!-- One compact toolbox tile: colour-coded icon badge above the step name. -->
            <DataTemplate x:Key="ToolboxTileTemplate" DataType="{x:Type steps:StepTypeInfo}">
                <Button Style="{StaticResource ToolboxTile}" ToolTip="{Binding Description}"
                        Command="{Binding DataContext.AddStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding Kind}" AutomationProperties.Name="{Binding DisplayName}"
                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Add to end" Command="{Binding PlacementTarget.Tag.AddToEndCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding Kind}" ToolTip="Adds this step after the last step in the workflow." />
                            <MenuItem Header="Insert after selected" Command="{Binding PlacementTarget.Tag.InsertAfterSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding Kind}" ToolTip="Adds this step right after the selected step (at the end when nothing is selected)." />
                        </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="6" HorizontalAlignment="Center"
                                Background="{Binding Kind, Converter={StaticResource CategoryBrush}, ConverterParameter=Badge}">
                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}" FontSize="12" HorizontalAlignment="Center"
                                       Foreground="{Binding Kind, Converter={StaticResource CategoryBrush}, ConverterParameter=Accent}" />
                        </Border>
                        <TextBlock Text="{Binding DisplayName}" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
            </DataTemplate>

            <ItemsPanelTemplate x:Key="TwoColumnTiles">
                <UniformGrid Columns="2" />
            </ItemsPanelTemplate>

            <!-- Inline previews on step cards: picture thumbnail (Find image), colour swatch (Find color / Feedback loop). -->
            <DataTemplate x:Key="ImagePreviewTemplate">
                <Border Width="28" Height="28" CornerRadius="5" BorderThickness="1" BorderBrush="{StaticResource InputBorderBrush}"
                        Background="{StaticResource InputBrush}" ToolTip="The picture this step looks for"
                        Visibility="{Binding HasTemplate, Converter={StaticResource BoolToVisibility}}">
                    <Border CornerRadius="4" RenderOptions.BitmapScalingMode="HighQuality">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding TemplatePreview}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                </Border>
            </DataTemplate>
            <DataTemplate x:Key="ColorPreviewTemplate">
                <Ellipse Width="16" Height="16" Fill="{Binding ColorBrush}" Stroke="{StaticResource InputBorderBrush}" StrokeThickness="1"
                         ToolTip="{Binding Color}" />
            </DataTemplate>
            <DataTemplate x:Key="FeedbackPreviewTemplate">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="16" Height="16" Fill="{Binding MarkerBrush}" Stroke="{StaticResource InputBorderBrush}" StrokeThickness="1"
                             ToolTip="Marker color" />
                    <Ellipse Width="16" Height="16" Fill="{Binding ZoneBrush}" Stroke="{StaticResource InputBorderBrush}" StrokeThickness="1"
                             Margin="-5,0,0,0" ToolTip="Zone color (empty for a fixed zone)" />
                </StackPanel>
            </DataTemplate>
            <!-- AAA: a recorded click's Smart Click Snapshot (+ ✨ when Smart-Aim is on). -->
            <DataTemplate x:Key="ClickSnapshotPreviewTemplate">
                <Grid>
                    <Border Width="28" Height="28" CornerRadius="4" BorderBrush="{StaticResource VisionAccentBrush}" BorderThickness="1"
                            Background="{StaticResource SurfaceBrush}" ToolTip="What this click hit when it was recorded (Smart Click Snapshot)">
                        <Image Source="{Binding TargetThumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock Text="✨" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0"
                               Visibility="{Binding SmartAimAtTarget, Converter={StaticResource BoolToVisibility}}"
                               ToolTip="Smart-Aim is on: finds this target again if it moved" />
                </Grid>
            </DataTemplate>
            <conv:StepKindTemplateSelector x:Key="StepPreviewSelector"
                                           ClickSnapshotTemplate="{StaticResource ClickSnapshotPreviewTemplate}"
                                           FindImageTemplate="{StaticResource ImagePreviewTemplate}"
                                           FindColorTemplate="{StaticResource ColorPreviewTemplate}"
                                           FeedbackLoopTemplate="{StaticResource FeedbackPreviewTemplate}" />

            <!-- Pinned bottom bar of the inspector: "Test detection now" is always one click away. -->
            <DataTemplate x:Key="SearchActionBarTemplate">
                <Border Style="{StaticResource InspectorActionBar}">
                    <StackPanel>
                        <Button Style="{StaticResource TestActionButton}" Command="{Binding TestCommand}"
                                ToolTip="SmartMacro hides for a moment, looks once where this step would look, and shows what it found."
                                AutomationProperties.Name="Test detection now">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" />
                                <TextBlock Text="Test detection now" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto">
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SearchTestResultTemplate}" Focusable="False" />
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </DataTemplate>
            <DataTemplate x:Key="FeedbackActionBarTemplate">
                <Border Style="{StaticResource InspectorActionBar}">
                    <StackPanel>
                        <Button Style="{StaticResource TestActionButton}" Command="{Binding TestDetectionCommand}"
                                ToolTip="Looks at the bar once: where the marker and the zone are, and what the loop would do right now. No input is sent."
                                AutomationProperties.Name="Test detection now">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" />
                                <TextBlock Text="Test detection now" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding TestResult, Converter={StaticResource NullToVisibility}}">
                            <Border Margin="0,8,0,0" Padding="10,8" CornerRadius="6" Background="{StaticResource SurfaceAltBrush}">
                                <StackPanel>
                                    <TextBlock Text="{Binding TestResult}" TextWrapping="Wrap" FontSize="12" />
                                    <Button Command="{Binding ShowMatchCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="8,4" FontSize="12"
                                            ToolTip="Moves your mouse cursor onto the marker the test found. Nothing is clicked.">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7C9;" Style="{StaticResource IconText}" FontSize="12" />
                                            <TextBlock Text="Show me (move cursor to the marker)" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </DataTemplate>
            <conv:StepKindTemplateSelector x:Key="InspectorActionSelector"
                                           ScreenSearchTemplate="{StaticResource SearchActionBarTemplate}"
                                           FeedbackLoopTemplate="{StaticResource FeedbackActionBarTemplate}" />

            <!-- Live automation state pill (● Ready / Recording / Playing / Paused). DataContext = AutomationViewModel. -->
            <Style x:Key="StatePillStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="8,2,10,2" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Mode}" Value="Recording">
                        <Setter Property="Background" Value="{StaticResource ErrorSoftBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Mode}" Value="Playing">
                        <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Mode}" Value="Paused">
                        <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Mode}" Value="Stopping">
                        <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="StateDotStyle" TargetType="Ellipse">
                <Setter Property="Width" Value="7" />
                <Setter Property="Height" Value="7" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Mode}" Value="Recording">
                        <Setter Property="Fill" Value="{StaticResource ErrorBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Mode}" Value="Paused">
                        <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Mode}" Value="Stopping">
                        <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{Binding RedoCommand}" />
        <KeyBinding Key="F5" Modifiers="Shift" Command="{Binding PlayFromSelectedCommand}" />
        <KeyBinding Key="F3" Command="{Binding NextMatchCommand}" />
        <KeyBinding Key="F3" Modifiers="Shift" Command="{Binding PreviousMatchCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <!-- ============ Nothing open ============ -->
        <Border Style="{StaticResource Card}" Visibility="{Binding HasMacro, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
                <Border Width="64" Height="64" CornerRadius="16" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE70F;" Style="{StaticResource IconText}" FontSize="28" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                </Border>
                <TextBlock Text="No macro open" Style="{StaticResource SectionTitle}" FontSize="16" HorizontalAlignment="Center" Margin="0,16,0,0" />
                <TextBlock Text="Pick a macro in the library (or create a new one) to edit its workflow here."
                           Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,6,0,16" />
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding GoToLibraryCommand}" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8F1;" Style="{StaticResource IconText}" />
                        <TextBlock Text="Go to Macro Library" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ============ Editor ============ -->
        <Grid Visibility="{Binding HasMacro, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="300" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===== Unified command header: name + description | playback settings | Save, Record, Play ===== -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,8,12,8" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="160" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Row 1 left: macro name -->
                    <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0" LastChildFill="True" VerticalAlignment="Center">
                        <TextBlock DockPanel.Dock="Left" Text="WORKFLOW" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SubtleTextBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Tag="Macro name" FontSize="17" FontWeight="SemiBold"
                                 Background="Transparent" BorderBrush="Transparent" Padding="2,1" Margin="-4,0,0,0" MaxLength="100"
                                 AutomationProperties.Name="Macro name" />
                    </DockPanel>

                    <!-- Row 1 right: saved state, Discard, Save | Record, Play (or Pause / Stop while playing) -->
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Pill}" Margin="0,0,8,0" Background="{StaticResource WarningSoftBrush}"
                                Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Unsaved" Foreground="{StaticResource WarningBrush}" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                        <Border Style="{StaticResource Pill}" Margin="0,0,8,0" Background="{StaticResource SuccessSoftBrush}"
                                Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" FontSize="10" Foreground="{StaticResource SuccessBrush}" />
                                <TextBlock Text="Saved" Foreground="{StaticResource SuccessBrush}" FontSize="11" FontWeight="SemiBold" Margin="5,0,0,0" />
                            </StackPanel>
                        </Border>
                        <Button Command="{Binding RevertCommand}" Margin="0,0,6,0" Padding="10,6" ToolTip="Discard changes: throw away everything since the last save"
                                AutomationProperties.Name="Discard changes">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7A7;" Style="{StaticResource IconText}" FontSize="12" />
                                <TextBlock Text="Discard" Margin="6,0,0,0" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SaveCommand}" Padding="12,6" ToolTip="Save (Ctrl+S)" AutomationProperties.Name="Save">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" Style="{StaticResource IconText}" FontSize="12" />
                                <TextBlock Text="Save" Margin="6,0,0,0" FontSize="12" />
                            </StackPanel>
                        </Button>

                        <Border Width="1" Margin="10,4" Background="{StaticResource BorderBrush}" />

                        <!-- Automation controls: the same commands as the old middle bar (now removed on this page). -->
                        <StackPanel Orientation="Horizontal" DataContext="{Binding DataContext.Automation, RelativeSource={RelativeSource AncestorType=Window}}">
                            <Button Style="{StaticResource RecordButton}" Command="{Binding RecordCommand}" Margin="0,0,6,0"
                                    ToolTip="{Binding RecordTooltip}" AutomationProperties.Name="Record"
                                    Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="9" Height="9" Fill="White" VerticalAlignment="Center" />
                                    <TextBlock Text="Record" Margin="7,0,0,0" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <ComboBox ItemsSource="{Binding RecordingModes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding RecordingMode, Mode=TwoWay}"
                                      MinWidth="190" MaxWidth="250" Padding="8,5" FontSize="11.5" Margin="0,0,6,0" VerticalAlignment="Center"
                                      ToolTip="Quick Recording Mode selector: switch between Smart, Desktop &amp; UI, 3D Game / FPS, and Exact 1:1 / Rhythm without leaving the editor."
                                      AutomationProperties.Name="Recording mode"
                                      Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                            <Button Style="{StaticResource DangerButton}" Command="{Binding StopRecordingCommand}" Margin="0,0,6,0"
                                    ToolTip="{Binding StopRecordingTooltip}" AutomationProperties.Name="Stop recording"
                                    Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE71A;" Style="{StaticResource IconText}" FontSize="12" />
                                    <TextBlock Text="Stop recording" Margin="6,0,0,0" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PlayButton}" Command="{Binding PlayCommand}"
                                    ToolTip="{Binding PlayTooltip}" AutomationProperties.Name="Play"
                                    Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" Style="{StaticResource IconText}" FontSize="12" />
                                    <TextBlock Text="Play" Margin="6,0,0,0" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding PauseResumeCommand}" Margin="0,0,6,0" Padding="10,6" ToolTip="{Binding PauseTooltip}"
                                    AutomationProperties.Name="Pause or resume"
                                    Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding PauseButtonGlyph}" Style="{StaticResource IconText}" FontSize="12" />
                                    <TextBlock Text="{Binding PauseButtonText}" Margin="6,0,0,0" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource DangerButton}" Command="{Binding StopCommand}" Padding="10,6" ToolTip="{Binding StopTooltip}"
                                    AutomationProperties.Name="Stop playback"
                                    Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE71A;" Style="{StaticResource IconText}" FontSize="12" />
                                    <TextBlock Text="Stop" Margin="6,0,0,0" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <!-- Live run counter while playing: "Run #3 / ∞ · Step 4 / 12" (Play = 0 shows ∞). -->
                            <Border Style="{StaticResource Pill}" Margin="8,0,0,0" Padding="9,3,10,4"
                                    ToolTip="Which run (repeat) of the macro is playing now, and which step"
                                    AutomationProperties.Name="Run counter" AutomationProperties.LiveSetting="Polite"
                                    Visibility="{Binding HasRunCounter, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8EE;" Style="{StaticResource IconText}" FontSize="11" Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock Text="{Binding RunCounterText}" FontSize="11.5" FontWeight="SemiBold" Margin="6,0,0,0" />
                                    <TextBlock Text="·" FontSize="11.5" Margin="6,0" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding StepCounterText}" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" />
                                    <!-- ⚡ live vision speed (latest image / colour look or Smart-Aim search) -->
                                    <TextBlock Text="·" FontSize="11.5" Margin="6,0" Foreground="{StaticResource MutedTextBrush}"
                                               Visibility="{Binding HasVisionTelemetry, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding VisionTelemetryText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource VisionAccentBrush}"
                                               ToolTip="How long the latest screen look took (capture + search). ⚡ under 1 ms = the target was re-found at its last spot."
                                               Visibility="{Binding HasVisionTelemetry, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Row 2 left: description -->
                    <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Tag="Add a description (optional)"
                             Foreground="{StaticResource MutedTextBrush}" Background="Transparent" BorderBrush="Transparent" FontSize="12"
                             Padding="2,1" Margin="-4,2,12,0" MaxLength="2000" VerticalAlignment="Center" AutomationProperties.Name="Macro description" />

                    <!-- Row 2 right: playback settings + quick toggles -->
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="Play" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" FontSize="12" />
                        <TextBox Style="{StaticResource HeaderNumberBox}" Text="{Binding RepeatCount, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                 Width="46" Margin="6,0,4,0" AutomationProperties.Name="Repeat count"
                                 ToolTip="How many times to run the steps. 0 = keep repeating until you stop it." />
                        <TextBlock Text="times" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" FontSize="12"
                                   ToolTip="0 = until stopped" />
                        <TextBlock Text="Speed" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12" />
                        <ComboBox ItemsSource="{Binding SpeedChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Speed, Mode=TwoWay}" MinWidth="64" Padding="8,3" FontSize="11.5" Margin="6,0,0,0" VerticalAlignment="Center"
                                  AutomationProperties.Name="Playback speed"
                                  ToolTip="Playback speed: delays, glides and recorded input run this many times faster (0.5× = half speed). Clicks and key taps are never held shorter than 25 ms, so games still see them. Changing it while this macro plays takes effect from the next step." />
                        <TextBlock Text="Wait" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12"
                                   ToolTip="Wait between repeats" />
                        <TextBox Style="{StaticResource HeaderNumberBox}" Text="{Binding RepeatDelayMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                 Width="54" Margin="6,0,4,0" AutomationProperties.Name="Wait between repeats in milliseconds"
                                 ToolTip="Wait between repeats: pause after each run before the next one starts (milliseconds). Not used when playing once." />
                        <TextBlock Text="ms" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" FontSize="12" />

                        <Border Width="1" Margin="12,2" Background="{StaticResource BorderBrush}" />

                        <!-- Macro settings: target window + auto-adjust coordinates (popover), Humanize pill. -->
                        <ToggleButton x:Name="TargetToggle" Style="{StaticResource GhostToggle}" Padding="6,2" Margin="0,0,10,0"
                                      IsHitTestVisible="{Binding IsOpen, ElementName=TargetPopup, Converter={StaticResource InverseBool}}"
                                      ToolTip="Target window: bind this macro to a window (e.g. Roblox) or the main screen, and optionally auto-adjust its positions when the window moves or the resolution changes."
                                      AutomationProperties.Name="Target window settings">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎯" FontSize="11" />
                                <TextBlock Text="{Binding TargetSummary}" FontSize="11" Margin="5,0,0,0" MaxWidth="150" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text=" ▾" FontSize="10" />
                            </StackPanel>
                        </ToggleButton>
                        <Popup x:Name="TargetPopup" IsOpen="{Binding IsChecked, ElementName=TargetToggle, Mode=TwoWay}" StaysOpen="False" PlacementTarget="{Binding ElementName=TargetToggle}"
                               Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="10"
                                    Padding="14,12" Width="340" Margin="0,4,0,0">
                                <StackPanel>
                                    <TextBlock Text="TARGET WINDOW" Style="{StaticResource SetupCardTitle}" />
                                    <DockPanel Margin="0,8,0,0">
                                        <Button DockPanel.Dock="Right" Command="{Binding RefreshTargetWindowsCommand}" Style="{StaticResource IconButton}" Content="&#xE72C;"
                                                Width="30" Height="28" Padding="6" FontSize="12" Margin="6,0,0,0" ToolTip="Read the list of open windows again"
                                                AutomationProperties.Name="Refresh windows" />
                                        <ComboBox IsEditable="True" ItemsSource="{Binding TargetWindowChoices}"
                                                  Text="{Binding TargetWindowTitle, UpdateSourceTrigger=PropertyChanged}"
                                                  AutomationProperties.Name="Target window"
                                                  ToolTip="Any / Main screen, or (part of) a window title such as Roblox. Open the game first, then click refresh." />
                                    </DockPanel>
                                    <CheckBox Style="{StaticResource ToggleSwitchCheckBoxStyle}" Margin="0,12,0,0"
                                              Content="Auto-adjust coordinates if window moves or screen resolution changes"
                                              IsChecked="{Binding ScaleCoordinatesToWindow}"
                                              ToolTip="At playback, every stored position (Move / Click / Scroll, drag ends, custom search areas, feedback bar areas) is moved and scaled from the reference size into the target window's current position and size (or the current main screen). Pictures of Find image steps aren't resized: recapture them for a very different resolution."
                                              AutomationProperties.Name="Auto-adjust coordinates" />
                                    <TextBlock Text="{Binding ReferenceText}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
                                    <Button Command="{Binding UseCurrentSizeCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,5" FontSize="12"
                                            ToolTip="Use current size: remember where the target window (or main screen) is right now as the reference. Do this with the window where it was when you picked the positions."
                                            AutomationProperties.Name="Use current size as reference">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE740;" Style="{StaticResource IconText}" FontSize="12" />
                                            <TextBlock Text="Use current size" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                        <CheckBox Style="{StaticResource ToggleSwitchCheckBoxStyle}" Content="🎲 Humanize" FontSize="11" Margin="0,0,12,0"
                                  IsChecked="{Binding HumanizePlayback}" ToolTip="{Binding HumanizeTooltip}"
                                  AutomationProperties.Name="Humanize playback timing and clicks" />

                        <!-- Quick toggles for single-monitor gamers (saved in Settings straight away). -->
                        <CheckBox Style="{StaticResource ToggleSwitchCheckBoxStyle}" Content="With overlay" FontSize="11"
                                  IsChecked="{Binding DataContext.ShowMiniOverlay, RelativeSource={RelativeSource AncestorType=Window}}"
                                  ToolTip="With overlay: a mini-HUD in the top-right corner shows the run, a timer and which step runs (with ⏸ F8 / ⏹ Esc buttons), and a neon target-lock flashes on everything a Find step, If condition or Smart-Aim finds. It never takes focus from your game, isn't seen by Find steps, and closes when playback ends."
                                  AutomationProperties.Name="Show mini status overlay while playing" />
                        <CheckBox Style="{StaticResource ToggleSwitchCheckBoxStyle}" Content="Minimize" FontSize="11" Margin="12,0,0,0"
                                  IsChecked="{Binding DataContext.MinimizeWhilePlaying, RelativeSource={RelativeSource AncestorType=Window}}"
                                  ToolTip="Minimize main window while playing: SmartMacro gets out of the way on a single monitor and comes back when playback ends."
                                  AutomationProperties.Name="Minimize main window while playing" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Toolbox | Workflow steps | Properties ===== -->
            <Grid Grid.Row="1">
                <!-- The 10 px gaps are splitters: drag them to make Add step / Workflow steps / Properties wider. -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" MinWidth="176" MaxWidth="420" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" MinWidth="280" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="360" MinWidth="280" MaxWidth="760" />
                </Grid.ColumnDefinitions>

                <GridSplitter Grid.Column="1" Style="{StaticResource PanelSplitter}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                              ToolTip="Drag to resize" AutomationProperties.Name="Resize the Add step panel" />
                <GridSplitter Grid.Column="3" Style="{StaticResource PanelSplitter}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                              ToolTip="Drag to resize" AutomationProperties.Name="Resize the Properties panel" />

                <!-- ===== Toolbox: categorized 2-column tiles ===== -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8,10,8,6">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="4,0,4,0">
                            <TextBlock Text="Add step" Style="{StaticResource SectionTitle}" FontSize="13" />
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock DockPanel.Dock="Left" Text="Insert" FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Border Style="{StaticResource SegmentedContainer}"
                                        ToolTip="Where a new step goes: right after the selected step (at the end when nothing is selected), or always after the last step. Right-click a tile for the other choice.">
                                    <UniformGrid Rows="1">
                                        <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" Content="After selected" GroupName="InsertPlacement"
                                                     IsChecked="{Binding AddAfterSelected}" AutomationProperties.Name="Add new steps after the selected step" />
                                        <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" Content="At end" GroupName="InsertPlacement"
                                                     IsChecked="{Binding AddAtEnd}" AutomationProperties.Name="Add new steps at the end" />
                                    </UniformGrid>
                                </Border>
                            </DockPanel>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,2,0,0">
                            <StackPanel>
                                <TextBlock Text="INPUT" Style="{StaticResource ToolboxCategoryHeader}" />
                                <ItemsControl ItemsSource="{Binding StepTypes, Converter={StaticResource StepTypeFilter}, ConverterParameter=Input}" Focusable="False"
                                              ItemsPanel="{StaticResource TwoColumnTiles}" ItemTemplate="{StaticResource ToolboxTileTemplate}" />

                                <TextBlock Text="VISION &amp; AI" Style="{StaticResource ToolboxCategoryHeader}" />
                                <ItemsControl ItemsSource="{Binding StepTypes, Converter={StaticResource StepTypeFilter}, ConverterParameter=Vision}" Focusable="False"
                                              ItemsPanel="{StaticResource TwoColumnTiles}" ItemTemplate="{StaticResource ToolboxTileTemplate}" />

                                <TextBlock Text="LOGIC &amp; LOOPS" Style="{StaticResource ToolboxCategoryHeader}"
                                           ToolTip="If and Repeat are added together with their End." />
                                <ItemsControl ItemsSource="{Binding LogicStepTypes}" Focusable="False"
                                              ItemsPanel="{StaticResource TwoColumnTiles}" ItemTemplate="{StaticResource ToolboxTileTemplate}" />

                                <!-- Quick patterns: 1-click multi-step starters for common game loops (full-width rows: long names). -->
                                <TextBlock Text="QUICK PATTERNS" Style="{StaticResource ToolboxCategoryHeader}"
                                           ToolTip="Ready-made step combinations. Insert one, then capture the images / pick the spots named in its step comments." />
                                <ItemsControl ItemsSource="{Binding QuickPatternTypes}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource ToolboxTile}" Height="Auto" MinHeight="36" Padding="8,6" HorizontalContentAlignment="Stretch"
                                                    ToolTip="{Binding Description}"
                                                    Command="{Binding DataContext.AddPatternCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Pattern}" AutomationProperties.Name="{Binding Title}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource FeedbackBadgeBrush}" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding Glyph}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- ===== Workflow steps: connected visual cards on a dot-grid canvas ===== -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,6,6,6">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="Workflow steps" Style="{StaticResource SectionTitle}" FontSize="13" />
                                    <Border Style="{StaticResource Pill}" Margin="8,0,0,0"
                                            ToolTip="Drag steps to reorder them (Shift+click to select several). Right-click a step for Move to top / bottom and more.">
                                        <TextBlock Text="{Binding StepCountText}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                    </Border>
                                </StackPanel>
                                <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource IconButton}" Width="30" Height="28" Padding="6" FontSize="12" Content="&#xE7A7;" Command="{Binding UndoCommand}"
                                            ToolTip="{Binding UndoTooltip}" AutomationProperties.Name="Undo" />
                                    <Button Style="{StaticResource IconButton}" Width="30" Height="28" Padding="6" FontSize="12" Content="&#xE7A6;" Command="{Binding RedoCommand}"
                                            ToolTip="{Binding RedoTooltip}" AutomationProperties.Name="Redo" />
                                    <Border Width="1" Height="18" Margin="4,0" Background="{StaticResource BorderBrush}" />
                                    <Button Style="{StaticResource GhostButton}" Command="{Binding PlayFromSelectedCommand}" Padding="7,4" FontSize="11"
                                            ToolTip="Play from the selected step to the end (Shift+F5). A step inside a Repeat starts at that Repeat, so the loop stays whole."
                                            AutomationProperties.Name="Play from the selected step">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="▶" FontSize="11" Foreground="{StaticResource SuccessBrush}" />
                                            <TextBlock Text="From here" Margin="5,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource GhostButton}" Command="{Binding WrapInIfCommand}" Padding="7,4" FontSize="11"
                                            ToolTip="Put an If … End If around the selected steps (Ctrl+Shift+I; select several with Shift+click)."
                                            AutomationProperties.Name="Wrap selected steps in If">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8AB;" Style="{StaticResource IconText}" FontSize="12" Foreground="{StaticResource LogicAccentBrush}" />
                                            <TextBlock Text="Wrap in If" Margin="5,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource GhostButton}" Command="{Binding WrapInRepeatCommand}" Padding="7,4" FontSize="11"
                                            ToolTip="Put a Repeat … End Repeat around the selected steps (Ctrl+Shift+R; select several with Shift+click)."
                                            AutomationProperties.Name="Wrap selected steps in Repeat">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8EE;" Style="{StaticResource IconText}" FontSize="12" Foreground="{StaticResource LogicAccentBrush}" />
                                            <TextBlock Text="Wrap in Repeat" Margin="5,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource GhostButton}" Command="{Binding CleanUpMousePathsCommand}" Padding="7,4" FontSize="11"
                                            ToolTip="Convert recording to clean steps: long runs of recorded Delay + Move mouse steps become one Delay (+ one Move only where it's needed). Clicks keep their own positions; drags, steps with a comment and turned-off steps are kept. Select several steps to clean only those."
                                            AutomationProperties.Name="Clean up mouse paths">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7E6;" Style="{StaticResource IconText}" FontSize="12" />
                                            <TextBlock Text="Clean up" Margin="5,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Border Width="1" Height="18" Margin="4,0" Background="{StaticResource BorderBrush}" />
                                    <ToggleButton IsChecked="{Binding IsCompactView}" Padding="7,4" FontSize="11"
                                                  ToolTip="Compact view: one dense line per step (about twice as many steps on screen). Click again for the comfortable cards."
                                                  AutomationProperties.Name="Compact view">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton" BasedOn="{StaticResource GhostToggle}">
                                                <Style.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource SelectedCardBrush}" />
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8FD;" Style="{StaticResource IconText}" FontSize="12" />
                                            <TextBlock Text="Compact view" Margin="5,0,0,0" />
                                        </StackPanel>
                                    </ToggleButton>
                                    <Button Style="{StaticResource IconButton}" Width="30" Height="28" Padding="6" FontSize="11" Content="▶" Command="{Binding CollapseAllCommand}"
                                            ToolTip="Fold every If / Repeat block (the steps inside still play)" AutomationProperties.Name="Fold all blocks" />
                                    <Button Style="{StaticResource IconButton}" Width="30" Height="28" Padding="6" FontSize="11" Content="▼" Command="{Binding ExpandAllCommand}"
                                            ToolTip="Unfold every block" AutomationProperties.Name="Unfold all blocks" />
                                    <Border Width="1" Height="18" Margin="4,0" Background="{StaticResource BorderBrush}" />
                                    <Button Style="{StaticResource IconButton}" Width="30" Height="28" Padding="6" FontSize="12" Content="&#xE70E;" Command="{Binding MoveToTopCommand}" ToolTip="Move to top (Alt+Home). An If / Repeat moves together with its whole block." AutomationProperties.Name="Move to top" />
                                    <Button Style="{StaticResource IconButton}" Width="30" Height="28" Padding="6" FontSize="12" Content="&#xE74A;" Command="{Binding MoveUpCommand}" ToolTip="Move up one place (Alt+Up)" AutomationProperties.Name="Move step up" />
                                    <Button Style="{StaticResource IconButton}" Width="30" Height="28" Padding="6" FontSize="12" Content="&#xE74B;" Command="{Binding MoveDownCommand}" ToolTip="Move down one place (Alt+Down)" AutomationProperties.Name="Move step down" />
                                    <Button Style="{StaticResource IconButton}" Width="30" Height="28" Padding="6" FontSize="12" Content="&#xE70D;" Command="{Binding MoveToBottomCommand}" ToolTip="Move to bottom (Alt+End). An If / Repeat moves together with its whole block." AutomationProperties.Name="Move to bottom" />
                                    <Button Style="{StaticResource IconButton}" Width="30" Height="28" Padding="6" FontSize="12" Content="&#xE8C8;" Command="{Binding DuplicateStepCommand}" ToolTip="Duplicate step (Ctrl+D)" AutomationProperties.Name="Duplicate step" />
                                    <Button Style="{StaticResource IconButton}" Width="30" Height="28" Padding="6" FontSize="12" Content="&#xE74D;" Command="{Binding DeleteStepCommand}" ToolTip="Delete step (Delete)" AutomationProperties.Name="Delete step" />
                                </WrapPanel>
                            </DockPanel>
                        </Border>

                        <!-- ✨ Auto-Fix banner: only while the If / Repeat markers don't match up (and Auto-Fix can repair them) -->
                        <Border DockPanel.Dock="Top" Background="{StaticResource ErrorSoftBrush}" BorderBrush="{StaticResource ErrorBrush}"
                                BorderThickness="0,0,0,1" Padding="12,7,8,7"
                                Visibility="{Binding CanAutoFixBlocks, Converter={StaticResource BoolToVisibility}}"
                                AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Block structure problem">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Padding="10,5" FontSize="11" Margin="10,0,0,0"
                                        VerticalAlignment="Center" Command="{Binding AutoFixBlocksCommand}"
                                        ToolTip="Removes stray Else / End If / End Repeat steps that have no If / Repeat above them (and extra Elses), and adds the missing End If / End Repeat steps. Your other steps stay exactly where they are. Ctrl+Z undoes it."
                                        AutomationProperties.Name="Auto-Fix block structure">
                                    <TextBlock Text="✨ Auto-Fix Block Structure" />
                                </Button>
                                <TextBlock Text="&#xEA39;" Style="{StaticResource IconText}" FontSize="13" Foreground="{StaticResource ErrorBrush}"
                                           VerticalAlignment="Top" Margin="0,1,8,0" />
                                <TextBlock Text="{Binding BlockProblemText}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                                           ToolTip="{Binding BlockProblemText}" />
                            </DockPanel>
                        </Border>

                        <!-- 🔍 Search + filter pills (Ctrl+F): highlights / filters steps without changing their order or numbers -->
                        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,5,8,5"
                                Visibility="{Binding HasSteps, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                            Visibility="{Binding IsSearchActive, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding MatchNavigatorText}" FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                                               VerticalAlignment="Center" Margin="8,0,4,0" AutomationProperties.LiveSetting="Polite" />
                                    <Button Style="{StaticResource IconButton}" Width="26" Height="24" Padding="4" FontSize="11" Content="↑"
                                            Command="{Binding PreviousMatchCommand}" ToolTip="Previous match (Shift+F3 / Shift+Enter)" AutomationProperties.Name="Previous match" />
                                    <Button Style="{StaticResource IconButton}" Width="26" Height="24" Padding="4" FontSize="11" Content="↓"
                                            Command="{Binding NextMatchCommand}" ToolTip="Next match (F3 / Enter)" AutomationProperties.Name="Next match" />
                                    <Button Style="{StaticResource IconButton}" Width="26" Height="24" Padding="4" FontSize="11" Content="✕"
                                            Command="{Binding ClearSearchCommand}" ToolTip="Clear the search and the filter (Esc)" AutomationProperties.Name="Clear search" />
                                </StackPanel>
                                <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding FilterPills}" VerticalAlignment="Center" Margin="8,0,0,0"
                                              Focusable="False" AutomationProperties.Name="Step filters">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button x:Name="PillButton" Content="{Binding Label}" ToolTip="{Binding Tooltip}" Padding="8,2,8,3" Margin="2,0" FontSize="11"
                                                    Command="{Binding DataContext.SetFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" Style="{StaticResource GhostButton}"
                                                    AutomationProperties.Name="{Binding Label}" />
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter TargetName="PillButton" Property="Background" Value="{StaticResource SelectedCardBrush}" />
                                                    <Setter TargetName="PillButton" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                    <Setter TargetName="PillButton" Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid>
                                    <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                                               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False" Panel.ZIndex="1" />
                                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=120}"
                                             Tag="Search steps (Ctrl+F)" Padding="26,4,6,4" FontSize="12" MinWidth="140"
                                             PreviewKeyDown="SearchBox_PreviewKeyDown"
                                             AutomationProperties.Name="Search steps" ToolTip="Type to highlight matching steps (name, description, comment). Enter / F3 = next match, Shift+Enter / Shift+F3 = previous, Esc = clear." />
                                </Grid>
                            </DockPanel>
                        </Border>

                        <Grid Background="{StaticResource StepsCanvasBrush}">
                            <Rectangle Fill="{StaticResource DotGridTile}" IsHitTestVisible="False" />
                            <ListBox x:Name="StepList" ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep}"
                                     SelectionMode="Extended" Padding="10,10,10,4"
                                     ItemContainerStyle="{StaticResource StudioStepCardItem}"
                                     PreviewKeyDown="StepList_PreviewKeyDown"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.CacheLengthUnit="Page" VirtualizingPanel.CacheLength="1,1"
                                     AutomationProperties.Name="Workflow steps"
                                     SelectionChanged="StepList_SelectionChanged"
                                     AllowDrop="True"
                                     PreviewMouseLeftButtonDown="StepList_PreviewMouseLeftButtonDown"
                                     PreviewMouseMove="StepList_PreviewMouseMove"
                                     PreviewMouseLeftButtonUp="StepList_PreviewMouseLeftButtonUp"
                                     DragOver="StepList_DragOver"
                                     DragLeave="StepList_DragLeave"
                                     Drop="StepList_Drop"
                                     Visibility="{Binding HasSteps, Converter={StaticResource BoolToVisibility}}">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="▶ Run step" Command="{Binding RunStepCommand}" />
                                        <MenuItem Header="▶ Play from here" InputGestureText="Shift+F5" Command="{Binding PlayFromSelectedCommand}" />
                                        <MenuItem Header="Turn on / off" InputGestureText="Space" Command="{Binding ToggleEnabledCommand}" />
                                        <MenuItem Header="Fold / unfold block" Command="{Binding ToggleCollapseCommand}" />
                                        <Separator />
                                        <MenuItem Header="Copy" InputGestureText="Ctrl+C" Command="{Binding CopySelectedStepCommand}" />
                                        <MenuItem Header="Paste" InputGestureText="Ctrl+V" Command="{Binding PasteStepCommand}" />
                                        <MenuItem Header="Undo" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}" />
                                        <MenuItem Header="Redo" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}" />
                                        <Separator />
                                        <MenuItem Header="Move to top" InputGestureText="Alt+Home" Command="{Binding MoveToTopCommand}" />
                                        <MenuItem Header="Move up" InputGestureText="Alt+Up" Command="{Binding MoveUpCommand}" />
                                        <MenuItem Header="Move down" InputGestureText="Alt+Down" Command="{Binding MoveDownCommand}" />
                                        <MenuItem Header="Move to bottom" InputGestureText="Alt+End" Command="{Binding MoveToBottomCommand}" />
                                        <Separator />
                                        <MenuItem Header="Wrap in If" InputGestureText="Ctrl+Shift+I" Command="{Binding WrapInIfCommand}" />
                                        <MenuItem Header="Wrap in Repeat" InputGestureText="Ctrl+Shift+R" Command="{Binding WrapInRepeatCommand}" />
                                        <MenuItem Header="Clean up mouse paths" Command="{Binding CleanUpMousePathsCommand}" />
                                        <Separator />
                                        <MenuItem Header="Duplicate" InputGestureText="Ctrl+D" Command="{Binding DuplicateStepCommand}" />
                                        <MenuItem Header="Delete" InputGestureText="Delete" Command="{Binding DeleteStepCommand}" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.InputBindings>
                                    <KeyBinding Key="Delete" Command="{Binding DeleteStepCommand}" />
                                    <KeyBinding Key="R" Modifiers="Control+Shift" Command="{Binding WrapInRepeatCommand}" />
                                    <KeyBinding Key="I" Modifiers="Control+Shift" Command="{Binding WrapInIfCommand}" />
                                    <KeyBinding Key="D" Modifiers="Control" Command="{Binding DuplicateStepCommand}" />
                                    <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopySelectedStepCommand}" />
                                    <KeyBinding Key="V" Modifiers="Control" Command="{Binding PasteStepCommand}" />
                                    <KeyBinding Key="F5" Modifiers="Control" Command="{Binding RunStepCommand}" />
                                    <KeyBinding Key="F5" Modifiers="Shift" Command="{Binding PlayFromSelectedCommand}" />
                                    <KeyBinding Key="Up" Modifiers="Alt" Command="{Binding MoveUpCommand}" />
                                    <KeyBinding Key="Down" Modifiers="Alt" Command="{Binding MoveDownCommand}" />
                                    <KeyBinding Key="Home" Modifiers="Alt" Command="{Binding MoveToTopCommand}" />
                                    <KeyBinding Key="End" Modifiers="Alt" Command="{Binding MoveToBottomCommand}" />
                                </ListBox.InputBindings>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type steps:StepViewModel}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Indentation for steps inside If / Repeat blocks: 24 px per level with a guide line and depth accent bar. -->
                                            <Grid Grid.Column="0" Margin="0,-6,0,0"
                                                  Width="{Binding IndentLevel, Converter={StaticResource IndentLevel}, ConverterParameter=24}">
                                                <Rectangle Fill="{StaticResource IndentGuideTile}" IsHitTestVisible="False" />
                                                <Border Width="2.5" HorizontalAlignment="Right" Margin="0,2,5,2" CornerRadius="1"
                                                        Background="{Binding BlockAccentBrush}" Opacity="0.65" IsHitTestVisible="False" />
                                            </Grid>

                                            <Border x:Name="Card" Grid.Column="1" Background="{StaticResource StepCardBrush}"
                                                    BorderBrush="{StaticResource StepCardBorderBrush}" BorderThickness="1.5" CornerRadius="8"
                                                    SnapsToDevicePixels="True">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3.5" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Left accent strip in the step's category colour (or nesting depth colour for block markers) -->
                                                    <Border x:Name="AccentStrip" Grid.Column="0" CornerRadius="6.5,0,0,6.5" Margin="0,0,0,0"
                                                            Background="{Binding Kind, Converter={StaticResource CategoryBrush}, ConverterParameter=Accent}" />

                                                    <Grid x:Name="Row" Grid.Column="1" Margin="8,7,10,7">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="26" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <!-- Number, or ▼ / ▶ fold chevron on If / Repeat rows (the number is in the tooltip then). -->
                                                        <TextBlock x:Name="NumberText" Text="{Binding Number}" Foreground="{StaticResource SubtleTextBrush}" FontSize="11"
                                                                   VerticalAlignment="Center" HorizontalAlignment="Left" />
                                                        <Button x:Name="FoldButton" Visibility="Collapsed" Width="22" Height="22" Padding="0" FontSize="10"
                                                                HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource IconButton}"
                                                                Content="{Binding CollapseGlyph}" ToolTip="{Binding CollapseTooltip}" Focusable="False"
                                                                Command="{Binding DataContext.ToggleCollapseCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                CommandParameter="{Binding}" AutomationProperties.Name="Fold or unfold this block" />
                                                        <!-- 32×32 category icon badge -->
                                                        <Border x:Name="IconBadge" Grid.Column="1" Width="32" Height="32" CornerRadius="8"
                                                                Background="{Binding Kind, Converter={StaticResource CategoryBrush}, ConverterParameter=Badge}">
                                                            <TextBlock x:Name="IconGlyph" Text="{Binding Glyph}" Style="{StaticResource IconText}" HorizontalAlignment="Center"
                                                                       Foreground="{Binding Kind, Converter={StaticResource CategoryBrush}, ConverterParameter=Accent}" />
                                                        </Border>
                                                        <StackPanel Grid.Column="2" Margin="10,0,8,0" VerticalAlignment="Center">
                                                            <DockPanel LastChildFill="True">
                                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                                <TextBlock x:Name="TitleText" Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                                                <Border x:Name="BlockPairBadge" CornerRadius="6" Padding="7,1,7,2" Margin="8,0,0,0"
                                                                        Background="{Binding BlockBadgeBackgroundBrush}"
                                                                        BorderBrush="{Binding BlockAccentBrush}" BorderThickness="1"
                                                                        VerticalAlignment="Center"
                                                                        Visibility="{Binding HasBlockBadge, Converter={StaticResource BoolToVisibility}}"
                                                                        ToolTip="Block pair badge: matching If / Else / End If or Repeat / End Repeat share the same badge number and depth color.">
                                                                    <TextBlock Text="{Binding BlockFullBadgeText}" FontSize="10.5" FontWeight="Bold"
                                                                               Foreground="{Binding BlockAccentBrush}" />
                                                                </Border>
                                                                <Border x:Name="PartnerTag" Style="{StaticResource Pill}" Margin="6,0,0,0"
                                                                        Background="{Binding BlockBadgeBackgroundBrush}"
                                                                        Visibility="{Binding IsBlockPartnerHighlighted, Converter={StaticResource BoolToVisibility}}"
                                                                        ToolTip="Matching block partner of the selected step.">
                                                                    <TextBlock Text="⇄ MATCHING PAIR" FontSize="9" FontWeight="SemiBold"
                                                                               Foreground="{Binding BlockAccentBrush}" />
                                                                </Border>
                                                                <Border x:Name="DisabledTag" Style="{StaticResource Pill}" Margin="8,0,0,0" Visibility="Collapsed">
                                                                    <TextBlock Text="DISABLED" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                                                                </Border>
                                                                <Border x:Name="RunningTag" Style="{StaticResource Pill}" Margin="8,0,0,0" Background="{StaticResource SuccessSoftBrush}"
                                                                        Visibility="Collapsed" ToolTip="Playback is running this step right now.">
                                                                    <TextBlock Text="▶ RUNNING" FontSize="9" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                                                                </Border>
                                                                <Border x:Name="HiddenTag" Style="{StaticResource Pill}" Margin="8,0,0,0" Visibility="Collapsed"
                                                                        ToolTip="This block is folded: the steps inside are hidden here but still play. Click ▶ to show them.">
                                                                    <TextBlock Text="{Binding HiddenBadgeText}" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                                                                </Border>
                                                            </StackPanel>
                                                            <!-- Compact view: the summary on the same line -->
                                                            <TextBlock x:Name="InlineSummary" Text="{Binding Summary}" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5"
                                                                       TextTrimming="CharacterEllipsis" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                                            </DockPanel>
                                                            <TextBlock x:Name="SummaryText" Text="{Binding Summary}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                            <TextBlock x:Name="CommentText" Text="{Binding Comment}" FontStyle="Italic" Foreground="{StaticResource SubtleTextBrush}" FontSize="11"
                                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                                                       Visibility="{Binding HasComment, Converter={StaticResource BoolToVisibility}}" />
                                                        </StackPanel>
                                                        <!-- Inline preview: image thumbnail / colour swatch (empty for other steps) -->
                                                        <ContentControl Grid.Column="3" Content="{Binding}" ContentTemplateSelector="{StaticResource StepPreviewSelector}"
                                                                        Focusable="False" IsTabStop="False" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                        <Grid Grid.Column="4" VerticalAlignment="Center">
                                                            <TextBlock Text="&#xEA39;" Style="{StaticResource IconText}" Foreground="{StaticResource ErrorBrush}"
                                                                       ToolTip="{Binding IssueText}" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                                            <TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}" Foreground="{StaticResource WarningBrush}"
                                                                       ToolTip="{Binding IssueText}" Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}" />
                                                        </Grid>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding HasBlockBadge}" Value="True">
                                                <Setter TargetName="AccentStrip" Property="Background" Value="{Binding BlockAccentBrush}" />
                                                <Setter TargetName="IconBadge" Property="Background" Value="{Binding BlockBadgeBackgroundBrush}" />
                                                <Setter TargetName="IconGlyph" Property="Foreground" Value="{Binding BlockAccentBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsBlockPartnerHighlighted}" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{Binding BlockAccentBrush}" />
                                                <Setter TargetName="Card" Property="Background" Value="{Binding BlockBadgeBackgroundBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=Card}" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                <Setter TargetName="Card" Property="Background" Value="{StaticResource SelectedCardBrush}" />
                                                <Setter TargetName="Card" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#3B82F6" BlurRadius="12" ShadowDepth="0" Opacity="0.45" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                <Setter TargetName="Card" Property="Opacity" Value="0.45" />
                                                <Setter TargetName="DisabledTag" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <!-- ▼ / ▶ fold chevron on If / Repeat rows; "[N steps hidden]" while folded -->
                                            <DataTrigger Binding="{Binding CanCollapse}" Value="True">
                                                <Setter TargetName="FoldButton" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="NumberText" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                                <Setter TargetName="HiddenTag" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <!-- Search: matches get an amber outline (the one the ↑ ↓ navigator is on glows), the rest is dimmed -->
                                            <DataTrigger Binding="{Binding IsSearchDimmed}" Value="True">
                                                <Setter TargetName="Card" Property="Opacity" Value="0.4" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSearchMatch}" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCurrentSearchMatch}" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                                                <Setter TargetName="Card" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#F59E0B" BlurRadius="12" ShadowDepth="0" Opacity="0.55" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                            <!-- Compact view: one dense line (summary inline, smaller badge, less padding) -->
                                            <DataTrigger Binding="{Binding DataContext.IsCompactView, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                                <Setter TargetName="Row" Property="Margin" Value="8,3,10,3" />
                                                <Setter TargetName="IconBadge" Property="Width" Value="22" />
                                                <Setter TargetName="IconBadge" Property="Height" Value="22" />
                                                <Setter TargetName="IconBadge" Property="CornerRadius" Value="6" />
                                                <Setter TargetName="IconGlyph" Property="FontSize" Value="11" />
                                                <Setter TargetName="TitleText" Property="FontSize" Value="12" />
                                                <Setter TargetName="SummaryText" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="CommentText" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="InlineSummary" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                                <Setter TargetName="Card" Property="Background" Value="{StaticResource RunningCardBrush}" />
                                                <Setter TargetName="RunningTag" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="Card" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#10B981" BlurRadius="14" ShadowDepth="0" Opacity="0.5" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="300"
                                        Visibility="{Binding HasSteps, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                <TextBlock Text="&#xE8FD;" Style="{StaticResource IconText}" FontSize="28" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="This macro has no steps yet" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                                <TextBlock Text="Add steps from the toolbox on the left (or press Record). Then drag steps to reorder them, right-click a step for more actions, and set them up on the right."
                                           Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- ===== Properties (inspector) ===== -->
                <Border Grid.Column="4" Style="{StaticResource Card}" Padding="0">
                    <DockPanel>
                        <!-- Sticky inspector header: category badge, step title, Step N pill, Enabled switch -->
                        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,10,14,10">
                            <Grid>
                                <TextBlock Text="Properties" Style="{StaticResource SectionTitle}" FontSize="13" VerticalAlignment="Center"
                                           Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="8"
                                            Background="{Binding SelectedStep.Kind, Converter={StaticResource CategoryBrush}, ConverterParameter=Badge}">
                                        <TextBlock Text="{Binding SelectedStep.Glyph}" Style="{StaticResource IconText}" HorizontalAlignment="Center"
                                                   Foreground="{Binding SelectedStep.Kind, Converter={StaticResource CategoryBrush}, ConverterParameter=Accent}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedStep.Title}" Style="{StaticResource SectionTitle}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                        <Border Style="{StaticResource Pill}" HorizontalAlignment="Left" Margin="0,3,0,0" Padding="6,0,6,1">
                                            <TextBlock FontSize="10" Foreground="{StaticResource MutedTextBrush}">
                                                <Run Text="Step " /><Run Text="{Binding SelectedStep.Number, Mode=OneWay}" />
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Command="{Binding RunStepCommand}" Padding="8,4" FontSize="11"
                                            Margin="0,0,8,0" VerticalAlignment="Center"
                                            ToolTip="Run step (Ctrl+F5): plays only this step right now (an If / Repeat runs its whole block), once. Esc stops it. A turned-off step runs too (just for this test)."
                                            AutomationProperties.Name="Run this step only">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="▶" FontSize="11" Foreground="{StaticResource SuccessBrush}" />
                                            <TextBlock Text="Run step" Margin="5,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <CheckBox Grid.Column="3" Style="{StaticResource ToggleSwitchCheckBoxStyle}" Content="Enabled" VerticalAlignment="Center"
                                              IsChecked="{Binding SelectedStep.Enabled}"
                                              ToolTip="Turned-off steps are skipped when the macro plays."
                                              AutomationProperties.Name="Step enabled" />
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Pinned bottom action bar: "Test detection now" for Find text / image / color and Feedback loop -->
                        <ContentControl DockPanel.Dock="Bottom" Content="{Binding SelectedStep}" ContentTemplateSelector="{StaticResource InspectorActionSelector}"
                                        Focusable="False" IsTabStop="False"
                                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}" />

                        <Grid>
                            <TextBlock Text="Select a step to edit its settings." Style="{StaticResource MutedText}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
                                       Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                            <ScrollViewer x:Name="PropertiesScroll" VerticalScrollBarVisibility="Auto" Padding="14,10,14,20"
                                          PreviewMouseWheel="Properties_PreviewMouseWheel"
                                          Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                                <ContentControl Content="{Binding SelectedStep}" Focusable="False" />
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ===== Bottom status & activity drawer (Problems + Activity in one place) ===== -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,8,0,0" Padding="0">
                <DockPanel>
                    <!-- 32 px header: state pill | problems badge | latest activity | Open full log | Expand -->
                    <Grid DockPanel.Dock="Top" Height="32" Margin="10,0,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Live status pill -->
                        <Border Grid.Column="0" Style="{StaticResource StatePillStyle}"
                                DataContext="{Binding DataContext.Automation, RelativeSource={RelativeSource AncestorType=Window}}"
                                AutomationProperties.LiveSetting="Polite">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource StateDotStyle}" />
                                <TextBlock Text="{Binding StateText}" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Problems count badge (click it to open the drawer; same switch as "Expand") -->
                        <ToggleButton Grid.Column="1" Style="{StaticResource GhostToggle}" Margin="6,0,0,0" Padding="2"
                                      IsChecked="{Binding IsChecked, ElementName=DrawerToggle, Mode=TwoWay}"
                                      ToolTip="Show the list of problems" AutomationProperties.Name="Problems">
                            <Border Style="{StaticResource Pill}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" FontSize="10" Foreground="{StaticResource SuccessBrush}"
                                               Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                    <TextBlock Text="&#xEA39;" Style="{StaticResource IconText}" FontSize="10" Foreground="{StaticResource ErrorBrush}"
                                               Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}" FontSize="10" Foreground="{StaticResource WarningBrush}" Margin="3,0,0,0"
                                               Visibility="{Binding WarningCount, Converter={StaticResource CountToVisibility}}" />
                                    <TextBlock Text="{Binding ValidationSummary}" FontSize="11" Margin="5,0,0,0" Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                            </Border>
                        </ToggleButton>

                        <!-- Latest activity line (or live progress while recording / playing) -->
                        <Grid Grid.Column="2" Margin="12,0,8,0" VerticalAlignment="Center"
                              DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                            <StackPanel Orientation="Horizontal" Visibility="{Binding Automation.IsIdle, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding Logs.Entries[0].Level, Converter={StaticResource LevelToGlyph}, FallbackValue=''}" Style="{StaticResource IconText}"
                                           FontSize="11" Foreground="{Binding Logs.Entries[0].Level, Converter={StaticResource LevelToBrush}, FallbackValue={StaticResource MutedTextBrush}}" />
                                <TextBlock Text="{Binding Logs.Entries[0].Message, FallbackValue=''}" FontSize="11" Margin="6,0,0,0"
                                           Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Text="{Binding Automation.ProgressText}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding Automation.IsIdle, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                        </Grid>

                        <Button Grid.Column="3" Style="{StaticResource GhostButton}" Padding="8,3" FontSize="11" Content="Open full log"
                                Command="{Binding DataContext.ShowLogsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <ToggleButton x:Name="DrawerToggle" Grid.Column="4" Style="{StaticResource GhostToggle}" IsChecked="False" Margin="2,0,0,0"
                                      ToolTip="Show or hide the Activity log and the Problems list" AutomationProperties.Name="Expand or collapse the activity drawer">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Expand ▴" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=DrawerToggle}" Value="True">
                                                <Setter Property="Text" Value="Collapse ▾" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </ToggleButton>
                    </Grid>

                    <!-- Progress line while playing -->
                    <ProgressBar DockPanel.Dock="Top" Height="2" Margin="10,0,10,0" Minimum="0" Maximum="1"
                                 DataContext="{Binding DataContext.Automation, RelativeSource={RelativeSource AncestorType=Window}}"
                                 Value="{Binding ProgressValue, Mode=OneWay}" IsIndeterminate="{Binding IsProgressIndeterminate}"
                                 Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Expanded: Activity log | Problems, split with a GridSplitter -->
                    <Grid Height="120" Margin="10,0,10,8" Visibility="{Binding IsChecked, ElementName=DrawerToggle, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" MinWidth="160" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="2*" MinWidth="160" />
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top" Text="ACTIVITY LOG" Style="{StaticResource SetupCardTitle}" FontSize="10" Margin="2,4,0,2" />
                            <ListBox ItemsSource="{Binding DataContext.Logs.Entries, RelativeSource={RelativeSource AncestorType=Window}}"
                                     ItemContainerStyle="{StaticResource PlainListItem}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True"
                                     AutomationProperties.Name="Activity log">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Level, Converter={StaticResource LevelToGlyph}}" Style="{StaticResource IconText}"
                                                       FontSize="11" Foreground="{Binding Level, Converter={StaticResource LevelToBrush}}" />
                                            <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource SubtleTextBrush}" Margin="8,0,10,0" FontSize="11" />
                                            <TextBlock Text="{Binding Message}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <GridSplitter Grid.Column="1" Style="{StaticResource PanelSplitter}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                                      ToolTip="Drag to resize" AutomationProperties.Name="Resize the Activity log and Problems lists" />

                        <DockPanel Grid.Column="2">
                            <TextBlock DockPanel.Dock="Top" Text="PROBLEMS" Style="{StaticResource SetupCardTitle}" FontSize="10" Margin="2,4,0,2" />
                            <Grid>
                                <TextBlock Text="No problems found. The macro can be saved and played." Style="{StaticResource MutedText}" FontSize="11" Margin="4,4,0,0"
                                           Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                <ListBox ItemsSource="{Binding Issues}" ItemContainerStyle="{StaticResource PlainListItem}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Problems"
                                         Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisibility}}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type core:ValidationIssue}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Severity, Converter={StaticResource LevelToGlyph}}" Style="{StaticResource IconText}" FontSize="11"
                                                           Foreground="{Binding Severity, Converter={StaticResource LevelToBrush}}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding DisplayText}" FontSize="11" Margin="8,0,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
