<UserControl x:Class="SmartMacro.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SmartMacro.ViewModels"
             xmlns:steps="clr-namespace:SmartMacro.ViewModels.Steps"
             xmlns:ctrl="clr-namespace:SmartMacro.Controls"
             xmlns:conv="clr-namespace:SmartMacro.Converters"
             xmlns:core="clr-namespace:SmartMacro.Core.Validation;assembly=SmartMacro.Core"
             xmlns:models="clr-namespace:SmartMacro.Core.Models;assembly=SmartMacro.Core"
             xmlns:playback="clr-namespace:SmartMacro.Core.Playback;assembly=SmartMacro.Core"
             xmlns:panes="clr-namespace:SmartMacro.Views.EditorPanes"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:EditorViewModel}"
             d:DesignWidth="1180" d:DesignHeight="760">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="StepEditorTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:StepCategoryBrushConverter x:Key="CategoryBrush" />

            <!-- Pinned bottom bar of the inspector -->
            <DataTemplate x:Key="SearchActionBarTemplate">
                <Border Style="{StaticResource InspectorActionBar}">
                    <StackPanel>
                        <Button Style="{StaticResource TestActionButton}" Command="{Binding TestCommand}"
                                ToolTip="Looks once where this step would look and highlights what it found."
                                AutomationProperties.Name="Test detection now">
                            <StackPanel Orientation="Horizontal">
                                <ctrl:StudioIcon Kind="Flask" Size="13" />
                                <TextBlock Text="Test detection now" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto">
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SearchTestResultTemplate}" Focusable="False" />
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </DataTemplate>
            <DataTemplate x:Key="FeedbackActionBarTemplate">
                <Border Style="{StaticResource InspectorActionBar}">
                    <StackPanel>
                        <Button Style="{StaticResource TestActionButton}" Command="{Binding TestDetectionCommand}"
                                ToolTip="Looks at the bar once and shows where the marker and zone are."
                                AutomationProperties.Name="Test detection now">
                            <StackPanel Orientation="Horizontal">
                                <ctrl:StudioIcon Kind="Flask" Size="13" />
                                <TextBlock Text="Test detection now" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding TestResult, Converter={StaticResource NullToVisibility}}">
                            <Border Margin="0,8,0,0" Padding="10,8" CornerRadius="6" Background="{DynamicResource SurfaceAltBrush}">
                                <StackPanel>
                                    <TextBlock Text="{Binding TestResult}" TextWrapping="Wrap" FontSize="12" />
                                    <Button Command="{Binding ShowMatchCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="8,4" FontSize="12"
                                            ToolTip="Moves your mouse cursor onto the marker the test found.">
                                        <StackPanel Orientation="Horizontal">
                                            <ctrl:StudioIcon Kind="Target" Size="12" />
                                            <TextBlock Text="Show me (move cursor to marker)" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <conv:StepKindTemplateSelector x:Key="InspectorActionSelector"
                                           ScreenSearchTemplate="{StaticResource SearchActionBarTemplate}"
                                           FeedbackLoopTemplate="{StaticResource FeedbackActionBarTemplate}" />
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{Binding RedoCommand}" />
        <KeyBinding Key="F5" Modifiers="Shift" Command="{Binding PlayFromSelectedCommand}" />
        <KeyBinding Key="F9" Command="{Binding ToggleBreakpointCommand}" />
        <KeyBinding Key="F10" Command="{Binding StepOverCommand}" />
        <KeyBinding Key="F11" Command="{Binding StepIntoCommand}" />
        <KeyBinding Key="F11" Modifiers="Shift" Command="{Binding StepOutCommand}" />
        <KeyBinding Key="F3" Command="{Binding NextMatchCommand}" />
        <KeyBinding Key="F3" Modifiers="Shift" Command="{Binding PreviousMatchCommand}" />
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding ToggleCommandPaletteCommand}" />
        <KeyBinding Key="T" Modifiers="Control" Command="{Binding TestSelectedStepCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <!-- ============ Empty State: Nothing Open ============ -->
        <Border Style="{StaticResource GlassCard}" Visibility="{Binding HasMacro, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400">
                <Border Width="64" Height="64" CornerRadius="18" Background="{DynamicResource AccentSoftBrush}"
                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" HorizontalAlignment="Center">
                    <ctrl:StudioIcon Kind="Editor" Size="26" Foreground="{DynamicResource AccentHoverBrush}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="No workflow open" Style="{StaticResource SectionTitle}" FontSize="17" HorizontalAlignment="Center" Margin="0,16,0,0" />
                <TextBlock Text="Open a macro from your Library, press Rec in the title bar to record a new one, or load a 1-click recipe from the Studio Manual."
                           Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,6,0,18" />
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding GoToLibraryCommand}" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ctrl:StudioIcon Kind="Library" Size="14" />
                        <TextBlock Text="Open Macro Library" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ============ Studio X Workflow Editor ============ -->
        <Grid Visibility="{Binding HasMacro, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="300" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- =========================================================================
                 C1: STREAMLINED 1-ROW STUDIO HEADER (Name · Description · Run Settings Popover · Save)
                 ========================================================================= -->
            <Border Grid.Row="0" Style="{StaticResource GlassCard}" Padding="14,7,12,7" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="220" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Macro Name + Inline Description -->
                    <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" MaxWidth="280" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource AccentSoftBrush}" CornerRadius="5" Padding="6,2"
                                VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="MACRO" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentHoverBrush}" />
                        </Border>
                        <TextBox x:Name="MacroNameBox" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Tag="Macro name"
                                 FontSize="15.5" FontWeight="SemiBold" MinWidth="130" Padding="6,2" MaxLength="100"
                                 ToolTip="Click or press F2 to rename macro (Enter saves, Esc cancels)"
                                 GotKeyboardFocus="HeaderTextBox_GotKeyboardFocus"
                                 PreviewMouseLeftButtonDown="MacroNameBox_PreviewMouseLeftButtonDown"
                                 PreviewKeyDown="HeaderTextBox_PreviewKeyDown"
                                 AutomationProperties.Name="Macro name">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBlock Grid.Column="2" Text="—" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" Margin="6,0" />
                        <TextBox x:Name="MacroDescriptionBox" Grid.Column="3" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Tag="Add notes or description…"
                                 Foreground="{DynamicResource MutedTextBrush}"
                                 FontSize="12" Padding="6,2" MaxLength="2000" VerticalAlignment="Center"
                                 ToolTip="Click to edit notes or description (Enter saves, Esc cancels)"
                                 GotKeyboardFocus="HeaderTextBox_GotKeyboardFocus"
                                 PreviewKeyDown="HeaderTextBox_PreviewKeyDown"
                                 AutomationProperties.Name="Macro description">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>

                    <!-- Right: Quick Run Summary & Settings Popover + Brain Pills + Discard / Save -->
                    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Quick inline Repeat & Speed controls + Run Settings Popover -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                            <TextBlock Text="Runs" Foreground="{DynamicResource MutedTextBrush}" FontSize="11.5" VerticalAlignment="Center" />
                            <TextBox Style="{StaticResource HeaderNumberBox}" Text="{Binding RepeatCount, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                     Width="40" Margin="5,0,6,0" FontFamily="{StaticResource MonoFont}"
                                     GotKeyboardFocus="HeaderTextBox_GotKeyboardFocus"
                                     PreviewKeyDown="HeaderTextBox_PreviewKeyDown"
                                     ToolTip="How many times to run (0 = repeat forever until Esc)" AutomationProperties.Name="Repeat count" />
                            <ComboBox ItemsSource="{Binding SpeedChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding Speed, Mode=TwoWay}" MinWidth="60" Padding="7,3" FontSize="11.5"
                                      ToolTip="Playback speed multiplier (applies live even mid-run)" AutomationProperties.Name="Playback speed" />
                        </StackPanel>

                        <!-- ⚙ Run & Target Window Settings Popover -->
                        <Grid Margin="0,0,6,0" VerticalAlignment="Center">
                            <ToggleButton x:Name="RunSettingsToggle" Style="{StaticResource GhostToggle}" Padding="8,4"
                                          IsHitTestVisible="{Binding IsOpen, ElementName=RunSettingsPopup, Converter={StaticResource InverseBool}}"
                                          ToolTip="Run settings: Target window, coordinate auto-scaling, repeat delay, Humanize, and OBS streamer mode"
                                          AutomationProperties.Name="Run and target settings">
                                <StackPanel Orientation="Horizontal">
                                    <ctrl:StudioIcon Kind="Sliders" Size="13" />
                                    <TextBlock Text="{Binding TargetSummary}" FontSize="11.5" Margin="6,0,4,0" MaxWidth="130" TextTrimming="CharacterEllipsis" />
                                    <ctrl:StudioIcon Kind="ChevronDown" Size="11" />
                                </StackPanel>
                            </ToggleButton>

                            <Popup x:Name="RunSettingsPopup" IsOpen="{Binding IsChecked, ElementName=RunSettingsToggle, Mode=TwoWay}"
                                   Opened="RunSettingsPopup_Opened"
                                   StaysOpen="False" PlacementTarget="{Binding ElementName=RunSettingsToggle}"
                                   Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Background="{DynamicResource CharcoalBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="16,14" Width="360" Margin="8"
                                        Effect="{StaticResource ShadowPopover}">
                                    <StackPanel>
                                        <TextBlock Text="PLAYBACK &amp; TARGET WINDOW" Style="{StaticResource OverlineHeaderStyle}" />

                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Repeat count (0 = ∞)" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding RepeatCount, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                                         GotKeyboardFocus="HeaderTextBox_GotKeyboardFocus"
                                                         PreviewKeyDown="HeaderTextBox_PreviewKeyDown" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Between runs (ms)" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding RepeatDelayMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                                         GotKeyboardFocus="HeaderTextBox_GotKeyboardFocus"
                                                         PreviewKeyDown="HeaderTextBox_PreviewKeyDown" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Profile / context tag (optional)" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                                        <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. Work, Excel, Elden Ring (empty = global)"
                                                 MaxLength="60" AutomationProperties.Name="Profile or context tag"
                                                 GotKeyboardFocus="HeaderTextBox_GotKeyboardFocus"
                                                 PreviewKeyDown="HeaderTextBox_PreviewKeyDown"
                                                 ToolTip="Assigns this macro to an app or game profile. When Auto-Switch Profile by Active Window is enabled, shortcuts for this profile only fire while that app/game is active." />

                                        <TextBlock Text="Target window" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Command="{Binding RefreshTargetWindowsCommand}" Padding="8,5" Margin="6,0,0,0"
                                                    ToolTip="Refresh open windows" AutomationProperties.Name="Refresh windows">
                                                <TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" FontSize="12" />
                                            </Button>
                                            <ComboBox IsEditable="True" ItemsSource="{Binding TargetWindowChoices}"
                                                      Text="{Binding TargetWindowTitle, UpdateSourceTrigger=PropertyChanged}"
                                                      AutomationProperties.Name="Target window" />
                                        </DockPanel>

                                        <CheckBox Style="{StaticResource ToggleSwitchCheckBoxStyle}" Margin="0,10,0,0"
                                                  Content="Auto-scale coordinates to target window"
                                                  IsChecked="{Binding ScaleCoordinatesToWindow}" />
                                        <TextBlock Text="{Binding ReferenceText}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" />
                                        <Button Command="{Binding UseCurrentSizeCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="9,4" FontSize="11.5"
                                                Content="Capture current window size as reference" />

                                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,12,0,10" />

                                        <TextBlock Text="BEHAVIOR &amp; OVERLAYS" Style="{StaticResource OverlineHeaderStyle}" Margin="0,0,0,8" />
                                        <CheckBox Style="{StaticResource ToggleSwitchCheckBoxStyle}" Content="🎲 Humanize timing &amp; click offsets"
                                                  IsChecked="{Binding HumanizePlayback}" ToolTip="{Binding HumanizeTooltip}" Margin="0,0,0,6" />
                                        <CheckBox Style="{StaticResource ToggleSwitchCheckBoxStyle}" Content="Show mini HUD pill while playing"
                                                  IsChecked="{Binding DataContext.ShowMiniOverlay, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,6" />
                                        <CheckBox Style="{StaticResource ToggleSwitchCheckBoxStyle}" Content="🎥 Show overlays in OBS / Discord"
                                                  IsChecked="{Binding DataContext.ShowOverlaysInObs, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,6" />
                                        <CheckBox Style="{StaticResource ToggleSwitchCheckBoxStyle}" Content="Minimize main window during playback"
                                                  IsChecked="{Binding DataContext.MinimizeWhilePlaying, RelativeSource={RelativeSource AncestorType=Window}}" />

                                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,12,0,10" />

                                        <TextBlock Text="CLI &amp; STREAM DECK" Style="{StaticResource OverlineHeaderStyle}" Margin="0,0,0,6" />
                                        <Button Command="{Binding CopyCliCommand}" HorizontalAlignment="Left" Padding="9,4" FontSize="11.5"
                                                ToolTip="Copy a command line (--run ... --no-focus) for Task Scheduler, Stream Deck, or desktop shortcuts."
                                                AutomationProperties.Name="Copy CLI command">
                                            <StackPanel Orientation="Horizontal">
                                                <ctrl:StudioIcon Kind="ExternalLink" Size="12" />
                                                <TextBlock Text="Copy CLI Run Command" Margin="6,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- Quick Brain Dock Buttons (Variables & Watchers) -->
                        <Button Style="{StaticResource GhostButton}" Padding="8,4" Margin="0,0,4,0"
                                Command="{Binding OpenBottomTabCommand}" CommandParameter="2"
                                ToolTip="Open Variables (memory &amp; live OCR readouts) in bottom dock"
                                AutomationProperties.Name="Open variables dock">
                            <StackPanel Orientation="Horizontal">
                                <ctrl:StudioIcon Kind="Variable" Size="13" Foreground="{DynamicResource MemoryAccentBrush}" />
                                <TextBlock Text="{Binding VariablesSummary}" FontSize="11.5" Margin="5,0,0,0" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource GhostButton}" Padding="8,4" Margin="0,0,4,0"
                                Command="{Binding OpenBottomTabCommand}" CommandParameter="3"
                                ToolTip="Open Background Watchers (popup &amp; disconnect guards) in bottom dock"
                                AutomationProperties.Name="Open watchers dock">
                            <StackPanel Orientation="Horizontal">
                                <ctrl:StudioIcon Kind="Watcher" Size="13" Foreground="{DynamicResource MemoryAccentBrush}" />
                                <TextBlock Text="{Binding WatchersSummary}" FontSize="11.5" Margin="5,0,0,0" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource GhostButton}" Padding="8,4" Margin="0,0,8,0"
                                Command="{Binding OpenBottomTabCommand}" CommandParameter="4"
                                ToolTip="Open Triggers (per-macro hotkeys, schedules, window triggers &amp; Run Governor) in bottom dock"
                                AutomationProperties.Name="Open triggers dock">
                            <StackPanel Orientation="Horizontal">
                                <ctrl:StudioIcon Kind="Bolt" Size="13" Foreground="{DynamicResource WarningBrush}" />
                                <TextBlock Text="{Binding TriggersSummary}" FontSize="11.5" Margin="5,0,0,0" />
                            </StackPanel>
                        </Button>

                        <Border Width="1" Height="18" Background="{DynamicResource BorderBrush}" Margin="0,0,8,0" />

                        <!-- Validation Error Alert + Saved / Unsaved badge + Discard & Save -->
                        <Button Style="{StaticResource DangerButton}" Command="{Binding FocusFirstErrorCommand}"
                                Padding="8,4" Margin="0,0,6,0" FontSize="11"
                                Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="This workflow has validation errors that must be fixed before saving. Click to jump to the first error step and open the Problems panel."
                                AutomationProperties.Name="Jump to first validation error">
                            <StackPanel Orientation="Horizontal">
                                <ctrl:StudioIcon Kind="ErrorCircle" Size="11" Foreground="{DynamicResource ErrorBrush}" />
                                <TextBlock Text="{Binding ErrorBadgeText}" FontWeight="SemiBold" Margin="5,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Border Style="{StaticResource Pill}" Margin="0,0,6,0" Background="{DynamicResource WarningSoftBrush}"
                                Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Unsaved" Foreground="{DynamicResource WarningBrush}" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                        <Border Style="{StaticResource Pill}" Margin="0,0,6,0" Background="{DynamicResource SuccessSoftBrush}"
                                Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                            <StackPanel Orientation="Horizontal">
                                <ctrl:StudioIcon Kind="CheckCircle" Size="11" Foreground="{DynamicResource SuccessBrush}" />
                                <TextBlock Text="Saved" Foreground="{DynamicResource SuccessBrush}" FontSize="11" FontWeight="SemiBold" Margin="4,0,0,0" />
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource GhostButton}" Command="{Binding RevertCommand}" Padding="8,5" Margin="0,0,4,0"
                                ToolTip="Discard unsaved changes" AutomationProperties.Name="Discard changes">
                            <ctrl:StudioIcon Kind="Undo" Size="13" />
                        </Button>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Padding="11,5"
                                ToolTip="Save workflow (Ctrl+S)" AutomationProperties.Name="Save">
                            <StackPanel Orientation="Horizontal">
                                <ctrl:StudioIcon Kind="Save" Size="13" />
                                <TextBlock Text="Save" Margin="6,0,0,0" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- =========================================================================
                 ROW 1: 3-PANE STUDIO WORKSPACE (Searchable Toolbox | Step Canvas + Minimap | Inspector)
                 ========================================================================= -->
            <Grid Grid.Row="1" SizeChanged="Workspace_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="224" MinWidth="176" MaxWidth="420" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" MinWidth="280" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="364" MinWidth="280" MaxWidth="760" />
                </Grid.ColumnDefinitions>

                <GridSplitter Grid.Column="1" Style="{StaticResource PanelSplitter}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                              ToolTip="Drag to resize Toolbox" AutomationProperties.Name="Resize Toolbox" />
                <GridSplitter Grid.Column="3" Style="{StaticResource PanelSplitter}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                              ToolTip="Drag to resize Inspector" AutomationProperties.Name="Resize Inspector" />

                <panes:ToolboxPane Grid.Column="0" />

                <panes:WorkflowCanvasPane x:Name="WorkflowCanvas" Grid.Column="2" />

                <!-- ===== C8: Sticky Inspector Panel v3 ("Precision Parameter Deck") ===== -->
                <Border Grid.Column="4" Style="{StaticResource GlassCard}" Padding="0" ClipToBounds="True">
                    <DockPanel>
                        <!-- Category-Tinted Neon Top Accent Strip -->
                        <Border DockPanel.Dock="Top" Height="3"
                                Background="{Binding SelectedStep.Kind, Converter={StaticResource CategoryBrush}, ConverterParameter=Accent}"
                                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}" />

                        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                            <Grid>
                                <TextBlock Text="Inspector" Style="{StaticResource SectionTitle}" FontSize="13" VerticalAlignment="Center"
                                           Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="9"
                                                Background="{Binding SelectedStep.Kind, Converter={StaticResource CategoryBrush}, ConverterParameter=Badge}"
                                                BorderBrush="{Binding SelectedStep.Kind, Converter={StaticResource CategoryBrush}, ConverterParameter=Accent}"
                                                BorderThickness="1">
                                            <TextBlock Text="{Binding SelectedStep.Glyph}" Style="{StaticResource IconText}" FontSize="15" HorizontalAlignment="Center"
                                                       Foreground="{Binding SelectedStep.Kind, Converter={StaticResource CategoryBrush}, ConverterParameter=Accent}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedStep.Title}" Style="{StaticResource SectionTitle}" FontSize="14.5" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <Border Style="{StaticResource Pill}" Padding="2,0,2,1">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource GhostButton}" Command="{Binding SelectPreviousStepCommand}"
                                                                Padding="4,0" Height="16" FontSize="9" VerticalAlignment="Center"
                                                                ToolTip="Inspect previous step (Alt+[)" AutomationProperties.Name="Inspect previous step">
                                                            <TextBlock Text="◀" FontSize="8.5" VerticalAlignment="Center" />
                                                        </Button>
                                                        <TextBlock FontSize="10" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource MutedTextBrush}"
                                                                   Margin="3,0" VerticalAlignment="Center">
                                                            <Run Text="Step #" /><Run Text="{Binding SelectedStep.Number, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <Button Style="{StaticResource GhostButton}" Command="{Binding SelectNextStepCommand}"
                                                                Padding="4,0" Height="16" FontSize="9" VerticalAlignment="Center"
                                                                ToolTip="Inspect next step (Alt+])" AutomationProperties.Name="Inspect next step">
                                                            <TextBlock Text="▶" FontSize="8.5" VerticalAlignment="Center" />
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource Pill}" Margin="5,0,0,0" Padding="6,0,6,1"
                                                        Background="{Binding SelectedStep.CategoryGlowBrush}">
                                                    <TextBlock Text="{Binding SelectedStep.CategoryLabel}" FontSize="9.5" FontWeight="Bold"
                                                               FontFamily="{StaticResource MonoFont}" Foreground="{Binding SelectedStep.CategoryAccentBrush}" />
                                                </Border>
                                                <Border Style="{StaticResource Pill}" Margin="5,0,0,0" Padding="6,0,6,1"
                                                        Visibility="{Binding SelectedStep.HasTimelineOffset, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{Binding SelectedStep.TimelineOffsetText}" FontSize="10"
                                                               FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource AccentHoverBrush}" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                        <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitchCheckBoxStyle}" Content="On" VerticalAlignment="Center"
                                                  IsChecked="{Binding SelectedStep.Enabled}"
                                                  ToolTip="Turned-off steps are skipped during playback" />
                                    </Grid>

                                    <!-- Quick-Action Deck (Run Step · Play From Here · Duplicate) -->
                                    <UniformGrid Columns="3" Margin="0,9,0,0">
                                        <Button Style="{StaticResource GhostButton}" Command="{Binding RunStepCommand}" Padding="6,4" FontSize="11" Margin="0,0,4,0"
                                                ToolTip="Run only this step right now (Ctrl+F5)">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <ctrl:StudioIcon Kind="Play" Size="10" Foreground="{DynamicResource SuccessBrush}" />
                                                <TextBlock Text="Run Step" Margin="5,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource GhostButton}" Command="{Binding PlayFromHereCommand}" Padding="6,4" FontSize="11" Margin="2,0,2,0"
                                                ToolTip="Play workflow starting from this step (Shift+F5)">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <ctrl:StudioIcon Kind="Play" Size="10" Foreground="{DynamicResource AccentHoverBrush}" />
                                                <TextBlock Text="From Here" Margin="5,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource GhostButton}" Command="{Binding DuplicateStepCommand}" Padding="6,4" FontSize="11" Margin="4,0,0,0"
                                                ToolTip="Duplicate this step (Ctrl+D)">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="&#xE8C8;" Style="{StaticResource IconText}" FontSize="10.5" />
                                                <TextBlock Text="Duplicate" Margin="5,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </UniformGrid>

                                    <!-- Studio X Ultra: Inspector Deck 2.0 Segmented 3-Tab Switcher (Setup · Tune & Motion · Recovery & Notes) -->
                                    <Border Margin="0,9,0,0" Padding="2" CornerRadius="8"
                                            Background="{DynamicResource SurfaceRecessedBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                            Visibility="{Binding SelectedStep.HasInspectorTabs, Converter={StaticResource BoolToVisibility}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <RadioButton Grid.Column="0" Content="⚡ Setup"
                                                         GroupName="InspectorDeckTabs"
                                                         IsChecked="{Binding SelectedStep.IsSetupTab, Mode=TwoWay}"
                                                         Style="{StaticResource InspectorTabRadioButtonStyle}"
                                                         Padding="10,5"
                                                         ToolTip="Core step setup (Alt+1)"
                                                         AutomationProperties.Name="Setup inspector tab" />
                                            <RadioButton Grid.Column="1" Content="{Binding SelectedStep.TuneTabTitle}"
                                                         GroupName="InspectorDeckTabs"
                                                         IsChecked="{Binding SelectedStep.IsTuneTab, Mode=TwoWay}"
                                                         Visibility="{Binding SelectedStep.HasTuneTab, Converter={StaticResource BoolToVisibility}}"
                                                         Style="{StaticResource InspectorTabRadioButtonStyle}"
                                                         ToolTip="Fine-tune motion, accuracy &amp; detection parameters (Alt+2)"
                                                         AutomationProperties.Name="Tune and motion inspector tab" />
                                            <RadioButton Grid.Column="2" Content="{Binding SelectedStep.RecoveryTabTitle}"
                                                         GroupName="InspectorDeckTabs"
                                                         IsChecked="{Binding SelectedStep.IsRecoveryTab, Mode=TwoWay}"
                                                         Style="{StaticResource InspectorTabRadioButtonStyle}"
                                                         ToolTip="Timeouts, self-healing recovery &amp; step notes (Alt+3)"
                                                         AutomationProperties.Name="Recovery and notes inspector tab" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ContentControl DockPanel.Dock="Bottom" Content="{Binding SelectedStep}" ContentTemplateSelector="{StaticResource InspectorActionSelector}"
                                        Focusable="False" IsTabStop="False"
                                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}" />

                        <Grid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                <ctrl:StudioIcon Kind="Sliders" Size="24" Foreground="{DynamicResource SubtleTextBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="Select a step to inspect and tune its parameters." Style="{StaticResource MutedText}"
                                           TextAlignment="Center" Margin="0,10,0,0" />
                            </StackPanel>
                            <ScrollViewer x:Name="PropertiesScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,10,14,32"
                                          PreviewMouseWheel="Properties_PreviewMouseWheel"
                                          Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                                <ContentControl Content="{Binding SelectedStep}" Focusable="False" />
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <panes:BottomDockPane x:Name="BottomDock" Grid.Row="2" Margin="0,8,0,0" />
        </Grid>

        <panes:CommandPaletteOverlay x:Name="CommandPalette" Panel.ZIndex="100"
                                     PaletteClosedFocusRequested="CommandPalette_PaletteClosedFocusRequested" />
    </Grid>
</UserControl>
