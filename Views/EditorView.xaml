<UserControl x:Class="SmartMacro.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SmartMacro.ViewModels"
             xmlns:steps="clr-namespace:SmartMacro.ViewModels.Steps"
             xmlns:core="clr-namespace:SmartMacro.Core.Validation;assembly=SmartMacro.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:EditorViewModel}"
             d:DesignWidth="1100" d:DesignHeight="680">
    <UserControl.Resources>
        <ResourceDictionary Source="StepEditorTemplates.xaml" />
    </UserControl.Resources>

    <Grid>
        <!-- ============ Nothing open ============ -->
        <Border Style="{StaticResource Card}" Visibility="{Binding HasMacro, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
                <Border Width="64" Height="64" CornerRadius="16" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE70F;" Style="{StaticResource IconText}" FontSize="28" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                </Border>
                <TextBlock Text="No macro open" Style="{StaticResource SectionTitle}" FontSize="16" HorizontalAlignment="Center" Margin="0,16,0,0" />
                <TextBlock Text="Pick a macro in the library (or create a new one) to edit its workflow here."
                           Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,6,0,16" />
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding GoToLibraryCommand}" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8F1;" Style="{StaticResource IconText}" />
                        <TextBlock Text="Go to Macro Library" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ============ Editor ============ -->
        <Grid Visibility="{Binding HasMacro, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: name, description, save -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="WORKFLOW EDITOR" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Tag="Macro name" FontSize="20" FontWeight="SemiBold"
                             Background="Transparent" BorderBrush="Transparent" Padding="2,4" Margin="-4,4,0,0" MaxLength="100"
                             AutomationProperties.Name="Macro name" />
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Tag="Add a description (optional)"
                             Foreground="{StaticResource MutedTextBrush}" Background="Transparent" BorderBrush="Transparent"
                             Padding="2,3" Margin="-4,0,0,0" MaxLength="2000" AutomationProperties.Name="Macro description" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Play" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                        <TextBox Text="{Binding RepeatCount, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="64" Margin="8,0,8,0"
                                 Padding="6,4" HorizontalContentAlignment="Center" AutomationProperties.Name="Repeat count"
                                 ToolTip="How many times to run the steps. 0 = keep repeating until you stop it." />
                        <TextBlock Text="time(s)  (0 = until stopped)" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Speed" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="24,0,0,0" />
                        <TextBox Text="{Binding Speed, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" Width="56" Margin="8,0,6,0"
                                 Padding="6,4" HorizontalContentAlignment="Center" AutomationProperties.Name="Playback speed"
                                 ToolTip="Speed multiplier for delays: 2 = twice as fast, 0.5 = half speed (0.1 to 10)." />
                        <TextBlock Text="×" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Wait between repeats" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="24,0,0,0" />
                        <TextBox Text="{Binding RepeatDelayMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="72" Margin="8,0,6,0"
                                 Padding="6,4" HorizontalContentAlignment="Center" AutomationProperties.Name="Wait between repeats in milliseconds"
                                 ToolTip="Pause after each run before the next one starts (milliseconds). Not used when playing once." />
                        <TextBlock Text="ms" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Padding="10,5" CornerRadius="12" Margin="0,0,12,0" Background="{StaticResource WarningSoftBrush}"
                            Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Unsaved changes" Foreground="{StaticResource WarningBrush}" FontSize="12" />
                    </Border>
                    <Border Padding="10,5" CornerRadius="12" Margin="0,0,12,0" Background="{StaticResource SuccessSoftBrush}"
                            Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" FontSize="11" Foreground="{StaticResource SuccessBrush}" />
                            <TextBlock Text="Saved" Foreground="{StaticResource SuccessBrush}" FontSize="12" Margin="6,0,0,0" />
                        </StackPanel>
                    </Border>
                    <Button Command="{Binding RevertCommand}" Margin="0,0,8,0" ToolTip="Throw away changes since the last save">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7A7;" Style="{StaticResource IconText}" />
                            <TextBlock Text="Discard changes" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" ToolTip="Save (Ctrl+S)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" Style="{StaticResource IconText}" />
                            <TextBlock Text="Save" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Toolbox | steps | properties -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" MinWidth="280" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="330" />
                </Grid.ColumnDefinitions>

                <!-- Toolbox -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="2,0,0,10">
                            <TextBlock Text="Add step" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Inserted after the selected step." Style="{StaticResource MutedText}" FontSize="11" Margin="0,3,0,0" />
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding StepTypes}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type steps:StepTypeInfo}">
                                        <Button Style="{StaticResource ToolboxButton}" ToolTip="{Binding Description}"
                                                Command="{Binding DataContext.AddStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Kind}" AutomationProperties.Name="{Binding DisplayName}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}" Foreground="{StaticResource AccentBrush}" Width="20" />
                                                <TextBlock Text="{Binding DisplayName}" Margin="8,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Steps -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="8">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="8,4,4,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource IconButton}" Content="&#xE74A;" Command="{Binding MoveUpCommand}" ToolTip="Move up (Alt+Up)" AutomationProperties.Name="Move step up" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE74B;" Command="{Binding MoveDownCommand}" ToolTip="Move down (Alt+Down)" AutomationProperties.Name="Move step down" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" Command="{Binding DuplicateStepCommand}" ToolTip="Duplicate step (Ctrl+D)" AutomationProperties.Name="Duplicate step" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Command="{Binding DeleteStepCommand}" ToolTip="Delete step (Delete)" AutomationProperties.Name="Delete step" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Workflow steps" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding StepCountText}" Foreground="{StaticResource MutedTextBrush}" Margin="10,0,0,0" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>

                        <Grid>
                            <ListBox x:Name="StepList" ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep}"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                     AutomationProperties.Name="Workflow steps"
                                     SelectionChanged="StepList_SelectionChanged"
                                     Visibility="{Binding HasSteps, Converter={StaticResource BoolToVisibility}}">
                                <ListBox.InputBindings>
                                    <KeyBinding Key="Delete" Command="{Binding DeleteStepCommand}" />
                                    <KeyBinding Key="D" Modifiers="Control" Command="{Binding DuplicateStepCommand}" />
                                    <KeyBinding Key="Up" Modifiers="Alt" Command="{Binding MoveUpCommand}" />
                                    <KeyBinding Key="Down" Modifiers="Alt" Command="{Binding MoveDownCommand}" />
                                </ListBox.InputBindings>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type steps:StepViewModel}">
                                        <Grid x:Name="Row">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Number}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" Width="30" Height="30" CornerRadius="7" Background="{StaticResource SurfaceAltBrush}">
                                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="2" Margin="10,0,8,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                    <Border x:Name="DisabledTag" Margin="8,0,0,0" Padding="6,1" CornerRadius="4" Background="{StaticResource CharcoalBrush}" Visibility="Collapsed">
                                                        <TextBlock Text="Disabled" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Summary}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding Comment}" FontStyle="Italic" Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                                           Visibility="{Binding HasComment, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="3" Text="&#xEA39;" Style="{StaticResource IconText}" Foreground="{StaticResource ErrorBrush}"
                                                       ToolTip="{Binding IssueText}" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Grid.Column="3" Text="&#xE7BA;" Style="{StaticResource IconText}" Foreground="{StaticResource WarningBrush}"
                                                       ToolTip="{Binding IssueText}" Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                <Setter TargetName="Row" Property="Opacity" Value="0.5" />
                                                <Setter TargetName="DisabledTag" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="300"
                                        Visibility="{Binding HasSteps, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                <TextBlock Text="&#xE8FD;" Style="{StaticResource IconText}" FontSize="28" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="This macro has no steps yet" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                                <TextBlock Text="Add steps from the panel on the left. You can reorder, duplicate and configure them afterwards."
                                           Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Properties -->
                <Border Grid.Column="4" Style="{StaticResource Card}" Padding="0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Properties" Style="{StaticResource SectionTitle}" Margin="16,14,16,4" />
                        <Grid>
                            <TextBlock Text="Select a step to edit its settings." Style="{StaticResource MutedText}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
                                       Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,8,16,16"
                                          Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                                <ContentControl Content="{Binding SelectedStep}" Focusable="False" />
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Problems -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="12,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <TextBlock Text="&#xEA39;" Style="{StaticResource IconText}" Foreground="{StaticResource ErrorBrush}" Margin="0,0,8,0"
                                   Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" Foreground="{StaticResource SuccessBrush}" Margin="0,0,8,0"
                                   Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                        <TextBlock Text="Problems" Style="{StaticResource SectionTitle}" FontSize="13" />
                        <TextBlock Text="{Binding ValidationSummary}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Issues}" MaxHeight="96" Margin="0,6,0,0" ItemContainerStyle="{StaticResource PlainListItem}"
                             Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisibility}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type core:ValidationIssue}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Severity, Converter={StaticResource LevelToGlyph}}" Style="{StaticResource IconText}" FontSize="12"
                                               Foreground="{Binding Severity, Converter={StaticResource LevelToBrush}}" />
                                    <TextBlock Text="{Binding DisplayText}" FontSize="12" Margin="8,0,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
