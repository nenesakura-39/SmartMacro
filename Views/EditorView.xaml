<UserControl x:Class="SmartMacro.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SmartMacro.ViewModels"
             xmlns:steps="clr-namespace:SmartMacro.ViewModels.Steps"
             xmlns:core="clr-namespace:SmartMacro.Core.Validation;assembly=SmartMacro.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:EditorViewModel}"
             d:DesignWidth="1100" d:DesignHeight="680">
    <UserControl.Resources>
        <ResourceDictionary Source="StepEditorTemplates.xaml" />
    </UserControl.Resources>

    <Grid>
        <!-- ============ Nothing open ============ -->
        <Border Style="{StaticResource Card}" Visibility="{Binding HasMacro, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
                <Border Width="64" Height="64" CornerRadius="16" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE70F;" Style="{StaticResource IconText}" FontSize="28" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                </Border>
                <TextBlock Text="No macro open" Style="{StaticResource SectionTitle}" FontSize="16" HorizontalAlignment="Center" Margin="0,16,0,0" />
                <TextBlock Text="Pick a macro in the library (or create a new one) to edit its workflow here."
                           Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,6,0,16" />
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding GoToLibraryCommand}" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8F1;" Style="{StaticResource IconText}" />
                        <TextBlock Text="Go to Macro Library" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ============ Editor ============ -->
        <Grid Visibility="{Binding HasMacro, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="360" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: name + save (row 1), description + play settings (row 2). Kept compact so the workspace
                 below gets most of the height, also in a smaller (non-maximized) window. -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,0" LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" Text="WORKFLOW" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Tag="Macro name" FontSize="18" FontWeight="SemiBold"
                             Background="Transparent" BorderBrush="Transparent" Padding="2,2" Margin="-4,0,0,0" MaxLength="100"
                             AutomationProperties.Name="Macro name" />
                </DockPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Padding="10,4" CornerRadius="12" Margin="0,0,10,0" Background="{StaticResource WarningSoftBrush}"
                            Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Unsaved changes" Foreground="{StaticResource WarningBrush}" FontSize="12" />
                    </Border>
                    <Border Padding="10,4" CornerRadius="12" Margin="0,0,10,0" Background="{StaticResource SuccessSoftBrush}"
                            Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" FontSize="11" Foreground="{StaticResource SuccessBrush}" />
                            <TextBlock Text="Saved" Foreground="{StaticResource SuccessBrush}" FontSize="12" Margin="6,0,0,0" />
                        </StackPanel>
                    </Border>
                    <Button Command="{Binding RevertCommand}" Margin="0,0,8,0" Padding="10,5" ToolTip="Throw away changes since the last save">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7A7;" Style="{StaticResource IconText}" />
                            <TextBlock Text="Discard changes" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Padding="12,5" ToolTip="Save (Ctrl+S)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" Style="{StaticResource IconText}" />
                            <TextBlock Text="Save" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Tag="Add a description (optional)"
                         Foreground="{StaticResource MutedTextBrush}" Background="Transparent" BorderBrush="Transparent" FontSize="12"
                         Padding="2,2" Margin="-4,2,16,0" MaxLength="2000" VerticalAlignment="Center" AutomationProperties.Name="Macro description" />

                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Play" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" FontSize="12" />
                    <TextBox Text="{Binding RepeatCount, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="56" Margin="6,0,4,0"
                             Padding="4,2" HorizontalContentAlignment="Center" AutomationProperties.Name="Repeat count"
                             ToolTip="How many times to run the steps. 0 = keep repeating until you stop it." />
                    <TextBlock Text="time(s) (0 = until stopped)" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" FontSize="12" />
                    <TextBlock Text="Speed" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="12" />
                    <TextBox Text="{Binding Speed, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" Width="48" Margin="6,0,4,0"
                             Padding="4,2" HorizontalContentAlignment="Center" AutomationProperties.Name="Playback speed"
                             ToolTip="Speed multiplier for delays: 2 = twice as fast, 0.5 = half speed (0.1 to 10)." />
                    <TextBlock Text="×" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Wait between repeats" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="12" />
                    <TextBox Text="{Binding RepeatDelayMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="64" Margin="6,0,4,0"
                             Padding="4,2" HorizontalContentAlignment="Center" AutomationProperties.Name="Wait between repeats in milliseconds"
                             ToolTip="Pause after each run before the next one starts (milliseconds). Not used when playing once." />
                    <TextBlock Text="ms" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" FontSize="12" />
                </StackPanel>
            </Grid>

            <!-- Toolbox | steps | properties -->
            <Grid Grid.Row="1">
                <!-- The 12 px gaps are splitters: drag them to make Add step / Workflow steps / Properties wider. -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" MinWidth="150" MaxWidth="420" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" MinWidth="280" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="360" MinWidth="280" MaxWidth="760" />
                </Grid.ColumnDefinitions>

                <GridSplitter Grid.Column="1" Style="{StaticResource PanelSplitter}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                              ToolTip="Drag to resize" AutomationProperties.Name="Resize the Add step panel" />
                <GridSplitter Grid.Column="3" Style="{StaticResource PanelSplitter}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                              ToolTip="Drag to resize" AutomationProperties.Name="Resize the Properties panel" />

                <!-- Toolbox -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10">
                    <DockPanel>
                        <!-- Compact header: one toggle instead of two radio buttons + a hint, so the step buttons below
                             keep their space in a small window. -->
                        <StackPanel DockPanel.Dock="Top" Margin="2,0,0,8">
                            <TextBlock Text="Add step" Style="{StaticResource SectionTitle}" />
                            <CheckBox Content="Add new steps at the end" IsChecked="{Binding AddAtEnd}" FontSize="12" Margin="0,6,0,0"
                                      ToolTip="Off: a new step goes right after the selected step (at the end when nothing is selected). On: always after the last step. Right-click a step button for the other choice."
                                      AutomationProperties.Name="Add new steps at the end" />
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding StepTypes}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type steps:StepTypeInfo}">
                                            <Button Style="{StaticResource ToolboxButton}" ToolTip="{Binding Description}"
                                                    Command="{Binding DataContext.AddStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Kind}" AutomationProperties.Name="{Binding DisplayName}"
                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Add to end" Command="{Binding PlacementTarget.Tag.AddToEndCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding Kind}" ToolTip="Adds this step after the last step in the workflow." />
                                                        <MenuItem Header="Insert after selected" Command="{Binding PlacementTarget.Tag.InsertAfterSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding Kind}" ToolTip="Adds this step right after the selected step (at the end when nothing is selected)." />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}" Foreground="{StaticResource AccentBrush}" Width="20" />
                                                    <TextBlock Text="{Binding DisplayName}" Margin="8,0,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Stage 3: blocks (If / Else / End If, Repeat / End Repeat) -->
                                <TextBlock Text="Logic" Style="{StaticResource SectionTitle}" Margin="2,14,0,0" />
                                <TextBlock Text="If and Repeat are added together with their End." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="2,3,0,8" />
                                <ItemsControl ItemsSource="{Binding LogicStepTypes}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type steps:StepTypeInfo}">
                                            <Button Style="{StaticResource ToolboxButton}" ToolTip="{Binding Description}"
                                                    Command="{Binding DataContext.AddStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Kind}" AutomationProperties.Name="{Binding DisplayName}"
                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Add to end" Command="{Binding PlacementTarget.Tag.AddToEndCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding Kind}" ToolTip="Adds this step after the last step in the workflow." />
                                                        <MenuItem Header="Insert after selected" Command="{Binding PlacementTarget.Tag.InsertAfterSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding Kind}" ToolTip="Adds this step right after the selected step (at the end when nothing is selected)." />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}" Foreground="{StaticResource AccentBrush}" Width="20" />
                                                    <TextBlock Text="{Binding DisplayName}" Margin="8,0,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Quick patterns: 1-click multi-step starters for common game loops -->
                                <TextBlock Text="Quick patterns" Style="{StaticResource SectionTitle}" Margin="2,14,0,0" />
                                <TextBlock Text="Ready-made step combinations. Insert one, then capture the images / pick the spots named in its step comments."
                                           Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="2,3,0,8" />
                                <ItemsControl ItemsSource="{Binding QuickPatternTypes}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource ToolboxButton}" ToolTip="{Binding Description}"
                                                    Command="{Binding DataContext.AddPatternCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Pattern}" AutomationProperties.Name="{Binding Title}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="22" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Glyph}" FontSize="13" VerticalAlignment="Top" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap" Margin="6,0,0,0" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Steps -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="8">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="8,4,4,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Command="{Binding WrapInIfCommand}" Padding="8,4" FontSize="12" Margin="0,0,6,0"
                                        ToolTip="Put an If … End If around the selected steps (select several with Shift+click)."
                                        AutomationProperties.Name="Wrap selected steps in If">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8AB;" Style="{StaticResource IconText}" FontSize="12" />
                                        <TextBlock Text="Wrap in If" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding WrapInRepeatCommand}" Padding="8,4" FontSize="12" Margin="0,0,10,0"
                                        ToolTip="Put a Repeat … End Repeat around the selected steps (select several with Shift+click)."
                                        AutomationProperties.Name="Wrap selected steps in Repeat">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8EE;" Style="{StaticResource IconText}" FontSize="12" />
                                        <TextBlock Text="Wrap in Repeat" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding CleanUpMousePathsCommand}" Padding="8,4" FontSize="12" Margin="0,0,10,0"
                                        ToolTip="Convert recording to clean steps: long runs of recorded Delay + Move mouse steps become one Delay (+ one Move only where it's needed). Clicks keep their own positions; drags, steps with a comment and turned-off steps are kept. Select several steps to clean only those."
                                        AutomationProperties.Name="Clean up mouse paths">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7E6;" Style="{StaticResource IconText}" FontSize="12" />
                                        <TextBlock Text="Clean up mouse paths" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Content="&#xE70E;" Command="{Binding MoveToTopCommand}" ToolTip="Move to top (Alt+Home). An If / Repeat moves together with its whole block." AutomationProperties.Name="Move to top" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE74A;" Command="{Binding MoveUpCommand}" ToolTip="Move up one place (Alt+Up)" AutomationProperties.Name="Move step up" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE74B;" Command="{Binding MoveDownCommand}" ToolTip="Move down one place (Alt+Down)" AutomationProperties.Name="Move step down" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE70D;" Command="{Binding MoveToBottomCommand}" ToolTip="Move to bottom (Alt+End). An If / Repeat moves together with its whole block." AutomationProperties.Name="Move to bottom" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" Command="{Binding DuplicateStepCommand}" ToolTip="Duplicate step (Ctrl+D)" AutomationProperties.Name="Duplicate step" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Command="{Binding DeleteStepCommand}" ToolTip="Delete step (Delete)" AutomationProperties.Name="Delete step" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Workflow steps" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding StepCountText}" Foreground="{StaticResource MutedTextBrush}" Margin="10,0,0,0" FontSize="12" VerticalAlignment="Center"
                                           ToolTip="Drag steps to reorder them (Shift+click to select several). Right-click a step for Move to top / bottom and more." />
                            </StackPanel>
                        </DockPanel>

                        <Grid>
                            <ListBox x:Name="StepList" ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep}"
                                     SelectionMode="Extended"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                     AutomationProperties.Name="Workflow steps"
                                     SelectionChanged="StepList_SelectionChanged"
                                     AllowDrop="True"
                                     PreviewMouseLeftButtonDown="StepList_PreviewMouseLeftButtonDown"
                                     PreviewMouseMove="StepList_PreviewMouseMove"
                                     PreviewMouseLeftButtonUp="StepList_PreviewMouseLeftButtonUp"
                                     DragOver="StepList_DragOver"
                                     DragLeave="StepList_DragLeave"
                                     Drop="StepList_Drop"
                                     Visibility="{Binding HasSteps, Converter={StaticResource BoolToVisibility}}">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Move to top" InputGestureText="Alt+Home" Command="{Binding MoveToTopCommand}" />
                                        <MenuItem Header="Move up" InputGestureText="Alt+Up" Command="{Binding MoveUpCommand}" />
                                        <MenuItem Header="Move down" InputGestureText="Alt+Down" Command="{Binding MoveDownCommand}" />
                                        <MenuItem Header="Move to bottom" InputGestureText="Alt+End" Command="{Binding MoveToBottomCommand}" />
                                        <Separator />
                                        <MenuItem Header="Wrap in If" InputGestureText="Ctrl+Shift+I" Command="{Binding WrapInIfCommand}" />
                                        <MenuItem Header="Wrap in Repeat" InputGestureText="Ctrl+Shift+R" Command="{Binding WrapInRepeatCommand}" />
                                        <MenuItem Header="Clean up mouse paths" Command="{Binding CleanUpMousePathsCommand}" />
                                        <Separator />
                                        <MenuItem Header="Duplicate" InputGestureText="Ctrl+D" Command="{Binding DuplicateStepCommand}" />
                                        <MenuItem Header="Delete" InputGestureText="Delete" Command="{Binding DeleteStepCommand}" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.InputBindings>
                                    <KeyBinding Key="Delete" Command="{Binding DeleteStepCommand}" />
                                    <KeyBinding Key="R" Modifiers="Control+Shift" Command="{Binding WrapInRepeatCommand}" />
                                    <KeyBinding Key="I" Modifiers="Control+Shift" Command="{Binding WrapInIfCommand}" />
                                    <KeyBinding Key="D" Modifiers="Control" Command="{Binding DuplicateStepCommand}" />
                                    <KeyBinding Key="Up" Modifiers="Alt" Command="{Binding MoveUpCommand}" />
                                    <KeyBinding Key="Down" Modifiers="Alt" Command="{Binding MoveDownCommand}" />
                                    <KeyBinding Key="Home" Modifiers="Alt" Command="{Binding MoveToTopCommand}" />
                                    <KeyBinding Key="End" Modifiers="Alt" Command="{Binding MoveToBottomCommand}" />
                                </ListBox.InputBindings>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type steps:StepViewModel}">
                                        <Border x:Name="RunningFrame" BorderThickness="2,0,0,0" BorderBrush="Transparent" Padding="4,0,0,0" CornerRadius="2">
                                        <Grid x:Name="Row" Margin="{Binding IndentMargin}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Number}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" Width="30" Height="30" CornerRadius="7" Background="{StaticResource SurfaceAltBrush}">
                                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="2" Margin="10,0,8,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                    <Border x:Name="DisabledTag" Margin="8,0,0,0" Padding="6,1" CornerRadius="4" Background="{StaticResource CharcoalBrush}" Visibility="Collapsed">
                                                        <TextBlock Text="Disabled" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                                                    </Border>
                                                    <Border x:Name="RunningTag" Margin="8,0,0,0" Padding="6,1" CornerRadius="4" Background="{StaticResource SuccessSoftBrush}"
                                                            Visibility="Collapsed" ToolTip="Playback is running this step right now.">
                                                        <TextBlock Text="▶ Running" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Summary}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding Comment}" FontStyle="Italic" Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                                           Visibility="{Binding HasComment, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="3" Text="&#xEA39;" Style="{StaticResource IconText}" Foreground="{StaticResource ErrorBrush}"
                                                       ToolTip="{Binding IssueText}" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Grid.Column="3" Text="&#xE7BA;" Style="{StaticResource IconText}" Foreground="{StaticResource WarningBrush}"
                                                       ToolTip="{Binding IssueText}" Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                <Setter TargetName="Row" Property="Opacity" Value="0.5" />
                                                <Setter TargetName="DisabledTag" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter TargetName="RunningFrame" Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                                <Setter TargetName="RunningFrame" Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                                <Setter TargetName="RunningTag" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="300"
                                        Visibility="{Binding HasSteps, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                <TextBlock Text="&#xE8FD;" Style="{StaticResource IconText}" FontSize="28" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="This macro has no steps yet" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                                <TextBlock Text="Add steps from the panel on the left. Then drag steps to reorder them, right-click a step for more actions, and set them up on the right."
                                           Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Properties -->
                <Border Grid.Column="4" Style="{StaticResource Card}" Padding="0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10,16,8">
                            <TextBlock Text="Properties" Style="{StaticResource SectionTitle}" />
                        </Border>
                        <Grid>
                            <TextBlock Text="Select a step to edit its settings." Style="{StaticResource MutedText}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
                                       Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                            <ScrollViewer x:Name="PropertiesScroll" VerticalScrollBarVisibility="Auto" Padding="16,10,16,28"
                                          PreviewMouseWheel="Properties_PreviewMouseWheel"
                                          Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                                <ContentControl Content="{Binding SelectedStep}" Focusable="False" />
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Problems -->
            <!-- Problems: a one-line banner when everything is fine; the list only appears when there are problems. -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,8,0,0" Padding="12,6">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <TextBlock Text="&#xEA39;" Style="{StaticResource IconText}" Foreground="{StaticResource ErrorBrush}" Margin="0,0,8,0"
                                   Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" Foreground="{StaticResource SuccessBrush}" Margin="0,0,8,0"
                                   Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                        <TextBlock Text="Problems" Style="{StaticResource SectionTitle}" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ValidationSummary}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Issues}" MaxHeight="84" Margin="0,4,0,0" ItemContainerStyle="{StaticResource PlainListItem}"
                             Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisibility}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type core:ValidationIssue}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Severity, Converter={StaticResource LevelToGlyph}}" Style="{StaticResource IconText}" FontSize="12"
                                               Foreground="{Binding Severity, Converter={StaticResource LevelToBrush}}" />
                                    <TextBlock Text="{Binding DisplayText}" FontSize="12" Margin="8,0,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
