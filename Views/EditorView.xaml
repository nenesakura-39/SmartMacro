<UserControl x:Class="SmartMacro.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SmartMacro.ViewModels"
             xmlns:steps="clr-namespace:SmartMacro.ViewModels.Steps"
             xmlns:ctrl="clr-namespace:SmartMacro.Controls"
             xmlns:conv="clr-namespace:SmartMacro.Converters"
             xmlns:core="clr-namespace:SmartMacro.Core.Validation;assembly=SmartMacro.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:EditorViewModel}"
             d:DesignWidth="1180" d:DesignHeight="760">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="StepEditorTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:StepCategoryBrushConverter x:Key="CategoryBrush" />
            <conv:StepTypeFilterConverter x:Key="StepTypeFilter" />
            <conv:IndentLevelConverter x:Key="IndentLevel" />
            <conv:CountToVisibilityConverter x:Key="CountToVisibility" />

            <!-- Step rows: hidden while folded away or filtered out; tighter spacing in Compact view. -->
            <Style x:Key="StudioStepCardItem" TargetType="ListBoxItem" BasedOn="{StaticResource StepCardItem}">
                <Setter Property="Visibility" Value="{Binding IsVisibleInList, Converter={StaticResource BoolToVisibility}}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding DataContext.IsCompactView, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                        <Setter Property="Margin" Value="0,0,0,2" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Studio dot-grid canvas -->
            <DrawingBrush x:Key="DotGridTile" TileMode="Tile" Viewport="0,0,18,18" ViewportUnits="Absolute" Stretch="None">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="Transparent">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,18,18" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="{StaticResource DotGridBrush}">
                            <GeometryDrawing.Geometry>
                                <EllipseGeometry Center="1,1" RadiusX="1" RadiusY="1" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>

            <!-- Vertical guide lines for nested blocks -->
            <DrawingBrush x:Key="IndentGuideTile" TileMode="Tile" Viewport="0,0,18,8" ViewportUnits="Absolute" Stretch="None">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="Transparent">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,18,8" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="{StaticResource IndentGuideBrush}">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="8,0,1.5,8" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>

            <!-- Toolbox 2-column tile -->
            <DataTemplate x:Key="ToolboxTileTemplate" DataType="{x:Type steps:StepTypeInfo}">
                <Button Style="{StaticResource ToolboxTile}" ToolTip="{Binding Description}"
                        Command="{Binding DataContext.AddStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding Kind}" AutomationProperties.Name="{Binding DisplayName}"
                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Add to end" Command="{Binding PlacementTarget.Tag.AddToEndCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding Kind}" ToolTip="Adds this step after the last step in the workflow." />
                            <MenuItem Header="Insert after selected" Command="{Binding PlacementTarget.Tag.InsertAfterSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding Kind}" ToolTip="Adds this step right after the selected step." />
                        </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="24" Height="24" CornerRadius="7" HorizontalAlignment="Center"
                                Background="{Binding Kind, Converter={StaticResource CategoryBrush}, ConverterParameter=Badge}">
                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}" FontSize="12" HorizontalAlignment="Center"
                                       Foreground="{Binding Kind, Converter={StaticResource CategoryBrush}, ConverterParameter=Accent}" />
                        </Border>
                        <TextBlock Text="{Binding DisplayName}" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
            </DataTemplate>

            <ItemsPanelTemplate x:Key="TwoColumnTiles">
                <UniformGrid Columns="2" />
            </ItemsPanelTemplate>

            <!-- Inline previews on step cards -->
            <DataTemplate x:Key="ImagePreviewTemplate">
                <Border Width="28" Height="28" CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource InputBorderBrush}"
                        Background="{DynamicResource InputBrush}" ToolTip="The picture this step looks for"
                        Visibility="{Binding HasTemplate, Converter={StaticResource BoolToVisibility}}">
                    <Border CornerRadius="4" RenderOptions.BitmapScalingMode="HighQuality">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding TemplatePreview}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                </Border>
            </DataTemplate>
            <DataTemplate x:Key="ColorPreviewTemplate">
                <Ellipse Width="16" Height="16" Fill="{Binding ColorBrush}" Stroke="{DynamicResource InputBorderBrush}" StrokeThickness="1"
                         ToolTip="{Binding Color}" />
            </DataTemplate>
            <DataTemplate x:Key="FeedbackPreviewTemplate">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="16" Height="16" Fill="{Binding MarkerBrush}" Stroke="{DynamicResource InputBorderBrush}" StrokeThickness="1"
                             ToolTip="Marker color" />
                    <Ellipse Width="16" Height="16" Fill="{Binding ZoneBrush}" Stroke="{DynamicResource InputBorderBrush}" StrokeThickness="1"
                             Margin="-5,0,0,0" ToolTip="Zone color (empty for a fixed zone)" />
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="ClickSnapshotPreviewTemplate">
                <Grid>
                    <Border Width="28" Height="28" CornerRadius="4" BorderBrush="{DynamicResource VisionAccentBrush}" BorderThickness="1"
                            Background="{DynamicResource SurfaceBrush}" ToolTip="Smart Click Snapshot">
                        <Image Source="{Binding TargetThumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock Text="✨" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0"
                               Visibility="{Binding SmartAimAtTarget, Converter={StaticResource BoolToVisibility}}"
                               ToolTip="Smart-Aim is on" />
                </Grid>
            </DataTemplate>
            <conv:StepKindTemplateSelector x:Key="StepPreviewSelector"
                                           ClickSnapshotTemplate="{StaticResource ClickSnapshotPreviewTemplate}"
                                           FindImageTemplate="{StaticResource ImagePreviewTemplate}"
                                           FindColorTemplate="{StaticResource ColorPreviewTemplate}"
                                           FeedbackLoopTemplate="{StaticResource FeedbackPreviewTemplate}" />

            <!-- Pinned bottom bar of the inspector -->
            <DataTemplate x:Key="SearchActionBarTemplate">
                <Border Style="{StaticResource InspectorActionBar}">
                    <StackPanel>
                        <Button Style="{StaticResource TestActionButton}" Command="{Binding TestCommand}"
                                ToolTip="Looks once where this step would look and highlights what it found."
                                AutomationProperties.Name="Test detection now">
                            <StackPanel Orientation="Horizontal">
                                <ctrl:StudioIcon Kind="Flask" Size="13" />
                                <TextBlock Text="Test detection now" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto">
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SearchTestResultTemplate}" Focusable="False" />
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </DataTemplate>
            <DataTemplate x:Key="FeedbackActionBarTemplate">
                <Border Style="{StaticResource InspectorActionBar}">
                    <StackPanel>
                        <Button Style="{StaticResource TestActionButton}" Command="{Binding TestDetectionCommand}"
                                ToolTip="Looks at the bar once and shows where the marker and zone are."
                                AutomationProperties.Name="Test detection now">
                            <StackPanel Orientation="Horizontal">
                                <ctrl:StudioIcon Kind="Flask" Size="13" />
                                <TextBlock Text="Test detection now" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding TestResult, Converter={StaticResource NullToVisibility}}">
                            <Border Margin="0,8,0,0" Padding="10,8" CornerRadius="6" Background="{DynamicResource SurfaceAltBrush}">
                                <StackPanel>
                                    <TextBlock Text="{Binding TestResult}" TextWrapping="Wrap" FontSize="12" />
                                    <Button Command="{Binding ShowMatchCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="8,4" FontSize="12"
                                            ToolTip="Moves your mouse cursor onto the marker the test found.">
                                        <StackPanel Orientation="Horizontal">
                                            <ctrl:StudioIcon Kind="Target" Size="12" />
                                            <TextBlock Text="Show me (move cursor to marker)" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <LinearGradientBrush x:Key="NeonProgressBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#22D3EE" Offset="0" />
                <GradientStop Color="#818CF8" Offset="0.6" />
                <GradientStop Color="#A855F7" Offset="1" />
            </LinearGradientBrush>

            <!-- Command Palette rows -->
            <Style x:Key="PaletteItemStyle" TargetType="ListBoxItem">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="10,7" Margin="0,1"
                                    BorderThickness="1" BorderBrush="Transparent">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <conv:StepKindTemplateSelector x:Key="InspectorActionSelector"
                                           ScreenSearchTemplate="{StaticResource SearchActionBarTemplate}"
                                           FeedbackLoopTemplate="{StaticResource FeedbackActionBarTemplate}" />
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{Binding RedoCommand}" />
        <KeyBinding Key="F5" Modifiers="Shift" Command="{Binding PlayFromSelectedCommand}" />
        <KeyBinding Key="F3" Command="{Binding NextMatchCommand}" />
        <KeyBinding Key="F3" Modifiers="Shift" Command="{Binding PreviousMatchCommand}" />
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding ToggleCommandPaletteCommand}" />
        <KeyBinding Key="T" Modifiers="Control" Command="{Binding TestSelectedStepCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <!-- ============ Empty State: Nothing Open ============ -->
        <Border Style="{StaticResource GlassCard}" Visibility="{Binding HasMacro, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400">
                <Border Width="64" Height="64" CornerRadius="18" Background="{DynamicResource AccentSoftBrush}"
                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" HorizontalAlignment="Center">
                    <ctrl:StudioIcon Kind="Editor" Size="26" Foreground="{DynamicResource AccentHoverBrush}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="No workflow open" Style="{StaticResource SectionTitle}" FontSize="17" HorizontalAlignment="Center" Margin="0,16,0,0" />
                <TextBlock Text="Open a macro from your Library, press Rec in the title bar to record a new one, or load a 1-click recipe from the Studio Manual."
                           Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,6,0,18" />
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding GoToLibraryCommand}" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ctrl:StudioIcon Kind="Library" Size="14" />
                        <TextBlock Text="Open Macro Library" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ============ Studio X Workflow Editor ============ -->
        <Grid Visibility="{Binding HasMacro, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="300" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- =========================================================================
                 C1: STREAMLINED 1-ROW STUDIO HEADER (Name · Description · Run Settings Popover · Save)
                 ========================================================================= -->
            <Border Grid.Row="0" Style="{StaticResource GlassCard}" Padding="14,7,12,7" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="220" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Macro Name + Inline Description -->
                    <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" MaxWidth="280" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource AccentSoftBrush}" CornerRadius="5" Padding="6,2"
                                VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="MACRO" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentHoverBrush}" />
                        </Border>
                        <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Tag="Macro name"
                                 FontSize="15.5" FontWeight="SemiBold" MinWidth="130"
                                 Background="Transparent" BorderBrush="Transparent" Padding="3,2" MaxLength="100"
                                 AutomationProperties.Name="Macro name" />
                        <TextBlock Grid.Column="2" Text="—" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" Margin="6,0" />
                        <TextBox Grid.Column="3" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Tag="Add notes or description…"
                                 Foreground="{DynamicResource MutedTextBrush}" Background="Transparent" BorderBrush="Transparent"
                                 FontSize="12" Padding="3,2" MaxLength="2000" VerticalAlignment="Center"
                                 AutomationProperties.Name="Macro description" />
                    </Grid>

                    <!-- Right: Quick Run Summary & Settings Popover + Brain Pills + Discard / Save -->
                    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Quick inline Repeat & Speed controls + Run Settings Popover -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                            <TextBlock Text="Runs" Foreground="{DynamicResource MutedTextBrush}" FontSize="11.5" VerticalAlignment="Center" />
                            <TextBox Style="{StaticResource HeaderNumberBox}" Text="{Binding RepeatCount, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                     Width="40" Margin="5,0,6,0" FontFamily="{StaticResource MonoFont}"
                                     ToolTip="How many times to run (0 = repeat forever until Esc)" AutomationProperties.Name="Repeat count" />
                            <ComboBox ItemsSource="{Binding SpeedChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding Speed, Mode=TwoWay}" MinWidth="60" Padding="7,3" FontSize="11.5"
                                      ToolTip="Playback speed multiplier (applies live even mid-run)" AutomationProperties.Name="Playback speed" />
                        </StackPanel>

                        <!-- ⚙ Run & Target Window Settings Popover -->
                        <Grid Margin="0,0,6,0" VerticalAlignment="Center">
                            <ToggleButton x:Name="RunSettingsToggle" Style="{StaticResource GhostToggle}" Padding="8,4"
                                          IsHitTestVisible="{Binding IsOpen, ElementName=RunSettingsPopup, Converter={StaticResource InverseBool}}"
                                          ToolTip="Run settings: Target window, coordinate auto-scaling, repeat delay, Humanize, and OBS streamer mode"
                                          AutomationProperties.Name="Run and target settings">
                                <StackPanel Orientation="Horizontal">
                                    <ctrl:StudioIcon Kind="Sliders" Size="13" />
                                    <TextBlock Text="{Binding TargetSummary}" FontSize="11.5" Margin="6,0,4,0" MaxWidth="130" TextTrimming="CharacterEllipsis" />
                                    <ctrl:StudioIcon Kind="ChevronDown" Size="11" />
                                </StackPanel>
                            </ToggleButton>

                            <Popup x:Name="RunSettingsPopup" IsOpen="{Binding IsChecked, ElementName=RunSettingsToggle, Mode=TwoWay}"
                                   StaysOpen="False" PlacementTarget="{Binding ElementName=RunSettingsToggle}"
                                   Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Background="{DynamicResource CharcoalBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="16,14" Width="360" Margin="8"
                                        Effect="{StaticResource ShadowPopover}">
                                    <StackPanel>
                                        <TextBlock Text="PLAYBACK &amp; TARGET WINDOW" Style="{StaticResource OverlineHeaderStyle}" />

                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Repeat count (0 = ∞)" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding RepeatCount, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Between runs (ms)" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding RepeatDelayMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Target window" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Command="{Binding RefreshTargetWindowsCommand}" Padding="8,5" Margin="6,0,0,0"
                                                    ToolTip="Refresh open windows" AutomationProperties.Name="Refresh windows">
                                                <TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" FontSize="12" />
                                            </Button>
                                            <ComboBox IsEditable="True" ItemsSource="{Binding TargetWindowChoices}"
                                                      Text="{Binding TargetWindowTitle, UpdateSourceTrigger=PropertyChanged}"
                                                      AutomationProperties.Name="Target window" />
                                        </DockPanel>

                                        <CheckBox Style="{StaticResource ToggleSwitchCheckBoxStyle}" Margin="0,10,0,0"
                                                  Content="Auto-scale coordinates to target window"
                                                  IsChecked="{Binding ScaleCoordinatesToWindow}" />
                                        <TextBlock Text="{Binding ReferenceText}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" />
                                        <Button Command="{Binding UseCurrentSizeCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="9,4" FontSize="11.5"
                                                Content="Capture current window size as reference" />

                                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,12,0,10" />

                                        <TextBlock Text="BEHAVIOR &amp; OVERLAYS" Style="{StaticResource OverlineHeaderStyle}" Margin="0,0,0,8" />
                                        <CheckBox Style="{StaticResource ToggleSwitchCheckBoxStyle}" Content="🎲 Humanize timing &amp; click offsets"
                                                  IsChecked="{Binding HumanizePlayback}" ToolTip="{Binding HumanizeTooltip}" Margin="0,0,0,6" />
                                        <CheckBox Style="{StaticResource ToggleSwitchCheckBoxStyle}" Content="Show mini HUD pill while playing"
                                                  IsChecked="{Binding DataContext.ShowMiniOverlay, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,6" />
                                        <CheckBox Style="{StaticResource ToggleSwitchCheckBoxStyle}" Content="🎥 Show overlays in OBS / Discord"
                                                  IsChecked="{Binding DataContext.ShowOverlaysInObs, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,6" />
                                        <CheckBox Style="{StaticResource ToggleSwitchCheckBoxStyle}" Content="Minimize main window during playback"
                                                  IsChecked="{Binding DataContext.MinimizeWhilePlaying, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- Quick Brain Dock Buttons (Variables & Watchers) -->
                        <Button Style="{StaticResource GhostButton}" Padding="8,4" Margin="0,0,4,0"
                                Command="{Binding OpenBottomTabCommand}" CommandParameter="2"
                                ToolTip="Open Variables (memory &amp; live OCR readouts) in bottom dock"
                                AutomationProperties.Name="Open variables dock">
                            <StackPanel Orientation="Horizontal">
                                <ctrl:StudioIcon Kind="Variable" Size="13" Foreground="{DynamicResource MemoryAccentBrush}" />
                                <TextBlock Text="{Binding VariablesSummary}" FontSize="11.5" Margin="5,0,0,0" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource GhostButton}" Padding="8,4" Margin="0,0,8,0"
                                Command="{Binding OpenBottomTabCommand}" CommandParameter="3"
                                ToolTip="Open Background Watchers (popup &amp; disconnect guards) in bottom dock"
                                AutomationProperties.Name="Open watchers dock">
                            <StackPanel Orientation="Horizontal">
                                <ctrl:StudioIcon Kind="Watcher" Size="13" Foreground="{DynamicResource MemoryAccentBrush}" />
                                <TextBlock Text="{Binding WatchersSummary}" FontSize="11.5" Margin="5,0,0,0" />
                            </StackPanel>
                        </Button>

                        <Border Width="1" Height="18" Background="{DynamicResource BorderBrush}" Margin="0,0,8,0" />

                        <!-- Saved / Unsaved badge + Discard & Save -->
                        <Border Style="{StaticResource Pill}" Margin="0,0,6,0" Background="{DynamicResource WarningSoftBrush}"
                                Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Unsaved" Foreground="{DynamicResource WarningBrush}" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                        <Border Style="{StaticResource Pill}" Margin="0,0,6,0" Background="{DynamicResource SuccessSoftBrush}"
                                Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                            <StackPanel Orientation="Horizontal">
                                <ctrl:StudioIcon Kind="CheckCircle" Size="11" Foreground="{DynamicResource SuccessBrush}" />
                                <TextBlock Text="Saved" Foreground="{DynamicResource SuccessBrush}" FontSize="11" FontWeight="SemiBold" Margin="4,0,0,0" />
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource GhostButton}" Command="{Binding RevertCommand}" Padding="8,5" Margin="0,0,4,0"
                                ToolTip="Discard unsaved changes" AutomationProperties.Name="Discard changes">
                            <ctrl:StudioIcon Kind="Undo" Size="13" />
                        </Button>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Padding="11,5"
                                ToolTip="Save workflow (Ctrl+S)" AutomationProperties.Name="Save">
                            <StackPanel Orientation="Horizontal">
                                <ctrl:StudioIcon Kind="Save" Size="13" />
                                <TextBlock Text="Save" Margin="6,0,0,0" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- =========================================================================
                 ROW 1: 3-PANE STUDIO WORKSPACE (Searchable Toolbox | Step Canvas + Minimap | Inspector)
                 ========================================================================= -->
            <Grid Grid.Row="1" SizeChanged="Workspace_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="224" MinWidth="176" MaxWidth="420" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" MinWidth="280" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="364" MinWidth="280" MaxWidth="760" />
                </Grid.ColumnDefinitions>

                <GridSplitter Grid.Column="1" Style="{StaticResource PanelSplitter}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                              ToolTip="Drag to resize Toolbox" AutomationProperties.Name="Resize Toolbox" />
                <GridSplitter Grid.Column="3" Style="{StaticResource PanelSplitter}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                              ToolTip="Drag to resize Inspector" AutomationProperties.Name="Resize Inspector" />

                <!-- ===== C7: Searchable Toolbox v2 ===== -->
                <Border Grid.Column="0" Style="{StaticResource GlassCard}" Padding="8,10,8,6">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="4,0,4,6">
                            <TextBlock Text="Toolbox" Style="{StaticResource SectionTitle}" FontSize="13" />

                            <!-- Instant Toolbox Filter -->
                            <Grid Margin="0,7,0,0">
                                <ctrl:StudioIcon Kind="Search" Size="12" Foreground="{DynamicResource MutedTextBrush}"
                                                 HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" Panel.ZIndex="1" />
                                <TextBox Text="{Binding ToolboxFilter, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="Filter steps…" Padding="25,4,22,4" FontSize="11.5"
                                         AutomationProperties.Name="Filter toolbox steps" />
                                <Button Style="{StaticResource DismissButton}" Width="18" Height="18" HorizontalAlignment="Right" Margin="0,0,4,0"
                                        Command="{Binding ClearToolboxFilterCommand}"
                                        Visibility="{Binding HasToolboxFilter, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="Clear toolbox filter" />
                            </Grid>

                            <DockPanel Margin="0,6,0,0">
                                <TextBlock DockPanel.Dock="Left" Text="Insert" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Border Style="{StaticResource SegmentedContainer}"
                                        ToolTip="Where newly added steps are inserted">
                                    <UniformGrid Rows="1">
                                        <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" Content="After selected" GroupName="InsertPlacement"
                                                     IsChecked="{Binding AddAfterSelected}" AutomationProperties.Name="Add after selected" />
                                        <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" Content="At end" GroupName="InsertPlacement"
                                                     IsChecked="{Binding AddAtEnd}" AutomationProperties.Name="Add at end" />
                                    </UniformGrid>
                                </Border>
                            </DockPanel>
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,2,0,0">
                            <StackPanel>
                                <StackPanel Visibility="{Binding HasFilteredInputSteps, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="INPUT &amp; TIMING" Style="{StaticResource ToolboxCategoryHeader}" />
                                    <ItemsControl ItemsSource="{Binding FilteredInputSteps}" Focusable="False"
                                                  ItemsPanel="{StaticResource TwoColumnTiles}" ItemTemplate="{StaticResource ToolboxTileTemplate}" />
                                </StackPanel>

                                <StackPanel Visibility="{Binding HasFilteredVisionSteps, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="VISION &amp; AI" Style="{StaticResource ToolboxCategoryHeader}" />
                                    <ItemsControl ItemsSource="{Binding FilteredVisionSteps}" Focusable="False"
                                                  ItemsPanel="{StaticResource TwoColumnTiles}" ItemTemplate="{StaticResource ToolboxTileTemplate}" />
                                </StackPanel>

                                <StackPanel Visibility="{Binding HasFilteredLogicSteps, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="LOGIC &amp; LOOPS" Style="{StaticResource ToolboxCategoryHeader}" />
                                    <ItemsControl ItemsSource="{Binding FilteredLogicSteps}" Focusable="False"
                                                  ItemsPanel="{StaticResource TwoColumnTiles}" ItemTemplate="{StaticResource ToolboxTileTemplate}" />
                                </StackPanel>

                                <StackPanel Visibility="{Binding HasFilteredBrainSteps, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="MEMORY &amp; SUB-MACROS" Style="{StaticResource ToolboxCategoryHeader}" />
                                    <ItemsControl ItemsSource="{Binding FilteredBrainSteps}" Focusable="False"
                                                  ItemsPanel="{StaticResource TwoColumnTiles}" ItemTemplate="{StaticResource ToolboxTileTemplate}" />
                                </StackPanel>

                                <StackPanel Visibility="{Binding HasFilteredUtilitySteps, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="UTILITY &amp; GAME" Style="{StaticResource ToolboxCategoryHeader}" />
                                    <ItemsControl ItemsSource="{Binding FilteredUtilitySteps}" Focusable="False"
                                                  ItemsPanel="{StaticResource TwoColumnTiles}" ItemTemplate="{StaticResource ToolboxTileTemplate}" />
                                </StackPanel>

                                <StackPanel Visibility="{Binding HasFilteredQuickPatterns, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="QUICK PATTERNS" Style="{StaticResource ToolboxCategoryHeader}" />
                                    <ItemsControl ItemsSource="{Binding FilteredQuickPatterns}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource ToolboxTile}" Height="Auto" MinHeight="34" Padding="8,5" HorizontalContentAlignment="Stretch"
                                                        ToolTip="{Binding Description}"
                                                        Command="{Binding DataContext.AddPatternCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Pattern}" AutomationProperties.Name="{Binding Title}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="24" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource FeedbackBadgeBrush}" VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding Glyph}" FontSize="11.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- ===== C2, C3, C5 & C6: Workflow Step Canvas + Minimap ===== -->
                <Border Grid.Column="2" Style="{StaticResource GlassCard}" Padding="0" ClipToBounds="True">
                    <DockPanel>
                        <!-- Step Canvas Toolbar -->
                        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,6,8,5">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ToggleButton IsChecked="{Binding IsCompactView}" Padding="7,3" FontSize="11"
                                                      Style="{StaticResource GhostToggle}"
                                                      ToolTip="Compact dense rows vs comfortable studio cards"
                                                      AutomationProperties.Name="Compact view">
                                            <TextBlock Text="Compact" />
                                        </ToggleButton>
                                        <Button Style="{StaticResource GhostButton}" Command="{Binding CollapseAllCommand}" Padding="7,3" FontSize="11"
                                                ToolTip="Collapse all If/Repeat blocks" Content="Fold all" />
                                        <Button Style="{StaticResource GhostButton}" Command="{Binding ExpandAllCommand}" Padding="7,3" FontSize="11"
                                                ToolTip="Expand all If/Repeat blocks" Content="Unfold" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Workflow" Style="{StaticResource SectionTitle}" FontSize="13" />
                                        <Border Style="{StaticResource Pill}" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding StepCountText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                                        </Border>
                                    </StackPanel>
                                </DockPanel>

                                <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-4,4,0,0">
                                    <Button Style="{StaticResource GhostButton}" Padding="6,4" Command="{Binding UndoCommand}"
                                            ToolTip="{Binding UndoTooltip}" AutomationProperties.Name="Undo">
                                        <ctrl:StudioIcon Kind="Undo" Size="13" />
                                    </Button>
                                    <Button Style="{StaticResource GhostButton}" Padding="6,4" Command="{Binding RedoCommand}"
                                            ToolTip="{Binding RedoTooltip}" AutomationProperties.Name="Redo">
                                        <ctrl:StudioIcon Kind="Redo" Size="13" />
                                    </Button>
                                    <Border Width="1" Height="16" Margin="4,0" Background="{DynamicResource BorderBrush}" />

                                    <Button Style="{StaticResource GhostButton}" Command="{Binding PlayFromSelectedCommand}" Padding="7,4" FontSize="11"
                                            ToolTip="Play from selected step (Shift+F5)" AutomationProperties.Name="Play from selected step">
                                        <StackPanel Orientation="Horizontal">
                                            <ctrl:StudioIcon Kind="Play" Size="11" Foreground="{DynamicResource SuccessBrush}" />
                                            <TextBlock Text="From here" Margin="5,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource GhostButton}" Command="{Binding TestSelectedStepCommand}" Padding="7,4" FontSize="11"
                                            ToolTip="Test selected step once right now (Ctrl+T)" AutomationProperties.Name="Test selected step">
                                        <StackPanel Orientation="Horizontal">
                                            <ctrl:StudioIcon Kind="Flask" Size="12" Foreground="{DynamicResource VisionAccentBrush}" />
                                            <TextBlock Text="Test" Margin="5,0,0,0" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Blueprints Popover -->
                                    <Grid>
                                        <ToggleButton x:Name="BlueprintsButton" Style="{StaticResource GhostToggle}" Padding="7,4" FontSize="11"
                                                      IsChecked="{Binding IsBlueprintsMenuOpen, Mode=TwoWay}"
                                                      ToolTip="Insert a 1-click multi-step Blueprint" AutomationProperties.Name="Blueprints">
                                            <StackPanel Orientation="Horizontal">
                                                <ctrl:StudioIcon Kind="Blueprint" Size="12" Foreground="{DynamicResource AccentHoverBrush}" />
                                                <TextBlock Text="Blueprints" Margin="5,0,3,0" />
                                                <ctrl:StudioIcon Kind="ChevronDown" Size="10" />
                                            </StackPanel>
                                        </ToggleButton>
                                        <Popup IsOpen="{Binding IsBlueprintsMenuOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=BlueprintsButton}"
                                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                            <Border Background="{DynamicResource CharcoalBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                    CornerRadius="10" Padding="6" Margin="8" Width="390" Effect="{StaticResource ShadowPopover}">
                                                <ItemsControl ItemsSource="{Binding Blueprints}" Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch" Padding="10,7" Margin="0,1"
                                                                    Command="{Binding DataContext.AddBlueprintCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding Blueprint}" ToolTip="{Binding Description}"
                                                                    AutomationProperties.Name="{Binding Title}">
                                                                <StackPanel HorizontalAlignment="Left">
                                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextBrush}" />
                                                                    <TextBlock Text="{Binding Shape}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,1,0,0" />
                                                                </StackPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                        </Popup>
                                    </Grid>

                                    <Button Style="{StaticResource GhostButton}" Command="{Binding WrapInIfCommand}" Padding="7,4" FontSize="11"
                                            ToolTip="Wrap selected steps in If … End If (Ctrl+Shift+I)">
                                        <StackPanel Orientation="Horizontal">
                                            <ctrl:StudioIcon Kind="BranchIf" Size="12" Foreground="{DynamicResource LogicAccentBrush}" />
                                            <TextBlock Text="If" Margin="4,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource GhostButton}" Command="{Binding WrapInRepeatCommand}" Padding="7,4" FontSize="11"
                                            ToolTip="Wrap selected steps in Repeat … End Repeat (Ctrl+Shift+R)">
                                        <StackPanel Orientation="Horizontal">
                                            <ctrl:StudioIcon Kind="LoopRepeat" Size="12" Foreground="{DynamicResource LogicAccentBrush}" />
                                            <TextBlock Text="Repeat" Margin="4,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource GhostButton}" Command="{Binding CleanUpMousePathsCommand}" Padding="7,4" FontSize="11"
                                            ToolTip="Clean up redundant mouse movement steps">
                                        <StackPanel Orientation="Horizontal">
                                            <ctrl:StudioIcon Kind="Sparkles" Size="12" />
                                            <TextBlock Text="Clean up" Margin="4,0,0,0" />
                                        </StackPanel>
                                    </Button>

                                    <Border Width="1" Height="16" Margin="4,0" Background="{DynamicResource BorderBrush}" />
                                    <Button Style="{StaticResource IconButton}" Width="28" Height="26" Padding="5" FontSize="11" Content="&#xE74A;" Command="{Binding MoveUpCommand}" ToolTip="Move up (Alt+Up)" />
                                    <Button Style="{StaticResource IconButton}" Width="28" Height="26" Padding="5" FontSize="11" Content="&#xE74B;" Command="{Binding MoveDownCommand}" ToolTip="Move down (Alt+Down)" />
                                    <Button Style="{StaticResource GhostButton}" Padding="6,4" Command="{Binding DuplicateStepCommand}" ToolTip="Duplicate (Ctrl+D)">
                                        <ctrl:StudioIcon Kind="Duplicate" Size="12" />
                                    </Button>
                                    <Button Style="{StaticResource GhostButton}" Padding="6,4" Command="{Binding DeleteStepCommand}" ToolTip="Delete (Delete)">
                                        <ctrl:StudioIcon Kind="Trash" Size="12" />
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- ✨ Auto-Fix Block Structure Banner -->
                        <Border DockPanel.Dock="Top" Background="{DynamicResource ErrorSoftBrush}" BorderBrush="{DynamicResource ErrorBrush}"
                                BorderThickness="0,0,0,1" Padding="12,7,8,7"
                                Visibility="{Binding CanAutoFixBlocks, Converter={StaticResource BoolToVisibility}}"
                                AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Block structure problem">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Padding="10,5" FontSize="11" Margin="10,0,0,0"
                                        VerticalAlignment="Center" Command="{Binding AutoFixBlocksCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <ctrl:StudioIcon Kind="Sparkles" Size="12" />
                                        <TextBlock Text="Auto-Fix Blocks" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <ctrl:StudioIcon Kind="ErrorCircle" Size="14" Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding BlockProblemText}" FontSize="11.5" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <!-- D4: Upgraded Smart Self-Heal Review Banner -->
                        <Border DockPanel.Dock="Top" Background="{DynamicResource VisionSoftBrush}" BorderBrush="{DynamicResource VisionAccentBrush}"
                                BorderThickness="0,0,0,1" Padding="12,7,8,7"
                                Visibility="{Binding HasPendingSuggestions, Converter={StaticResource BoolToVisibility}}"
                                AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Smart Self-Heal suggestion">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource DismissButton}" Margin="6,0,0,0" VerticalAlignment="Center"
                                        Command="{Binding DismissSuggestionsCommand}" ToolTip="Dismiss suggestion (leave macro unchanged)"
                                        AutomationProperties.Name="Dismiss self-heal suggestion" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Padding="10,4" FontSize="11" Margin="10,0,0,0"
                                        VerticalAlignment="Center" Command="{Binding ApplyAllSuggestionsCommand}"
                                        ToolTip="Updates the drifted click coordinate(s) in the editor (Ctrl+Z undoes it)."
                                        AutomationProperties.Name="Apply self-heal coordinates">
                                    <StackPanel Orientation="Horizontal">
                                        <ctrl:StudioIcon Kind="SelfHeal" Size="12" />
                                        <TextBlock Text="Update Coordinates" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <ctrl:StudioIcon Kind="SelfHeal" Size="14" Foreground="{DynamicResource VisionAccentBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding SelfHealBannerText}" FontSize="11.5" TextWrapping="Wrap" VerticalAlignment="Center"
                                           ToolTip="{Binding SelfHealBannerText}" />
                            </DockPanel>
                        </Border>

                        <!-- Search + Category Filter Pills (Ctrl+F) -->
                        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,5,8,5"
                                Visibility="{Binding HasSteps, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                            Visibility="{Binding IsSearchActive, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding MatchNavigatorText}" FontSize="11" FontFamily="{StaticResource MonoFont}"
                                               Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="8,0,4,0" />
                                    <Button Style="{StaticResource GhostButton}" Width="24" Height="22" Padding="0"
                                            Command="{Binding PreviousMatchCommand}" ToolTip="Previous match (Shift+F3)">
                                        <Path Data="M0,5 L4.5,0.5 L9,5" Width="9" Height="6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Stretch="None" />
                                    </Button>
                                    <Button Style="{StaticResource GhostButton}" Width="24" Height="22" Padding="0"
                                            Command="{Binding NextMatchCommand}" ToolTip="Next match (F3)">
                                        <Path Data="M0,0.5 L4.5,5 L9,0.5" Width="9" Height="6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Stretch="None" />
                                    </Button>
                                    <Button Style="{StaticResource DismissButton}" Width="22" Height="22" Focusable="True"
                                            Command="{Binding ClearSearchCommand}" ToolTip="Clear search (Esc)" />
                                </StackPanel>

                                <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding FilterPills}" VerticalAlignment="Center" Margin="6,0,0,0"
                                              Focusable="False" AutomationProperties.Name="Step filters">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button x:Name="PillButton" Content="{Binding Label}" ToolTip="{Binding Tooltip}" Padding="7,2,7,3" Margin="1,0" FontSize="11"
                                                    Command="{Binding DataContext.SetFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" Style="{StaticResource GhostButton}" />
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter TargetName="PillButton" Property="Background" Value="{DynamicResource SelectedCardBrush}" />
                                                    <Setter TargetName="PillButton" Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
                                                    <Setter TargetName="PillButton" Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid>
                                    <ctrl:StudioIcon Kind="Search" Size="12" Foreground="{DynamicResource MutedTextBrush}"
                                                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" Panel.ZIndex="1" />
                                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=120}"
                                             Tag="Find in workflow (Ctrl+F)" Padding="25,4,6,4" FontSize="11.5" MinWidth="120"
                                             PreviewKeyDown="SearchBox_PreviewKeyDown"
                                             AutomationProperties.Name="Search steps" />
                                </Grid>
                            </DockPanel>
                        </Border>

                        <!-- Step Canvas + Right-Edge Workflow Minimap -->
                        <Grid Background="{DynamicResource StepsCanvasBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Rectangle Grid.Column="0" Grid.ColumnSpan="2" Fill="{StaticResource DotGridTile}" IsHitTestVisible="False" />

                            <ListBox x:Name="StepList" Grid.Column="0" ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep}"
                                     SelectionMode="Extended" Padding="10,10,6,6"
                                     ItemContainerStyle="{StaticResource StudioStepCardItem}"
                                     PreviewKeyDown="StepList_PreviewKeyDown"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.CacheLengthUnit="Page" VirtualizingPanel.CacheLength="1,1"
                                     AutomationProperties.Name="Workflow steps"
                                     SelectionChanged="StepList_SelectionChanged"
                                     AllowDrop="True"
                                     PreviewMouseLeftButtonDown="StepList_PreviewMouseLeftButtonDown"
                                     PreviewMouseMove="StepList_PreviewMouseMove"
                                     PreviewMouseLeftButtonUp="StepList_PreviewMouseLeftButtonUp"
                                     DragOver="StepList_DragOver"
                                     DragLeave="StepList_DragLeave"
                                     Drop="StepList_Drop"
                                     Visibility="{Binding HasSteps, Converter={StaticResource BoolToVisibility}}">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="▶ Run step" InputGestureText="Ctrl+F5" Command="{Binding RunStepCommand}" />
                                        <MenuItem Header="🧪 Test step" InputGestureText="Ctrl+T" Command="{Binding TestSelectedStepCommand}" />
                                        <MenuItem Header="▶ Play from here" InputGestureText="Shift+F5" Command="{Binding PlayFromSelectedCommand}" />
                                        <MenuItem Header="Turn on / off" InputGestureText="Space" Command="{Binding ToggleEnabledCommand}" />
                                        <MenuItem Header="Fold / unfold block" Command="{Binding ToggleCollapseCommand}" />
                                        <Separator />
                                        <MenuItem Header="Copy" InputGestureText="Ctrl+C" Command="{Binding CopySelectedStepCommand}" />
                                        <MenuItem Header="Paste" InputGestureText="Ctrl+V" Command="{Binding PasteStepCommand}" />
                                        <MenuItem Header="Undo" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}" />
                                        <MenuItem Header="Redo" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}" />
                                        <Separator />
                                        <MenuItem Header="Move to top" InputGestureText="Alt+Home" Command="{Binding MoveToTopCommand}" />
                                        <MenuItem Header="Move up" InputGestureText="Alt+Up" Command="{Binding MoveUpCommand}" />
                                        <MenuItem Header="Move down" InputGestureText="Alt+Down" Command="{Binding MoveDownCommand}" />
                                        <MenuItem Header="Move to bottom" InputGestureText="Alt+End" Command="{Binding MoveToBottomCommand}" />
                                        <Separator />
                                        <MenuItem Header="Wrap in If" InputGestureText="Ctrl+Shift+I" Command="{Binding WrapInIfCommand}" />
                                        <MenuItem Header="Wrap in Repeat" InputGestureText="Ctrl+Shift+R" Command="{Binding WrapInRepeatCommand}" />
                                        <MenuItem Header="Clean up mouse paths" Command="{Binding CleanUpMousePathsCommand}" />
                                        <Separator />
                                        <MenuItem Header="Duplicate" InputGestureText="Ctrl+D" Command="{Binding DuplicateStepCommand}" />
                                        <MenuItem Header="Delete" InputGestureText="Delete" Command="{Binding DeleteStepCommand}" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.InputBindings>
                                    <KeyBinding Key="F5" Modifiers="Control" Command="{Binding RunStepCommand}" />
                                    <KeyBinding Key="F5" Modifiers="Shift" Command="{Binding PlayFromSelectedCommand}" />
                                </ListBox.InputBindings>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type steps:StepViewModel}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Nested Block Guide Rail -->
                                            <Grid Grid.Column="0" Margin="0,-6,0,0"
                                                  Width="{Binding IndentLevel, Converter={StaticResource IndentLevel}, ConverterParameter=18}">
                                                <Rectangle Fill="{StaticResource IndentGuideTile}" IsHitTestVisible="False" />
                                                <Border x:Name="BlockRail" Width="2.5" HorizontalAlignment="Right" Margin="0,0,5,0" CornerRadius="1.25"
                                                        Background="{Binding BlockRailBrush}" Opacity="0.7" IsHitTestVisible="False"
                                                        Visibility="{Binding IsInsideBlock, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>

                                            <!-- Step Card v2 -->
                                            <Border x:Name="Card" Grid.Column="1" Background="{DynamicResource StepCardBrush}"
                                                    BorderBrush="{DynamicResource StepCardBorderBrush}" BorderThickness="1.5" CornerRadius="9"
                                                    SnapsToDevicePixels="True">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3.5" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Category / Block Depth Accent Strip -->
                                                    <Border x:Name="AccentStrip" Grid.Column="0" CornerRadius="7.5,0,0,7.5"
                                                            Background="{Binding Kind, Converter={StaticResource CategoryBrush}, ConverterParameter=Accent}" />

                                                    <Grid x:Name="Row" Grid.Column="1" Margin="8,7,10,7">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" MinWidth="26" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Step Number + Block Fold Chevron -->
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                                                            <TextBlock x:Name="NumberText" Text="{Binding Number}" FontFamily="{StaticResource MonoFont}"
                                                                       Foreground="{DynamicResource SubtleTextBrush}" FontSize="11"
                                                                       MinWidth="15" VerticalAlignment="Center" />
                                                            <Button x:Name="FoldButton" Visibility="Collapsed" Width="18" Height="20" Padding="0" Margin="1,0,0,0"
                                                                    Style="{StaticResource GhostButton}" ToolTip="{Binding CollapseTooltip}" Focusable="False"
                                                                    Command="{Binding DataContext.ToggleCollapseCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                    CommandParameter="{Binding}">
                                                                <Path Data="M0,0.5 L4,4.5 L8,0.5" Width="8" Height="5" RenderTransformOrigin="0.5,0.5"
                                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="None">
                                                                    <Path.Style>
                                                                        <Style TargetType="Path">
                                                                            <Setter Property="RenderTransform">
                                                                                <Setter.Value><RotateTransform Angle="0" /></Setter.Value>
                                                                            </Setter>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                                                                    <Setter Property="RenderTransform">
                                                                                        <Setter.Value><RotateTransform Angle="-90" /></Setter.Value>
                                                                                    </Setter>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Path.Style>
                                                                </Path>
                                                            </Button>
                                                        </StackPanel>

                                                        <!-- 32x32 Squircle Category Badge -->
                                                        <Border x:Name="IconBadge" Grid.Column="1" Width="32" Height="32" CornerRadius="8"
                                                                Background="{Binding Kind, Converter={StaticResource CategoryBrush}, ConverterParameter=Badge}">
                                                            <TextBlock x:Name="IconGlyph" Text="{Binding Glyph}" Style="{StaticResource IconText}" HorizontalAlignment="Center"
                                                                       Foreground="{Binding Kind, Converter={StaticResource CategoryBrush}, ConverterParameter=Accent}" />
                                                        </Border>

                                                        <!-- Title + Smart Metadata Chips + Summary -->
                                                        <StackPanel Grid.Column="2" Margin="10,0,8,0" VerticalAlignment="Center">
                                                            <DockPanel LastChildFill="True">
                                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                                    <TextBlock x:Name="TitleText" Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />

                                                                    <Border x:Name="BlockPairBadge" CornerRadius="6" Padding="7,1,7,2" Margin="8,0,0,0"
                                                                            Background="{Binding BlockBadgeBackgroundBrush}" BorderBrush="{Binding BlockAccentBrush}" BorderThickness="1"
                                                                            VerticalAlignment="Center"
                                                                            Visibility="{Binding HasBlockBadge, Converter={StaticResource BoolToVisibility}}">
                                                                        <TextBlock Text="{Binding BlockFullBadgeText}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding BlockAccentBrush}" />
                                                                    </Border>

                                                                    <!-- Inline Smart Intent / Brain / Recovery Chip -->
                                                                    <Border CornerRadius="6" Padding="6,1,6,1.5" Margin="7,0,0,0" VerticalAlignment="Center"
                                                                            Background="{Binding Kind, Converter={StaticResource CategoryBrush}, ConverterParameter=Badge}"
                                                                            Visibility="{Binding HasSmartChip, Converter={StaticResource BoolToVisibility}}">
                                                                        <TextBlock Text="{Binding SmartChipText}" FontSize="10" FontWeight="SemiBold"
                                                                                   Foreground="{Binding Kind, Converter={StaticResource CategoryBrush}, ConverterParameter=Accent}" />
                                                                    </Border>

                                                                    <Border x:Name="PartnerTag" Style="{StaticResource Pill}" Margin="6,0,0,0"
                                                                            Background="{Binding BlockBadgeBackgroundBrush}"
                                                                            Visibility="{Binding IsBlockPartnerHighlighted, Converter={StaticResource BoolToVisibility}}">
                                                                        <TextBlock Text="⇄ PAIR" FontSize="9" FontWeight="SemiBold" Foreground="{Binding BlockAccentBrush}" />
                                                                    </Border>

                                                                    <Border x:Name="DisabledTag" Style="{StaticResource Pill}" Margin="8,0,0,0" Visibility="Collapsed">
                                                                        <TextBlock Text="DISABLED" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
                                                                    </Border>

                                                                    <Border x:Name="RunningTag" Style="{StaticResource Pill}" Margin="8,0,0,0" Background="{DynamicResource SuccessSoftBrush}"
                                                                            Visibility="Collapsed">
                                                                        <TextBlock Text="▶ RUNNING" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" />
                                                                    </Border>

                                                                    <Border x:Name="HiddenTag" Style="{StaticResource Pill}" Margin="8,0,0,0" Visibility="Collapsed">
                                                                        <TextBlock Text="{Binding HiddenBadgeText}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
                                                                    </Border>
                                                                </StackPanel>

                                                                <TextBlock x:Name="InlineSummary" Text="{Binding Summary}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11.5"
                                                                           TextTrimming="CharacterEllipsis" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                                            </DockPanel>

                                                            <TextBlock x:Name="SummaryText" Text="{Binding Summary}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                            <TextBlock x:Name="CommentText" Text="{Binding Comment}" FontStyle="Italic" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11"
                                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                                                       Visibility="{Binding HasComment, Converter={StaticResource BoolToVisibility}}" />
                                                        </StackPanel>

                                                        <!-- Hover-Reveal Quick Actions (Run · Test · Delete) -->
                                                        <StackPanel x:Name="HoverActions" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                                                    Margin="0,0,6,0" Visibility="Collapsed">
                                                            <Button Style="{StaticResource GhostButton}" Width="24" Height="24" Padding="0" Focusable="False"
                                                                    Command="{Binding DataContext.RunGivenStepCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                    CommandParameter="{Binding}" ToolTip="Run only this step (Ctrl+F5)">
                                                                <ctrl:StudioIcon Kind="Play" Size="11" Foreground="{DynamicResource SuccessBrush}" />
                                                            </Button>
                                                            <Button Style="{StaticResource GhostButton}" Width="24" Height="24" Padding="0" Margin="2,0,0,0" Focusable="False"
                                                                    Command="{Binding DataContext.TestGivenStepCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                    CommandParameter="{Binding}" ToolTip="Test this step (Ctrl+T)">
                                                                <ctrl:StudioIcon Kind="Flask" Size="11" Foreground="{DynamicResource VisionAccentBrush}" />
                                                            </Button>
                                                            <Button Style="{StaticResource GhostButton}" Width="24" Height="24" Padding="0" Margin="2,0,0,0" Focusable="False"
                                                                    Command="{Binding DataContext.DeleteGivenStepCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                    CommandParameter="{Binding}" ToolTip="Delete step">
                                                                <ctrl:StudioIcon Kind="Trash" Size="11" Foreground="{DynamicResource ErrorBrush}" />
                                                            </Button>
                                                        </StackPanel>

                                                        <!-- Inline Preview (Snapshot / Template / Color Swatch) -->
                                                        <ContentControl Grid.Column="4" Content="{Binding}" ContentTemplateSelector="{StaticResource StepPreviewSelector}"
                                                                        Focusable="False" IsTabStop="False" VerticalAlignment="Center" Margin="0,0,6,0" />

                                                        <!-- Validation Error / Warning Icon -->
                                                        <Grid Grid.Column="5" VerticalAlignment="Center">
                                                            <ctrl:StudioIcon Kind="ErrorCircle" Size="14" Foreground="{DynamicResource ErrorBrush}"
                                                                             ToolTip="{Binding IssueText}" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                                            <ctrl:StudioIcon Kind="WarningTriangle" Size="14" Foreground="{DynamicResource WarningBrush}"
                                                                             ToolTip="{Binding IssueText}" Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}" />
                                                        </Grid>
                                                    </Grid>

                                                    <!-- Live 2px Neon Step Progress Bar -->
                                                    <Grid Grid.Column="0" Grid.ColumnSpan="2" Height="2.5" VerticalAlignment="Bottom" Margin="6,0,6,1"
                                                          IsHitTestVisible="False"
                                                          Visibility="{Binding ShowExecutionProgress, Converter={StaticResource BoolToVisibility}}">
                                                        <Border Background="#1F22D3EE" CornerRadius="1" />
                                                        <Border Background="{DynamicResource NeonProgressBrush}" CornerRadius="1" RenderTransformOrigin="0,0.5">
                                                            <Border.RenderTransform>
                                                                <ScaleTransform ScaleX="{Binding ExecutionProgress}" ScaleY="1" />
                                                            </Border.RenderTransform>
                                                            <Border.Effect>
                                                                <DropShadowEffect Color="#22D3EE" BlurRadius="6" ShadowDepth="0" Opacity="0.85" />
                                                            </Border.Effect>
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding HasBlockBadge}" Value="True">
                                                <Setter TargetName="AccentStrip" Property="Background" Value="{Binding BlockAccentBrush}" />
                                                <Setter TargetName="IconBadge" Property="Background" Value="{Binding BlockBadgeBackgroundBrush}" />
                                                <Setter TargetName="IconGlyph" Property="Foreground" Value="{Binding BlockAccentBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsBlockPartnerHighlighted}" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{Binding BlockAccentBrush}" />
                                                <Setter TargetName="Card" Property="Background" Value="{Binding BlockBadgeBackgroundBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=Card}" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
                                                <Setter TargetName="HoverActions" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource SelectedCardBrush}" />
                                                <Setter TargetName="Card" Property="Effect" Value="{StaticResource GlowSelectedStep}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                <Setter TargetName="Card" Property="Opacity" Value="0.45" />
                                                <Setter TargetName="DisabledTag" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CanCollapse}" Value="True">
                                                <Setter TargetName="FoldButton" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                                <Setter TargetName="HiddenTag" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSearchDimmed}" Value="True">
                                                <Setter TargetName="Card" Property="Opacity" Value="0.38" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSearchMatch}" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCurrentSearchMatch}" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DataContext.IsCompactView, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                                <Setter TargetName="Row" Property="Margin" Value="8,3,10,3" />
                                                <Setter TargetName="IconBadge" Property="Width" Value="22" />
                                                <Setter TargetName="IconBadge" Property="Height" Value="22" />
                                                <Setter TargetName="IconBadge" Property="CornerRadius" Value="6" />
                                                <Setter TargetName="IconGlyph" Property="FontSize" Value="11" />
                                                <Setter TargetName="TitleText" Property="FontSize" Value="12" />
                                                <Setter TargetName="SummaryText" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="CommentText" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="InlineSummary" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource RunningCardBrush}" />
                                                <Setter TargetName="RunningTag" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="Card" Property="Effect" Value="{StaticResource GlowRunningStep}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- C6: Right-Edge Workflow Minimap -->
                            <ctrl:WorkflowMinimap x:Name="StepMinimap" Grid.Column="1" Margin="0,8,4,8"
                                                  Items="{Binding Steps}" SelectedStep="{Binding SelectedStep}"
                                                  StepClicked="StepMinimap_StepClicked"
                                                  Visibility="{Binding HasSteps, Converter={StaticResource BoolToVisibility}}" />

                            <!-- Empty Canvas Guidance -->
                            <StackPanel Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320"
                                        Visibility="{Binding HasSteps, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                <Border Width="52" Height="52" CornerRadius="14" Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Center">
                                    <ctrl:StudioIcon Kind="Sparkles" Size="22" Foreground="{DynamicResource AccentHoverBrush}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Ready to build your workflow" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                                <TextBlock Text="Click any tile in the Toolbox on the left, press Rec in the top bar, or pick a 1-click Blueprint above."
                                           Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- ===== C8: Sticky Inspector Panel ===== -->
                <Border Grid.Column="4" Style="{StaticResource GlassCard}" Padding="0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                            <Grid>
                                <TextBlock Text="Inspector" Style="{StaticResource SectionTitle}" FontSize="13" VerticalAlignment="Center"
                                           Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="8"
                                            Background="{Binding SelectedStep.Kind, Converter={StaticResource CategoryBrush}, ConverterParameter=Badge}">
                                        <TextBlock Text="{Binding SelectedStep.Glyph}" Style="{StaticResource IconText}" HorizontalAlignment="Center"
                                                   Foreground="{Binding SelectedStep.Kind, Converter={StaticResource CategoryBrush}, ConverterParameter=Accent}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedStep.Title}" Style="{StaticResource SectionTitle}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                        <Border Style="{StaticResource Pill}" HorizontalAlignment="Left" Margin="0,3,0,0" Padding="6,0,6,1">
                                            <TextBlock FontSize="10" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource MutedTextBrush}">
                                                <Run Text="Step #" /><Run Text="{Binding SelectedStep.Number, Mode=OneWay}" />
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Command="{Binding RunStepCommand}" Padding="8,4" FontSize="11"
                                            Margin="0,0,8,0" VerticalAlignment="Center"
                                            ToolTip="Run only this step right now (Ctrl+F5)">
                                        <StackPanel Orientation="Horizontal">
                                            <ctrl:StudioIcon Kind="Play" Size="11" Foreground="{DynamicResource SuccessBrush}" />
                                            <TextBlock Text="Run" Margin="5,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <CheckBox Grid.Column="3" Style="{StaticResource ToggleSwitchCheckBoxStyle}" Content="On" VerticalAlignment="Center"
                                              IsChecked="{Binding SelectedStep.Enabled}"
                                              ToolTip="Turned-off steps are skipped during playback" />
                                </Grid>
                            </Grid>
                        </Border>

                        <ContentControl DockPanel.Dock="Bottom" Content="{Binding SelectedStep}" ContentTemplateSelector="{StaticResource InspectorActionSelector}"
                                        Focusable="False" IsTabStop="False"
                                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}" />

                        <Grid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                <ctrl:StudioIcon Kind="Sliders" Size="24" Foreground="{DynamicResource SubtleTextBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="Select a step to inspect and tune its parameters." Style="{StaticResource MutedText}"
                                           TextAlignment="Center" Margin="0,10,0,0" />
                            </StackPanel>
                            <ScrollViewer x:Name="PropertiesScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,10,14,32"
                                          PreviewMouseWheel="Properties_PreviewMouseWheel"
                                          Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                                <ContentControl Content="{Binding SelectedStep}" Focusable="False" />
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- =========================================================================
                 D1 & D2: STUDIO BOTTOM DOCK (Activity · Problems · Variables (Live) · Watchers)
                 ========================================================================= -->
            <Border Grid.Row="2" Style="{StaticResource GlassCard}" Margin="0,8,0,0" Padding="0">
                <DockPanel>
                    <!-- 34px Dock Header Strip -->
                    <Grid DockPanel.Dock="Top" Height="34" Margin="10,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Dock Tab Strip -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource GhostButton}" Padding="8,4" FontSize="11.5"
                                    Command="{Binding OpenBottomTabCommand}" CommandParameter="0"
                                    ToolTip="Toggle Activity Log tab">
                                <TextBlock Text="Activity" FontWeight="SemiBold" />
                            </Button>

                            <Button Style="{StaticResource GhostButton}" Padding="8,4" FontSize="11.5" Margin="2,0,0,0"
                                    Command="{Binding OpenBottomTabCommand}" CommandParameter="1"
                                    ToolTip="Toggle Problems &amp; Validation tab">
                                <StackPanel Orientation="Horizontal">
                                    <ctrl:StudioIcon Kind="CheckCircle" Size="12" Foreground="{DynamicResource SuccessBrush}"
                                                     Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                    <ctrl:StudioIcon Kind="ErrorCircle" Size="12" Foreground="{DynamicResource ErrorBrush}"
                                                     Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibility}}" />
                                    <ctrl:StudioIcon Kind="WarningTriangle" Size="12" Foreground="{DynamicResource WarningBrush}" Margin="2,0,0,0"
                                                     Visibility="{Binding WarningCount, Converter={StaticResource CountToVisibility}}" />
                                    <TextBlock Text="{Binding ValidationSummary}" Margin="5,0,0,0" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource GhostButton}" Padding="8,4" FontSize="11.5" Margin="2,0,0,0"
                                    Command="{Binding OpenBottomTabCommand}" CommandParameter="2"
                                    ToolTip="Toggle Live Variables table">
                                <StackPanel Orientation="Horizontal">
                                    <ctrl:StudioIcon Kind="Variable" Size="12" Foreground="{DynamicResource MemoryAccentBrush}" />
                                    <TextBlock Text="{Binding VariablesSummary}" Margin="5,0,0,0" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource GhostButton}" Padding="8,4" FontSize="11.5" Margin="2,0,0,0"
                                    Command="{Binding OpenBottomTabCommand}" CommandParameter="3"
                                    ToolTip="Toggle Background Watchers">
                                <StackPanel Orientation="Horizontal">
                                    <ctrl:StudioIcon Kind="Watcher" Size="12" Foreground="{DynamicResource MemoryAccentBrush}" />
                                    <TextBlock Text="{Binding WatchersSummary}" Margin="5,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Inline Test Result / Latest Log Preview -->
                        <Grid Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center"
                              DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                            <StackPanel Orientation="Horizontal" Visibility="{Binding Automation.IsIdle, Converter={StaticResource BoolToVisibility}}">
                                <Border CornerRadius="10" Padding="9,2,4,2" Margin="0,0,10,0" VerticalAlignment="Center" BorderThickness="1"
                                        Visibility="{Binding Editor.HasLastTestResult, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="{Binding Editor.LastTestResultText}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Editor.LastTestPassed}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Editor.LastTestResultText}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   MaxWidth="480" TextTrimming="CharacterEllipsis" />
                                        <Button Style="{StaticResource DismissButton}" Margin="6,0,0,0" VerticalAlignment="Center"
                                                Command="{Binding Editor.DismissTestResultCommand}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Automation.ProgressText}" FontSize="11" FontFamily="{StaticResource MonoFont}"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding Automation.IsIdle, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                        </Grid>

                        <!-- Expand / Collapse Toggle -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource GhostButton}" Padding="8,3" FontSize="11" Content="Full log"
                                    Command="{Binding DataContext.ShowLogsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <ToggleButton x:Name="DrawerToggle" Style="{StaticResource GhostToggle}" Padding="8,4" FontSize="11"
                                          IsChecked="{Binding IsBottomDockExpanded, Mode=TwoWay}"
                                          ToolTip="Expand or collapse bottom dock">
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Dock ▴" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBottomDockExpanded}" Value="True">
                                                    <Setter Property="Text" Value="Hide ▾" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </ToggleButton>
                        </StackPanel>
                    </Grid>

                    <!-- Expanded Tab Content Body -->
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Height="175" Padding="12,8"
                            Visibility="{Binding IsBottomDockExpanded, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <!-- TAB 0: ACTIVITY LOG -->
                            <ListBox ItemsSource="{Binding DataContext.Logs.Entries, RelativeSource={RelativeSource AncestorType=Window}}"
                                     ItemContainerStyle="{StaticResource PlainListItem}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True"
                                     AutomationProperties.Name="Activity log">
                                <ListBox.Style>
                                    <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedBottomTab}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.Style>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Level, Converter={StaticResource LevelToGlyph}}" Style="{StaticResource IconText}"
                                                       FontSize="11" Foreground="{Binding Level, Converter={StaticResource LevelToBrush}}" />
                                            <TextBlock Text="{Binding TimeText}" FontFamily="{StaticResource MonoFont}"
                                                       Foreground="{DynamicResource SubtleTextBrush}" Margin="8,0,10,0" FontSize="11" />
                                            <TextBlock Text="{Binding Message}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- TAB 1: PROBLEMS -->
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedBottomTab}" Value="1">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <TextBlock Text="✓ No problems found — this workflow is ready to save and play."
                                           Style="{StaticResource MutedText}" FontSize="12" Margin="4,6,0,0"
                                           Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                <ListBox ItemsSource="{Binding Issues}" ItemContainerStyle="{StaticResource PlainListItem}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisibility}}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type core:ValidationIssue}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Severity, Converter={StaticResource LevelToGlyph}}" Style="{StaticResource IconText}" FontSize="11"
                                                           Foreground="{Binding Severity, Converter={StaticResource LevelToBrush}}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding DisplayText}" FontSize="11.5" Margin="8,0,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>

                            <!-- TAB 2: LIVE VARIABLES TABLE (D1) -->
                            <DockPanel>
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedBottomTab}" Value="2">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Content="+ Add variable" Command="{Binding AddVariableCommand}" Padding="9,3" FontSize="11" />
                                    <TextBlock Text="Declare counters, OCR numbers, or flags — reference anywhere as {name}."
                                               Style="{StaticResource MutedText}" FontSize="11.5" VerticalAlignment="Center" />
                                </DockPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Variables}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type steps:VariableItemViewModel}">
                                                <Border Padding="8,5" Margin="0,0,0,5" CornerRadius="7" Background="{DynamicResource SurfaceAltBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="160" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="120" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="160" />
                                                            <ColumnDefinition Width="12" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Tag="Variable name"
                                                                 FontFamily="{StaticResource MonoFont}" FontSize="12" Padding="6,3" />
                                                        <ComboBox Grid.Column="2" ItemsSource="{x:Static steps:VariableItemViewModel.Types}"
                                                                  DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Type}" Padding="6,3" FontSize="11.5" />
                                                        <TextBox Grid.Column="4" Text="{Binding DefaultValue, UpdateSourceTrigger=PropertyChanged}" Tag="Default value"
                                                                 FontFamily="{StaticResource MonoFont}" FontSize="12" Padding="6,3" />
                                                        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="Live: " FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                                                            <TextBlock Text="{Binding LiveValue}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                                       FontWeight="SemiBold" Foreground="{DynamicResource MemoryAccentBrush}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="7" Style="{StaticResource DismissButton}"
                                                                Command="{Binding DataContext.RemoveVariableCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" ToolTip="Remove variable" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>

                            <!-- TAB 3: BACKGROUND WATCHERS (D2) -->
                            <DockPanel>
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedBottomTab}" Value="3">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Content="+ Add watcher" Command="{Binding AddWatcherCommand}" Padding="9,3" FontSize="11" />
                                    <TextBlock Text="Interrupt guards checked between steps (dismiss surprise popups, reconnect, or jump to a Checkpoint)."
                                               Style="{StaticResource MutedText}" FontSize="11.5" VerticalAlignment="Center" />
                                </DockPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Watchers}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type steps:WatcherItemViewModel}">
                                                <Border Padding="10,8" Margin="0,0,0,8" CornerRadius="8" Background="{DynamicResource SurfaceAltBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <Button DockPanel.Dock="Right" Style="{StaticResource DismissButton}" Margin="6,0,0,0"
                                                                    Command="{Binding DataContext.RemoveWatcherCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}" ToolTip="Remove watcher" />
                                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitchCheckBoxStyle}" Content="Armed"
                                                                      IsChecked="{Binding Enabled}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="200" />
                                                                    <ColumnDefinition Width="10" />
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="10" />
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="10" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox Grid.Column="0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Tag="Watcher name"
                                                                         FontWeight="SemiBold" Padding="6,3" FontSize="12" />
                                                                <TextBox Grid.Column="2" Text="{Binding CheckIntervalMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                                                         Tag="Interval ms" Padding="6,3" FontSize="11.5" ToolTip="Check every (ms)" />
                                                                <TextBox Grid.Column="4" Text="{Binding CooldownMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                                                         Tag="Cooldown ms" Padding="6,3" FontSize="11.5" ToolTip="Cooldown after firing (ms)" />
                                                                <ComboBox Grid.Column="6" ItemsSource="{x:Static steps:WatcherItemViewModel.ActionChoices}"
                                                                          DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Action}" Padding="6,3" FontSize="11.5" />
                                                            </Grid>
                                                        </DockPanel>
                                                        <ContentControl Content="{Binding Condition}" ContentTemplate="{StaticResource ConditionEditorTemplate}"
                                                                        Focusable="False" Margin="0,6,0,0" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding IsSubMacro, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock Text="Handler sub-macro:" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                            <ComboBox ItemsSource="{Binding MacroChoices}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedMacroChoice}" MinWidth="180" />
                                                            <TextBox Text="{Binding HandlerMacroName, UpdateSourceTrigger=PropertyChanged}" Tag="Or macro name" Width="160" Margin="8,0,0,0" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding IsCheckpointJump, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock Text="Target checkpoint:" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                            <TextBox Text="{Binding CheckpointName, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. start" Width="180" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>

        <!-- =========================================================================
             C9: CTRL+K COMMAND PALETTE v2 (Glass Modal + Keycaps)
             ========================================================================= -->
        <Grid Panel.ZIndex="100" Visibility="{Binding IsCommandPaletteOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Background="#AA05070C" MouseLeftButtonDown="PaletteBackdrop_MouseLeftButtonDown" />
            <Border x:Name="PaletteCard" Width="580" MaxHeight="450" Margin="0,56,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Background="{DynamicResource CharcoalBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="12"
                    Padding="12" Effect="{StaticResource ShadowModal}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top">
                        <ctrl:StudioIcon Kind="Search" Size="14" Foreground="{DynamicResource AccentHoverBrush}"
                                         HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,0,0" Panel.ZIndex="1" />
                        <TextBox x:Name="PaletteBox" Text="{Binding PaletteQuery, UpdateSourceTrigger=PropertyChanged}" FontSize="14"
                                 Padding="34,9,10,9" Tag="Type a step, blueprint, or studio command…"
                                 PreviewKeyDown="PaletteBox_PreviewKeyDown" AutomationProperties.Name="Command palette search" />
                    </Grid>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="4,8,0,0">
                        <TextBlock Text="↑↓ navigate  ·  Enter execute  ·  Esc close" FontSize="10.5"
                                   FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource SubtleTextBrush}" />
                    </StackPanel>

                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="No matching steps or commands." Style="{StaticResource MutedText}" Margin="10,8,0,8"
                                   Visibility="{Binding HasNoPaletteResults, Converter={StaticResource BoolToVisibility}}" />
                        <ListBox x:Name="PaletteList" ItemsSource="{Binding PaletteItems}" SelectedIndex="{Binding SelectedPaletteIndex, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource PaletteItemStyle}" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" Focusable="False"
                                 PreviewMouseLeftButtonUp="PaletteList_PreviewMouseLeftButtonUp"
                                 AutomationProperties.Name="Command palette results">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Margin="12,0,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource KeycapBorder}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Shortcut}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Shortcut}" FontSize="10" FontFamily="{StaticResource MonoFont}"
                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                        </Border>
                                        <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{DynamicResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
