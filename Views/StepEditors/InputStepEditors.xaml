<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="clr-namespace:SmartMacro.Core.Models;assembly=SmartMacro.Core"
                    xmlns:steps="clr-namespace:SmartMacro.ViewModels.Steps"
                    xmlns:vision="clr-namespace:SmartMacro.Services.Vision"
                    xmlns:controls="clr-namespace:SmartMacro.Controls"
                    xmlns:conv="clr-namespace:SmartMacro.Converters">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SmartMacro;component/Views/StepEditors/StepEditorsShared.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ===================================== 1. DELAY (WAIT) ===================================== -->
    <DataTemplate DataType="{x:Type steps:DelayStepViewModel}">
        <StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepHeaderTemplate}" Focusable="False" />
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SummaryBannerTemplate}" Focusable="False" />

            <StackPanel Visibility="{Binding ShowSetupSection, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource SetupCard}">
                    <StackPanel>
                        <TextBlock Text="⏱ WAIT TIMING &amp; MODE" Style="{StaticResource SetupCardTitle}" />
                        <TextBlock Text="Timing mode" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                        <ListBox ItemsSource="{x:Static steps:DelayStepViewModel.Modes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                 SelectedValue="{Binding Mode}" Style="{StaticResource ChoiceChipListBoxStyle}"
                                 AutomationProperties.Name="Wait mode" />

                        <TextBlock Text="{Binding DurationFieldLabel}" Style="{StaticResource FieldLabel}" Margin="0,6,0,4" />
                        <controls:StudioNumberBox Value="{Binding DurationMs}" Unit="ms" Step="50" Minimum="0" Maximum="3600000"
                                                  Presets="-50,+50,+100,+500,+1000,+5000,0"
                                                  AutomationProperties.Name="Wait time in milliseconds" />
                        <TextBlock Text="{Binding SecondsText}" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,4,0,0" />

                        <!-- Adaptive wait bounds -->
                        <StackPanel Visibility="{Binding IsAdaptive, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                                    <TextBlock Text="Min wait floor" Style="{StaticResource FieldLabel}" />
                                    <controls:StudioNumberBox Value="{Binding MinDurationMs}" Unit="ms" Step="50" Minimum="0" Maximum="3600000"
                                                              Presets="50,100,250,500"
                                                              AutomationProperties.Name="Minimum wait in milliseconds" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                    <TextBlock Text="Max wait cap" Style="{StaticResource FieldLabel}" />
                                    <controls:StudioNumberBox Value="{Binding MaxDurationMs}" Unit="ms" Step="100" Minimum="0" Maximum="3600000"
                                                              Presets="1000,2500,5000,10000"
                                                              AutomationProperties.Name="Maximum wait in milliseconds" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding AdaptiveModeHelp}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepFooterTemplate}" Focusable="False" />
        </StackPanel>
    </DataTemplate>

    <!-- ===================================== 2. MOVE MOUSE ===================================== -->
    <DataTemplate DataType="{x:Type steps:MouseMoveStepViewModel}">
        <StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepHeaderTemplate}" Focusable="False" />
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SummaryBannerTemplate}" Focusable="False" />

            <!-- SETUP TAB: Target Destination -->
            <StackPanel Visibility="{Binding ShowSetupSection, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource SetupCard}">
                    <StackPanel>
                        <TextBlock Text="🎯 WHERE TO MOVE" Style="{StaticResource SetupCardTitle}" />
                        <CheckBox Content="🎮 Relative mouse delta (3D camera turn)" IsChecked="{Binding UseRelativeDelta}" Margin="0,8,0,6"
                                  AutomationProperties.Name="Relative mouse delta" />

                        <StackPanel Visibility="{Binding IsAbsolute, Converter={StaticResource BoolToVisibility}}">
                            <ComboBox ItemsSource="{x:Static steps:MouseMoveStepViewModel.Targets}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding TargetMode}" AutomationProperties.Name="Where to move" />

                            <!-- Chosen screen coordinates -->
                            <StackPanel Visibility="{Binding UsesFixedPosition, Converter={StaticResource BoolToVisibility}}">
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PositionPickerTemplate}" Focusable="False" />
                            </StackPanel>

                            <!-- Relative to what the last Find step found or cursor -->
                            <StackPanel Visibility="{Binding UsesOffset, Converter={StaticResource BoolToVisibility}}" Margin="0,6,0,0">
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource OffsetFieldsTemplate}" Focusable="False" />
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource OffsetPickerTemplate}" Focusable="False" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Relative to current cursor (3D camera turn / aim nudge) -->
                        <StackPanel Visibility="{Binding UseRelativeDelta, Converter={StaticResource BoolToVisibility}}" Margin="0,6,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Delta X (+ = right)" Style="{StaticResource FieldLabel}" />
                                    <controls:StudioNumberBox Value="{Binding DeltaX}" Unit="px" Step="10" Minimum="-10000" Maximum="10000"
                                                              AutomationProperties.Name="Delta X" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Delta Y (+ = down)" Style="{StaticResource FieldLabel}" />
                                    <controls:StudioNumberBox Value="{Binding DeltaY}" Unit="px" Step="10" Minimum="-10000" Maximum="10000"
                                                              AutomationProperties.Name="Delta Y" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- TUNE & MOTION TAB: Trajectory Curve & Jitter -->
            <StackPanel Visibility="{Binding ShowTuneSection, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource SetupCard}" Visibility="{Binding IsAbsolute, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="🎛 CURSOR TRAJECTORY &amp; HUMANIZATION" Style="{StaticResource SetupCardTitle}" />
                        <TextBlock Text="Movement style" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                        <ComboBox ItemsSource="{x:Static steps:StepViewModel.MoveStyles}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding MoveStyle}" AutomationProperties.Name="Movement style" />

                        <!-- Live Trajectory Curve Visualizer -->
                        <controls:MotionCurvePreview MoveStyle="{Binding MoveStyle}" DurationMs="{Binding MoveDurationMs}" />

                        <StackPanel IsEnabled="{Binding Glides}" Margin="0,6,0,0">
                            <TextBlock Text="Glide duration" Style="{StaticResource FieldLabel}" />
                            <controls:StudioNumberBox Value="{Binding MoveDurationMs}" Unit="ms" Step="20" Minimum="0" Maximum="10000"
                                                      Presets="0,80,150,250,500"
                                                      AutomationProperties.Name="Glide duration in milliseconds" />
                        </StackPanel>
                        <TextBlock Text="{Binding MoveHelp}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepFooterTemplate}" Focusable="False" />
        </StackPanel>
    </DataTemplate>

    <!-- ===================================== 3. MOUSE CLICK ===================================== -->
    <DataTemplate DataType="{x:Type steps:MouseClickStepViewModel}">
        <StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepHeaderTemplate}" Focusable="False" />
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SummaryBannerTemplate}" Focusable="False" />

            <!-- SETUP TAB: Button, Action & Target Location -->
            <StackPanel Visibility="{Binding ShowSetupSection, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource SetupCard}">
                    <StackPanel>
                        <TextBlock Text="🖱 CLICK BUTTON &amp; ACTION" Style="{StaticResource SetupCardTitle}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Mouse button" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <ListBox ItemsSource="{x:Static steps:MouseClickStepViewModel.Buttons}"
                                         SelectedItem="{Binding Button}" Style="{StaticResource ChoiceChipListBoxStyle}"
                                         AutomationProperties.Name="Mouse button" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Action" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <ListBox ItemsSource="{x:Static steps:MouseClickStepViewModel.Actions}"
                                         DisplayMemberPath="Label" SelectedValuePath="Value"
                                         SelectedValue="{Binding Action}" Style="{StaticResource ChoiceChipListBoxStyle}"
                                         AutomationProperties.Name="Click action" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Visibility="{Binding UsesHoldTime, Converter={StaticResource BoolToVisibility}}" Margin="0,6,0,0">
                            <TextBlock Text="Hold duration" Style="{StaticResource FieldLabel}" />
                            <controls:StudioNumberBox Value="{Binding HoldMs}" Unit="ms" Step="50" Minimum="0" Maximum="3600000"
                                                      Presets="-50,+50,+100,+500,+1000,0"
                                                      AutomationProperties.Name="Hold time in milliseconds" />
                        </StackPanel>

                        <TextBlock Text="Where to click" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                        <ComboBox ItemsSource="{x:Static steps:MouseClickStepViewModel.Targets}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Target}" AutomationProperties.Name="Where to click" />

                        <StackPanel Visibility="{Binding UsesFixedPosition, Converter={StaticResource BoolToVisibility}}">
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PositionPickerTemplate}" Focusable="False" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding UsesLastFound, Converter={StaticResource BoolToVisibility}}" Margin="0,6,0,0">
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource OffsetFieldsTemplate}" Focusable="False" />
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource OffsetPickerTemplate}" Focusable="False" />
                        </StackPanel>

                        <!-- Drag & drop target -->
                        <StackPanel Visibility="{Binding IsDrag, Converter={StaticResource BoolToVisibility}}" Margin="0,12,0,0">
                            <TextBlock Text="DRAG DESTINATION" Style="{StaticResource SetupCardTitle}" Margin="0,0,0,6" />
                            <ContentControl Content="{Binding EndPoint}" ContentTemplate="{StaticResource PositionPickerTemplate}" Focusable="False" />
                            <TextBlock Text="Drag duration" Style="{StaticResource FieldLabel}" Margin="0,6,0,4" />
                            <controls:StudioNumberBox Value="{Binding DragDurationMs}" Unit="ms" Step="50" Minimum="0" Maximum="60000"
                                                      Presets="150,300,500,1000"
                                                      AutomationProperties.Name="Drag duration in milliseconds" />
                            <TextBlock Text="Drag trajectory style" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                            <ComboBox ItemsSource="{x:Static steps:StepViewModel.MoveStyles}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding MoveStyle}" AutomationProperties.Name="Drag trajectory style" />
                            <Button Command="{Binding DataContext.ExpandDragToMovesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,5"
                                    ToolTip="Expand this Drag step into explicit Press, intermediate Move/Delay waypoints, and Release steps"
                                    AutomationProperties.Name="Expand Drag into Move steps">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✂" FontSize="12" />
                                    <TextBlock Text="Expand Drag into Move steps" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Smart Click & Intent Snapshot Card (also shown on Setup when recorded with a snapshot) -->
                <Border Style="{StaticResource SetupCard}" Visibility="{Binding HasSmartCard, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="🧭 SMART CLICK &amp; TARGET RELOCATION" Style="{StaticResource SetupCardTitle}" />

                        <!-- Interactive Visual Crosshair on Recorded Snapshot -->
                        <controls:OffsetCrosshairPreview Source="{Binding TargetThumbnail}"
                                                         OffsetX="{Binding OffsetX}" OffsetY="{Binding OffsetY}"
                                                         Height="116" Margin="0,8,0,6"
                                                         Visibility="{Binding HasTargetThumbnail, Converter={StaticResource BoolToVisibility}}" />

                        <StackPanel Visibility="{Binding HasTargetIntent, Converter={StaticResource BoolToVisibility}}" Margin="0,4,0,0">
                            <Border Padding="8,6" CornerRadius="6" Background="{DynamicResource SurfaceAltBrush}">
                                <TextBlock Text="{Binding TargetSignalsSummary}" FontSize="11.5" TextWrapping="Wrap" FontWeight="SemiBold" />
                            </Border>
                            <CheckBox Content="🧭 Smart Intent: relocate target automatically (UI → OCR → Image → Window → X/Y)"
                                      IsChecked="{Binding UseSmartIntent}" Margin="0,6,0,0"
                                      AutomationProperties.Name="Smart Intent relocate target automatically" />
                            <Button Command="{Binding LocateTargetCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="10,5"
                                    AutomationProperties.Name="Locate target now">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎯" FontSize="12" />
                                    <TextBlock Text="Locate target now" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Visibility="{Binding HasTargetThumbnail, Converter={StaticResource BoolToVisibility}}" Margin="0,6,0,0">
                            <CheckBox Content="✨ Smart-Aim: find this button near X / Y if it moved slightly"
                                      IsChecked="{Binding SmartAimAtTarget}"
                                      AutomationProperties.Name="Smart-Aim at recorded target" />
                            <Grid Margin="0,6,0,0" Visibility="{Binding SmartAimAtTarget, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                                    <TextBlock Text="Match accuracy (%)" Style="{StaticResource FieldLabel}" />
                                    <controls:StudioNumberBox Value="{Binding SmartAimAccuracyPercent}" Unit="%" Step="2" Minimum="60" Maximum="100"
                                                              AutomationProperties.Name="Smart-Aim match accuracy percent" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                    <TextBlock Text="Search radius" Style="{StaticResource FieldLabel}" />
                                    <controls:StudioNumberBox Value="{Binding SmartAimRadiusPx}" Unit="px" Step="25" Minimum="30" Maximum="1000"
                                                              AutomationProperties.Name="Smart-Aim search radius in pixels" />
                                </StackPanel>
                            </Grid>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Command="{Binding DataContext.ConvertClickToFindImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,4"
                                        AutomationProperties.Name="Convert click to Find Image step">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🖼" FontSize="12" />
                                        <TextBlock Text="Convert to Find Image Step" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding TestSmartAimCommand}" Margin="0,0,8,4"
                                        AutomationProperties.Name="Test Smart-Aim now">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🎯" FontSize="12" />
                                        <TextBlock Text="Test Smart-Aim now" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>

                        <Border Padding="8,6" CornerRadius="6" Background="{DynamicResource SurfaceAltBrush}" Margin="0,6,0,0"
                                Visibility="{Binding SmartAimTestResult, Converter={StaticResource NullToVisibility}}">
                            <TextBlock Text="{Binding SmartAimTestResult}" TextWrapping="Wrap" FontSize="11.5" />
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- TUNE & MOTION TAB: Cursor Movement, Click Cadence & Timing -->
            <StackPanel Visibility="{Binding ShowTuneSection, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource SetupCard}">
                    <StackPanel>
                        <TextBlock Text="🎛 CURSOR TRAJECTORY &amp; CLICK TIMING" Style="{StaticResource SetupCardTitle}" />
                        <StackPanel Visibility="{Binding UsesFixedPosition, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Movement style" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                            <ComboBox ItemsSource="{x:Static steps:StepViewModel.MoveStyles}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding MoveStyle}" AutomationProperties.Name="Movement style" />

                            <controls:MotionCurvePreview MoveStyle="{Binding MoveStyle}" DurationMs="{Binding MoveDurationMs}" />

                            <StackPanel IsEnabled="{Binding Glides}" Margin="0,6,0,0">
                                <TextBlock Text="Glide duration" Style="{StaticResource FieldLabel}" />
                                <controls:StudioNumberBox Value="{Binding MoveDurationMs}" Unit="ms" Step="20" Minimum="0" Maximum="10000"
                                                          Presets="0,80,120,250"
                                                          AutomationProperties.Name="Glide duration in milliseconds" />
                            </StackPanel>
                        </StackPanel>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                                <TextBlock Text="Click hold duration" Style="{StaticResource FieldLabel}" />
                                <controls:StudioNumberBox Value="{Binding HoldMs}" Unit="ms" Step="5" Minimum="0" Maximum="10000"
                                                          AutomationProperties.Name="Click hold duration in milliseconds" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                <TextBlock Text="Wait after click" Style="{StaticResource FieldLabel}" />
                                <controls:StudioNumberBox Value="{Binding PostActionDelayMs}" Unit="ms" Step="20" Minimum="0" Maximum="60000"
                                                          AutomationProperties.Name="Wait after click in milliseconds" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,6,0,0">
                            <TextBlock Text="Double-click gap" Style="{StaticResource FieldLabel}" />
                            <controls:StudioNumberBox Value="{Binding DoubleClickIntervalMs}" Unit="ms" Step="10" Minimum="0" Maximum="5000"
                                                      AutomationProperties.Name="Double-click gap in milliseconds" />
                        </StackPanel>

                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="👻 Background window title (optional — click without moving cursor)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding BackgroundWindowTitle, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Leave empty for normal physical cursor click, or enter window title / process…"
                                     MaxLength="120" Margin="0,4,0,0"
                                     AutomationProperties.Name="Background window title" />
                            <StackPanel Visibility="{Binding HasBackgroundTarget, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0">
                                <TextBlock Text="Background delivery method" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <ListBox ItemsSource="{x:Static steps:MouseClickStepViewModel.BackgroundBackends}"
                                         DisplayMemberPath="Label" SelectedValuePath="Value"
                                         SelectedValue="{Binding BackgroundBackend}"
                                         Style="{StaticResource ChoiceChipListBoxStyle}"
                                         AutomationProperties.Name="Background delivery method" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepFooterTemplate}" Focusable="False" />
        </StackPanel>
    </DataTemplate>

    <!-- ===================================== 4. MOUSE SCROLL ===================================== -->
    <DataTemplate DataType="{x:Type steps:MouseScrollStepViewModel}">
        <StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepHeaderTemplate}" Focusable="False" />
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SummaryBannerTemplate}" Focusable="False" />

            <StackPanel Visibility="{Binding ShowSetupSection, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource SetupCard}">
                    <StackPanel>
                        <TextBlock Text="🖱 SCROLL DIRECTION &amp; NOTCHES" Style="{StaticResource SetupCardTitle}" />
                        <TextBlock Text="Direction" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                        <ListBox ItemsSource="{x:Static steps:MouseScrollStepViewModel.Directions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                 SelectedValue="{Binding Direction}" Style="{StaticResource ChoiceChipListBoxStyle}"
                                 AutomationProperties.Name="Scroll direction" />

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                                <TextBlock Text="Wheel notches" Style="{StaticResource FieldLabel}" />
                                <controls:StudioNumberBox Value="{Binding Notches}" Unit="×" Step="1" Minimum="1" Maximum="500"
                                                          Presets="1,3,5,10"
                                                          AutomationProperties.Name="Number of wheel notches" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                <TextBlock Text="Raw delta (120/notch)" Style="{StaticResource FieldLabel}" />
                                <controls:StudioNumberBox Value="{Binding Delta}" Unit="Δ" Step="120" Minimum="-60000" Maximum="60000"
                                                          AutomationProperties.Name="Exact wheel amount" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Where to scroll" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                        <ComboBox ItemsSource="{x:Static steps:MouseScrollStepViewModel.PositionModes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding UseCurrentPosition}" AutomationProperties.Name="Where to scroll" />
                        <StackPanel Visibility="{Binding UsesFixedPosition, Converter={StaticResource BoolToVisibility}}">
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PositionPickerTemplate}" Focusable="False" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepFooterTemplate}" Focusable="False" />
        </StackPanel>
    </DataTemplate>

    <!-- ===================================== 5. KEY PRESS ===================================== -->
    <DataTemplate DataType="{x:Type steps:KeyPressStepViewModel}">
        <StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepHeaderTemplate}" Focusable="False" />

            <!-- SETUP TAB: Interactive 3D Keycap Deck, Key, Action & Modifiers -->
            <StackPanel Visibility="{Binding ShowSetupSection, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource SetupCard}">
                    <StackPanel>
                        <TextBlock Text="⌨ HARDWARE KEYCAP DECK" Style="{StaticResource SetupCardTitle}" />
                        <Grid Margin="0,10,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 3D Hardware Keycap Visual -->
                            <Border Grid.Column="0" MinWidth="68" Height="46" Padding="14,6" CornerRadius="8"
                                    Background="{DynamicResource SurfaceElevatedBrush}"
                                    BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1,1,1,3">
                                <TextBlock Text="{Binding KeycapDisplayText}"
                                           FontFamily="{StaticResource FontFamilyMono}" FontSize="15" FontWeight="Bold"
                                           Foreground="{DynamicResource BrandPrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <Button x:Name="KeyRecordButton"
                                        Content="{Binding KeyRecorderButtonText}"
                                        Command="{Binding ToggleKeyRecordCommand}"
                                        HorizontalAlignment="Stretch" Padding="12,8" FontWeight="SemiBold"
                                        AutomationProperties.Name="Press key to bind">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRecordingKey}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource BrandRecordBrush}" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <TextBlock Text="{Binding HardwareKeyInfoText}"
                                           FontFamily="{StaticResource FontFamilyMono}" FontSize="10.5"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="2,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Key" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{x:Static steps:KeyPressStepViewModel.Keys}" DisplayMemberPath="Name" SelectedValuePath="Code"
                                  SelectedValue="{Binding VirtualKey}" IsTextSearchEnabled="True" TextSearch.TextPath="Name"
                                  AutomationProperties.Name="Key" />

                        <TextBlock Text="Action" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                        <ListBox ItemsSource="{x:Static steps:KeyPressStepViewModel.Actions}"
                                 SelectedItem="{Binding Action}" Style="{StaticResource ChoiceChipListBoxStyle}"
                                 AutomationProperties.Name="Key action" />

                        <StackPanel Visibility="{Binding IsPress, Converter={StaticResource BoolToVisibility}}" Margin="0,4,0,0">
                            <TextBlock Text="Hold duration (0 = instant tap)" Style="{StaticResource FieldLabel}" />
                            <controls:StudioNumberBox Value="{Binding HoldMs}" Unit="ms" Step="25" Minimum="0" Maximum="3600000"
                                                      Presets="-50,+50,+100,+500,+1000,0"
                                                      AutomationProperties.Name="Hold time in milliseconds" />

                            <TextBlock Text="Hold with modifiers" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                            <WrapPanel>
                                <CheckBox Content="Ctrl" IsChecked="{Binding Ctrl}" Margin="0,0,16,0" />
                                <CheckBox Content="Shift" IsChecked="{Binding Shift}" Margin="0,0,16,0" />
                                <CheckBox Content="Alt" IsChecked="{Binding Alt}" Margin="0,0,16,0" />
                                <CheckBox Content="Win" IsChecked="{Binding Win}" />
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- TUNE TAB: Hardware ScanCode & Extended Flag -->
            <StackPanel Visibility="{Binding ShowTuneSection, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource SetupCard}">
                    <StackPanel>
                        <TextBlock Text="🎛 DIRECTINPUT HARDWARE SCAN CODE" Style="{StaticResource SetupCardTitle}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Scan code (0 = auto from VK)" Style="{StaticResource FieldLabel}" />
                                <controls:StudioNumberBox Value="{Binding ScanCode}" Unit="SC" Step="1" Minimum="0" Maximum="255"
                                                          AutomationProperties.Name="Hardware scan code" />
                            </StackPanel>
                            <CheckBox Grid.Column="2" Content="Extended key (E0)" IsChecked="{Binding Extended}"
                                      VerticalAlignment="Bottom" Margin="0,0,0,8"
                                      AutomationProperties.Name="Extended key flag" />
                        </Grid>

                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="👻 Background window title (optional — PostMessage key without switching focus)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding BackgroundWindowTitle, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Leave empty for normal active keyboard input, or enter window title / process…"
                                     MaxLength="120" Margin="0,4,0,0"
                                     AutomationProperties.Name="Background window title" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepFooterTemplate}" Focusable="False" />
        </StackPanel>
    </DataTemplate>

    <!-- ===================================== 6. TYPE TEXT ===================================== -->
    <DataTemplate DataType="{x:Type steps:TypeTextStepViewModel}">
        <StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepHeaderTemplate}" Focusable="False" />

            <!-- SETUP TAB: Text Content + 1-Click {Variable} Insertion Bar -->
            <StackPanel Visibility="{Binding ShowSetupSection, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource SetupCard}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="⌨ TEXT TO TYPE" Style="{StaticResource SetupCardTitle}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CharacterCountText}" Style="{StaticResource MutedText}" FontSize="11"
                                       HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center" />
                        </DockPanel>

                        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="84" MaxHeight="200" VerticalScrollBarVisibility="Auto" MaxLength="10000" Margin="0,8,0,0"
                                 AutomationProperties.Name="Text to type" />

                        <!-- 1-Click {Variable} Token Insertion Bar -->
                        <WrapPanel Margin="0,8,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Insert {var}:" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Button Content="{}{value}" Command="{Binding InsertVariableTokenCommand}" CommandParameter="value"
                                    Style="{StaticResource VariableTokenChipButtonStyle}" ToolTip="Insert {value} variable token" />
                            <Button Content="{}{count}" Command="{Binding InsertVariableTokenCommand}" CommandParameter="count"
                                    Style="{StaticResource VariableTokenChipButtonStyle}" ToolTip="Insert {count} variable token" />
                            <Button Content="{}{loop}" Command="{Binding InsertVariableTokenCommand}" CommandParameter="loop"
                                    Style="{StaticResource VariableTokenChipButtonStyle}" ToolTip="Insert {loop} variable token" />
                            <Button Content="{}{score}" Command="{Binding InsertVariableTokenCommand}" CommandParameter="score"
                                    Style="{StaticResource VariableTokenChipButtonStyle}" ToolTip="Insert {score} variable token" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- TUNE TAB: Typing Cadence -->
            <StackPanel Visibility="{Binding ShowTuneSection, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource SetupCard}">
                    <StackPanel>
                        <TextBlock Text="🎛 TYPING CADENCE" Style="{StaticResource SetupCardTitle}" />
                        <TextBlock Text="Delay between characters (0 = instant)" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                        <controls:StudioNumberBox Value="{Binding CharacterDelayMs}" Unit="ms" Step="5" Minimum="0" Maximum="5000"
                                                  Presets="0,15,35,65,120"
                                                  AutomationProperties.Name="Delay between characters in milliseconds" />

                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="👻 Background window title (optional — type without switching focus)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding BackgroundWindowTitle, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Leave empty for normal active typing, or enter window title / process…"
                                     MaxLength="120" Margin="0,4,0,0"
                                     AutomationProperties.Name="Background window title" />
                            <StackPanel Visibility="{Binding HasBackgroundTarget, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0">
                                <TextBlock Text="Background delivery method" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <ListBox ItemsSource="{x:Static steps:TypeTextStepViewModel.BackgroundBackends}"
                                         DisplayMemberPath="Label" SelectedValuePath="Value"
                                         SelectedValue="{Binding BackgroundBackend}"
                                         Style="{StaticResource ChoiceChipListBoxStyle}"
                                         AutomationProperties.Name="Background delivery method" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepFooterTemplate}" Focusable="False" />
        </StackPanel>
    </DataTemplate>

    <!-- ===================================== 7. RECORDED INPUT SEQUENCE ===================================== -->
    <DataTemplate DataType="{x:Type steps:InputSequenceStepViewModel}">
        <StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepHeaderTemplate}" Focusable="False" />

            <StackPanel Visibility="{Binding ShowSetupSection, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource SetupCard}">
                    <StackPanel>
                        <TextBlock Text="🎞 RECORDED TIMELINE OVERVIEW" Style="{StaticResource SetupCardTitle}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Duration" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />
                                <TextBlock Text="{Binding DurationText}" FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Total events" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />
                                <TextBlock Text="{Binding EventCountText}" FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding MouseText}" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ButtonsText}" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding KeysText}" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SetupCard}">
                    <StackPanel>
                        <TextBlock Text="🧭 MOUSE PLAYBACK &amp; SEGMENTS" Style="{StaticResource SetupCardTitle}" />
                        <TextBlock Text="{Binding PlaybackExplanation}" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap" />

                        <CheckBox Content="Move cursor to recorded start position before playing"
                                  IsChecked="{Binding MoveCursorToStart}" Margin="0,8,0,0"
                                  AutomationProperties.Name="Move cursor to recorded start position" />

                        <StackPanel Visibility="{Binding HasMouseParts, Converter={StaticResource BoolToVisibility}}" Margin="0,10,0,0">
                            <WrapPanel Margin="0,0,0,6">
                                <Button Content="Automatic everywhere" Command="{Binding UseAutomaticEverywhereCommand}" Padding="8,4" Margin="0,0,6,6" FontSize="11" />
                                <Button Content="Screen coordinates everywhere" Command="{Binding UseCursorEverywhereCommand}" Padding="8,4" Margin="0,0,6,6" FontSize="11" />
                                <Button Content="3D camera turn everywhere" Command="{Binding UseRelativeEverywhereCommand}" Padding="8,4" Margin="0,0,0,6" FontSize="11" />
                            </WrapPanel>

                            <ItemsControl ItemsSource="{Binding MouseParts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type steps:MouseSegmentViewModel}">
                                        <Border Margin="0,0,0,6" Padding="10,8" CornerRadius="6" Background="{DynamicResource SurfaceBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" />
                                                    <TextBlock Text="{Binding RangeText}" Style="{StaticResource MutedText}" FontSize="11"
                                                               HorizontalAlignment="Right" DockPanel.Dock="Right" />
                                                </DockPanel>
                                                <ComboBox ItemsSource="{x:Static steps:MouseSegmentViewModel.Choices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                          SelectedValue="{Binding SelectedMode}" Margin="0,6,0,0" />
                                                <TextBlock Text="{Binding EffectiveText}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Button Command="{Binding DataContext.BreakIntoStepsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding CanBreakIntoSteps}"
                                HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,6"
                                ToolTip="{Binding BreakIntoStepsHint}"
                                AutomationProperties.Name="Break recording into editable steps">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✂" FontSize="12" />
                                <TextBlock Text="Break into individual editable steps" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>

            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepFooterTemplate}" Focusable="False" />
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
