<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="clr-namespace:SmartMacro.Core.Models;assembly=SmartMacro.Core"
                    xmlns:steps="clr-namespace:SmartMacro.ViewModels.Steps"
                    xmlns:vision="clr-namespace:SmartMacro.Services.Vision"
                    xmlns:controls="clr-namespace:SmartMacro.Controls"
                    xmlns:conv="clr-namespace:SmartMacro.Converters">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SmartMacro;component/Views/StepEditors/StepEditorsShared.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ===================================== 1. FIND TEXT (OCR) ===================================== -->
    <DataTemplate DataType="{x:Type steps:FindTextStepViewModel}">
        <StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepHeaderTemplate}" Focusable="False"
                            Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}}" />
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SummaryBannerTemplate}" Focusable="False" />

            <Border Margin="0,8,0,0" Padding="10,8" CornerRadius="6" Background="{DynamicResource WarningSoftBrush}"
                    Visibility="{Binding OcrWarning, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{Binding OcrWarning}" TextWrapping="Wrap" FontSize="12" />
            </Border>

            <!-- SETUP TAB: 1. What to Find -->
            <Border Style="{StaticResource SetupCard}" Visibility="{Binding ShowSetupSection, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="1. WHAT TO FIND (OCR TEXT)" Style="{StaticResource SetupCardTitle}" />
                    <TextBlock Text="Text to find (separate alternatives with |)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" Tag="e.g. nice (or nice | great)"
                             AutomationProperties.Name="Text to find" />

                    <!-- 1-click {Variable} token insertion + Inspect Screen Text -->
                    <WrapPanel Margin="0,8,0,0" VerticalAlignment="Center">
                        <Button Command="{Binding InspectScreenTextCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,6"
                                ToolTip="Captures the search area, runs Windows OCR across all words on screen, highlights every match, and lets you click any word chip to select it."
                                AutomationProperties.Name="Inspect screen text">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👁" />
                                <TextBlock Text="Inspect screen text" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Content="{}{value}" Command="{Binding InsertVariableTokenCommand}" CommandParameter="value"
                                Style="{StaticResource VariableTokenChipButtonStyle}" Margin="0,0,4,6" ToolTip="Insert {value} variable token" />
                        <Button Content="{}{target}" Command="{Binding InsertVariableTokenCommand}" CommandParameter="target"
                                Style="{StaticResource VariableTokenChipButtonStyle}" Margin="0,0,6,6" ToolTip="Insert {target} variable token" />
                        <Border Padding="8,4" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center" Margin="0,0,0,6"
                                Visibility="{Binding MatchCountBadgeText, Converter={StaticResource NullToVisibility}}">
                            <TextBlock Text="{Binding MatchCountBadgeText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentHoverBrush}" />
                        </Border>
                    </WrapPanel>

                    <TextBlock Text="Matching rules" Style="{StaticResource FieldLabel}" Margin="0,6,0,2" />
                    <CheckBox Content="Match whole word only (e.g. 'art' won't match 'apart')" IsChecked="{Binding MatchWholeWord}" Margin="0,4,0,0"
                              AutomationProperties.Name="Match whole word only" />
                    <CheckBox Content="Match exact case (e.g. 'aRt' only matches 'aRt')" IsChecked="{Binding MatchCase}" Margin="0,6,0,0"
                              AutomationProperties.Name="Match exact case" />
                    <CheckBox Content="Strict exact characters (reject attached punctuation like 'nice!')" IsChecked="{Binding StrictPunctuation}" Margin="0,6,0,0"
                              AutomationProperties.Name="Strict exact characters" />
                </StackPanel>
            </Border>

            <!-- Shared Tab-Aware Cards (Setup: Scenario + Where + Action | Tune: Match Selection | Recovery: Timing + FailurePolicy) -->
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SearchCardsTemplate}" Focusable="False" />

            <!-- TUNE & MOTION TAB: OCR Accuracy, Preprocessing & Cursor Movement -->
            <Border Style="{StaticResource SetupCard}" Visibility="{Binding ShowTuneSection, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="🎛 OCR ACCURACY &amp; PREPROCESSING" Style="{StaticResource SetupCardTitle}" />
                    <TextBlock Text="Match accuracy (%)" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="134" />
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" Minimum="50" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding MinSimilarityPercent}" VerticalAlignment="Center" />
                        <controls:StudioNumberBox Grid.Column="2" Value="{Binding MinSimilarityPercent}" Unit="%" Step="1" Minimum="50" Maximum="100"
                                                  AutomationProperties.Name="Match accuracy percent" />
                    </Grid>

                    <CheckBox Content="Normalize similar characters (0/O, 1/I/l)" IsChecked="{Binding NormalizeLookAlikes}" Margin="0,10,0,0"
                              AutomationProperties.Name="Normalize similar characters" />
                    <CheckBox Content="Use Regular Expression (Regex) pattern" IsChecked="{Binding UseRegexPattern}" Margin="0,6,0,0"
                              AutomationProperties.Name="Use regex pattern" />
                    <CheckBox Content="🚀 Find-Once-Then-Track: lock onto found word as a moving image (60 FPS)" IsChecked="{Binding TrackTextAsImage}" Margin="0,6,0,0"
                              AutomationProperties.Name="Track found text as image" />

                    <TextBlock Text="Image pre-processing before OCR" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                    <ComboBox ItemsSource="{x:Static steps:FindTextStepViewModel.PreprocessModes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding Preprocess}" AutomationProperties.Name="OCR image preprocessing" />

                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SearchMovementTemplate}" Focusable="False"
                                    Margin="0,12,0,0"
                                    Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- Inline Test button only when embedded inside an If/Repeat condition -->
            <Button Command="{Binding TestCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" Style="{StaticResource TestActionButton}"
                    Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                    AutomationProperties.Name="Test detection now">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" />
                    <TextBlock Text="Test detection now" Margin="8,0,0,0" />
                </StackPanel>
            </Button>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SearchTestResultTemplate}" Focusable="False"
                            Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />

            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepFooterTemplate}" Focusable="False"
                            Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </DataTemplate>

    <!-- ===================================== 2. FIND IMAGE ===================================== -->
    <DataTemplate DataType="{x:Type steps:FindImageStepViewModel}">
        <StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepHeaderTemplate}" Focusable="False"
                            Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}}" />
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SummaryBannerTemplate}" Focusable="False" />

            <!-- SETUP TAB: 1. What to Find + Interactive Crosshair Template Preview -->
            <Border Style="{StaticResource SetupCard}" Visibility="{Binding ShowSetupSection, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="1. WHAT TO FIND (IMAGE TEMPLATE)" Style="{StaticResource SetupCardTitle}" />

                    <!-- Interactive Template Preview + Aim Reticle -->
                    <controls:OffsetCrosshairPreview Source="{Binding TemplatePreview}"
                                                     OffsetX="{Binding OffsetX}" OffsetY="{Binding OffsetY}"
                                                     Height="136" Margin="0,8,0,4"
                                                     Visibility="{Binding TemplatePreview, Converter={StaticResource NullToVisibility}}" />

                    <TextBlock Text="{Binding TemplateInfo}" Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <WrapPanel Margin="0,8,0,0">
                        <Button Command="{Binding CaptureTemplateCommand}" Margin="0,0,8,6" Style="{StaticResource PrimaryButton}"
                                ToolTip="SmartMacro hides and the screen freezes. Drag a box tightly around the button or icon to find."
                                AutomationProperties.Name="Capture image">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE722;" Style="{StaticResource IconText}" />
                                <TextBlock Text="Capture image" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding AutoTuneCommand}" Margin="0,0,8,6"
                                ToolTip="Analyzes your captured image and automatically sets the best detector, similarity, and partial-occlusion settings."
                                AutomationProperties.Name="Auto-Tune image settings">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✨" />
                                <TextBlock Text="Auto-Tune" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        <ComboBox Style="{StaticResource FreezeComboBox}" Margin="0,0,0,6" />
                    </WrapPanel>

                    <!-- Plan 10: Shared Macro Template Gallery -->
                    <Border Visibility="{Binding HasSharedTemplates, Converter={StaticResource BoolToVisibility}}"
                            Margin="0,10,0,0" Padding="10,8" CornerRadius="8"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="6,2" FontSize="11"
                                        Command="{Binding RefreshSharedTemplatesCommand}"
                                        ToolTip="Scan this macro again for captured images"
                                        AutomationProperties.Name="Refresh shared image templates">
                                    <TextBlock Text="↻" />
                                </Button>
                                <TextBlock Text="🖼 Reuse captured image from this macro" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
                            </DockPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding SharedTemplates}"
                                          SelectedItem="{Binding SelectedSharedTemplate, Mode=TwoWay}"
                                          AutomationProperties.Name="Shared templates in this macro">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="28" Height="22" CornerRadius="4" Margin="0,0,8,0"
                                                        Background="{DynamicResource SurfaceRecessedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                    <Image Source="{Binding Preview}" Stretch="Uniform" />
                                                </Border>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Label}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding DimensionsText}" Style="{StaticResource MutedText}" FontSize="10.5" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Padding="10,5" FontSize="11.5"
                                        Command="{Binding ApplySharedTemplateCommand}"
                                        ToolTip="Apply the selected image from this macro without re-capturing"
                                        AutomationProperties.Name="Use selected shared image">
                                    <TextBlock Text="Use image" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Shared Tab-Aware Cards -->
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SearchCardsTemplate}" Focusable="False" />

            <!-- TUNE & MOTION TAB: Similarity Slider, Detector Mode & Movement -->
            <Border Style="{StaticResource SetupCard}" Visibility="{Binding ShowTuneSection, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="🎛 IMAGE SIMILARITY &amp; DETECTOR TUNING" Style="{StaticResource SetupCardTitle}" />
                    <TextBlock Text="Match similarity threshold (%)" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="134" />
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" Minimum="50" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding MinSimilarityPercent}" VerticalAlignment="Center" />
                        <controls:StudioNumberBox Grid.Column="2" Value="{Binding MinSimilarityPercent}" Unit="%" Step="1" Minimum="50" Maximum="100"
                                                  AutomationProperties.Name="Match accuracy percent" />
                    </Grid>

                    <CheckBox Content="Adapt to Day/Night lighting changes (ZNCC)" IsChecked="{Binding AdaptToLighting}" Margin="0,10,0,0"
                              AutomationProperties.Name="Adapt to Day/Night lighting changes" />
                    <CheckBox Content="Match across display scales &amp; sizes (75%–150%)" IsChecked="{Binding AllowMultiScale}" Margin="0,6,0,0"
                              AutomationProperties.Name="Match across display scales and sizes" />
                    <CheckBox Content="Ignore color (match shape only)" IsChecked="{Binding IgnoreColor}" Margin="0,6,0,0"
                              AutomationProperties.Name="Ignore color" />
                    <CheckBox Content="Transparent Game UI / Edge Mode: ignore corners (round buttons)" IsChecked="{Binding IgnoreEdges}" Margin="0,6,0,0"
                              AutomationProperties.Name="Ignore the edges" />
                    <StackPanel Orientation="Horizontal" Margin="24,6,0,0" Visibility="{Binding IgnoreEdges, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Crop each edge by:" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <controls:StudioNumberBox Value="{Binding IgnoreEdgesPercent}" Unit="%" Step="1" Minimum="0" Maximum="40" Width="134"
                                                  AutomationProperties.Name="Ignore edges percent" />
                    </StackPanel>
                    <CheckBox Content="Transparent Game UI: match bright text &amp; strokes only" IsChecked="{Binding MatchForeground}" Margin="0,6,0,0"
                              AutomationProperties.Name="Ignore background and match bright text and edges" />

                    <TextBlock Text="Vision 2.0 detector mode" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                    <ComboBox ItemsSource="{x:Static steps:FindImageStepViewModel.Detectors}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding Detector}" AutomationProperties.Name="Image detector mode" />

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                            <TextBlock Text="Min visible (0 = full)" Style="{StaticResource FieldLabel}" />
                            <controls:StudioNumberBox Value="{Binding MinVisiblePercent}" Unit="%" Step="5" Minimum="0" Maximum="100"
                                                      AutomationProperties.Name="Minimum visible percent" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                            <TextBlock Text="Rotation range (±°)" Style="{StaticResource FieldLabel}" />
                            <controls:StudioNumberBox Value="{Binding RotationRangeDeg}" Unit="°" Step="5" Minimum="0" Maximum="45"
                                                      AutomationProperties.Name="Rotation tolerance in degrees" />
                        </StackPanel>
                    </Grid>

                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SearchMovementTemplate}" Focusable="False"
                                    Margin="0,12,0,0"
                                    Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- Inline Test button only when embedded inside an If/Repeat condition -->
            <Button Command="{Binding TestCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" Style="{StaticResource TestActionButton}"
                    Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                    AutomationProperties.Name="Test detection now">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" />
                    <TextBlock Text="Test detection now" Margin="8,0,0,0" />
                </StackPanel>
            </Button>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SearchTestResultTemplate}" Focusable="False"
                            Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />

            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepFooterTemplate}" Focusable="False"
                            Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </DataTemplate>

    <!-- ===================================== 3. FIND COLOR ===================================== -->
    <DataTemplate DataType="{x:Type steps:FindColorStepViewModel}">
        <StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepHeaderTemplate}" Focusable="False"
                            Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}}" />
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SummaryBannerTemplate}" Focusable="False" />

            <!-- SETUP TAB: 1. What to Find (Color Swatch, Eyedropper & Tolerance) -->
            <Border Style="{StaticResource SetupCard}" Visibility="{Binding ShowSetupSection, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="1. WHAT TO FIND (PIXEL / BLOB COLOR)" Style="{StaticResource SetupCardTitle}" />
                    <TextBlock Text="Primary Color (#RRGGBB)" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="7" Background="{Binding ColorBrush}"
                                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" ToolTip="Primary color swatch" />
                        <TextBox Grid.Column="2" Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}" MaxLength="7" Tag="#FF0000"
                                 FontFamily="{StaticResource FontFamilyMono}"
                                 AutomationProperties.Name="Color to find" />
                    </Grid>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Command="{Binding PickColorCommand}" Margin="0,0,8,6" Style="{StaticResource PrimaryButton}"
                                AutomationProperties.Name="Pick color from screen">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEF3C;" Style="{StaticResource IconText}" />
                                <TextBlock Text="Pick from screen" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <ComboBox Style="{StaticResource FreezeComboBox}" Margin="0,0,0,6" />
                    </WrapPanel>

                    <CheckBox Content="+ Add 2nd Color (match either color)" IsChecked="{Binding UseSecondaryColor}" Margin="0,6,0,0"
                              AutomationProperties.Name="+ Add 2nd Color" />
                    <StackPanel Visibility="{Binding UseSecondaryColor, Converter={StaticResource BoolToVisibility}}" Margin="0,6,0,0">
                        <TextBlock Text="2nd Color (#RRGGBB)" Style="{StaticResource FieldLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="7" Background="{Binding SecondaryColorBrush}"
                                    BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" />
                            <TextBox Grid.Column="2" Text="{Binding SecondaryColor, UpdateSourceTrigger=PropertyChanged}" MaxLength="7" Tag="#FFFFFF"
                                     FontFamily="{StaticResource FontFamilyMono}"
                                     AutomationProperties.Name="2nd Color to find" />
                            <Button Grid.Column="4" Command="{Binding PickSecondaryColorCommand}"
                                    AutomationProperties.Name="Pick 2nd color from screen">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEF3C;" Style="{StaticResource IconText}" />
                                    <TextBlock Text="Pick 2nd" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- One-click tuning presets -->
                    <TextBlock Text="Quick tolerance presets" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                    <WrapPanel>
                        <Button Command="{Binding ApplyColorPresetCommand}" CommandParameter="exact" Padding="9,4" Margin="0,0,6,6" FontSize="11.5"
                                AutomationProperties.Name="Exact UI Color preset">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✓ " Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold"
                                           Visibility="{Binding IsExactPreset, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="🎯 Exact UI (10)" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ApplyColorPresetCommand}" CommandParameter="game" Padding="9,4" Margin="0,0,6,6" FontSize="11.5"
                                AutomationProperties.Name="Game Target preset">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✓ " Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold"
                                           Visibility="{Binding IsGamePreset, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="🔴 Game Object (28)" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ApplyColorPresetCommand}" CommandParameter="glow" Padding="9,4" Margin="0,0,6,6" FontSize="11.5"
                                AutomationProperties.Name="Lighting or Glowing Object preset">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✓ " Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold"
                                           Visibility="{Binding IsGlowPreset, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="🌅 Glow / Broad (50)" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <!-- Unified Slider + StudioNumberBox for Tolerance -->
                    <TextBlock Text="Color tolerance (0 = exact, 150 = broad)" Style="{StaticResource FieldLabel}" Margin="0,4,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="134" />
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" Minimum="0" Maximum="150" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding Tolerance}" VerticalAlignment="Center"
                                AutomationProperties.Name="Color tolerance slider" />
                        <controls:StudioNumberBox Grid.Column="2" Value="{Binding Tolerance}" Unit="±" Step="2" Minimum="0" Maximum="255"
                                                  AutomationProperties.Name="Color tolerance" />
                    </Grid>

                    <CheckBox Content="Shade variation (match darker / lighter 3D shades)" IsChecked="{Binding MatchShades}" Margin="0,8,0,0"
                              AutomationProperties.Name="Shade variation" />
                </StackPanel>
            </Border>

            <!-- Shared Tab-Aware Cards -->
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SearchCardsTemplate}" Focusable="False" />

            <!-- TUNE & MOTION TAB: Blob Size, Shape Circularity & Cursor Movement -->
            <Border Style="{StaticResource SetupCard}" Visibility="{Binding ShowTuneSection, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="🎛 COLOR BLOB &amp; SHAPE FILTERING" Style="{StaticResource SetupCardTitle}" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                            <TextBlock Text="Min blob size" Style="{StaticResource FieldLabel}" />
                            <controls:StudioNumberBox Value="{Binding MinPixels}" Unit="px" Step="5" Minimum="1" Maximum="100000"
                                                      AutomationProperties.Name="Minimum size in pixels" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                            <TextBlock Text="Max blob (0 = any)" Style="{StaticResource FieldLabel}" />
                            <controls:StudioNumberBox Value="{Binding MaxPixels}" Unit="px" Step="50" Minimum="0" Maximum="1000000"
                                                      AutomationProperties.Name="Maximum size in pixels" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                            <TextBlock Text="Min roundness" Style="{StaticResource FieldLabel}" />
                            <controls:StudioNumberBox Value="{Binding MinCircularityPercent}" Unit="%" Step="5" Minimum="0" Maximum="100"
                                                      AutomationProperties.Name="Minimum roundness percent" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                            <TextBlock Text="Min fill density" Style="{StaticResource FieldLabel}" />
                            <controls:StudioNumberBox Value="{Binding MinFillPercent}" Unit="%" Step="5" Minimum="0" Maximum="100"
                                                      AutomationProperties.Name="Minimum fill density percent" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Color space" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                    <ComboBox ItemsSource="{x:Static steps:FindColorStepViewModel.ColorSpaces}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding ColorSpace}" AutomationProperties.Name="Color space" />

                    <TextBlock Text="Which matching blob to pick" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                    <ComboBox ItemsSource="{x:Static steps:FindColorStepViewModel.SelectRules}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding SelectRule}" AutomationProperties.Name="Color blob selection rule" />

                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SearchMovementTemplate}" Focusable="False"
                                    Margin="0,12,0,0"
                                    Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <WrapPanel Margin="0,12,0,0">
                <Button Command="{Binding TestCommand}" Style="{StaticResource TestActionButton}" Margin="0,0,8,6" HorizontalAlignment="Left"
                        Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                        AutomationProperties.Name="Test detection now">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" />
                        <TextBlock Text="Test detection now" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding TrackCommand}" Margin="0,0,0,6"
                        ToolTip="Follows the color inside a custom search area for 3 seconds and reports its positions and frame rate."
                        AutomationProperties.Name="Track for 3 seconds">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE916;" Style="{StaticResource IconText}" />
                        <TextBlock Text="Track for 3 s" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </WrapPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SearchTestResultTemplate}" Focusable="False"
                            Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />

            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepFooterTemplate}" Focusable="False"
                            Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </DataTemplate>

    <!-- ===================================== 4. WAIT FOR SCREEN CHANGE ===================================== -->
    <DataTemplate DataType="{x:Type steps:WaitForChangeStepViewModel}">
        <StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepHeaderTemplate}" Focusable="False" />
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SummaryBannerTemplate}" Focusable="False" />

            <!-- SETUP TAB: Area to Watch (with Radar) + Action When Changed -->
            <StackPanel Visibility="{Binding ShowSetupSection, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource SetupCard}">
                    <StackPanel>
                        <TextBlock Text="1. THE AREA TO WATCH" Style="{StaticResource SetupCardTitle}" />

                        <!-- Mini Monitor Radar for Watched Region -->
                        <controls:SearchRegionRadar Scope="CustomArea"
                                                    RegionX="{Binding RegionX}" RegionY="{Binding RegionY}"
                                                    RegionWidth="{Binding RegionWidth}" RegionHeight="{Binding RegionHeight}" />

                        <WrapPanel Margin="0,8,0,0">
                            <Button Command="{Binding PickAreaCommand}" Margin="0,0,8,6" Style="{StaticResource PrimaryButton}"
                                    AutomationProperties.Name="Pick area to watch">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B0;" Style="{StaticResource IconText}" />
                                    <TextBlock Text="Pick area" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ShowAreaCommand}" Margin="0,0,8,6"
                                    AutomationProperties.Name="Show watched area on screen">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎯" />
                                    <TextBlock Text="Show on screen" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <ComboBox Style="{StaticResource FreezeComboBox}" Margin="0,0,0,6" />
                        </WrapPanel>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Left (X)" Style="{StaticResource FieldLabel}" />
                                <controls:StudioNumberBox Value="{Binding RegionX}" Unit="px" Step="10" ShowStepper="False"
                                                          AutomationProperties.Name="Area X" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Top (Y)" Style="{StaticResource FieldLabel}" />
                                <controls:StudioNumberBox Value="{Binding RegionY}" Unit="px" Step="10" ShowStepper="False"
                                                          AutomationProperties.Name="Area Y" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,4,0,0">
                                <TextBlock Text="Width" Style="{StaticResource FieldLabel}" />
                                <controls:StudioNumberBox Value="{Binding RegionWidth}" Unit="px" Step="10" Minimum="0" ShowStepper="False"
                                                          AutomationProperties.Name="Area width" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,4,0,0">
                                <TextBlock Text="Height" Style="{StaticResource FieldLabel}" />
                                <controls:StudioNumberBox Value="{Binding RegionHeight}" Unit="px" Step="10" Minimum="0" ShowStepper="False"
                                                          AutomationProperties.Name="Area height" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SetupCard}">
                    <StackPanel>
                        <TextBlock Text="2. WHEN IT CHANGES" Style="{StaticResource SetupCardTitle}" />
                        <ComboBox ItemsSource="{x:Static steps:WaitForChangeStepViewModel.Actions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Action}" Margin="0,8,0,0" AutomationProperties.Name="When it changes" />
                        <StackPanel Visibility="{Binding UsesHold, Converter={StaticResource BoolToVisibility}}" Margin="0,6,0,0">
                            <TextBlock Text="Hold for" Style="{StaticResource FieldLabel}" />
                            <controls:StudioNumberBox Value="{Binding ActionHoldMs}" Unit="ms" Step="50" Minimum="0" Maximum="60000"
                                                      Presets="50,100,250,500"
                                                      AutomationProperties.Name="Hold time in milliseconds" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- TUNE TAB: Change Sensitivity & Pixel Tolerance -->
            <StackPanel Visibility="{Binding ShowTuneSection, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource SetupCard}">
                    <StackPanel>
                        <TextBlock Text="🎛 CHANGE SENSITIVITY &amp; NOISE FILTER" Style="{StaticResource SetupCardTitle}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                                <TextBlock Text="Min changed (%)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding MinChangedPercent, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                                         AutomationProperties.Name="How much must change in percent" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                <TextBlock Text="Color shift tol." Style="{StaticResource FieldLabel}" />
                                <controls:StudioNumberBox Value="{Binding PixelTolerance}" Unit="±" Step="2" Minimum="0" Maximum="255"
                                                          AutomationProperties.Name="Colour tolerance" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- RECOVERY & TIMING TAB: Timeout, Poll Interval & Failure Policy -->
            <StackPanel Visibility="{Binding ShowRecoverySection, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource SetupCard}">
                    <StackPanel>
                        <TextBlock Text="🛡 WATCH TIMING &amp; SELF-HEALING" Style="{StaticResource SetupCardTitle}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Wait up to" Style="{StaticResource FieldLabel}" />
                                <controls:StudioNumberBox Value="{Binding TimeoutMs}" Unit="ms" Step="250" Minimum="0" Maximum="3600000"
                                                          Presets="1000,3000,5000,10000"
                                                          AutomationProperties.Name="Wait up to in milliseconds" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Check every" Style="{StaticResource FieldLabel}" />
                                <controls:StudioNumberBox Value="{Binding CheckIntervalMs}" Unit="ms" Step="25" Minimum="10" Maximum="60000"
                                                          Presets="16,50,100,250"
                                                          AutomationProperties.Name="Check every in milliseconds" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="If nothing changes in time" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                        <ContentControl Content="{Binding FailurePolicy}" ContentTemplate="{StaticResource FailurePolicyEditorTemplate}" Focusable="False" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBlock Text="{Binding TestResult}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                       Visibility="{Binding TestResult, Converter={StaticResource NullToVisibility}}" />
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepFooterTemplate}" Focusable="False" />
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
