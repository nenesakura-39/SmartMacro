<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="clr-namespace:SmartMacro.Core.Models;assembly=SmartMacro.Core"
                    xmlns:steps="clr-namespace:SmartMacro.ViewModels.Steps"
                    xmlns:vision="clr-namespace:SmartMacro.Services.Vision"
                    xmlns:controls="clr-namespace:SmartMacro.Controls"
                    xmlns:conv="clr-namespace:SmartMacro.Converters">

    <!-- Section headers whose text comes from a view model are shown in capitals like the fixed ones. -->
    <conv:UpperCaseConverter x:Key="UpperCase" />

    <!--
        Property editors for each step type. The Content of the properties panel is the selected
        StepViewModel, and WPF picks the template below that matches its type.
    -->

    <!-- Header shared by every step: validation banners + compact description. -->
    <DataTemplate x:Key="StepHeaderTemplate" DataType="{x:Type steps:StepViewModel}">
        <StackPanel>
            <TextBlock Text="{Binding TypeInfo.Description}" Style="{StaticResource MutedText}" FontSize="11.5" />

            <Border Margin="0,8,0,0" Padding="10,8" CornerRadius="6" Background="{DynamicResource ErrorSoftBrush}"
                    BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="2,0,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding IssueText}" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" FontSize="12" />
            </Border>
            <Border Margin="0,8,0,0" Padding="10,8" CornerRadius="6" Background="{DynamicResource WarningSoftBrush}"
                    BorderBrush="{DynamicResource WarningBrush}" BorderThickness="2,0,0,0"
                    Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding IssueText}" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" FontSize="12" />
            </Border>
            <Border Height="8" />
        </StackPanel>
    </DataTemplate>

    <!-- Footer shared by every step: step notes / comment (shown in Recovery & Notes tab, or inline when a note exists). -->
    <DataTemplate x:Key="StepFooterTemplate" DataType="{x:Type steps:StepViewModel}">
        <StackPanel>
            <!-- Full Notes Card when on the Recovery & Notes tab -->
            <Border Style="{StaticResource SetupCard}" Margin="0,8,0,0"
                    Visibility="{Binding ShowRecoverySection, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="📝 STEP NOTES &amp; DOCUMENTATION" Style="{StaticResource SetupCardTitle}" />
                    <TextBlock Text="Comment (shown as a badge on the workflow canvas)" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                    <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" Tag="Add a note for yourself or collaborators…" MaxLength="500"
                             AutomationProperties.Name="Step comment" />
                </StackPanel>
            </Border>

            <!-- Compact inline note editor on Setup/Tune tabs only when a comment is already present, or 1-click button to add one -->
            <StackPanel Visibility="{Binding IsRecoveryTab, Converter={StaticResource InverseBoolToVisibility}}" Margin="0,6,0,0">
                <StackPanel Visibility="{Binding HasComment, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="📝 Step Note" Style="{StaticResource FieldLabel}" Margin="0,4,0,4" />
                    <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" Tag="A note for yourself" MaxLength="500"
                             AutomationProperties.Name="Step comment" />
                </StackPanel>
                <Button Command="{Binding SelectInspectorTabCommand}" CommandParameter="2"
                        HorizontalAlignment="Left" Padding="8,4" FontSize="11"
                        Visibility="{Binding HasComment, Converter={StaticResource InverseBoolToVisibility}}"
                        ToolTip="Switch to Notes &amp; Recovery tab to add a step comment">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📝" FontSize="11" />
                        <TextBlock Text="Add step note…" Margin="5,0,0,0" Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- X / Y fields used by several mouse steps (now powered by tactile drag-to-scrub StudioNumberBox). -->
    <DataTemplate x:Key="PositionFieldsTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                <TextBlock Text="X Position" Style="{StaticResource FieldLabel}" />
                <controls:StudioNumberBox Value="{Binding X}" Unit="px" Step="10" Minimum="-32000" Maximum="32000"
                                          AutomationProperties.Name="X position"
                                          ToolTip="Pixels from the left edge of your main monitor (drag ⟷ to scrub, Shift = 10×)." />
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                <TextBlock Text="Y Position" Style="{StaticResource FieldLabel}" />
                <controls:StudioNumberBox Value="{Binding Y}" Unit="px" Step="10" Minimum="-32000" Maximum="32000"
                                          AutomationProperties.Name="Y position"
                                          ToolTip="Pixels down from the top edge of your main monitor (drag ⟷ to scrub, Shift = 10×)." />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!--
        X / Y plus "Pick position" and "Use cursor position", shared by Move mouse, Mouse click and Scroll wheel.
        DataContext = the step editor (it has X, Y and PositionPicker).
    -->
    <DataTemplate x:Key="PositionPickerTemplate">
        <StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PositionFieldsTemplate}" Focusable="False" />
            <WrapPanel Margin="0,10,0,0">
                <Button Command="{Binding PositionPicker.PickCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,6"
                        ToolTip="SmartMacro hides; click a point on your screen to fill in X and Y automatically. Esc or right-click cancels."
                        AutomationProperties.Name="Pick position on screen">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B0;" Style="{StaticResource IconText}" />
                        <TextBlock Text="Pick position" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding PositionPicker.UseCursorCommand}" Margin="0,0,0,6"
                        ToolTip="After a 3-second countdown, uses wherever your mouse cursor is. Move the mouse to the spot during the countdown."
                        AutomationProperties.Name="Use current cursor position">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7C9;" Style="{StaticResource IconText}" />
                        <TextBlock Text="Use cursor (3 s)" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </WrapPanel>
            <Border Padding="10,6" CornerRadius="6" Background="{DynamicResource SurfaceAltBrush}" Margin="0,2,0,0"
                    Visibility="{Binding PositionPicker.Status, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{Binding PositionPicker.Status}" TextWrapping="Wrap" FontSize="12" />
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="{Binding DataContext.ScreenBoundsText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" />
                <Border Style="{StaticResource InfoHintBadgeStyle}"
                        ToolTip="X counts pixels from the left edge of your main monitor, Y from its top edge. Monitors to the left of or above the main one have negative values. Real screen pixels (Windows display scaling included).">
                    <TextBlock Text="?" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrandPrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!--
        AAA upgrade: "🎯 Pick offset from screen" + its status line. DataContext = a step editor with OffsetPicker.
    -->
    <DataTemplate x:Key="OffsetPickerTemplate">
        <StackPanel>
            <WrapPanel Margin="0,8,0,0">
                <Button Command="{Binding OffsetPicker.PickCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,6"
                        ToolTip="SmartMacro hides and finds the target the last Find step / If condition looks for, then you click the spot to use. The difference becomes Offset X / Y."
                        AutomationProperties.Name="Pick offset from screen">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B0;" Style="{StaticResource IconText}" />
                        <TextBlock Text="🎯 Pick offset from screen" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </WrapPanel>
            <Border Padding="10,6" CornerRadius="6" Background="{DynamicResource SurfaceAltBrush}" Margin="0,2,0,0"
                    Visibility="{Binding OffsetPicker.Status, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{Binding OffsetPicker.Status}" TextWrapping="Wrap" FontSize="12" />
            </Border>
        </StackPanel>
    </DataTemplate>

    <!-- AAA upgrade: Offset X / Y fields + interactive crosshair radar (DataContext has OffsetX / OffsetY). -->
    <DataTemplate x:Key="OffsetFieldsTemplate">
        <StackPanel Margin="0,6,0,0">
            <controls:OffsetCrosshairPreview OffsetX="{Binding OffsetX}" OffsetY="{Binding OffsetY}" Height="108" Margin="0,0,0,8" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                    <TextBlock Text="Offset X (+ = right)" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                    <controls:StudioNumberBox Value="{Binding OffsetX}" Unit="px" Step="5" Minimum="-10000" Maximum="10000"
                                              AutomationProperties.Name="Offset X"
                                              ToolTip="Pixels to the right of the found spot (negative = left)." />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                    <TextBlock Text="Offset Y (+ = down)" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                    <controls:StudioNumberBox Value="{Binding OffsetY}" Unit="px" Step="5" Minimum="-10000" Maximum="10000"
                                              AutomationProperties.Name="Offset Y"
                                              ToolTip="Pixels below the found spot (negative = above)." />
                </StackPanel>
            </Grid>
        </StackPanel>
    </DataTemplate>

    <!-- "Freeze:" drop-down next to Capture / Pick buttons (one setting shared by every picker). -->
    <Style x:Key="FreezeComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="ItemsSource" Value="{x:Static vision:ScreenFreezeOptions.Choices}" />
        <Setter Property="DisplayMemberPath" Value="Label" />
        <Setter Property="SelectedValuePath" Value="Seconds" />
        <Setter Property="SelectedValue" Value="{Binding Source={x:Static vision:ScreenFreezeOptions.Instance}, Path=DelaySeconds, Mode=TwoWay}" />
        <Setter Property="MinWidth" Value="185" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="ToolTip" Value="When the picker freezes the screen. Immediately: it freezes as soon as you click the button. After 3s / 5s countdown: switch to your game and SmartMacro freezes the screen when the countdown ends." />
        <Setter Property="AutomationProperties.Name" Value="When to freeze the screen" />
    </Style>

    <!-- The live plain-English summary at the top of a step ("Searches Main Monitor every 250 ms for up to 10 s…"). -->
    <DataTemplate x:Key="SummaryBannerTemplate" DataType="{x:Type steps:StepViewModel}">
        <Border Style="{StaticResource SummaryBanner}" Visibility="{Binding PlainSummary, Converter={StaticResource NullToVisibility}}"
                ToolTip="A plain-English summary of what this step will do. It updates as you change the settings below.">
            <StackPanel>
                <TextBlock Text="LIVE EXECUTION BRIEF" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrandPrimaryBrush}" />
                <TextBlock Text="{Binding PlainSummary}" TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- 2. Where to look: main monitor / a specific monitor / an app window / a custom area / all monitors + Mini Radar. -->
    <DataTemplate x:Key="SearchAreaTemplate" DataType="{x:Type steps:ScreenSearchStepViewModel}">
        <StackPanel>
            <ComboBox ItemsSource="{x:Static steps:ScreenSearchStepViewModel.Scopes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding Scope}" Margin="0,8,0,0" AutomationProperties.Name="Where to look"
                      ToolTip="Which part of the screen is searched. Main Monitor is the default: faster than all monitors, and it can't match something on a second screen by mistake." />

            <!-- Live 16:9 Mini Monitor Radar -->
            <controls:SearchRegionRadar Scope="{Binding Scope}"
                                        RegionX="{Binding RegionX}" RegionY="{Binding RegionY}"
                                        RegionWidth="{Binding RegionWidth}" RegionHeight="{Binding RegionHeight}" />

            <!-- Specific monitor -->
            <StackPanel Visibility="{Binding UsesMonitor, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Monitor" Style="{StaticResource FieldLabel}" ToolTip="Monitor 1 is your main monitor; the others are numbered left to right." />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding Monitors}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding MonitorNumber}" AutomationProperties.Name="Monitor to search"
                              ToolTip="The monitor to search. Its size is read again every time the step runs." />
                    <Button Grid.Column="1" Command="{Binding RefreshMonitorsCommand}" Margin="8,0,0,0" Padding="10,6"
                            ToolTip="Read the list of connected monitors again (after plugging one in or out)." AutomationProperties.Name="Refresh monitors">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" FontSize="12" />
                            <TextBlock Text="Refresh" Margin="6,0,0,0" FontSize="12" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- Specific app window -->
            <StackPanel Visibility="{Binding UsesWindow, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Open windows" Style="{StaticResource FieldLabel}" ToolTip="Choose the app or game window to search in." />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding WindowTitles}" SelectedItem="{Binding SelectedWindowTitle}" AutomationProperties.Name="Window to search in"
                              ToolTip="The app windows open right now. Choosing one fills in the title below." />
                    <Button Grid.Column="1" Command="{Binding RefreshWindowsCommand}" Margin="8,0,0,0" Padding="10,6"
                            ToolTip="Read the list of open windows again." AutomationProperties.Name="Refresh windows">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" FontSize="12" />
                            <TextBlock Text="Refresh" Margin="6,0,0,0" FontSize="12" />
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock Text="Window title contains" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding WindowTitle, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. Roblox" MaxLength="260"
                         AutomationProperties.Name="Window title contains" />
            </StackPanel>

            <!-- Custom area (2x2 clean grid with StudioNumberBox) -->
            <StackPanel Visibility="{Binding UsesRegion, Converter={StaticResource BoolToVisibility}}" Margin="0,6,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="Left (X)" Style="{StaticResource FieldLabel}" Margin="0,2,0,3" />
                        <controls:StudioNumberBox Value="{Binding RegionX}" Unit="px" Step="10" ShowStepper="False"
                                                  AutomationProperties.Name="Area left" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="Top (Y)" Style="{StaticResource FieldLabel}" Margin="0,2,0,3" />
                        <controls:StudioNumberBox Value="{Binding RegionY}" Unit="px" Step="10" ShowStepper="False"
                                                  AutomationProperties.Name="Area top" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,4,0,0">
                        <TextBlock Text="Width" Style="{StaticResource FieldLabel}" Margin="0,2,0,3" />
                        <controls:StudioNumberBox Value="{Binding RegionWidth}" Unit="px" Step="10" Minimum="0" ShowStepper="False"
                                                  AutomationProperties.Name="Area width" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,4,0,0">
                        <TextBlock Text="Height" Style="{StaticResource FieldLabel}" Margin="0,2,0,3" />
                        <controls:StudioNumberBox Value="{Binding RegionHeight}" Unit="px" Step="10" Minimum="0" ShowStepper="False"
                                                  AutomationProperties.Name="Area height" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <WrapPanel Margin="0,8,0,0">
                <Button Command="{Binding PickRegionCommand}" Margin="0,0,8,6"
                        ToolTip="Drag a rectangle around the part of the screen to search. Switches &quot;Where to look&quot; to Custom Area."
                        AutomationProperties.Name="Pick area on screen">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B0;" Style="{StaticResource IconText}" />
                        <TextBlock Text="Pick area" Margin="7,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ShowSearchAreaCommand}" Margin="0,0,8,6"
                        ToolTip="Outlines (cyan, dashed) exactly where this step will look right now."
                        AutomationProperties.Name="Show search area on screen">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🎯" />
                        <TextBlock Text="Highlight ROI" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
                <ComboBox Style="{StaticResource FreezeComboBox}" Margin="0,0,0,6" />
            </WrapPanel>
        </StackPanel>
    </DataTemplate>

    <!-- 4. Search timing: wait for appear / disappear, keep checking for, check every. -->
    <DataTemplate x:Key="SearchWaitTemplate" DataType="{x:Type steps:ScreenSearchStepViewModel}">
        <StackPanel>
            <StackPanel Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Wait goal" Style="{StaticResource FieldLabel}" />
                <ListBox ItemsSource="{x:Static steps:ScreenSearchStepViewModel.Goals}" DisplayMemberPath="Label" SelectedValuePath="Value"
                         SelectedValue="{Binding Goal}" Style="{StaticResource ChoiceChipListBoxStyle}"
                         AutomationProperties.Name="Wait for" />
            </StackPanel>
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                    <TextBlock Text="Keep checking for" Style="{StaticResource FieldLabel}"
                               ToolTip="How long to keep looking before giving up. 10000 = 10 seconds. 0 = look just once." />
                    <controls:StudioNumberBox Value="{Binding TimeoutMs}" Unit="ms" Step="250" Minimum="0" Maximum="3600000"
                                              Presets="0,1000,3000,5000,10000"
                                              AutomationProperties.Name="Timeout in milliseconds" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                    <TextBlock Text="Check every" Style="{StaticResource FieldLabel}"
                               ToolTip="Pause between two looks at the screen. 250 ms is quick; lower values use more CPU." />
                    <controls:StudioNumberBox Value="{Binding CheckIntervalMs}" Unit="ms" Step="25" Minimum="10" Maximum="60000"
                                              Presets="16,50,100,250,500"
                                              AutomationProperties.Name="Check interval in milliseconds" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </DataTemplate>

    <!-- v1.2 Brain: Reusable per-step Failure Policy editor (Continue, Skip next, Stop, Retry, Run recovery macro, Jump to Checkpoint). -->
    <DataTemplate x:Key="FailurePolicyEditorTemplate" DataType="{x:Type steps:FailurePolicyViewModel}">
        <StackPanel>
            <ComboBox ItemsSource="{x:Static steps:FailurePolicyViewModel.ActionChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding Action}" AutomationProperties.Name="When the time is up" />

            <!-- Retry settings -->
            <Grid Margin="0,8,0,0" Visibility="{Binding IsRetry, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                    <TextBlock Text="Retry attempts (1–20)" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                    <controls:StudioNumberBox Value="{Binding RetryCount}" Unit="×" Step="1" Minimum="1" Maximum="20"
                                              AutomationProperties.Name="Retry count" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                    <TextBlock Text="Wait before retry" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                    <controls:StudioNumberBox Value="{Binding RetryDelayMs}" Unit="ms" Step="100" Minimum="0" Maximum="60000"
                                              AutomationProperties.Name="Retry delay in milliseconds" />
                </StackPanel>
            </Grid>

            <!-- Recovery sub-macro picker -->
            <StackPanel Margin="0,8,0,0" Visibility="{Binding IsRecoveryMacro, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Recovery sub-macro" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding MacroChoices}" DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedMacroChoice}" AutomationProperties.Name="Recovery sub-macro" />
                    <Button Grid.Column="1" Command="{Binding RefreshMacrosCommand}" Margin="8,0,0,0" Padding="10,6"
                            ToolTip="Refresh macro list from library" AutomationProperties.Name="Refresh macros">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" FontSize="12" />
                    </Button>
                </Grid>
                <TextBlock Text="Or macro name" Style="{StaticResource FieldLabel}" Margin="0,6,0,2" />
                <TextBox Text="{Binding RecoveryMacroName, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. Close Popups" MaxLength="100"
                         AutomationProperties.Name="Recovery sub-macro name" />
            </StackPanel>

            <!-- Checkpoint jump target -->
            <StackPanel Margin="0,8,0,0" Visibility="{Binding IsCheckpointJump, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Checkpoint name to jump to" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                <TextBox Text="{Binding CheckpointName, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. start" MaxLength="60"
                         AutomationProperties.Name="Checkpoint name" />
            </StackPanel>

            <TextBlock Text="{Binding HelpText}" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,2" />
        </StackPanel>
    </DataTemplate>

    <!-- 3. What to do when found (essentials; movement and click timing are in Match & Motion tab). -->
    <DataTemplate x:Key="SearchResultTemplate" DataType="{x:Type steps:ScreenSearchStepViewModel}">
        <StackPanel>
            <StackPanel Visibility="{Binding WaitsForAppear, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="When found" Style="{StaticResource FieldLabel}"
                           ToolTip="What to do with what was found. Clicks happen at its CENTER (plus any offset configured in Match &amp; Motion)." />
                <ComboBox ItemsSource="{x:Static steps:ScreenSearchStepViewModel.Actions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding Action}" AutomationProperties.Name="Action when found" />
            </StackPanel>
            <StackPanel Margin="0,6,0,0" Visibility="{Binding IsHoldAction, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Hold the left button for" Style="{StaticResource FieldLabel}" />
                <controls:StudioNumberBox Value="{Binding ActionHoldMs}" Unit="ms" Step="50" Minimum="0" Maximum="60000"
                                          Presets="50,100,250,500,1000"
                                          AutomationProperties.Name="Hold time in milliseconds" />
            </StackPanel>
            <StackPanel Margin="0,6,0,0" Visibility="{Binding IsFoundKeyAction, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Key to press when found" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{x:Static steps:ScreenSearchStepViewModel.FoundKeys}" DisplayMemberPath="Name" SelectedValuePath="Code"
                          SelectedValue="{Binding FoundVirtualKey}" IsTextSearchEnabled="True" TextSearch.TextPath="Name"
                          AutomationProperties.Name="Key to press when found" />
            </StackPanel>
            <StackPanel Margin="0,6,0,0" Visibility="{Binding IsFoundTextAction, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Text to type when found" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding FoundTextToType, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" Tag="e.g. /collect or Hello"
                         AutomationProperties.Name="Text to type when found" />
            </StackPanel>
            <StackPanel Margin="0,6,0,0" Visibility="{Binding IsFoundScrollAction, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Wheel notches to scroll (1–50)" Style="{StaticResource FieldLabel}" />
                <controls:StudioNumberBox Value="{Binding FoundScrollClicks}" Unit="×" Step="1" Minimum="1" Maximum="50"
                                          AutomationProperties.Name="Wheel notches to scroll" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- Advanced Tuning & Movement (shared part): how the cursor moves, click timing, parking the cursor, offsets. -->
    <DataTemplate x:Key="SearchMovementTemplate" DataType="{x:Type steps:ScreenSearchStepViewModel}">
        <StackPanel Visibility="{Binding HasPointerAction, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Cursor trajectory style" Style="{StaticResource FieldLabel}" />
            <ComboBox ItemsSource="{x:Static steps:StepViewModel.MoveStyles}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding MoveStyle}" AutomationProperties.Name="Movement style" />

            <!-- Live Trajectory Curve Visualizer -->
            <controls:MotionCurvePreview MoveStyle="{Binding MoveStyle}" DurationMs="{Binding MoveDurationMs}" />

            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" IsEnabled="{Binding Glides}" VerticalAlignment="Bottom">
                    <TextBlock Text="Glide duration" Style="{StaticResource FieldLabel}" />
                    <controls:StudioNumberBox Value="{Binding MoveDurationMs}" Unit="ms" Step="20" Minimum="0" Maximum="10000"
                                              AutomationProperties.Name="Glide duration in milliseconds" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                    <TextBlock Text="Click hold duration" Style="{StaticResource FieldLabel}" />
                    <controls:StudioNumberBox Value="{Binding ClickHoldMs}" Unit="ms" Step="5" Minimum="0" Maximum="10000"
                                              AutomationProperties.Name="Click hold duration in milliseconds" />
                </StackPanel>
            </Grid>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                    <TextBlock Text="Wait after click" Style="{StaticResource FieldLabel}" />
                    <controls:StudioNumberBox Value="{Binding PostActionDelayMs}" Unit="ms" Step="25" Minimum="0" Maximum="60000"
                                              AutomationProperties.Name="Wait after click in milliseconds" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                    <TextBlock Text="Double-click gap" Style="{StaticResource FieldLabel}" />
                    <controls:StudioNumberBox Value="{Binding DoubleClickIntervalMs}" Unit="ms" Step="10" Minimum="0" Maximum="5000"
                                              AutomationProperties.Name="Double-click gap in milliseconds" />
                </StackPanel>
            </Grid>
            <CheckBox Content="Move cursor away after click (prevents hover glow occlusion)" IsChecked="{Binding MoveCursorAwayAfterAction}" Margin="0,10,0,0"
                      AutomationProperties.Name="Move cursor away after click" />

            <!-- Interactive Target Crosshair & Offset X / Y -->
            <TextBlock Text="TARGET AIM OFFSET" Style="{StaticResource SetupCardTitle}" Margin="0,12,0,4" />
            <controls:OffsetCrosshairPreview OffsetX="{Binding OffsetX}" OffsetY="{Binding OffsetY}" Height="104" Margin="0,2,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                    <TextBlock Text="Click offset X" Style="{StaticResource FieldLabel}" />
                    <controls:StudioNumberBox Value="{Binding OffsetX}" Unit="px" Step="5" Minimum="-10000" Maximum="10000"
                                              AutomationProperties.Name="Offset X" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                    <TextBlock Text="Click offset Y" Style="{StaticResource FieldLabel}" />
                    <controls:StudioNumberBox Value="{Binding OffsetY}" Unit="px" Step="5" Minimum="-10000" Maximum="10000"
                                              AutomationProperties.Name="Offset Y" />
                </StackPanel>
            </Grid>

            <!-- Vision 2.0 Motion Tracking, Predictive Lead & Temporal Confirmation -->
            <TextBlock Text="VISION 2.0 · MOTION &amp; PARTICLE FILTERING" Style="{StaticResource SetupCardTitle}" Margin="0,14,0,4" />
            <CheckBox Content="🏃 Track moving target across frames (2D Kalman velocity filter)" IsChecked="{Binding TrackTarget}" Margin="0,4,0,0"
                      AutomationProperties.Name="Track moving target across frames" />
            <CheckBox Content="🎯 Predictive lead click (aim where the moving target will be)" IsChecked="{Binding PredictiveClick}" Margin="0,6,0,0"
                      AutomationProperties.Name="Predictive lead click" />
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                    <TextBlock Text="Predictive lead" Style="{StaticResource FieldLabel}" />
                    <controls:StudioNumberBox Value="{Binding PredictiveLeadMs}" Unit="ms" Step="5" Minimum="0" Maximum="2000"
                                              AutomationProperties.Name="Predictive lead in milliseconds" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                    <TextBlock Text="Confirm frames" Style="{StaticResource FieldLabel}" />
                    <controls:StudioNumberBox Value="{Binding ConfirmFrames}" Unit="fr" Step="1" Minimum="1" Maximum="10"
                                              AutomationProperties.Name="Confirm frames" />
                </StackPanel>
            </Grid>
            <CheckBox Content="⚡ Only search where the screen moved (FrameBus motion mask)" IsChecked="{Binding OnlyWhereMoved}" Margin="0,8,0,0"
                      AutomationProperties.Name="Only search where the screen moved" />
        </StackPanel>
    </DataTemplate>

    <!-- Studio X Ultra Live Test Bench Result Card -->
    <DataTemplate x:Key="SearchTestResultTemplate" DataType="{x:Type steps:ScreenSearchStepViewModel}">
        <Border Margin="0,8,0,0" Padding="10,8" CornerRadius="7"
                Background="{DynamicResource SurfaceRecessedBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                Visibility="{Binding TestResult, Converter={StaticResource NullToVisibility}}">
            <StackPanel>
                <DockPanel Margin="0,0,0,4">
                    <Border Padding="6,2" CornerRadius="4" Background="#2238BDF8" BorderBrush="#5538BDF8" BorderThickness="1"
                            HorizontalAlignment="Left">
                        <TextBlock Text="{Binding TestStatusBadgeText}" FontFamily="{StaticResource FontFamilyMono}"
                                   FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrandPrimaryBrush}" />
                    </Border>
                </DockPanel>
                <TextBlock Text="{Binding TestResult}" TextWrapping="Wrap" FontSize="12" />
                <Button Command="{Binding ShowMatchCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="8,4" FontSize="12"
                        Visibility="{Binding HasTestMatch, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="Moves your mouse cursor onto the match so you can see exactly where it is. Nothing is clicked."
                        AutomationProperties.Name="Move the cursor to the match">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7C9;" Style="{StaticResource IconText}" FontSize="12" />
                        <TextBlock Text="Show me (move cursor to the match)" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- Multi-Match Selection & Counting ("Find One vs. Find All") shared across Find text / Find image / Find color -->
    <DataTemplate x:Key="SearchMatchSelectionTemplate" DataType="{x:Type steps:ScreenSearchStepViewModel}">
        <StackPanel>
            <TextBlock Text="Find mode (one vs. all matches)" Style="{StaticResource FieldLabel}" />
            <ComboBox ItemsSource="{x:Static steps:ScreenSearchStepViewModel.TargetSelectionOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding TargetSelection}" AutomationProperties.Name="Find mode one or all matches" />
            <TextBlock Text="{Binding TargetSelectionHelp}" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />

            <!-- Specific N-th match -->
            <StackPanel Margin="0,6,0,0" Visibility="{Binding IsReadingOrderNth, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Which match # to pick (1 = first in reading order)" Style="{StaticResource FieldLabel}" />
                <controls:StudioNumberBox Value="{Binding TargetMatchIndex}" Unit="#" Step="1" Minimum="1" Maximum="1000"
                                          Width="140" HorizontalAlignment="Left"
                                          AutomationProperties.Name="Target match number" />
            </StackPanel>

            <!-- Find All batch order, cap & delay -->
            <StackPanel Margin="0,6,0,0" Visibility="{Binding IsAllMatches, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Order when acting on all matches" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{x:Static steps:ScreenSearchStepViewModel.MatchOrderOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding MatchOrder}" AutomationProperties.Name="Multi-match action order" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                            <TextBlock Text="Max matches (0 = all)" Style="{StaticResource FieldLabel}" />
                            <controls:StudioNumberBox Value="{Binding MaxMatchesToActOn}" Unit="×" Step="1" Minimum="0" Maximum="1000"
                                                      AutomationProperties.Name="Maximum matches to act on" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                            <TextBlock Text="Pause between matches" Style="{StaticResource FieldLabel}" />
                            <controls:StudioNumberBox Value="{Binding BetweenMatchesDelayMs}" Unit="ms" Step="20" Minimum="0" Maximum="60000"
                                                      AutomationProperties.Name="Delay between matches in milliseconds" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>

            <!-- Minimum match count gate & variable storage -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                    <TextBlock Text="Min matches required" Style="{StaticResource FieldLabel}"
                               ToolTip="Require at least this many matches on screen before the step succeeds." />
                    <controls:StudioNumberBox Value="{Binding MinMatchCount}" Unit="×" Step="1" Minimum="1" Maximum="1000"
                                              AutomationProperties.Name="Minimum match count required" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                    <TextBlock Text="Save count to variable" Style="{StaticResource FieldLabel}"
                               ToolTip="Optional variable name to store how many matches were found on screen." />
                    <TextBox Text="{Binding CountVariableName, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. matchCount" MaxLength="40"
                             AutomationProperties.Name="Variable name to store match count" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </DataTemplate>

    <!-- Studio X Ultra Tab-Aware Search Cards (Setup / Match & Motion / Timing & Recovery) -->
    <DataTemplate x:Key="SearchCardsTemplate" DataType="{x:Type steps:ScreenSearchStepViewModel}">
        <StackPanel>
            <!-- SETUP TAB: Scenario Preset + Where to Look + Action When Found -->
            <StackPanel Visibility="{Binding ShowSetupSection, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource SetupCard}">
                    <StackPanel>
                        <TextBlock Text="✨ SMART SCENARIO PRESET (1-CLICK AUTO-TUNE)" Style="{StaticResource SetupCardTitle}" />
                        <ComboBox ItemsSource="{x:Static steps:ScreenSearchStepViewModel.Scenarios}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Scenario}" Margin="0,8,0,0" AutomationProperties.Name="Vision scenario preset"
                                  ToolTip="1-click setup for Static UI, Game HUD, Moving Objects, Busy Particles, or Fast Scrolling Text." />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SetupCard}">
                    <StackPanel>
                        <TextBlock Text="2. WHERE TO LOOK" Style="{StaticResource SetupCardTitle}" />
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SearchAreaTemplate}" Focusable="False" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SetupCard}" Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="3. ACTION WHEN FOUND" Style="{StaticResource SetupCardTitle}" />
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SearchResultTemplate}" Focusable="False" />
                    </StackPanel>
                </Border>
                <!-- When embedded inside a condition (IsStandalone == false), show Search Timing inline -->
                <Border Style="{StaticResource SetupCard}" Visibility="{Binding IsStandalone, Converter={StaticResource InverseBoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding TimingCardTitle, Converter={StaticResource UpperCase}}" Style="{StaticResource SetupCardTitle}" />
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SearchWaitTemplate}" Focusable="False" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- TUNE & MOTION TAB: Match Selection (Find One vs. Find All) -->
            <StackPanel Visibility="{Binding ShowTuneSection, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource SetupCard}">
                    <StackPanel>
                        <TextBlock Text="🎯 MATCH SELECTION &amp; COUNTING (FIND ONE VS. FIND ALL)" Style="{StaticResource SetupCardTitle}" />
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SearchMatchSelectionTemplate}" Focusable="False" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- RECOVERY & TIMING TAB: Search Timing + When Not Found Failure Policy -->
            <StackPanel Visibility="{Binding ShowRecoverySection, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource SetupCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding TimingCardTitle, Converter={StaticResource UpperCase}}" Style="{StaticResource SetupCardTitle}" />
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SearchWaitTemplate}" Focusable="False" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SetupCard}" Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="🛡 WHEN NOT FOUND &amp; SELF-HEALING RECOVERY" Style="{StaticResource SetupCardTitle}" />
                        <TextBlock Text="{Binding NotFoundLabel}" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                        <ContentControl Content="{Binding FailurePolicy}" ContentTemplate="{StaticResource FailurePolicyEditorTemplate}" Focusable="False" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!--
        Stage 3: conditions and blocks.
        A condition shows the normal Find text / image / color editor for its search settings (IsStandalone = false
        hides the parts conditions don't use), so Pick area, Capture image, Pick color and Test now work here too.
    -->
    <DataTemplate x:Key="ConditionEditorTemplate" DataType="{x:Type steps:ConditionViewModel}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Look for" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{x:Static steps:ConditionViewModel.Kinds}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding Kind}" AutomationProperties.Name="What the condition looks for" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="True when it" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding EffectiveNegateOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding Negate}" AutomationProperties.Name="Is or is not on screen" />
                </StackPanel>
            </Grid>

            <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="6" Background="{DynamicResource ErrorSoftBrush}"
                    Visibility="{Binding IsDamaged, Converter={StaticResource BoolToVisibility}}">
                <TextBlock TextWrapping="Wrap" FontSize="12"
                           Text="This condition's settings are missing or damaged. Choose what to look for above to start again." />
            </Border>

            <!-- v1.2 Brain: Variable comparison condition -->
            <Border Margin="0,12,0,0" Padding="12,10" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                    Background="{DynamicResource SurfaceAltBrush}"
                    Visibility="{Binding IsVariableCompare, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="VARIABLE COMPARISON" Style="{StaticResource SetupCardTitle}" />
                    <TextBlock Text="Variable name" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                    <TextBox Text="{Binding VariableName, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. gold or count" MaxLength="40"
                             AutomationProperties.Name="Variable name to compare" />
                    <TextBlock Text="Comparison" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{x:Static steps:ConditionViewModel.CompareOperators}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding CompareOperator}" AutomationProperties.Name="Comparison operator" />
                    <TextBlock Text="Compare against value (or {otherVar})" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding RightValue, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. 10000 or true or Ready" MaxLength="500"
                             AutomationProperties.Name="Value to compare against" />
                </StackPanel>
            </Border>

            <Border Margin="0,12,0,0" Padding="10,4,10,10" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                    Visibility="{Binding CheckEditor, Converter={StaticResource NullToVisibility}}">
                <ContentControl Content="{Binding CheckEditor}" Focusable="False" />
            </Border>

            <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding TestHint}" />
            <Border Margin="0,6,0,0" Padding="10,6" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}"
                    Visibility="{Binding TestVerdict, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{Binding TestVerdict}" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold" />
            </Border>

            <!-- v1.8 Evergreen: Compound Condition (AND / OR second condition) -->
            <Border Margin="0,12,0,0" Padding="12,10" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                    Background="{DynamicResource SurfaceAltBrush}"
                    Visibility="{Binding AllowSecondCondition, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="➕ COMBINE WITH SECOND CONDITION (AND / OR)" Style="{StaticResource SetupCardTitle}" />
                    <ComboBox ItemsSource="{x:Static steps:ConditionViewModel.CombinatorChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding SecondCombinator}" Margin="0,6,0,0"
                              AutomationProperties.Name="Second condition combinator" />

                    <StackPanel Visibility="{Binding HasSecondCondition, Converter={StaticResource BoolToVisibility}}" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Second — look for" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{x:Static steps:ConditionViewModel.Kinds}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding SecondCondition.Kind}" AutomationProperties.Name="What the second condition looks for" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="True when it" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding SecondCondition.EffectiveNegateOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding SecondCondition.Negate}" AutomationProperties.Name="Second condition is or is not" />
                            </StackPanel>
                        </Grid>

                        <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                Visibility="{Binding SecondCondition.IsVariableCompare, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="SECOND VARIABLE COMPARISON" Style="{StaticResource SetupCardTitle}" />
                                <TextBlock Text="Variable name" Style="{StaticResource FieldLabel}" Margin="0,6,0,4" />
                                <TextBox Text="{Binding SecondCondition.VariableName, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. hp or count" MaxLength="40"
                                         AutomationProperties.Name="Second condition variable name" />
                                <TextBlock Text="Comparison" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{x:Static steps:ConditionViewModel.CompareOperators}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding SecondCondition.CompareOperator}" AutomationProperties.Name="Second condition comparison operator" />
                                <TextBlock Text="Compare against value (or {otherVar})" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding SecondCondition.RightValue, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. 50 or Ready" MaxLength="500"
                                         AutomationProperties.Name="Second condition value to compare against" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,10,0,0" Padding="8,4,8,8" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                Visibility="{Binding SecondCondition.CheckEditor, Converter={StaticResource NullToVisibility}}">
                            <ContentControl Content="{Binding SecondCondition.CheckEditor}" Focusable="False" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
