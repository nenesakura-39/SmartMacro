<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="clr-namespace:SmartMacro.Core.Models;assembly=SmartMacro.Core"
                    xmlns:steps="clr-namespace:SmartMacro.ViewModels.Steps"
                    xmlns:vision="clr-namespace:SmartMacro.Services.Vision"
                    xmlns:conv="clr-namespace:SmartMacro.Converters">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SmartMacro;component/Views/StepEditors/StepEditorsShared.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <DataTemplate DataType="{x:Type steps:IfStepViewModel}">
        <StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepHeaderTemplate}" Focusable="False" />

            <Border Style="{StaticResource SetupCard}">
                <StackPanel>
                    <TextBlock Text="1 · BRANCH CONDITION" Style="{StaticResource SetupCardTitle}" />
                    <ContentControl Content="{Binding Condition}" ContentTemplate="{StaticResource ConditionEditorTemplate}" Focusable="False" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SetupCard}" Visibility="{Binding ShowsWhenFound, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="2 · WHEN FOUND ACTION (OPTIONAL)" Style="{StaticResource SetupCardTitle}"
                               ToolTip="When the image / color / text is on screen, act on the spot where it was found before the steps inside the If run." />
                    <TextBlock Text="When found, also:" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                    <ComboBox ItemsSource="{x:Static steps:IfStepViewModel.WhenFoundActions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding WhenFoundAction}" AutomationProperties.Name="When found, also" />
                    <StackPanel Visibility="{Binding HasThenAction, Converter={StaticResource BoolToVisibility}}">
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Offset X (+ = right)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding ThenOffsetX, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="Offset X" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Offset Y (+ = down)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding ThenOffsetY, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="Offset Y" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Visibility="{Binding IsThenHold, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Hold the left button for (ms)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ThenHoldMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="100" HorizontalAlignment="Left"
                                     AutomationProperties.Name="Hold time in milliseconds" />
                        </StackPanel>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource OffsetPickerTemplate}" Focusable="False" />
                    </StackPanel>
                    <TextBlock Text="{Binding ThenActionHint}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="True: the steps up to Else (or End If) run. False: the steps after Else run, or nothing if there's no Else. When the condition sees the text / image / color, a later Mouse click can use &quot;the last found spot&quot;. Turning this If off skips its whole block." />

            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepFooterTemplate}" Focusable="False" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type steps:RepeatStepViewModel}">
        <StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepHeaderTemplate}" Focusable="False" />

            <Border Style="{StaticResource SetupCard}">
                <StackPanel>
                    <TextBlock Text="1 · LOOP MODE &amp; CONDITION" Style="{StaticResource SetupCardTitle}" />
                    <TextBlock Text="Repeat mode" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                    <ComboBox ItemsSource="{x:Static steps:RepeatStepViewModel.Modes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding Mode}" AutomationProperties.Name="Repeat mode" />

                    <StackPanel Visibility="{Binding IsTimes, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Number of times" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Count, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="120" HorizontalAlignment="Left"
                                 AutomationProperties.Name="Number of times" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding UsesCondition, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding ConditionLabel}" Style="{StaticResource FieldLabel}" />
                        <ContentControl Content="{Binding Condition}" ContentTemplate="{StaticResource ConditionEditorTemplate}" Focusable="False"
                                        Visibility="{Binding Condition, Converter={StaticResource NullToVisibility}}" />
                        <TextBlock Text="Keep checking before leaving (ms)" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                        <TextBox Text="{Binding KeepCheckingForMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="120" HorizontalAlignment="Left"
                                 AutomationProperties.Name="Keep checking before leaving, in milliseconds" />
                        <TextBlock Text="{Binding KeepCheckingHint}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SetupCard}">
                <StackPanel>
                    <TextBlock Text="2 · SAFETY LIMITS &amp; TIMEOUT POLICY" Style="{StaticResource SetupCardTitle}" />
                    <TextBlock Text="{Binding LimitHint}" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Visibility="{Binding UsesCondition, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Max turns" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding MaxIterations, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                     ToolTip="The loop stops after this many turns. 0 = no turn limit (then set Max time)." AutomationProperties.Name="Max turns" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Max time (ms)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding MaxDurationMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                     ToolTip="The loop stops after running this long. 0 = no time limit." AutomationProperties.Name="Max time in milliseconds" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding MaxDurationText}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" />

                    <TextBlock Text="When a limit is reached" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{x:Static steps:RepeatStepViewModel.LimitOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding WhenLimitReached}" AutomationProperties.Name="When a limit is reached" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="The condition is checked before every turn (so a While loop may run 0 times), and checks are at least &quot;Check every&quot; apart. Example: Repeat UNTIL the reeling bar image is on screen, with a Find image &quot;Shake&quot; step set to &quot;Click its center&quot; inside. Stop, Esc and Pause work at any time inside the loop. Turning this Repeat off skips its whole block." />

            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepFooterTemplate}" Focusable="False" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type steps:BlockMarkerStepViewModel}">
        <StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepHeaderTemplate}" Focusable="False" />
            <Border Style="{StaticResource SetupCard}">
                <StackPanel>
                    <TextBlock Text="BLOCK BOUNDARY MARKER" Style="{StaticResource SetupCardTitle}" />
                    <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding DisableHint}" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepFooterTemplate}" Focusable="False" />
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
