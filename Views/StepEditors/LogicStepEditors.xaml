<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="clr-namespace:SmartMacro.Core.Models;assembly=SmartMacro.Core"
                    xmlns:steps="clr-namespace:SmartMacro.ViewModels.Steps"
                    xmlns:vision="clr-namespace:SmartMacro.Services.Vision"
                    xmlns:controls="clr-namespace:SmartMacro.Controls"
                    xmlns:conv="clr-namespace:SmartMacro.Converters">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SmartMacro;component/Views/StepEditors/StepEditorsShared.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ===================================== 1. IF CONDITION BLOCK ===================================== -->
    <DataTemplate DataType="{x:Type steps:IfStepViewModel}">
        <StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepHeaderTemplate}" Focusable="False" />

            <StackPanel Visibility="{Binding ShowSetupSection, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource SetupCard}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="🔀 CONDITION TO CHECK" Style="{StaticResource SetupCardTitle}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource InfoHintBadgeStyle}" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                    ToolTip="When this condition is true, the steps between If and Else (or End If) run. Otherwise, the steps after Else run.">
                                <TextBlock Text="?" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrandPrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </DockPanel>
                        <ContentControl Content="{Binding Condition}" ContentTemplate="{StaticResource ConditionEditorTemplate}"
                                        Focusable="False" Margin="0,8,0,0" />

                        <!-- Optional "When found, also:" action right on the matched spot -->
                        <StackPanel Visibility="{Binding ShowsWhenFound, Converter={StaticResource BoolToVisibility}}" Margin="0,12,0,0">
                            <TextBlock Text="When found, also:" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{x:Static steps:IfStepViewModel.WhenFoundActions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding WhenFoundAction}" AutomationProperties.Name="Action when condition is found" />

                            <StackPanel Visibility="{Binding IsThenHold, Converter={StaticResource BoolToVisibility}}" Margin="0,6,0,0">
                                <TextBlock Text="Hold duration" Style="{StaticResource FieldLabel}" />
                                <controls:StudioNumberBox Value="{Binding ThenHoldMs}" Unit="ms" Step="50" Minimum="0" Maximum="60000"
                                                          Presets="50,100,250,500,1000"
                                                          AutomationProperties.Name="Hold time in milliseconds" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding HasThenAction, Converter={StaticResource BoolToVisibility}}" Margin="0,6,0,0">
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource OffsetFieldsTemplate}" Focusable="False" />
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource OffsetPickerTemplate}" Focusable="False" />
                                <TextBlock Text="{Binding ThenActionHint}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepFooterTemplate}" Focusable="False" />
        </StackPanel>
    </DataTemplate>

    <!-- ===================================== 2. REPEAT LOOP BLOCK ===================================== -->
    <DataTemplate DataType="{x:Type steps:RepeatStepViewModel}">
        <StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepHeaderTemplate}" Focusable="False" />

            <StackPanel Visibility="{Binding ShowSetupSection, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource SetupCard}">
                    <StackPanel>
                        <TextBlock Text="🔁 LOOP MODE &amp; ITERATIONS" Style="{StaticResource SetupCardTitle}" />
                        <TextBlock Text="How to repeat" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                        <ListBox ItemsSource="{x:Static steps:RepeatStepViewModel.Modes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                 SelectedValue="{Binding Mode}" Style="{StaticResource ChoiceChipListBoxStyle}"
                                 AutomationProperties.Name="How to repeat" />

                        <StackPanel Visibility="{Binding IsTimes, Converter={StaticResource BoolToVisibility}}" Margin="0,6,0,0">
                            <TextBlock Text="Number of times to run" Style="{StaticResource FieldLabel}" />
                            <controls:StudioNumberBox Value="{Binding Count}" Unit="×" Step="1" Minimum="1" Maximum="100000"
                                                      Presets="2,3,5,10,25,50,100"
                                                      AutomationProperties.Name="Repeat count" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding UsesCondition, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0">
                            <TextBlock Text="{Binding ConditionLabel}" Style="{StaticResource FieldLabel}" />
                            <ContentControl Content="{Binding Condition}" ContentTemplate="{StaticResource ConditionEditorTemplate}"
                                            Focusable="False" Margin="0,6,0,0" />

                            <TextBlock Text="Keep checking condition for (before each pass)" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                            <controls:StudioNumberBox Value="{Binding KeepCheckingForMs}" Unit="ms" Step="100" Minimum="0" Maximum="600000"
                                                      Presets="0,250,1000,3000"
                                                      AutomationProperties.Name="Keep checking condition in milliseconds" />
                            <TextBlock Text="{Binding KeepCheckingHint}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                                    <TextBlock Text="Max passes (cap)" Style="{StaticResource FieldLabel}" />
                                    <controls:StudioNumberBox Value="{Binding MaxIterations}" Unit="×" Step="10" Minimum="1" Maximum="100000"
                                                              Presets="10,50,100,500,1000"
                                                              AutomationProperties.Name="Maximum passes" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                    <TextBlock Text="Max runtime (0 = none)" Style="{StaticResource FieldLabel}" />
                                    <controls:StudioNumberBox Value="{Binding MaxDurationMs}" Unit="ms" Step="1000" Minimum="0" Maximum="86400000"
                                                              Presets="0,10000,30000,60000"
                                                              AutomationProperties.Name="Maximum loop duration in milliseconds" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding MaxDurationText}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" />

                            <TextBlock Text="When a safety limit is reached" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                            <ComboBox ItemsSource="{x:Static steps:RepeatStepViewModel.LimitOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding WhenLimitReached}" AutomationProperties.Name="When safety limit is reached" />
                            <TextBlock Text="{Binding LimitHint}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepFooterTemplate}" Focusable="False" />
        </StackPanel>
    </DataTemplate>

    <!-- ===================================== 3. BLOCK MARKERS (ELSE / END IF / END REPEAT) ===================================== -->
    <DataTemplate DataType="{x:Type steps:BlockMarkerStepViewModel}">
        <StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepHeaderTemplate}" Focusable="False" />
            <Border Style="{StaticResource SetupCard}">
                <StackPanel>
                    <TextBlock Text="🔗 CONNECTED BLOCK BOUNDARY" Style="{StaticResource SetupCardTitle}" />
                    <TextBlock Text="{Binding Explanation}" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SetupCard}">
                <StackPanel>
                    <TextBlock Text="📝 STEP NOTE" Style="{StaticResource SetupCardTitle}" />
                    <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" Tag="Optional note on this block marker…"
                             MaxLength="500" Margin="0,8,0,0" AutomationProperties.Name="Step comment" />
                </StackPanel>
            </Border>
        </StackPanel>
    </DataTemplate>

    <!-- ===================================== 4. FLOW CONTROL (BREAK / CONTINUE / STOP) ===================================== -->
    <DataTemplate DataType="{x:Type steps:FlowControlStepViewModel}">
        <StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepHeaderTemplate}" Focusable="False" />

            <StackPanel Visibility="{Binding ShowSetupSection, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource SetupCard}">
                    <StackPanel>
                        <TextBlock Text="🔀 LOOP &amp; MACRO FLOW CONTROL" Style="{StaticResource SetupCardTitle}" />
                        <TextBlock Text="Action when reached" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                        <ComboBox ItemsSource="{x:Static steps:FlowControlStepViewModel.Actions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Action}" AutomationProperties.Name="Flow control action" />
                        <TextBlock Text="{Binding ActionHelp}" Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0" />

                        <TextBlock Text="Status message (optional — supports {variables})" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                        <TextBox Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="e.g. Target reached ({gold} gold), exiting loop…" MaxLength="500"
                                 AutomationProperties.Name="Flow control status message" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepFooterTemplate}" Focusable="False" />
        </StackPanel>
    </DataTemplate>

    <!-- ===================================== BEGIN GROUP ===================================== -->
    <DataTemplate DataType="{x:Type steps:BeginGroupStepViewModel}">
        <StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepHeaderTemplate}" Focusable="False" />

            <StackPanel Visibility="{Binding ShowSetupSection, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource SetupCard}">
                    <StackPanel>
                        <TextBlock Text="📂 WORKFLOW GROUP &amp; SUB-MACRO EXTRACTION" Style="{StaticResource SetupCardTitle}" />
                        <TextBlock Text="Organize related steps into a collapsible, color-coded section. Turning off this Group header disables its entire section; playback inside runs with zero overhead."
                                   Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0" />

                        <TextBlock Text="Group title" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                        <TextBox Text="{Binding GroupTitle, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="e.g. Login Sequence, Loot Sweep, Form Fill"
                                 MaxLength="200"
                                 AutomationProperties.Name="Group title" />

                        <TextBlock Text="Accent tag color" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                        <ComboBox ItemsSource="{x:Static steps:BeginGroupStepViewModel.ColorChoices}"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding ColorHex}"
                                  AutomationProperties.Name="Group accent color">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="12" Height="12" CornerRadius="6" Background="{Binding Value}" Margin="0,0,8,0"
                                                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" />
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <WrapPanel Margin="0,12,0,0">
                            <Button Style="{StaticResource GhostButton}" Margin="0,0,8,6"
                                    Command="{Binding DataContext.RunGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    ToolTip="Play only the steps inside this Group once"
                                    AutomationProperties.Name="Run group">
                                <TextBlock Text="▶ Run Group" />
                            </Button>
                            <Button Style="{StaticResource PrimaryButton}" Margin="0,0,0,6"
                                    Command="{Binding DataContext.ExtractGroupToSubMacroCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    ToolTip="Save the steps inside this Group as a reusable sub-macro and replace the Group with a Call Macro step (Ctrl+Z undoes the canvas replacement)"
                                    AutomationProperties.Name="Extract group to sub-macro">
                                <TextBlock Text="🧩 Extract Group to Sub-Macro" />
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepFooterTemplate}" Focusable="False" />
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
