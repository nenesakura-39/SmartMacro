<UserControl x:Class="SmartMacro.Views.ManualView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SmartMacro.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ManualViewModel}"
             d:DesignWidth="1100" d:DesignHeight="700">
    <UserControl.Resources>
        <!-- A key cap for the cheat-sheet ("Ctrl+K"). -->
        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1,1,1,2" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="7,2,7,3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- ===== Header ===== -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="📚 SmartMacro Studio Guide" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Guides, ready-to-run macro recipes, every shortcut and fixes for common problems. Recipes load straight into the Workflow Editor."
                       Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- ===== Search + category pills ===== -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,12">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="✕ Clear" Padding="8,4" FontSize="11" Margin="8,0,0,0"
                            Command="{Binding ClearSearchCommand}" AutomationProperties.Name="Clear the search" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ResultText}" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5"
                               VerticalAlignment="Center" Margin="12,0,0,0" />
                    <Grid>
                        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=120}" FontSize="13.5"
                                 Padding="10,7,8,7" Tag="🔍 Search guides, steps, hotkeys, or troubleshooting..."
                                 PreviewKeyDown="SearchBox_PreviewKeyDown" AutomationProperties.Name="Search the manual" />
                    </Grid>
                </DockPanel>

                <ItemsControl ItemsSource="{Binding Pills}" Margin="0,10,0,0" Focusable="False" AutomationProperties.Name="Manual categories">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button x:Name="PillButton" Content="{Binding Label}" Padding="10,3,10,4" Margin="0,0,6,4" FontSize="11.5"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding DataContext.SetCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" AutomationProperties.Name="{Binding Label}" />
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="PillButton" Property="Background" Value="{StaticResource SelectedCardBrush}" />
                                    <Setter TargetName="PillButton" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="PillButton" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ===== Guides, recipes and the cheat-sheet ===== -->
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel MaxWidth="1040" HorizontalAlignment="Stretch" Margin="0,0,6,12">

                <TextBlock Text="Nothing matches. Try fewer or other words (e.g. &quot;black&quot;, &quot;admin&quot;, &quot;loop&quot;, &quot;ctrl&quot;)."
                           Style="{StaticResource MutedText}" Margin="4,8,0,8" FontSize="13"
                           Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisibility}}" />

                <!-- ⌨️ Studio shortcut cheat-sheet (real keys; the global ones follow Settings) -->
                <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,12"
                        Visibility="{Binding ShowShortcutTable, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="⌨️ STUDIO SHORTCUT CHEAT-SHEET" Style="{StaticResource SetupCardTitle}" />
                        <TextBlock Text="Global keys (first three) can be changed in Settings → Keyboard shortcuts. Editor keys never fire while you type in a text box."
                                   Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,0,0,8" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding Shortcuts}" Focusable="False" AutomationProperties.Name="Keyboard shortcuts">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="210" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="150" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource KeyCap}">
                                                <TextBlock Text="{Binding Keys}" FontFamily="Cascadia Mono, Consolas" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Action}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12.5"
                                                       Margin="10,0,10,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding Where}" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5"
                                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Guide and recipe cards -->
                <ItemsControl ItemsSource="{Binding Articles}" Focusable="False" AutomationProperties.Name="Guides">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="ArticleCard" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,12">
                                <StackPanel>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" VerticalAlignment="Top" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding CategoryLabel}" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" />
                                        </Border>
                                        <Border x:Name="GlyphBadge" Width="34" Height="34" CornerRadius="9" Background="{StaticResource AccentSoftBrush}"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Glyph}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Margin="12,0,0,0">
                                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Summary}" Foreground="{StaticResource MutedTextBrush}" FontSize="12.5" TextWrapping="Wrap"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>

                                    <ItemsControl ItemsSource="{Binding Sections}" Margin="46,6,0,0" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,6,0,0">
                                                    <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource AccentBrush}"
                                                               Visibility="{Binding HasHeading, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,2" />
                                                    <TextBlock Text="{Binding Body}" TextWrapping="Wrap" FontSize="12.5" LineHeight="19"
                                                               Visibility="{Binding HasBody, Converter={StaticResource BoolToVisibility}}" />
                                                    <ItemsControl ItemsSource="{Binding Points}" Focusable="False" Margin="2,3,0,0"
                                                                  Visibility="{Binding HasPoints, Converter={StaticResource BoolToVisibility}}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <DockPanel Margin="0,2,0,0">
                                                                    <TextBlock DockPanel.Dock="Left" Text="•" Foreground="{StaticResource AccentBrush}" FontSize="12.5"
                                                                               Margin="0,0,8,0" />
                                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12.5" LineHeight="19"
                                                                               Foreground="{StaticResource TextBrush}" />
                                                                </DockPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Macro Recipe card: one click inserts it into the editor -->
                                    <Border x:Name="RecipeBar" Visibility="Collapsed" Margin="46,12,0,0" Padding="12,9" CornerRadius="8"
                                            Background="{StaticResource VisionSoftBrush}" BorderBrush="{StaticResource VisionAccentBrush}" BorderThickness="1">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Padding="12,6"
                                                    Command="{Binding DataContext.LoadRecipeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" AutomationProperties.Name="Load this example into the editor"
                                                    ToolTip="Adds these steps after the selected step of the macro open in the editor (or to a new macro) and opens the Editor. Ctrl+Z undoes it.">
                                                <TextBlock Text="➕ Load Example into Editor" FontWeight="SemiBold" />
                                            </Button>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="🎮 MACRO RECIPE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource VisionAccentBrush}" />
                                                <TextBlock Text="Loads as normal, editable steps. The Problems list shows what is left to set up." FontSize="11.5"
                                                           Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsRecipe}" Value="True">
                                    <Setter TargetName="RecipeBar" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="ArticleCard" Property="BorderBrush" Value="{StaticResource VisionAccentBrush}" />
                                    <Setter TargetName="GlyphBadge" Property="Background" Value="{StaticResource VisionSoftBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
