<UserControl x:Class="SmartMacro.Views.EditorPanes.ToolboxPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SmartMacro.ViewModels"
             xmlns:steps="clr-namespace:SmartMacro.ViewModels.Steps"
             xmlns:ctrl="clr-namespace:SmartMacro.Controls"
             xmlns:conv="clr-namespace:SmartMacro.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:EditorViewModel}">
    <UserControl.Resources>
        <conv:StepCategoryBrushConverter x:Key="CategoryBrush" />

        <!-- Toolbox 2-column tile -->
        <DataTemplate x:Key="ToolboxTileTemplate" DataType="{x:Type steps:StepTypeInfo}">
            <Button Style="{StaticResource ToolboxTile}" ToolTip="{Binding Description}"
                    Command="{Binding DataContext.AddStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding Kind}" AutomationProperties.Name="{Binding DisplayName}"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Add to end" Command="{Binding PlacementTarget.Tag.AddToEndCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding Kind}" ToolTip="Adds this step after the last step in the workflow." />
                        <MenuItem Header="Insert after selected" Command="{Binding PlacementTarget.Tag.InsertAfterSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding Kind}" ToolTip="Adds this step right after the selected step." />
                    </ContextMenu>
                </Button.ContextMenu>
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="24" Height="24" CornerRadius="7" HorizontalAlignment="Center"
                            Background="{Binding Kind, Converter={StaticResource CategoryBrush}, ConverterParameter=Badge}">
                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}" FontSize="12" HorizontalAlignment="Center"
                                   Foreground="{Binding Kind, Converter={StaticResource CategoryBrush}, ConverterParameter=Accent}" />
                    </Border>
                    <TextBlock Text="{Binding DisplayName}" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="TwoColumnTiles">
            <UniformGrid Columns="2" />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <!-- ===== C7: Searchable Toolbox v2 ===== -->
    <Border Style="{StaticResource GlassCard}" Padding="8,10,8,6">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="4,0,4,6">
                <TextBlock Text="Toolbox" Style="{StaticResource SectionTitle}" FontSize="13" />

                <!-- Instant Toolbox Filter -->
                <Grid Margin="0,7,0,0">
                    <ctrl:StudioIcon Kind="Search" Size="12" Foreground="{DynamicResource MutedTextBrush}"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" Panel.ZIndex="1" />
                    <TextBox Text="{Binding ToolboxFilter, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Filter steps…" Padding="25,4,22,4" FontSize="11.5"
                             AutomationProperties.Name="Filter toolbox steps" />
                    <Button Style="{StaticResource DismissButton}" Width="18" Height="18" HorizontalAlignment="Right" Margin="0,0,4,0"
                            Command="{Binding ClearToolboxFilterCommand}"
                            Visibility="{Binding HasToolboxFilter, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Clear toolbox filter" />
                </Grid>

                <DockPanel Margin="0,6,0,0">
                    <TextBlock DockPanel.Dock="Left" Text="Insert" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Border Style="{StaticResource SegmentedContainer}"
                            ToolTip="Where newly added steps are inserted">
                        <UniformGrid Rows="1">
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" Content="After selected"
                                         IsChecked="{Binding AddAfterSelected}" AutomationProperties.Name="Add after selected" />
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" Content="At end"
                                         IsChecked="{Binding AddAtEnd}" AutomationProperties.Name="Add at end" />
                        </UniformGrid>
                    </Border>
                </DockPanel>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,2,0,0">
                <StackPanel>
                    <StackPanel Visibility="{Binding HasFilteredInputSteps, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="INPUT &amp; TIMING" Style="{StaticResource ToolboxCategoryHeader}" />
                        <ItemsControl ItemsSource="{Binding FilteredInputSteps}" Focusable="False"
                                      ItemsPanel="{StaticResource TwoColumnTiles}" ItemTemplate="{StaticResource ToolboxTileTemplate}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding HasFilteredVisionSteps, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="VISION &amp; AI" Style="{StaticResource ToolboxCategoryHeader}" />
                        <ItemsControl ItemsSource="{Binding FilteredVisionSteps}" Focusable="False"
                                      ItemsPanel="{StaticResource TwoColumnTiles}" ItemTemplate="{StaticResource ToolboxTileTemplate}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding HasFilteredLogicSteps, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="LOGIC &amp; LOOPS" Style="{StaticResource ToolboxCategoryHeader}" />
                        <ItemsControl ItemsSource="{Binding FilteredLogicSteps}" Focusable="False"
                                      ItemsPanel="{StaticResource TwoColumnTiles}" ItemTemplate="{StaticResource ToolboxTileTemplate}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding HasFilteredBrainSteps, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="MEMORY &amp; SUB-MACROS" Style="{StaticResource ToolboxCategoryHeader}" />
                        <ItemsControl ItemsSource="{Binding FilteredBrainSteps}" Focusable="False"
                                      ItemsPanel="{StaticResource TwoColumnTiles}" ItemTemplate="{StaticResource ToolboxTileTemplate}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding HasFilteredUtilitySteps, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="UTILITY &amp; GAME" Style="{StaticResource ToolboxCategoryHeader}" />
                        <ItemsControl ItemsSource="{Binding FilteredUtilitySteps}" Focusable="False"
                                      ItemsPanel="{StaticResource TwoColumnTiles}" ItemTemplate="{StaticResource ToolboxTileTemplate}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
