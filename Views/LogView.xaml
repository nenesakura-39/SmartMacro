<UserControl x:Class="SmartMacro.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SmartMacro.ViewModels"
             xmlns:conv="clr-namespace:SmartMacro.Converters"
             xmlns:ctrl="clr-namespace:SmartMacro.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LogViewModel}">
    <UserControl.Resources>
        <conv:LogPillConverter x:Key="LogPill" />
        <conv:StringMatchConverter x:Key="StringMatch" />
    </UserControl.Resources>

    <DockPanel>
        <!-- ===== Header ===== -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Command="{Binding OpenFolderCommand}" Margin="0,0,6,0" ToolTip="Open the folder with the daily log files">
                    <StackPanel Orientation="Horizontal">
                        <ctrl:StudioIcon Kind="Folder" Size="13" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="Open log folder" Margin="7,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Telemetry &amp; Activity Logs" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Real-time execution telemetry, OCR matches, and system events (newest first). Automatically persisted to daily logs on this PC."
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </DockPanel>

        <!-- ===== Studio log surface v3 ===== -->
        <Border Style="{StaticResource Card}" Padding="0" Background="{DynamicResource StepsCanvasBrush}" ClipToBounds="True">
            <DockPanel>
                <!-- Toolbar: search | level filter pills | count | Copy Log / Clear Log -->
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                        CornerRadius="10,10,0,0" Padding="12,10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#16182C" Offset="0" />
                            <GradientStop Color="#101220" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource Pill}" Margin="0,0,10,0">
                                <TextBlock Text="{Binding CountText}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AccentHoverBrush}" />
                            </Border>
                            <Button Command="{Binding CopyCommand}" Margin="0,0,6,0" Padding="10,5" FontSize="12"
                                    ToolTip="Copy Log: copies the entries shown (oldest first) for bug reports" AutomationProperties.Name="Copy log">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C8;" Style="{StaticResource IconText}" FontSize="12" />
                                    <TextBlock Text="Copy Log" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource DangerButton}" Command="{Binding ClearCommand}" Padding="10,5" FontSize="12"
                                    ToolTip="Clear Log: empties this view (the daily log files are kept)" AutomationProperties.Name="Clear log">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" FontSize="12" />
                                    <TextBlock Text="Clear Log" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Grid Width="310">
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="Search telemetry entries…" Padding="30,6,28,6"
                                         AutomationProperties.Name="Search the log" />
                                <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" Foreground="{DynamicResource MutedTextBrush}"
                                           HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False" FontSize="12" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE711;" HorizontalAlignment="Right" Width="26" Height="24"
                                        Padding="4" FontSize="9" Margin="0,0,3,0" Command="{Binding ClearSearchCommand}" ToolTip="Clear search"
                                        Visibility="{Binding SearchText, Converter={StaticResource NullToVisibility}}" />
                            </Grid>
                            <Border Style="{StaticResource SegmentedContainer}" Margin="10,0,0,0" VerticalAlignment="Center"
                                    ToolTip="Show only one kind of line: INFO (blue), MATCH (violet: something was found / a condition answered), WARN (amber), ERROR (red).">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" Content="All" GroupName="LogLevel"
                                                 IsChecked="{Binding LevelFilter, Converter={StaticResource StringMatch}, ConverterParameter=All}" />
                                    <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" Content="Info" GroupName="LogLevel"
                                                 IsChecked="{Binding LevelFilter, Converter={StaticResource StringMatch}, ConverterParameter=Info}" />
                                    <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" Content="Match" GroupName="LogLevel"
                                                 IsChecked="{Binding LevelFilter, Converter={StaticResource StringMatch}, ConverterParameter=Match}" />
                                    <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" Content="Warn" GroupName="LogLevel"
                                                 IsChecked="{Binding LevelFilter, Converter={StaticResource StringMatch}, ConverterParameter=Warn}" />
                                    <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" Content="Error" GroupName="LogLevel"
                                                 IsChecked="{Binding LevelFilter, Converter={StaticResource StringMatch}, ConverterParameter=Error}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid>
                    <ListBox ItemsSource="{Binding EntriesView}" ItemContainerStyle="{StaticResource PlainListItem}" Background="Transparent" BorderThickness="0"
                             Padding="8,8,8,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             AutomationProperties.Name="Log entries">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="LogRowCard" Margin="2,2" Padding="10,6" CornerRadius="7"
                                        Background="#121426" BorderBrush="#1C2038" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="68" />
                                            <ColumnDefinition Width="68" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource SubtleTextBrush}" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                                   VerticalAlignment="Top" Margin="0,2,0,0" />
                                        <Border Grid.Column="1" Style="{StaticResource Pill}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,1,0,0"
                                                Background="{Binding Converter={StaticResource LogPill}, ConverterParameter=Soft}" MinWidth="54">
                                            <TextBlock Text="{Binding Converter={StaticResource LogPill}, ConverterParameter=Label}" FontSize="9" FontWeight="Bold"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{Binding Converter={StaticResource LogPill}, ConverterParameter=Brush}" />
                                        </Border>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" />
                                            <TextBlock Text="{Binding Details}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap"
                                                       FontFamily="{StaticResource MonoFont}" Margin="0,3,0,0"
                                                       Visibility="{Binding Details, Converter={StaticResource NullToVisibility}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="LogRowCard" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="LogRowCard" Property="Background" Value="#1A1D34" />
                                        <Setter TargetName="LogRowCard" Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <ctrl:StudioIcon Kind="Logs" Size="28" Foreground="{DynamicResource SubtleTextBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="No telemetry entries recorded yet." Foreground="{DynamicResource MutedTextBrush}" Margin="0,10,0,0" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsFilteredEmpty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="No log lines match the search / filter." Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,10" />
                        <Button Content="Clear search" Command="{Binding ClearSearchCommand}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
