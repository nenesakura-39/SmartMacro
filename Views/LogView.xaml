<UserControl x:Class="SmartMacro.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SmartMacro.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LogViewModel}">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding OpenFolderCommand}" Margin="0,0,8,0" ToolTip="Open the folder with the daily log files">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE838;" Style="{StaticResource IconText}" />
                        <TextBlock Text="Open log folder" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding CopyCommand}" Margin="0,0,8,0" ToolTip="Copy all entries (useful for bug reports)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C8;" Style="{StaticResource IconText}" />
                        <TextBlock Text="Copy all" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ClearCommand}" ToolTip="Clear this view (log files are kept)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" />
                        <TextBlock Text="Clear view" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Logs" Style="{StaticResource PageTitle}" />
                <TextBlock Text="What SmartMacro has been doing, newest first. Everything is also saved to a daily log file on this PC."
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </DockPanel>

        <Border Style="{StaticResource Card}" Padding="8">
            <Grid>
                <ListBox ItemsSource="{Binding Entries}" ItemContainerStyle="{StaticResource PlainListItem}"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Level, Converter={StaticResource LevelToGlyph}}" Style="{StaticResource IconText}" FontSize="13"
                                           Foreground="{Binding Level, Converter={StaticResource LevelToBrush}}" VerticalAlignment="Top" Margin="0,1,0,0" />
                                <TextBlock Grid.Column="1" Text="{Binding TimeText}" Foreground="{StaticResource MutedTextBrush}" />
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Details}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap"
                                               Visibility="{Binding Details, Converter={StaticResource NullToVisibility}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="No log entries yet." Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
