<UserControl x:Class="SmartMacro.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SmartMacro.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LibraryViewModel}"
             d:DesignWidth="1000" d:DesignHeight="640">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding OpenFolderCommand}" ToolTip="Open the folder where macro files are stored" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE838;" Style="{StaticResource IconText}" />
                        <TextBlock Text="Open folder" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ImportCommand}" ToolTip="Add macros from .smartmacro files (shared or backed up)" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B5;" Style="{StaticResource IconText}" />
                        <TextBlock Text="Import" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ReloadCommand}" ToolTip="Reload macros from disk" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" />
                        <TextBlock Text="Reload" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding NewCommand}" ToolTip="Create a new, empty macro">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource IconText}" />
                        <TextBlock Text="New macro" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Macro Library" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Create, organize and open your macros. Double-click a macro to edit its workflow." Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </DockPanel>

        <!-- Problem banner (files that failed to load) -->
        <Border Grid.Row="1" Margin="0,0,0,12" Padding="12,10" CornerRadius="8" Background="{StaticResource WarningSoftBrush}"
                BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                Visibility="{Binding HasLoadProblems, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Top" Margin="0,2,10,0" />
                <TextBlock Text="{Binding LoadProblemText}" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <!-- Search -->
        <DockPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Foreground="{StaticResource MutedTextBrush}"
                       VerticalAlignment="Center" Margin="12,0,0,0" />
            <Grid MaxWidth="420" HorizontalAlignment="Left">
                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="Search macros by name or description"
                         Padding="32,7,30,7" AutomationProperties.Name="Search macros" />
                <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" Foreground="{StaticResource MutedTextBrush}"
                           HorizontalAlignment="Left" Margin="11,0,0,0" IsHitTestVisible="False" />
                <Button Style="{StaticResource IconButton}" Content="&#xE711;" HorizontalAlignment="Right" Width="28" Height="26"
                        Padding="4" FontSize="10" Margin="0,0,3,0" Command="{Binding ClearSearchCommand}" ToolTip="Clear search"
                        Visibility="{Binding SearchText, Converter={StaticResource NullToVisibility}}" />
            </Grid>
        </DockPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- Macro list -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8">
                <Grid>
                    <ListBox x:Name="MacroList" ItemsSource="{Binding ItemsView}" SelectedItem="{Binding SelectedItem}" IsSynchronizedWithCurrentItem="False"
                             AutomationProperties.Name="Macros"
                             Visibility="{Binding HasVisibleItems, Converter={StaticResource BoolToVisibility}}">
                        <ListBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding OpenCommand}" />
                            <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
                        </ListBox.InputBindings>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <EventSetter Event="MouseDoubleClick" Handler="MacroItem_DoubleClick" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MacroListItemViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource SurfaceAltBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE945;" Style="{StaticResource IconText}" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="&#xEA39;" Style="{StaticResource IconText}" FontSize="12" Margin="8,0,0,0"
                                                       Foreground="{StaticResource ErrorBrush}" ToolTip="This macro has problems. Open it to see them."
                                                       Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding StepCountText}" HorizontalAlignment="Right" FontSize="12" />
                                        <TextBlock Text="{Binding ModifiedText}" HorizontalAlignment="Right" FontSize="11"
                                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE768;" Margin="10,0,0,0"
                                            Foreground="{StaticResource AccentBrush}" ToolTip="Play this macro"
                                            AutomationProperties.Name="Play macro"
                                            Command="{Binding DataContext.PlayItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Loading -->
                    <TextBlock Text="Loading macros…" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Empty library -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <Border Width="64" Height="64" CornerRadius="16" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE945;" Style="{StaticResource IconText}" FontSize="28" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Text="No macros yet" Style="{StaticResource SectionTitle}" FontSize="16" HorizontalAlignment="Center" Margin="0,16,0,0" />
                        <TextBlock Text="A macro is a list of steps such as mouse clicks, key presses and delays. Create one to start building a workflow."
                                   Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,6,0,16" />
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding NewCommand}" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource IconText}" />
                                <TextBlock Text="Create your first macro" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- No search matches -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsFilteredEmpty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" FontSize="26" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="No macros match your search." Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,10" />
                        <Button Content="Clear search" Command="{Binding ClearSearchCommand}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Details -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <TextBlock Text="Select a macro to see its details." Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />

                    <DockPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel DockPanel.Dock="Bottom">
                            <UniformGrid Columns="2" Margin="0,0,0,8">
                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding PlayItemCommand}" Margin="0,0,4,0" ToolTip="Play the saved version of this macro">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" Style="{StaticResource IconText}" />
                                        <TextBlock Text="Play" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding OpenCommand}" Margin="4,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE70F;" Style="{StaticResource IconText}" />
                                        <TextBlock Text="Edit" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                            <Button Command="{Binding ExportCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,8" ToolTip="Save this macro as a file to share or back up">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEDE1;" Style="{StaticResource IconText}" />
                                    <TextBlock Text="Export…" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <UniformGrid Columns="2">
                                <Button Command="{Binding DuplicateCommand}" Margin="0,0,4,0" ToolTip="Make a copy of this macro">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8C8;" Style="{StaticResource IconText}" />
                                        <TextBlock Text="Duplicate" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" Margin="4,0,0,0" ToolTip="Move this macro to the Trash folder">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" />
                                        <TextBlock Text="Delete" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                            <StackPanel DataContext="{Binding SelectedItem}">
                                <TextBlock Text="DETAILS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />

                                <TextBlock Text="Steps" Style="{StaticResource FieldLabel}" Margin="0,18,0,2" />
                                <TextBlock Text="{Binding StepCountText}" />
                                <TextBlock Text="Last modified" Style="{StaticResource FieldLabel}" Margin="0,12,0,2" />
                                <TextBlock Text="{Binding ModifiedText}" />
                                <TextBlock Text="Created" Style="{StaticResource FieldLabel}" Margin="0,12,0,2" />
                                <TextBlock Text="{Binding CreatedText}" />
                                <TextBlock Text="ID" Style="{StaticResource FieldLabel}" Margin="0,12,0,2" />
                                <TextBox Text="{Binding IdText, Mode=OneWay}" IsReadOnly="True" FontSize="11" Padding="6,4"
                                         Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
