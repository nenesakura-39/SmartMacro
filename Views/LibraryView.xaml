<UserControl x:Class="SmartMacro.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SmartMacro.ViewModels"
             xmlns:views="clr-namespace:SmartMacro.Views"
             xmlns:ctrl="clr-namespace:SmartMacro.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LibraryViewModel}"
             d:DesignWidth="1000" d:DesignHeight="640">
    <UserControl.Resources>
        <!-- Small action button on a macro card (icon + label, ghost style). -->
        <Style x:Key="CardActionButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,5,0" />
        </Style>
        <!-- Category pill on a macro card: colored text on its soft background. -->
        <Style x:Key="CategoryPill" TargetType="Border" BasedOn="{StaticResource Pill}">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="7,2,7,2" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Header: title | Triggers Armed, Trash, Open folder, Reload, Import .smacro, New macro ===== -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton Style="{StaticResource GhostToggle}"
                              IsChecked="{Binding DataContext.AreTriggersArmed, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                              ToolTip="Global switch for per-macro hotkeys, schedules, and window triggers"
                              Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <ctrl:StudioIcon Kind="Bolt" Size="13" Foreground="{DynamicResource WarningBrush}" />
                        <TextBlock Text="{Binding DataContext.TriggersArmedStatusText, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue='⚡ Triggers Armed'}" Margin="6,0,0,0" />
                    </StackPanel>
                </ToggleButton>
                <Button Style="{StaticResource GhostButton}" Command="{Binding AuditLibraryCommand}"
                        ToolTip="Scan every macro for broken links, dangling images, hotkey collisions, and portability warnings"
                        Margin="0,0,6,0"
                        AutomationProperties.Name="Audit library health">
                    <TextBlock Text="{Binding AuditButtonText}" />
                </Button>
                <ToggleButton Style="{StaticResource GhostToggle}"
                              IsChecked="{Binding IsTrashOpen, Mode=TwoWay}"
                              ToolTip="View and restore recently deleted macros in SmartMacro's Trash folder"
                              Margin="0,0,6,0">
                    <TextBlock Text="{Binding TrashButtonText}" />
                </ToggleButton>
                <Button Style="{StaticResource GhostButton}" Command="{Binding OpenFolderCommand}" ToolTip="Open the folder where macro files are stored" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <ctrl:StudioIcon Kind="Folder" Size="13" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="Open folder" Margin="7,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Command="{Binding ReloadCommand}" ToolTip="Reload macros from disk" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <ctrl:StudioIcon Kind="LoopRepeat" Size="13" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="Reload" Margin="7,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TestActionButton}" HorizontalAlignment="Left" Command="{Binding ImportCommand}" Margin="0,0,8,0"
                        ToolTip="Import .smacro files: add macros a friend shared with you (or your own backups). Each file is checked first; only known step types are loaded, never code."
                        AutomationProperties.Name="Import .smacro files">
                    <StackPanel Orientation="Horizontal">
                        <ctrl:StudioIcon Kind="Import" Size="13" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="Import .smacro" Margin="7,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding NewCommand}" ToolTip="Create a new, empty macro">
                    <StackPanel Orientation="Horizontal">
                        <ctrl:StudioIcon Kind="Plus" Size="13" Foreground="White" />
                        <TextBlock Text="New macro" Margin="7,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Macro Library" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Your macros as Obsidian Neon Studio cards with live Workflow Fingerprint strips. Double-click any card to edit, or play and export directly." Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </DockPanel>

        <!-- Problem banner (files that failed to load) -->
        <Border Grid.Row="1" Margin="0,0,0,12" Padding="12,10" CornerRadius="8" Background="{DynamicResource WarningSoftBrush}"
                BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                Visibility="{Binding HasLoadProblems, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Top" Margin="0,2,10,0" />
                <TextBlock Text="{Binding LoadProblemText}" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <!-- ===== Search / filter bar ===== -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12,9" Margin="0,0,0,12">
            <DockPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" Margin="12,0,0,0">
                    <TextBlock Text="{Binding CountText}" Foreground="{DynamicResource AccentHoverBrush}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" FontSize="11" />
                </Border>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="⇅ Sort:" Foreground="{DynamicResource MutedTextBrush}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding SortModes}" SelectedValue="{Binding SortMode}"
                              SelectedValuePath="Value" DisplayMemberPath="Label"
                              MinWidth="164" Padding="8,4" FontSize="11.5"
                              ToolTip="Sort macros in the library (pinned macros always stay at the top)"
                              AutomationProperties.Name="Sort macros" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="🗂 Profile:" Foreground="{DynamicResource MutedTextBrush}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding ProfileChoices}" SelectedItem="{Binding SelectedProfileFilter}"
                              MinWidth="148" Padding="8,4" FontSize="11.5"
                              ToolTip="Filter macros by app or game profile" AutomationProperties.Name="Filter by profile" />
                </StackPanel>
                <Grid MaxWidth="540" HorizontalAlignment="Left">
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Search by name, description, or category (vision, ocr, feedback, logic, input)…"
                             Padding="32,7,30,7" AutomationProperties.Name="Search macros"
                             ToolTip="Filters the cards as you type: by name or description, or by category (vision, ocr, feedback, logic, input, errors)." />
                    <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" Foreground="{DynamicResource MutedTextBrush}"
                               HorizontalAlignment="Left" Margin="11,0,0,0" IsHitTestVisible="False" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" HorizontalAlignment="Right" Width="28" Height="26"
                            Padding="4" FontSize="10" Margin="0,0,3,0" Command="{Binding ClearSearchCommand}" ToolTip="Clear search"
                            Visibility="{Binding SearchText, Converter={StaticResource NullToVisibility}}" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- ===== Trash Recovery & Library Audit Drawers ===== -->
        <StackPanel Grid.Row="3">
            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,12"
                    BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                    Visibility="{Binding IsAuditOpen, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource GhostButton}" Command="{Binding AuditLibraryCommand}"
                                    Padding="8,4" FontSize="11.5" Margin="0,0,6,0"
                                    ToolTip="Re-scan all macros in your library">
                                <TextBlock Text="↻ Re-scan" />
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Command="{Binding CloseAuditCommand}"
                                    Padding="8,4" FontSize="11.5">
                                <TextBlock Text="✕ Close" />
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🩺 LIBRARY HEALTH &amp; PORTABILITY AUDIT" FontWeight="Bold" FontSize="12"
                                       Foreground="{DynamicResource AccentHoverBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding AuditSummaryText}" Style="{StaticResource MutedText}" FontSize="11.5" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Text="✓ Every macro passed structural, sub-macro, hotkey collision, and portability checks."
                               Foreground="{DynamicResource SuccessBrush}" FontSize="12" Margin="0,4,0,2"
                               Visibility="{Binding HasAuditEntries, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />

                    <ItemsControl ItemsSource="{Binding AuditEntries}" MaxHeight="220"
                                  Visibility="{Binding HasAuditEntries, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" Padding="10,7" Margin="0,0,0,5"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                                                Padding="10,4" FontSize="11" Margin="10,0,0,0"
                                                Command="{Binding DataContext.OpenAuditEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Open this macro in the Workflow Editor">
                                            <TextBlock Text="Open ↗" />
                                        </Button>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                <TextBlock Text="{Binding SeverityIcon}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <Border Style="{StaticResource Pill}" Padding="6,1" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" />
                                                </Border>
                                                <TextBlock Text="{Binding LocationText}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== Trash Recovery Drawer ===== -->
            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,12"
                    BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                    Visibility="{Binding IsTrashOpen, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource DangerButton}" Command="{Binding EmptyTrashCommand}"
                                Visibility="{Binding HasTrashItems, Converter={StaticResource BoolToVisibility}}"
                                Padding="10,4" FontSize="11.5" Margin="0,0,6,0"
                                ToolTip="Permanently delete all macros in Trash">
                            <TextBlock Text="Empty Trash" />
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding ToggleTrashCommand}"
                                Padding="8,4" FontSize="11.5">
                            <TextBlock Text="✕ Close" />
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🗑 Recently Deleted Macros (Trash)" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center" />
                        <TextBlock Text=" · Automatically cleaned after 30 days" Style="{StaticResource MutedText}" FontSize="11.5" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>

                <TextBlock Text="Trash is empty — deleted macros appear here so you can restore them with 1 click."
                           Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,2"
                           Visibility="{Binding HasTrashItems, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />

                <ItemsControl ItemsSource="{Binding TrashItems}" MaxHeight="200"
                              Visibility="{Binding HasTrashItems, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Padding="10,7" Margin="0,0,0,5"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource TestActionButton}" Padding="10,4" FontSize="11" Margin="0,0,6,0"
                                                Command="{Binding DataContext.RestoreTrashItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Restore this macro back into your active Library">
                                            <TextBlock Text="↩ Restore" />
                                        </Button>
                                        <Button Style="{StaticResource GhostButton}" Foreground="{DynamicResource ErrorBrush}" Padding="8,4" FontSize="11"
                                                Command="{Binding DataContext.DeleteTrashItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Permanently delete this macro file">
                                            <TextBlock Text="✕ Delete Forever" />
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                                        <TextBlock Text=" · " Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding StepCountText}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{DynamicResource AccentHoverBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text=" · Deleted " Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding DeletedAtText}" FontFamily="{StaticResource MonoFont}" FontSize="11" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        </StackPanel>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- ===== Studio Macro Cards v3 ===== -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Background="{DynamicResource StepsCanvasBrush}" ClipToBounds="True">
                <Grid>
                    <ListBox x:Name="MacroList" ItemsSource="{Binding ItemsView}" SelectedItem="{Binding SelectedItem}" IsSynchronizedWithCurrentItem="False"
                             Padding="12,12,12,6" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             AutomationProperties.Name="Macros"
                             Visibility="{Binding HasVisibleItems, Converter={StaticResource BoolToVisibility}}">
                        <ListBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding OpenCommand}" />
                            <KeyBinding Key="F2" Command="{Binding BeginRenameCommand}" />
                            <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
                        </ListBox.InputBindings>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource StepCardItem}">
                                <Setter Property="Margin" Value="0,0,0,9" />
                                <EventSetter Event="MouseDoubleClick" Handler="MacroItem_DoubleClick" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MacroListItemViewModel}">
                                <Border x:Name="Card"
                                        BorderBrush="{DynamicResource StepCardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="11"
                                        ClipToBounds="True"
                                        SnapsToDevicePixels="True">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#191B30" Offset="0" />
                                            <GradientStop Color="#111322" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <!-- Top specular glass highlight rim -->
                                        <Border Height="1" VerticalAlignment="Top" Margin="10,0"
                                                Background="{DynamicResource GlassRimBorderBrush}"
                                                Opacity="0.6" IsHitTestVisible="False" />

                                        <!-- Left 4px glowing studio accent bar -->
                                        <Border x:Name="LeftAccentBar" Width="4" HorizontalAlignment="Left"
                                                CornerRadius="11,0,0,11"
                                                Background="{DynamicResource AccentBrush}" Opacity="0.85" />

                                        <Grid Margin="14,11,14,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Icon badge -->
                                            <Border Grid.RowSpan="2" Width="40" Height="40" CornerRadius="10"
                                                    Background="{DynamicResource AccentSoftBrush}"
                                                    BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                                                    VerticalAlignment="Top">
                                                <ctrl:StudioIcon Kind="Library" Size="17" Foreground="{DynamicResource AccentHoverBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Title row: name, problems, step count badge, last modified -->
                                            <DockPanel Grid.Column="1" Margin="12,0,0,0">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding ModifiedAgoText}" FontSize="11"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           Foreground="{DynamicResource SubtleTextBrush}"
                                                           VerticalAlignment="Center" Margin="10,0,0,0" ToolTip="{Binding ModifiedText}" />
                                                <Border DockPanel.Dock="Right" CornerRadius="6" Padding="8,2" Margin="8,0,0,0"
                                                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                        ToolTip="{Binding RepeatText}">
                                                    <TextBlock Text="{Binding StepCountText}" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentHoverBrush}" />
                                                </Border>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Style="{StaticResource IconButton}" Width="24" Height="24" Padding="0" Margin="0,0,6,0"
                                                            Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="{Binding PinTooltip}"
                                                            AutomationProperties.Name="Pin or unpin macro">
                                                        <TextBlock Text="{Binding PinGlyph}" FontFamily="{StaticResource UiFont}" FontSize="13" />
                                                    </Button>
                                                    <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="Bold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <Border Style="{StaticResource Pill}" Margin="8,0,0,0" Background="{DynamicResource ErrorSoftBrush}"
                                                            ToolTip="This macro has validation issues. Open it in the Editor to inspect."
                                                            Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibility}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ctrl:StudioIcon Kind="ErrorCircle" Size="10" Foreground="{DynamicResource ErrorBrush}" />
                                                            <TextBlock Text="NEEDS FIXING" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ErrorBrush}" Margin="4,0,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </DockPanel>

                                            <!-- Description + Workflow Fingerprint Strip + category pills -->
                                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,4,0,0">
                                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />

                                                <!-- Workflow Fingerprint Strip (proportional category composition bar) -->
                                                <Border Height="5" CornerRadius="2.5" Background="{DynamicResource SurfaceBrush}" Margin="0,8,0,0" ClipToBounds="True"
                                                        ToolTip="Workflow Fingerprint: proportional breakdown of Input, Vision, Logic, Brain &amp; Feedback steps"
                                                        Visibility="{Binding HasSteps, Converter={StaticResource BoolToVisibility}}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="{Binding InputWeight}" />
                                                            <ColumnDefinition Width="{Binding VisionWeight}" />
                                                            <ColumnDefinition Width="{Binding LogicWeight}" />
                                                            <ColumnDefinition Width="{Binding MemoryWeight}" />
                                                            <ColumnDefinition Width="{Binding FeedbackWeight}" />
                                                            <ColumnDefinition Width="{Binding UtilityWeight}" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="{DynamicResource InputAccentBrush}" />
                                                        <Border Grid.Column="1" Background="{DynamicResource VisionAccentBrush}" />
                                                        <Border Grid.Column="2" Background="{DynamicResource LogicAccentBrush}" />
                                                        <Border Grid.Column="3" Background="{DynamicResource MemoryAccentBrush}" />
                                                        <Border Grid.Column="4" Background="{DynamicResource FeedbackAccentBrush}" />
                                                        <Border Grid.Column="5" Background="{DynamicResource UtilityAccentBrush}" />
                                                    </Grid>
                                                </Border>

                                                <WrapPanel Margin="0,8,0,0">
                                                    <Border Style="{StaticResource CategoryPill}" Background="{DynamicResource AccentSoftBrush}" ToolTip="App / Game Profile tag"
                                                            Visibility="{Binding HasProfile, Converter={StaticResource BoolToVisibility}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="🗂 " FontSize="9" Foreground="{DynamicResource AccentBrush}" />
                                                            <TextBlock Text="{Binding ProfileName}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Style="{StaticResource CategoryPill}" Background="{DynamicResource InputSoftBrush}" ToolTip="Mouse, keyboard or recorded input"
                                                            Visibility="{Binding UsesInput, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="INPUT" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource InputAccentBrush}" />
                                                    </Border>
                                                    <Border Style="{StaticResource CategoryPill}" Background="{DynamicResource VisionSoftBrush}" ToolTip="Find image / Find color (or image / color conditions)"
                                                            Visibility="{Binding UsesVision, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="VISION" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource VisionAccentBrush}" />
                                                    </Border>
                                                    <Border Style="{StaticResource CategoryPill}" Background="{DynamicResource VisionSoftBrush}" ToolTip="Find text with OCR (or text conditions)"
                                                            Visibility="{Binding UsesOcr, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="OCR" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource VisionAccentBrush}" />
                                                    </Border>
                                                    <Border Style="{StaticResource CategoryPill}" Background="{DynamicResource FeedbackSoftBrush}" ToolTip="Feedback loop (minigame follower)"
                                                            Visibility="{Binding UsesFeedback, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="FEEDBACK LOOP" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource FeedbackAccentBrush}" />
                                                    </Border>
                                                    <Border Style="{StaticResource CategoryPill}" Background="{DynamicResource LogicSoftBrush}" ToolTip="If / Repeat blocks"
                                                            Visibility="{Binding UsesLogic, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="LOGIC" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource LogicAccentBrush}" />
                                                    </Border>
                                                    <Border Style="{StaticResource CategoryPill}" Background="{DynamicResource MemorySoftBrush}" ToolTip="Brain steps (Variables, Checkpoints, Sub-Macros, Watchers)"
                                                            Visibility="{Binding UsesMemory, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="BRAIN" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MemoryAccentBrush}" />
                                                    </Border>
                                                    <Border Style="{StaticResource CategoryPill}" Background="{DynamicResource MemorySoftBrush}" ToolTip="Variables and Background Watchers defined on this macro"
                                                            Visibility="{Binding HasBrainBadge, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="{Binding BrainBadgeText}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource MemoryAccentBrush}" />
                                                    </Border>
                                                    <Border Style="{StaticResource CategoryPill}" Background="{DynamicResource WarningSoftBrush}" ToolTip="Per-macro triggers (hotkey, schedule, or window event)"
                                                            Visibility="{Binding HasTriggerSummary, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="{Binding TriggerSummary}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" />
                                                    </Border>
                                                    <Border Style="{StaticResource CategoryPill}" Background="{DynamicResource AccentSoftBrush}" ToolTip="Uses Smart Target Intent (5-tier resilient relocation)"
                                                            Visibility="{Binding UsesIntent, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="🧭 INTENT" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                                    </Border>
                                                    <Border Style="{StaticResource CategoryPill}" Background="{DynamicResource TimingSoftBrush}" ToolTip="Humanize is on (small random click offsets and timing)"
                                                            Visibility="{Binding UsesHumanize, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="HUMANIZE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TimingAccentBrush}" />
                                                    </Border>
                                                    <Border Style="{StaticResource CategoryPill}" Background="{DynamicResource RecordedSoftBrush}" ToolTip="Bound to a target window / auto-adjusts its coordinates"
                                                            Visibility="{Binding UsesTargetWindow, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="🎯 TARGET" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource RecordedAccentBrush}" />
                                                    </Border>
                                                </WrapPanel>
                                            </StackPanel>

                                            <!-- Quick actions -->
                                            <WrapPanel Grid.Row="2" Grid.Column="1" Margin="12,9,0,0">
                                                <Button Style="{StaticResource PlayButton}" Padding="11,4" FontSize="11" Margin="0,0,6,0"
                                                        Command="{Binding DataContext.PlayItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                                        ToolTip="Play the saved version of this macro (Esc stops it)" AutomationProperties.Name="Play macro">
                                                    <TextBlock Text="▶ Play" />
                                                </Button>
                                                <Button Style="{StaticResource CardActionButton}"
                                                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                                        ToolTip="Open this macro in the Workflow Editor (or double-click the card)" AutomationProperties.Name="Edit macro">
                                                    <TextBlock Text="✏ Edit" />
                                                </Button>
                                                <Button Style="{StaticResource CardActionButton}"
                                                        Command="{Binding DataContext.DuplicateCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                                        ToolTip="Make a copy of this macro" AutomationProperties.Name="Duplicate macro">
                                                    <TextBlock Text="📋 Duplicate" />
                                                </Button>
                                                <Button Style="{StaticResource CardActionButton}"
                                                        Command="{Binding DataContext.ExportCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                                        ToolTip="Export .smacro: save this macro as one self-contained file (pictures included) to share with a friend or back up"
                                                        AutomationProperties.Name="Export macro as .smacro">
                                                    <TextBlock Text="📤 Export .smacro" />
                                                </Button>
                                                <Button Style="{StaticResource CardActionButton}" Foreground="{DynamicResource ErrorBrush}"
                                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                                        ToolTip="Move this macro to SmartMacro's Trash folder" AutomationProperties.Name="Delete macro">
                                                    <TextBlock Text="🗑 Delete" />
                                                </Button>
                                            </WrapPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=Card}" Value="True">
                                        <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
                                        <Setter TargetName="Card" Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#212440" Offset="0" />
                                                    <GradientStop Color="#16182C" Offset="1" />
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        <Setter TargetName="Card" Property="BorderThickness" Value="1.5" />
                                        <Setter TargetName="Card" Property="Background" Value="{DynamicResource SelectedCardBrush}" />
                                        <Setter TargetName="Card" Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#6366F1" BlurRadius="14" ShadowDepth="0" Opacity="0.38" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Loading -->
                    <TextBlock Text="Loading macros…" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Empty library -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <views:BrandLogo Width="72" Height="72" HorizontalAlignment="Center" />
                        <TextBlock Text="No macros yet" Style="{StaticResource SectionTitle}" FontSize="16" HorizontalAlignment="Center" Margin="0,16,0,0" />
                        <TextBlock Text="A macro is a list of steps such as mouse clicks, key presses and delays. Create one, or import a .smacro file a friend shared."
                                   Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,6,0,16" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding NewCommand}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource IconText}" />
                                    <TextBlock Text="Create your first macro" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ImportCommand}">
                                <TextBlock Text="📥 Import .smacro" />
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- No search matches -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsFilteredEmpty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" FontSize="26" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="No macros match your search." Foreground="{DynamicResource MutedTextBrush}" Margin="0,10,0,10" />
                        <Button Content="Clear search" Command="{Binding ClearSearchCommand}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Details inspector v3 ===== -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"
                                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                        <ctrl:StudioIcon Kind="Library" Size="28" Foreground="{DynamicResource SubtleTextBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Select a macro to inspect its telemetry and history."
                                   Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,10,0,0" />
                    </StackPanel>

                    <DockPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                        <!-- Sticky Hero Header -->
                        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" ClipToBounds="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#206366F1" Offset="0" />
                                    <GradientStop Color="#08000000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Border Height="2" VerticalAlignment="Top" Background="{DynamicResource AccentBrush}" Opacity="0.85" />
                                <StackPanel DataContext="{Binding SelectedItem}" Margin="14,14,14,12">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" CornerRadius="6" Padding="7,2" Background="{DynamicResource SurfaceBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StepCountText}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentHoverBrush}" />
                                        </Border>
                                        <TextBlock Text="MACRO INSPECTOR" Style="{StaticResource SetupCardTitle}" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBox x:Name="InspectorNameBox"
                                             Text="{Binding Name, Mode=OneWay}"
                                             FontSize="16.5" FontWeight="Bold"
                                             Padding="6,3" Margin="-6,6,-6,0"
                                             ToolTip="Macro name — click or press F2 to rename, press Enter to save or Esc to cancel"
                                             AutomationProperties.Name="Macro name"
                                             GotKeyboardFocus="InspectorNameBox_GotKeyboardFocus"
                                             PreviewMouseLeftButtonDown="InspectorNameBox_PreviewMouseLeftButtonDown"
                                             PreviewKeyDown="InspectorNameBox_PreviewKeyDown"
                                             LostKeyboardFocus="InspectorNameBox_LostKeyboardFocus">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border DockPanel.Dock="Bottom" Style="{StaticResource InspectorActionBar}">
                            <StackPanel>
                                <UniformGrid Columns="2" Margin="0,0,0,6">
                                    <Button Style="{StaticResource PlayButton}" Command="{Binding PlayItemCommand}" Margin="0,0,3,0" ToolTip="Play the saved version of this macro">
                                        <TextBlock Text="▶ Play" />
                                    </Button>
                                    <Button Style="{StaticResource TestActionButton}" Command="{Binding OpenCommand}" Margin="3,0,0,0" ToolTip="Open it in the Workflow Editor">
                                        <TextBlock Text="✏ Edit in Studio" />
                                    </Button>
                                </UniformGrid>
                                <Button Command="{Binding ExportCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                        ToolTip="Save this macro as one self-contained .smacro file to share or back up">
                                    <TextBlock Text="📤 Export .smacro" />
                                </Button>
                                <UniformGrid Columns="2">
                                    <Button Command="{Binding DuplicateCommand}" Margin="0,0,3,0" ToolTip="Make a copy of this macro">
                                        <TextBlock Text="📋 Duplicate" />
                                    </Button>
                                    <Button Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" Margin="3,0,0,0" ToolTip="Move this macro to the Trash folder">
                                        <TextBlock Text="🗑 Delete" />
                                    </Button>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,6,14,12">
                            <StackPanel DataContext="{Binding SelectedItem}">
                                <Border Style="{StaticResource SetupCard}">
                                    <StackPanel>
                                        <TextBlock Text="1 · WORKFLOW TELEMETRY" Style="{StaticResource SetupCardTitle}" />
                                        <TextBlock Text="{Binding StepCountText}" FontWeight="SemiBold" FontSize="13" Margin="0,8,0,0" />
                                        <TextBlock Text="{Binding RepeatText}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,0" />
                                        <Border Height="5" CornerRadius="2.5" Background="{DynamicResource SurfaceBrush}" Margin="0,10,0,0" ClipToBounds="True"
                                                Visibility="{Binding HasSteps, Converter={StaticResource BoolToVisibility}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding InputWeight}" />
                                                    <ColumnDefinition Width="{Binding VisionWeight}" />
                                                    <ColumnDefinition Width="{Binding LogicWeight}" />
                                                    <ColumnDefinition Width="{Binding MemoryWeight}" />
                                                    <ColumnDefinition Width="{Binding FeedbackWeight}" />
                                                    <ColumnDefinition Width="{Binding UtilityWeight}" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="{DynamicResource InputAccentBrush}" />
                                                <Border Grid.Column="1" Background="{DynamicResource VisionAccentBrush}" />
                                                <Border Grid.Column="2" Background="{DynamicResource LogicAccentBrush}" />
                                                <Border Grid.Column="3" Background="{DynamicResource MemoryAccentBrush}" />
                                                <Border Grid.Column="4" Background="{DynamicResource FeedbackAccentBrush}" />
                                                <Border Grid.Column="5" Background="{DynamicResource UtilityAccentBrush}" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SetupCard}">
                                    <StackPanel>
                                        <TextBlock Text="2 · TIMESTAMPS &amp; HISTORY" Style="{StaticResource SetupCardTitle}" />
                                        <TextBlock Text="Last modified" Style="{StaticResource FieldLabel}" Margin="0,8,0,2" />
                                        <TextBlock Text="{Binding ModifiedText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" />
                                        <TextBlock Text="Created" Style="{StaticResource FieldLabel}" Margin="0,8,0,2" />
                                        <TextBlock Text="{Binding CreatedText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SetupCard}">
                                    <StackPanel>
                                        <TextBlock Text="3 · MACRO IDENTIFIER" Style="{StaticResource SetupCardTitle}" />
                                        <TextBox Text="{Binding IdText, Mode=OneWay}" IsReadOnly="True"
                                                 FontFamily="{StaticResource MonoFont}" FontSize="11" Padding="7,5" Margin="0,8,0,0"
                                                 Foreground="{DynamicResource MutedTextBrush}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
