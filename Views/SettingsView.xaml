<UserControl x:Class="SmartMacro.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SmartMacro.ViewModels"
             xmlns:views="clr-namespace:SmartMacro.Views"
             xmlns:ctrl="clr-namespace:SmartMacro.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <UserControl.Resources>
        <!-- One Studio inspector card: rounded #111827 card with a colored badge header. -->
        <Style x:Key="SettingsCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="SettingsCardHeader" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
        <Style x:Key="SettingsCardBody" TargetType="StackPanel">
            <Setter Property="Margin" Value="16,6,16,14" />
        </Style>
        <!-- A setting row: switch with a wrapping label, plus a little air between rows. -->
        <Style x:Key="SettingSwitch" TargetType="CheckBox" BasedOn="{StaticResource ToggleSwitchCheckBoxStyle}">
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="SettingHelp" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,3,46,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Command="{Binding ResetCommand}" Margin="0,0,6,0" ToolTip="Put every setting back to its default (not saved until you click Save)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE777;" Style="{StaticResource IconText}" />
                        <TextBlock Text="Reset to defaults" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Command="{Binding RevertCommand}" Margin="0,0,8,0" ToolTip="Throw away the changes since the last save">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7A7;" Style="{StaticResource IconText}" />
                        <TextBlock Text="Undo changes" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" Style="{StaticResource IconText}" />
                        <TextBlock Text="Save settings" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Preferences are stored on this PC only." Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SettingsCardsStack" MaxWidth="780" HorizontalAlignment="Left">

                <!-- ===== Hero Banner Showcase: KuroLogic Custom Banner + Studio Identity ===== -->
                <Border x:Name="HeroBannerCard"
                        Style="{StaticResource SettingsCard}"
                        CornerRadius="14"
                        ClipToBounds="True"
                        BorderThickness="1">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#6622D3EE" Offset="0" />
                            <GradientStop Color="#446366F1" Offset="0.5" />
                            <GradientStop Color="#66A855F7" Offset="1" />
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <StackPanel>
                        <!-- Cinematic 16:9 Banner Stage with Zoom-Settle, Parallax & Neon Light Sweep -->
                        <Border x:Name="BannerHeroStage"
                                Height="208"
                                CornerRadius="13,13,0,0"
                                ClipToBounds="True"
                                Background="#05070E"
                                MouseMove="BannerHero_MouseMove"
                                MouseLeave="BannerHero_MouseLeave"
                                MouseLeftButtonDown="BannerHero_MouseLeftButtonDown"
                                Cursor="Hand"
                                ToolTip="Click to replay banner showcase effect">
                            <Grid>
                                <Image x:Name="BannerHeroImage"
                                       Stretch="UniformToFill"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="Linear"
                                       RenderTransformOrigin="0.5,0.5"
                                       AutomationProperties.Name="KuroLogic Studio Banner">
                                    <Image.Source>
                                        <BitmapImage UriSource="pack://application:,,,/SmartMacro;component/Assets/KuroLogic-Banner-1920x1080.png"
                                                     DecodePixelWidth="960"
                                                     CacheOption="OnLoad" />
                                    </Image.Source>
                                    <Image.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="BannerScale" ScaleX="1.0" ScaleY="1.0" />
                                            <TranslateTransform x:Name="BannerParallax" X="0" Y="0" />
                                        </TransformGroup>
                                    </Image.RenderTransform>
                                </Image>

                                <!-- Top & Bottom Cinematic Vignette -->
                                <Border IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Color="#4405070E" Offset="0" />
                                            <GradientStop Color="#0005070E" Offset="0.28" />
                                            <GradientStop Color="#0005070E" Offset="0.62" />
                                            <GradientStop Color="#EE0A0E1A" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- Diagonal Holographic Light-Sweep Shimmer -->
                                <Border x:Name="BannerLightSweep"
                                        Width="220"
                                        HorizontalAlignment="Left"
                                        IsHitTestVisible="False"
                                        Opacity="0.85">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                            <GradientStop Color="#00FFFFFF" Offset="0" />
                                            <GradientStop Color="#2222D3EE" Offset="0.35" />
                                            <GradientStop Color="#55FFFFFF" Offset="0.5" />
                                            <GradientStop Color="#22A855F7" Offset="0.65" />
                                            <GradientStop Color="#00FFFFFF" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.RenderTransform>
                                        <TransformGroup>
                                            <SkewTransform AngleX="-24" AngleY="0" />
                                            <TranslateTransform x:Name="BannerSweepTranslate" X="-360" />
                                        </TransformGroup>
                                    </Border.RenderTransform>
                                </Border>

                                <!-- Floating Corner Studio Pill Badge -->
                                <Border HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="14,12"
                                        Padding="10,4"
                                        CornerRadius="999"
                                        Background="#AA070A14"
                                        BorderBrush="#5522D3EE"
                                        BorderThickness="1"
                                        IsHitTestVisible="False">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="#22D3EE" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="KUROLOGIC STUDIO · OFFICIAL EDITION"
                                                   Foreground="#E2E8F0"
                                                   FontSize="10"
                                                   FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Bottom Neon Divider -->
                        <Border Height="1.5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#0022D3EE" Offset="0" />
                                    <GradientStop Color="#AA22D3EE" Offset="0.25" />
                                    <GradientStop Color="#AA818CF8" Offset="0.5" />
                                    <GradientStop Color="#AAA855F7" Offset="0.75" />
                                    <GradientStop Color="#00A855F7" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Studio Identity & Diagnostics Bar -->
                        <DockPanel Margin="18,14,18,14">
                            <views:BrandLogo DockPanel.Dock="Left" Width="52" Height="52" VerticalAlignment="Center" Margin="-2,0,0,0" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource GhostButton}" Command="{Binding CheckForUpdatesCommand}" Margin="0,0,8,0"
                                        ToolTip="Check the HTTPS release manifest for a newer version of SmartMacro">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE895;" Style="{StaticResource IconText}" />
                                        <TextBlock Text="Check for updates" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding CopyDiagnosticsCommand}"
                                        ToolTip="Copies version, Windows, screen and OCR info plus the recent log, for bug reports">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8C8;" Style="{StaticResource IconText}" />
                                        <TextBlock Text="Copy diagnostics" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel Margin="14,0,16,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AppName}" FontSize="17" FontWeight="Bold" />
                                    <Border Background="{DynamicResource AccentSoftBrush}"
                                            BorderBrush="{DynamicResource AccentBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="7,2"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding VersionText}"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding OwnerText}" FontWeight="SemiBold" FontSize="12" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding Tagline}" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ===== Studio X Appearance & Motion ===== -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Border Style="{StaticResource SettingsCardHeader}">
                            <DockPanel>
                                <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                                    <ctrl:StudioIcon Kind="Sparkles" Size="15" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Studio Appearance &amp; Motion" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="Customize SmartMacro Studio X's color theme, neon accent, layout density and transitions. Changes preview live."
                                               Style="{StaticResource MutedText}" FontSize="11" Margin="0,1,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <StackPanel Style="{StaticResource SettingsCardBody}">
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Studio theme" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding Themes}" SelectedValue="{Binding Theme}"
                                              SelectedValuePath="Value" DisplayMemberPath="Label"
                                              AutomationProperties.Name="Studio theme" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Layout density" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding Densities}" SelectedValue="{Binding Density}"
                                              SelectedValuePath="Value" DisplayMemberPath="Label"
                                              AutomationProperties.Name="Layout density" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Studio accent color" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                            <DockPanel>
                                <!-- Quick-click color swatches -->
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Button Width="26" Height="26" Padding="0" Margin="0,0,6,0"
                                            Command="{Binding SetAccentCommand}" CommandParameter="NeonBrand"
                                            ToolTip="Neon Brand (Sky &amp; Violet)">
                                        <Border Width="16" Height="16" CornerRadius="8">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#38BDF8" Offset="0" />
                                                    <GradientStop Color="#8B5CF6" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Button>
                                    <Button Width="26" Height="26" Padding="0" Margin="0,0,6,0"
                                            Command="{Binding SetAccentCommand}" CommandParameter="ElectricBlue"
                                            ToolTip="Electric Blue (#3B82F6)">
                                        <Border Width="16" Height="16" CornerRadius="8" Background="#3B82F6" />
                                    </Button>
                                    <Button Width="26" Height="26" Padding="0" Margin="0,0,6,0"
                                            Command="{Binding SetAccentCommand}" CommandParameter="CyberViolet"
                                            ToolTip="Cyber Violet (#8B5CF6)">
                                        <Border Width="16" Height="16" CornerRadius="8" Background="#8B5CF6" />
                                    </Button>
                                    <Button Width="26" Height="26" Padding="0" Margin="0,0,6,0"
                                            Command="{Binding SetAccentCommand}" CommandParameter="EmeraldPulse"
                                            ToolTip="Emerald Pulse (#10B981)">
                                        <Border Width="16" Height="16" CornerRadius="8" Background="#10B981" />
                                    </Button>
                                    <Button Width="26" Height="26" Padding="0"
                                            Command="{Binding SetAccentCommand}" CommandParameter="RoseQuartz"
                                            ToolTip="Rose Quartz (#F43F5E)">
                                        <Border Width="16" Height="16" CornerRadius="8" Background="#F43F5E" />
                                    </Button>
                                </StackPanel>
                                <ComboBox ItemsSource="{Binding Accents}" SelectedValue="{Binding Accent}"
                                          SelectedValuePath="Value" DisplayMemberPath="Label"
                                          AutomationProperties.Name="Studio accent color" />
                            </DockPanel>

                            <CheckBox Style="{StaticResource SettingSwitch}"
                                      Content="Reduce motion (skip page fade/slide transitions)"
                                      IsChecked="{Binding ReduceMotion}" />
                            <TextBlock Style="{StaticResource SettingHelp}"
                                       Text="SmartMacro also automatically honors Windows Accessibility → Animation effects." />

                            <TextBlock Text="Editor experience mode" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                            <ComboBox ItemsSource="{Binding ExperienceLevels}" SelectedValue="{Binding ExperienceLevel}"
                                      SelectedValuePath="Value" DisplayMemberPath="Label"
                                      AutomationProperties.Name="Editor experience mode" />
                            <TextBlock Style="{StaticResource SettingHelp}"
                                       Text="Beginner highlights 1-click Vision 2.0 scenario presets and Auto-Tune; Advanced exposes full partial-occlusion, Kalman tracking, predictive lead, and color-space controls." />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== Global Hotkeys ===== -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Border Style="{StaticResource SettingsCardHeader}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Reset shortcuts" Command="{Binding ResetShortcutsCommand}"
                                        Padding="10,4" FontSize="12" VerticalAlignment="Center" />
                                <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource InputBadgeBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE765;" Style="{StaticResource IconText}" Foreground="{DynamicResource InputAccentBrush}" HorizontalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Global Hotkeys" Style="{StaticResource SectionTitle}" FontSize="14" />
                                    <TextBlock Text="Work anywhere, even when SmartMacro is minimized." Style="{StaticResource MutedText}" FontSize="11" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <StackPanel Style="{StaticResource SettingsCardBody}">
                            <TextBlock Style="{StaticResource SettingHelp}" Margin="0,6,0,4"
                                       Text="Click a box and press the new key combination (e.g. Ctrl+Alt+R). Esc is always the emergency stop while playing." />
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="240" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="● Start / stop recording" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding RecordHotkeyText, Mode=OneWay}" Tag="Record" IsReadOnly="True"
                                         Margin="0,4" PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                         GotKeyboardFocus="HotkeyBox_GotKeyboardFocus" LostKeyboardFocus="HotkeyBox_LostKeyboardFocus"
                                         AutomationProperties.Name="Record shortcut" Cursor="Hand"
                                         FontWeight="SemiBold" />
                                <TextBlock Grid.Row="1" Text="▶ Play / stop" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PlayHotkeyText, Mode=OneWay}" Tag="Play" IsReadOnly="True"
                                         Margin="0,4" PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                         GotKeyboardFocus="HotkeyBox_GotKeyboardFocus" LostKeyboardFocus="HotkeyBox_LostKeyboardFocus"
                                         AutomationProperties.Name="Play shortcut" Cursor="Hand"
                                         FontWeight="SemiBold" />
                                <TextBlock Grid.Row="2" Text="⏸ Pause / resume (while playing)" VerticalAlignment="Center"
                                           ToolTip="F8 by default. Only active while a macro plays, so the key works normally in other apps the rest of the time. Pausing releases every held key and mouse button; Resume continues from the same step." />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PauseHotkeyText, Mode=OneWay}" Tag="Pause" IsReadOnly="True"
                                         Margin="0,4" PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                         GotKeyboardFocus="HotkeyBox_GotKeyboardFocus" LostKeyboardFocus="HotkeyBox_LostKeyboardFocus"
                                         AutomationProperties.Name="Pause shortcut" Cursor="Hand"
                                         FontWeight="SemiBold" />
                            </Grid>
                            <TextBlock Text="{Binding HotkeyError}" Foreground="{DynamicResource ErrorBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding HotkeyError, Converter={StaticResource NullToVisibility}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== Recording Defaults ===== -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Border Style="{StaticResource SettingsCardHeader}">
                            <DockPanel>
                                <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource RecordedBadgeBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE7C8;" Style="{StaticResource IconText}" Foreground="{DynamicResource RecordedAccentBrush}" HorizontalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Recording Defaults" Style="{StaticResource SectionTitle}" FontSize="14" />
                                    <TextBlock Text="How the Record button turns your input into steps." Style="{StaticResource MutedText}" FontSize="11" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <StackPanel Style="{StaticResource SettingsCardBody}">
                            <TextBlock Text="Recording mode" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                            <ComboBox ItemsSource="{Binding RecordingModes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding RecordingMode}" MaxWidth="520" HorizontalAlignment="Left"
                                      AutomationProperties.Name="Recording mode" />
                            <TextBlock Style="{StaticResource SettingHelp}" Text="{Binding RecordingModeHelp}" Margin="0,6,0,0" />

                            <TextBlock Text="Recording fidelity" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                            <ComboBox ItemsSource="{Binding RecordingFidelities}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding RecordingFidelity}" MaxWidth="520" HorizontalAlignment="Left"
                                      IsEnabled="{Binding MakesEditableSteps}" AutomationProperties.Name="Recording fidelity" />
                            <TextBlock Style="{StaticResource SettingHelp}" Text="{Binding RecordingFidelityHelp}" Margin="0,6,0,0" />
                            <TextBlock Style="{StaticResource SettingHelp}" Margin="0,2,0,0"
                                       Text="Applies to the editable steps of Smart and Desktop recordings. Camera parts, Game mode and Exact 1:1 / Rhythm always keep every event." />
                            <CheckBox Style="{StaticResource SettingSwitch}" IsChecked="{Binding UseRelativeMouseDeltas}" IsEnabled="{Binding MakesEditableSteps}"
                                      Content="🎮 Use relative mouse deltas for 3D camera" AutomationProperties.Name="Use relative mouse deltas for 3D camera"
                                      ToolTip="Every recorded mouse movement plays as a relative move (dx, dy), and clicks happen where the cursor is: for shift-lock, first-person and other games that lock the cursor in the middle." />
                            <TextBlock Style="{StaticResource SettingHelp}"
                                       Text="Off (recommended): moves and drags play at their exact screen positions, so dragging items, sliders or a map never drifts. Every Move step still remembers its dx / dy, so you can switch one step to relative in the editor." />
                            <CheckBox Style="{StaticResource SettingSwitch}" IsChecked="{Binding CaptureClickSnapshots}" IsEnabled="{Binding MakesEditableSteps}"
                                      Content="✨ Smart Click Snapshots: save a small picture of what I click" AutomationProperties.Name="Smart Click Snapshots"
                                      ToolTip="Every recorded click keeps a 56×56 picture of what was under the cursor. The editor shows it, Smart-Aim can find the button again if it moved a little, and one click turns the step into a 'Find image &amp; click'. The pictures are saved inside the macro file, so turn this off if your screen shows private things while you record." />
                            <CheckBox Style="{StaticResource SettingSwitch}" IsChecked="{Binding CaptureClickIntent}" IsEnabled="{Binding MakesEditableSteps}"
                                      Content="🧭 Intent Recording: remember UI buttons, text &amp; windows when I click" AutomationProperties.Name="Intent Recording"
                                      ToolTip="Off the input hook thread, SmartMacro records the clicked UI control (name / AutomationId), nearby screen text and window position so playback can relocate the target even if the window moves, resizes or rescales." />
                            <CheckBox Style="{StaticResource SettingSwitch}" IsChecked="{Binding SmartTimingOnRecord}" IsEnabled="{Binding MakesEditableSteps}"
                                      Content="⏱ Smart Timing: turn pauses after clicks into adaptive 'Until screen settles' waits" AutomationProperties.Name="Smart Timing"
                                      ToolTip="Pauses of 150 ms or longer right after a click become adaptive waits: playback continues early as soon as the UI stops changing, or waits safely up to 3× longer when a page or dialog loads slowly." />
                            <CheckBox Style="{StaticResource SettingSwitch}" IsChecked="{Binding CoalesceTypedTextOnRecord}" IsEnabled="{Binding MakesEditableSteps}"
                                      Content="⌨ Smart Typing: group typed words &amp; sentences into 'Type text' steps" AutomationProperties.Name="Smart Typing"
                                      ToolTip="Consecutive printable keystrokes (letters, numbers, spaces, punctuation, Shift casing, and Backspace corrections) are automatically merged into clean 'Type text' steps, while single game keys (WASD, Space) and shortcuts (Ctrl+C) stay individual KeyPress steps." />

                            <TextBlock Text="Default length of new Delay steps (ms)" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
                            <TextBox Text="{Binding DefaultDelayMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="140" HorizontalAlignment="Left"
                                     AutomationProperties.Name="Default delay in milliseconds" />
                            <TextBlock Text="{Binding DelayError}" Foreground="{DynamicResource ErrorBrush}" FontSize="12" Margin="0,4,0,0"
                                       Visibility="{Binding DelayError, Converter={StaticResource NullToVisibility}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== Playback & Safety ===== -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Border Style="{StaticResource SettingsCardHeader}">
                            <DockPanel>
                                <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource FeedbackBadgeBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE83D;" Style="{StaticResource IconText}" Foreground="{DynamicResource FeedbackAccentBrush}" HorizontalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Playback &amp; Safety" Style="{StaticResource SectionTitle}" FontSize="14" />
                                    <TextBlock Text="What SmartMacro does while a macro plays." Style="{StaticResource MutedText}" FontSize="11" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <StackPanel Style="{StaticResource SettingsCardBody}">
                            <Border Margin="0,8,0,2" Padding="10,8" CornerRadius="6" Background="{DynamicResource SuccessSoftBrush}">
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextBrush}"
                                           Text="🛡 Failsafe is always on: when playback finishes, is stopped (Esc / hotkey), times out or hits an error, every key and mouse button SmartMacro is still holding is released, so nothing stays stuck down in a game." />
                            </Border>
                            <CheckBox Style="{StaticResource SettingSwitch}" IsChecked="{Binding MinimizeDuringRun}"
                                      Content="Minimize SmartMacro while recording or playing" AutomationProperties.Name="Minimize while running" />
                            <CheckBox Style="{StaticResource SettingSwitch}" IsChecked="{Binding MinimizeToTrayOnClose}"
                                      Content="⚡ Resident Tray Mode: keep SmartMacro in the system tray when closing the window"
                                      AutomationProperties.Name="Keep in system tray when closing" />
                            <TextBlock Style="{StaticResource SettingHelp}" Text="Keeps per-macro hotkeys, schedules and window triggers armed in the background. Right-click the SmartMacro tray icon anytime to pause triggers or exit completely." />
                            <CheckBox Style="{StaticResource SettingSwitch}" IsChecked="{Binding StartWithWindows}"
                                      Content="🚀 Launch SmartMacro when Windows starts (minimized to system tray)"
                                      AutomationProperties.Name="Launch when Windows starts" />
                            <TextBlock Style="{StaticResource SettingHelp}" Text="Starts SmartMacro quietly in the Windows notification area (--tray) when you sign in so your hotkeys and schedules are always ready." />
                            <CheckBox Style="{StaticResource SettingSwitch}" IsChecked="{Binding AutoSwitchProfileByWindow}"
                                      Content="🗂 Auto-Switch Profile by Active Window"
                                      AutomationProperties.Name="Auto switch profile by active window" />
                            <TextBlock Style="{StaticResource SettingHelp}" Text="When ON, macros tagged with a Profile (e.g. 'Excel' or 'Elden Ring') only fire their shortcuts when that app or game window is focused." />

                            <!-- Profile Routing Rules Manager -->
                            <Border Margin="0,10,0,6" Padding="12" CornerRadius="8"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Padding="10,5"
                                                Command="{Binding AddProfileRuleCommand}"
                                                ToolTip="Add a custom Window Title / Process Name → Profile routing rule">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE710;" Style="{StaticResource IconText}" FontSize="12" />
                                                <TextBlock Text="Add rule" Margin="6,0,0,0" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                        <StackPanel>
                                            <TextBlock Text="PROFILE ROUTING RULES (PRIORITY ORDER)" Style="{StaticResource SetupCardTitle}" Margin="0" />
                                            <TextBlock Text="Matched top-to-bottom when switching apps. Process name (e.g. Code, chrome) works even when tab or document titles change."
                                                       Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,2,10,0" />
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Live foreground readout & preview -->
                                    <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="6"
                                            Background="{DynamicResource StepCardBrush}"
                                            BorderBrush="{DynamicResource StepCardBorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="4" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Detected app:" Style="{StaticResource MutedText}" FontSize="11.5" />
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding LiveForegroundDisplay}" FontSize="11.5"
                                                       FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Resolved profile:" Style="{StaticResource MutedText}" FontSize="11.5" />
                                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding LiveResolvedProfileDisplay}" FontSize="11.5"
                                                       Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>

                                    <!-- Open window picker -->
                                    <DockPanel Margin="0,10,0,0">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                                            <Button Style="{StaticResource GhostButton}" Padding="8,5"
                                                    Command="{Binding RefreshWindowContextCommand}"
                                                    ToolTip="Refresh list of currently open desktop windows"
                                                    AutomationProperties.Name="Refresh open windows">
                                                <TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" FontSize="12" />
                                            </Button>
                                            <Button Style="{StaticResource GhostButton}" Padding="9,5" Margin="6,0,0,0"
                                                    Command="{Binding AddRuleFromWindowProcessCommand}"
                                                    ToolTip="Create a rule matching this app's executable/process name">
                                                <TextBlock Text="+ By Process" FontSize="11.5" />
                                            </Button>
                                            <Button Style="{StaticResource GhostButton}" Padding="9,5" Margin="6,0,0,0"
                                                    Command="{Binding AddRuleFromWindowTitleCommand}"
                                                    ToolTip="Create a rule matching this window's exact title text">
                                                <TextBlock Text="+ By Title" FontSize="11.5" />
                                            </Button>
                                        </StackPanel>
                                        <Grid>
                                            <ComboBox ItemsSource="{Binding OpenWindows}"
                                                      SelectedItem="{Binding SelectedOpenWindow}"
                                                      DisplayMemberPath="DisplayLabel"
                                                      AutomationProperties.Name="Pick from open windows"
                                                      ToolTip="Pick an open window to test profile matching or create a rule with one click" />
                                            <TextBlock Text="Pick an open window to test or add rule…"
                                                       Style="{StaticResource MutedText}" FontSize="12"
                                                       VerticalAlignment="Center" Margin="11,0,32,0"
                                                       IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding HasSelectedOpenWindow, Converter={StaticResource InverseBoolToVisibility}}" />
                                        </Grid>
                                    </DockPanel>
                                    <TextBlock Text="{Binding SelectedWindowPreviewDisplay}"
                                               Visibility="{Binding HasSelectedOpenWindow, Converter={StaticResource BoolToVisibility}}"
                                               FontSize="11" Foreground="{DynamicResource TimingAccentBrush}" Margin="0,4,0,0"
                                               TextWrapping="Wrap" />

                                    <!-- Validation error summary -->
                                    <Border Margin="0,8,0,0" Padding="8,6" CornerRadius="6"
                                            Background="{DynamicResource ErrorSoftBrush}"
                                            BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1"
                                            Visibility="{Binding HasRulesError, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding RulesError}" Foreground="{DynamicResource ErrorBrush}" FontSize="11.5" TextWrapping="Wrap" />
                                    </Border>

                                    <!-- Empty state -->
                                    <TextBlock Margin="0,10,0,0" Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap"
                                               Visibility="{Binding HasProfileRules, Converter={StaticResource InverseBoolToVisibility}}"
                                               Text="No custom routing rules yet. Macros with a Profile tag still auto-match by their Profile name substring; add rules here to map specific apps (or combine process + title filters)." />

                                    <!-- Rule list -->
                                    <ItemsControl ItemsSource="{Binding ProfileRules}" Margin="0,10,0,0"
                                                  Visibility="{Binding HasProfileRules, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,8" Padding="10" CornerRadius="6"
                                                        Background="{DynamicResource StepCardBrush}"
                                                        BorderBrush="{DynamicResource StepCardBorderBrush}" BorderThickness="1">
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Button Style="{StaticResource GhostButton}" Padding="7,4" Margin="0,0,4,0"
                                                                        Command="{Binding DataContext.MoveRuleUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip="Increase priority (move rule up)">
                                                                    <TextBlock Text="&#xE70E;" Style="{StaticResource IconText}" FontSize="11" />
                                                                </Button>
                                                                <Button Style="{StaticResource GhostButton}" Padding="7,4" Margin="0,0,4,0"
                                                                        Command="{Binding DataContext.MoveRuleDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip="Decrease priority (move rule down)">
                                                                    <TextBlock Text="&#xE70D;" Style="{StaticResource IconText}" FontSize="11" />
                                                                </Button>
                                                                <Button Style="{StaticResource DangerButton}" Padding="7,4"
                                                                        Command="{Binding DataContext.DeleteProfileRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip="Delete rule">
                                                                    <TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" FontSize="11" />
                                                                </Button>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                                    <TextBlock Text="{Binding PriorityLabel}" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" />
                                                                </Border>
                                                                <CheckBox Style="{StaticResource ToggleSwitchCheckBoxStyle}" IsChecked="{Binding Enabled}" Margin="0,0,8,0"
                                                                          AutomationProperties.Name="Enable profile rule" />
                                                                <TextBlock Text="{Binding SummaryText}" Style="{StaticResource MutedText}" FontSize="11.5"
                                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                                                            </StackPanel>
                                                        </DockPanel>

                                                        <Grid Margin="0,8,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="1.2*" />
                                                                <ColumnDefinition Width="8" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="8" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="Window title contains" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,3" />
                                                                <TextBox Text="{Binding WindowTitleMatch, UpdateSourceTrigger=PropertyChanged}"
                                                                         Tag="e.g. Google Docs (optional if process set)"
                                                                         Padding="7,4" FontSize="12" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Text="Process contains" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,3" />
                                                                <TextBox Text="{Binding ProcessNameMatch, UpdateSourceTrigger=PropertyChanged}"
                                                                         Tag="e.g. chrome, Code"
                                                                         Padding="7,4" FontSize="12" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="4">
                                                                <TextBlock Text="Target profile" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,3" />
                                                                <DockPanel>
                                                                    <Grid DockPanel.Dock="Right" Width="88" Margin="4,0,0,0"
                                                                          Visibility="{Binding DataContext.HasKnownProfiles, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}">
                                                                        <ComboBox ItemsSource="{Binding DataContext.KnownProfiles, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                  SelectedItem="{Binding SelectedPresetProfile, Mode=TwoWay}"
                                                                                  Padding="8,4,22,4" FontSize="11.5"
                                                                                  ToolTip="Quick-fill an existing macro profile name"
                                                                                  AutomationProperties.Name="Pick existing profile" />
                                                                        <TextBlock Text="Existing" Style="{StaticResource MutedText}" FontSize="11"
                                                                                   VerticalAlignment="Center" Margin="8,0,22,0" IsHitTestVisible="False" />
                                                                    </Grid>
                                                                    <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"
                                                                             MaxLength="60" Tag="e.g. Work, Gaming"
                                                                             Padding="7,4" FontSize="12" />
                                                                </DockPanel>
                                                            </StackPanel>
                                                        </Grid>

                                                        <TextBlock Text="{Binding ValidationError}"
                                                                   Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVisibility}}"
                                                                   Foreground="{DynamicResource ErrorBrush}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <CheckBox Style="{StaticResource SettingSwitch}" IsChecked="{Binding ShowRunOverlay}"
                                      Content="Show mini status overlay while recording or playing" AutomationProperties.Name="Show mini status overlay" />
                            <TextBlock Style="{StaticResource SettingHelp}" Text="A small click-through pill in the top-right corner: the current step and what it's doing." />

                            <!-- Streamer mode: applied (and saved) the moment it's switched, also from the editor's top bar. -->
                            <Border Margin="0,12,0,2" Padding="12,10" CornerRadius="8" Background="{DynamicResource VisionSoftBrush}"
                                    BorderBrush="{DynamicResource VisionAccentBrush}" BorderThickness="1">
                                <StackPanel>
                                    <CheckBox Style="{StaticResource SettingSwitch}" IsChecked="{Binding ShowOverlaysInObsAndRecording}" Margin="0"
                                              Content="🎥 Show overlays in OBS / Discord" FontWeight="SemiBold"
                                              ToolTip="When ON, the Run HUD, status banner, target-lock reticle, and region highlight boxes are visible in OBS, Discord streams, and screen recordings"
                                              AutomationProperties.Name="Show overlays in OBS and Discord" />
                                    <TextBlock Style="{StaticResource SettingHelp}"
                                               Text="When ON, the Run HUD, status banner, target-lock reticle, and region highlight boxes are visible in OBS, Discord streams, and screen recordings. Off (default): Windows leaves them out of every capture, so viewers don't see them. Applied at once to overlays that are open. While it's on, the target-lock reticle is drawn only around a found target (never over it) and fades after 0.18 s, so SmartMacro's own Find steps don't see it. Pickers (Pick area / color / position) always stay out of captures – they'd end up in the picture you pick." />
                                </StackPanel>
                            </Border>
                            <CheckBox Style="{StaticResource SettingSwitch}" IsChecked="{Binding SmoothMouseMoves}"
                                      Content="Smooth mouse movement during playback (glide instead of jumping)"
                                      AutomationProperties.Name="Smooth mouse movement during playback"
                                      ToolTip="When a Move mouse step (or a click at a position) comes right after a Wait, the cursor glides there during the last 0.2 s of the wait instead of teleporting. The total time of the macro doesn't change." />

                            <TextBlock Text="TEXT RECOGNITION (OCR)" Style="{StaticResource SetupCardTitle}" Margin="0,16,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Top" Margin="0,2,8,0"
                                           Visibility="{Binding IsOcrAvailable, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Top" Margin="0,2,8,0"
                                           Visibility="{Binding IsOcrAvailable, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                <TextBlock Text="{Binding OcrStatus}" TextWrapping="Wrap" MaxWidth="660" FontSize="12" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingHelp}" Margin="0,6,0,0"
                                       Text="Uses the text recognition built into Windows. Screen captures are processed on this PC only and are never uploaded (only the latest editor 'Test' capture is saved locally in the Logs folder)." />

                            <TextBlock Text="HARDWARE VISION ACCELERATION &amp; MEMORY" Style="{StaticResource SetupCardTitle}" Margin="0,16,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE945;" Style="{StaticResource IconText}" Foreground="{DynamicResource VisionAccentBrush}" VerticalAlignment="Top" Margin="0,2,8,0" />
                                <TextBlock Text="{Binding HardwareAccelerationStatus}" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" MaxWidth="660" FontSize="12" />
                            </StackPanel>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Compute Engine" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding ComputeEngineModes}"
                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding ComputeEngineMode, Mode=TwoWay}"
                                              ToolTip="Choose Auto (GPU if available + CPU SIMD), strict CPU Only for low-end PCs/iGPUs, or GPU Accelerated (D3D11 DXGI)." />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="RAM Template Cache Limit" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding VisionMemoryBudgets}"
                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding VisionMemoryBudgetMb, Mode=TwoWay}"
                                              ToolTip="Control how much RAM SmartMacro reserves for cached image templates. Lower values keep RAM minimal on low-end PCs." />
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource SettingHelp}" Margin="0,6,0,0"
                                       Text="Uses 256-bit AVX2 / 128-bit SSE2 CPU SIMD, optional D3D11/DXGI GPU acceleration, and your chosen RAM cache budget so SmartMacro runs smoothly on both low-end laptops and gaming desktops." />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== Storage & Data ===== -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Border Style="{StaticResource SettingsCardHeader}">
                            <DockPanel>
                                <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource TimingBadgeBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE8B7;" Style="{StaticResource IconText}" Foreground="{DynamicResource TimingAccentBrush}" HorizontalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Storage &amp; Data" Style="{StaticResource SectionTitle}" FontSize="14" />
                                    <TextBlock Text="Where macros, settings and logs live. Nothing is uploaded anywhere." Style="{StaticResource MutedText}" FontSize="11" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <StackPanel Style="{StaticResource SettingsCardBody}">
                            <TextBlock Text="Data folder" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Command="{Binding OpenDataFolderCommand}" Margin="8,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE838;" Style="{StaticResource IconText}" />
                                        <TextBlock Text="Open" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <TextBox Text="{Binding DataFolder, Mode=OneWay}" IsReadOnly="True" Foreground="{DynamicResource MutedTextBrush}" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource SettingHelp}" Margin="0,6,0,0"
                                       Text="Macros, settings, daily logs (30-day automatic retention) and deleted macros (Trash) are stored here. Tip: create a portable.txt file next to SmartMacro.exe to run in USB/Portable Mode." />
                            <WrapPanel Margin="0,12,0,0">
                                <Button Style="{StaticResource TestActionButton}" Command="{Binding ExportBackupCommand}" Margin="0,0,8,0"
                                        ToolTip="Save all your macros, profiles and settings into one portable .smbackup ZIP file">
                                    <TextBlock Text="📦 Export Full Backup (.smbackup)…" />
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Command="{Binding RestoreBackupCommand}"
                                        ToolTip="Restore macros from a .smbackup or .zip backup archive (safely merges with your current library)">
                                    <TextBlock Text="📥 Restore Backup…" />
                                </Button>
                            </WrapPanel>
                            <CheckBox Style="{StaticResource SettingSwitch}" IsChecked="{Binding ConfirmBeforeDelete}" Margin="0,14,0,0"
                                      Content="Ask before deleting a macro" AutomationProperties.Name="Ask before deleting a macro" />
                            <CheckBox Style="{StaticResource SettingSwitch}" IsChecked="{Binding ShowLogPanel}"
                                      Content="Show the Activity panel at the bottom of the window" AutomationProperties.Name="Show the Activity panel" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== Webhooks, Failure Alerts & Updates ===== -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Border Style="{StaticResource SettingsCardHeader}">
                            <DockPanel>
                                <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE774;" Style="{StaticResource IconText}" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Webhooks, Failure Alerts &amp; Updates" Style="{StaticResource SectionTitle}" FontSize="14" />
                                    <TextBlock Text="SSRF security rules, automatic failure notifications, and release manifest feed." Style="{StaticResource MutedText}" FontSize="11" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <StackPanel Style="{StaticResource SettingsCardBody}">
                            <CheckBox Style="{StaticResource SettingSwitch}" IsChecked="{Binding AllowLocalWebhooks}" Margin="0,6,0,0"
                                      Content="Allow webhooks to reach localhost &amp; private LAN addresses"
                                      AutomationProperties.Name="Allow local network webhooks" />
                            <TextBlock Style="{StaticResource SettingHelp}"
                                       Text="Off by default to prevent SSRF access to internal services and cloud metadata IPs. Enable only for Home Assistant, ntfy, or local LAN endpoints." />

                            <TextBlock Text="Failure alert webhook URL (optional)" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Command="{Binding TestFailureWebhookCommand}" Margin="8,0,0,0" Padding="10,6"
                                        ToolTip="Send a test alert to verify the failure notification webhook."
                                        AutomationProperties.Name="Test failure webhook">
                                    <TextBlock Text="🧪 Test" FontSize="12" />
                                </Button>
                                <TextBox Text="{Binding FailureWebhookUrl, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="https://discord.com/api/webhooks/..." MaxLength="500"
                                         AutomationProperties.Name="Failure alert webhook URL" />
                            </DockPanel>
                            <TextBlock Text="{Binding FailureWebhookError}" Foreground="{DynamicResource ErrorBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding FailureWebhookError, Converter={StaticResource NullToVisibility}}" />
                            <TextBlock Text="{Binding FailureWebhookTestResult}" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding FailureWebhookTestResult, Converter={StaticResource NullToVisibility}}" />
                            <TextBlock Style="{StaticResource SettingHelp}"
                                       Text="When a macro stops with an execution failure, SmartMacro sends an alert here (with last-failure-snapshot.png attached if captured)." />

                            <TextBlock Text="Custom update manifest URL (optional)" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                            <TextBox Text="{Binding UpdateManifestUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Leave empty to use official GitHub releases manifest" MaxLength="500"
                                     AutomationProperties.Name="Custom update manifest URL" />
                            <TextBlock Text="{Binding UpdateManifestUrlError}" Foreground="{DynamicResource ErrorBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding UpdateManifestUrlError, Converter={StaticResource NullToVisibility}}" />
                            <TextBlock Text="{Binding UpdateStatusMessage}" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding UpdateStatusMessage, Converter={StaticResource NullToVisibility}}" />
                            <TextBlock Style="{StaticResource SettingHelp}"
                                       Text="Only public https:// manifest endpoints are accepted when you click Check for updates." />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
