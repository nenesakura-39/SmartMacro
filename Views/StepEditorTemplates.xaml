<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:steps="clr-namespace:SmartMacro.ViewModels.Steps"
                    xmlns:vision="clr-namespace:SmartMacro.Services.Vision"
                    xmlns:conv="clr-namespace:SmartMacro.Converters">

    <!-- Section headers whose text comes from a view model are shown in capitals like the fixed ones. -->
    <conv:UpperCaseConverter x:Key="UpperCase" />

    <!--
        Property editors for each step type. The Content of the properties panel is the selected
        StepViewModel, and WPF picks the template below that matches its type.
    -->

    <!-- Header shared by every step: what the step does + its problems. The step's icon, title, number and the
         Enabled pill switch are in the sticky inspector header at the top of the Properties panel (EditorView). -->
    <DataTemplate x:Key="StepHeaderTemplate" DataType="{x:Type steps:StepViewModel}">
        <StackPanel>
            <TextBlock Text="{Binding TypeInfo.Description}" Style="{StaticResource MutedText}" FontSize="12" />

            <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="6" Background="{StaticResource ErrorSoftBrush}"
                    BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1,0,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding IssueText}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" FontSize="12" />
            </Border>
            <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="6" Background="{StaticResource WarningSoftBrush}"
                    BorderBrush="{StaticResource WarningBrush}" BorderThickness="1,0,0,0"
                    Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding IssueText}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" FontSize="12" />
            </Border>
            <Border Height="10" />
        </StackPanel>
    </DataTemplate>

    <!-- Footer shared by every step: comment. -->
    <DataTemplate x:Key="StepFooterTemplate" DataType="{x:Type steps:StepViewModel}">
        <StackPanel>
            <TextBlock Text="Comment (optional)" Style="{StaticResource FieldLabel}" Margin="0,18,0,4" />
            <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" Tag="A note for yourself" MaxLength="500"
                     AutomationProperties.Name="Step comment" />
        </StackPanel>
    </DataTemplate>

    <!-- X / Y fields used by several mouse steps. -->
    <DataTemplate x:Key="PositionFieldsTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="X (pixels from the left)" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding X, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="X position"
                         ToolTip="The screen location where this action happens: pixels from the left edge of your main monitor (negative = a monitor further left)." />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Y (pixels from the top)" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Y, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="Y position"
                         ToolTip="The screen location where this action happens: pixels down from the top edge of your main monitor (negative = a monitor above it)." />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!--
        X / Y plus "Pick position" and "Use cursor position", shared by Move mouse, Mouse click and Scroll wheel.
        DataContext = the step editor (it has X, Y and PositionPicker).
    -->
    <DataTemplate x:Key="PositionPickerTemplate">
        <StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PositionFieldsTemplate}" Focusable="False" />
            <WrapPanel Margin="0,10,0,0">
                <Button Command="{Binding PositionPicker.PickCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,6"
                        ToolTip="SmartMacro hides; click a point on your screen to fill in X and Y automatically. Esc or right-click cancels."
                        AutomationProperties.Name="Pick position on screen">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B0;" Style="{StaticResource IconText}" />
                        <TextBlock Text="Pick position" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding PositionPicker.UseCursorCommand}" Margin="0,0,0,6"
                        ToolTip="After a 3-second countdown, uses wherever your mouse cursor is. Move the mouse to the spot during the countdown."
                        AutomationProperties.Name="Use current cursor position">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7C9;" Style="{StaticResource IconText}" />
                        <TextBlock Text="Use cursor position (3 s)" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </WrapPanel>
            <Border Padding="10,6" CornerRadius="6" Background="{StaticResource SurfaceAltBrush}" Margin="0,2,0,0"
                    Visibility="{Binding PositionPicker.Status, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{Binding PositionPicker.Status}" TextWrapping="Wrap" FontSize="12" />
            </Border>
            <TextBlock Text="{Binding DataContext.ScreenBoundsText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                       Text="X counts pixels from the left edge of your main monitor, Y from its top edge (so X 500, Y 300 is 500 px right and 300 px down). Monitors to the left of or above the main one have negative values. These are real screen pixels, so Windows display scaling is already included." />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type steps:DelayStepViewModel}">
        <StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepHeaderTemplate}" Focusable="False" Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="Wait time (milliseconds)" Style="{StaticResource FieldLabel}" Margin="0,18,0,4" />
            <TextBox Text="{Binding DurationMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="Wait time in milliseconds" />
            <TextBlock Text="{Binding SecondsText}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" />

            <TextBlock Text="Quick add" Style="{StaticResource FieldLabel}" />
            <UniformGrid Columns="5">
                <Button Content="+100ms" Command="{Binding AddDurationCommand}" CommandParameter="+100" Padding="4,6" Margin="0,0,3,0" />
                <Button Content="+500ms" Command="{Binding AddDurationCommand}" CommandParameter="+500" Padding="4,6" Margin="2,0,2,0" />
                <Button Content="+1s" Command="{Binding AddDurationCommand}" CommandParameter="+1000" Padding="4,6" Margin="2,0,2,0" />
                <Button Content="+5s" Command="{Binding AddDurationCommand}" CommandParameter="+5000" Padding="4,6" Margin="2,0,2,0" />
                <Button Content="Reset (0)" Command="{Binding ResetDurationCommand}" Padding="4,6" Margin="3,0,0,0" />
            </UniformGrid>

            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepFooterTemplate}" Focusable="False" Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type steps:MouseMoveStepViewModel}">
        <StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepHeaderTemplate}" Focusable="False" Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="Destination" Style="{StaticResource FieldLabel}" Margin="0,18,0,0" />
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PositionPickerTemplate}" Focusable="False" />
            <TextBlock Text="Movement style" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"
                       ToolTip="How the cursor travels there. Smooth Glide and Human Curve send real mouse movement (sliders, hover effects and games notice it); Instant jumps." />
            <ComboBox ItemsSource="{x:Static steps:StepViewModel.MoveStyles}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding MoveStyle}" AutomationProperties.Name="Movement style"
                      ToolTip="Smooth Glide: straight line at about 120 updates per second. Human Curve: a slight natural arc that speeds up and slows down. Instant: jumps there." />
            <StackPanel Visibility="{Binding Glides, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Glide duration (ms)" Style="{StaticResource FieldLabel}" ToolTip="How long the glide takes. 120 ms feels natural." />
                <TextBox Text="{Binding MoveDurationMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="100" HorizontalAlignment="Left"
                         AutomationProperties.Name="Glide duration in milliseconds" ToolTip="How long the glide takes. 120 ms feels natural; it's added to the macro's run time." />
            </StackPanel>
            <TextBlock Text="{Binding MoveHelp}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepFooterTemplate}" Focusable="False" Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type steps:MouseClickStepViewModel}">
        <StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepHeaderTemplate}" Focusable="False" Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}}" />

            <StackPanel>
                <StackPanel>
                    <TextBlock Text="Button" Style="{StaticResource FieldLabel}" Margin="0,18,0,4" />
                    <ComboBox ItemsSource="{x:Static steps:MouseClickStepViewModel.Buttons}" SelectedItem="{Binding Button}" AutomationProperties.Name="Mouse button"
                              ToolTip="Which mouse button: Left (normal click), Right (context menu) or Middle (wheel button)." />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Action type" Style="{StaticResource FieldLabel}" Margin="0,18,0,4" />
                    <ComboBox ItemsSource="{x:Static steps:MouseClickStepViewModel.Actions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding Action}" AutomationProperties.Name="Click action type" />
                </StackPanel>
            </StackPanel>
            <TextBlock Text="{Binding ActionHelp}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />

            <StackPanel Visibility="{Binding UsesHoldTime, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Click hold duration (ms)" Style="{StaticResource FieldLabel}"
                           ToolTip="How long the button stays down. Click / double click: 35 ms is reliable in games (0 = instant). Hold for a duration: e.g. 850 for a casting meter." />
                <TextBox Text="{Binding HoldMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                         AutomationProperties.Name="Hold time in milliseconds"
                         ToolTip="How long the button stays down. Click / double click: 35 ms is reliable in games (0 = instant; recordings fill in how long you held it). Hold for a duration: e.g. 850 for a casting meter." />
                <UniformGrid Columns="5" Margin="0,6,0,0">
                    <Button Content="+100ms" Command="{Binding AddDurationCommand}" CommandParameter="+100" Padding="4,6" Margin="0,0,3,0" />
                    <Button Content="+500ms" Command="{Binding AddDurationCommand}" CommandParameter="+500" Padding="4,6" Margin="2,0,2,0" />
                    <Button Content="+1s" Command="{Binding AddDurationCommand}" CommandParameter="+1000" Padding="4,6" Margin="2,0,2,0" />
                    <Button Content="+5s" Command="{Binding AddDurationCommand}" CommandParameter="+5000" Padding="4,6" Margin="2,0,2,0" />
                    <Button Content="Reset (0)" Command="{Binding ResetDurationCommand}" Padding="4,6" Margin="3,0,0,0" />
                </UniformGrid>
            </StackPanel>

            <TextBlock Text="Where to click" Style="{StaticResource FieldLabel}" Margin="0,18,0,4" />
            <ComboBox ItemsSource="{x:Static steps:MouseClickStepViewModel.Targets}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding Target}" AutomationProperties.Name="Where to click"
                      ToolTip="A chosen position (X / Y), wherever the cursor is when the step runs, or the spot the last Find text / image / color step found." />
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PositionPickerTemplate}" Focusable="False" Margin="0,4,0,0"
                            Visibility="{Binding UsesFixedPosition, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="Choose where the click should happen (for a drag: where it starts). With a chosen position, the cursor first moves to X / Y (the movement style is under Advanced), then the button is used there. Pick position lets you choose the spot directly on your screen." />

            <StackPanel Visibility="{Binding IsDrag, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Drag to (end position)" Style="{StaticResource FieldLabel}" Margin="0,18,0,0" />
                <ContentControl Content="{Binding EndPoint}" ContentTemplate="{StaticResource PositionPickerTemplate}" Focusable="False" />
                <TextBlock Text="Drag time (ms)" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding DragDurationMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="100" HorizontalAlignment="Left"
                         AutomationProperties.Name="Drag time in milliseconds"
                         ToolTip="How long the cursor takes to glide from the start to the end while holding the button. 300-800 ms works for most sliders; 0 = jump straight there." />
            </StackPanel>

            <Expander Header="Advanced Tuning &amp; Movement" Style="{StaticResource AdvancedExpander}"
                      ToolTip="How the cursor travels to the click spot, the double-click gap and the wait after the click.">
                <StackPanel>
                    <TextBlock Text="Movement style" Style="{StaticResource FieldLabel}"
                               ToolTip="How the cursor travels to the click spot. Smooth Glide / Human Curve send real mouse movement so hover effects and game buttons react; Instant jumps." />
                    <ComboBox ItemsSource="{x:Static steps:StepViewModel.MoveStyles}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding MoveStyle}" AutomationProperties.Name="Movement style"
                              ToolTip="Smooth Glide: straight line at about 120 updates per second. Human Curve: a slight natural arc that speeds up and slows down. Instant: jumps there (with a tiny hover nudge before the press)." />
                    <StackPanel IsEnabled="{Binding Glides}">
                        <TextBlock Text="Glide duration (ms)" Style="{StaticResource FieldLabel}" ToolTip="How long the glide to the click spot takes. 120 ms feels natural." />
                        <TextBox Text="{Binding MoveDurationMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="100" HorizontalAlignment="Left"
                                 AutomationProperties.Name="Glide duration in milliseconds" ToolTip="How long the glide to the click spot takes. 120 ms feels natural." />
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsDoubleClick, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Double-click gap (ms)" Style="{StaticResource FieldLabel}"
                                   ToolTip="Pause between the two clicks. 65 ms works in most games; 0 = back to back." />
                        <TextBox Text="{Binding DoubleClickIntervalMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="100" HorizontalAlignment="Left"
                                 AutomationProperties.Name="Double-click gap in milliseconds" ToolTip="Pause between the two clicks. 65 ms works in most games; 0 = back to back." />
                    </StackPanel>
                    <StackPanel Visibility="{Binding UsesClickTiming, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Wait after click (ms)" Style="{StaticResource FieldLabel}"
                                   ToolTip="Pause after the click so the app or game can react before the next step. 0 = go on right away." />
                        <TextBox Text="{Binding PostActionDelayMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="100" HorizontalAlignment="Left"
                                 AutomationProperties.Name="Wait after click in milliseconds" ToolTip="Pause after the click so the app or game can react before the next step. 0 = go on right away." />
                    </StackPanel>
                </StackPanel>
            </Expander>

            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepFooterTemplate}" Focusable="False" Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type steps:MouseScrollStepViewModel}">
        <StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepHeaderTemplate}" Focusable="False" Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}}" />

            <StackPanel Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Direction" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{x:Static steps:MouseScrollStepViewModel.Directions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding Direction}" AutomationProperties.Name="Scroll direction"
                              ToolTip="Up / Down turn the wheel like a normal mouse. Left / Right scroll sideways (tilt wheel)." />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Number of notches" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Notches, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="Number of notches"
                             ToolTip="How far to scroll: 1 notch = one click of a mouse wheel." />
                </StackPanel>
            </StackPanel>
            <TextBlock Text="{Binding AmountText}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />

            <TextBlock Text="Scroll position" Style="{StaticResource FieldLabel}" />
            <ComboBox ItemsSource="{x:Static steps:MouseScrollStepViewModel.PositionModes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding UseCurrentPosition}" AutomationProperties.Name="Scroll position"
                      ToolTip="Windows scrolls whatever is under the cursor. Choose a position to move the cursor there first." />
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PositionPickerTemplate}" Focusable="False" Margin="0,4,0,0"
                            Visibility="{Binding UsesFixedPosition, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="Scrolls whatever is under the cursor. With a chosen position the cursor first jumps to X / Y, then the wheel turns; otherwise it scrolls wherever the cursor already is." />

            <Expander Header="Exact amount (advanced)" Margin="0,12,0,0" Foreground="{StaticResource MutedTextBrush}">
                <StackPanel Margin="0,6,0,0">
                    <TextBox Text="{Binding Delta, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="Exact scroll amount" />
                    <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Windows' own number: 120 = one notch. Positive scrolls up (or right), negative down (or left). Recordings and some touchpads use amounts between whole notches." />
                </StackPanel>
            </Expander>

            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepFooterTemplate}" Focusable="False" Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type steps:KeyPressStepViewModel}">
        <StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepHeaderTemplate}" Focusable="False" Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="Key" Style="{StaticResource FieldLabel}" Margin="0,18,0,4" />
            <ComboBox ItemsSource="{x:Static steps:KeyPressStepViewModel.Keys}" DisplayMemberPath="Name" SelectedValuePath="Code"
                      SelectedValue="{Binding VirtualKey}" IsTextSearchEnabled="True" TextSearch.TextPath="Name"
                      AutomationProperties.Name="Key" />

            <TextBlock Text="Action" Style="{StaticResource FieldLabel}" />
            <ComboBox ItemsSource="{x:Static steps:KeyPressStepViewModel.Actions}" SelectedItem="{Binding Action}" AutomationProperties.Name="Key action" />
            <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0"
                       Text="Press = down and up. Down / Up let you hold a key across several steps." />

            <TextBlock Text="Hold the key for (ms, Press only)" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding HoldMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" IsEnabled="{Binding IsPress}"
                     AutomationProperties.Name="Hold time in milliseconds" />
            <UniformGrid Columns="5" Margin="0,6,0,0" IsEnabled="{Binding IsPress}">
                <Button Content="+100ms" Command="{Binding AddDurationCommand}" CommandParameter="+100" Padding="4,6" Margin="0,0,3,0" />
                <Button Content="+500ms" Command="{Binding AddDurationCommand}" CommandParameter="+500" Padding="4,6" Margin="2,0,2,0" />
                <Button Content="+1s" Command="{Binding AddDurationCommand}" CommandParameter="+1000" Padding="4,6" Margin="2,0,2,0" />
                <Button Content="+5s" Command="{Binding AddDurationCommand}" CommandParameter="+5000" Padding="4,6" Margin="2,0,2,0" />
                <Button Content="Reset (0)" Command="{Binding ResetDurationCommand}" Padding="4,6" Margin="3,0,0,0" />
            </UniformGrid>
            <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0"
                       Text="0 = instant tap. Recordings fill in how long you actually held the key (e.g. a short W tap in a game)." />

            <TextBlock Text="With modifier keys (Press only)" Style="{StaticResource FieldLabel}" />
            <WrapPanel IsEnabled="{Binding IsPress}">
                <CheckBox Content="Ctrl" IsChecked="{Binding Ctrl}" Margin="0,0,16,6" />
                <CheckBox Content="Shift" IsChecked="{Binding Shift}" Margin="0,0,16,6" />
                <CheckBox Content="Alt" IsChecked="{Binding Alt}" Margin="0,0,16,6" />
                <CheckBox Content="Win" IsChecked="{Binding Win}" Margin="0,0,16,6" />
            </WrapPanel>

            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepFooterTemplate}" Focusable="False" Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type steps:TypeTextStepViewModel}">
        <StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepHeaderTemplate}" Focusable="False" Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="Text to type" Style="{StaticResource FieldLabel}" Margin="0,18,0,4" />
            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                     MinHeight="90" MaxHeight="220" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                     MaxLength="10000" AutomationProperties.Name="Text to type" />
            <TextBlock Text="{Binding CharacterCountText}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" />

            <TextBlock Text="Delay between characters (ms)" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding CharacterDelayMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                     AutomationProperties.Name="Delay between characters" />
            <TextBlock Text="20 ms works in most apps and games. Even at 0, SmartMacro keeps a few ms between keys so characters aren't dropped. Spaces, Enter and Tab are sent as real key presses."
                       Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />

            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepFooterTemplate}" Focusable="False" Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </DataTemplate>

    <!--
        Parts shared by Find text / Find image / Find color (all ScreenSearchStepViewModel), used by the step editors
        and inside If / Repeat / Feedback loop conditions:
        the summary banner, "Where to look", "What to do when found", "Search timing", the Advanced Tuning & Movement
        settings and the test result box.
    -->

    <!-- "Freeze:" drop-down next to Capture / Pick buttons (one setting shared by every picker). -->
    <Style x:Key="FreezeComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="ItemsSource" Value="{x:Static vision:ScreenFreezeOptions.Choices}" />
        <Setter Property="DisplayMemberPath" Value="Label" />
        <Setter Property="SelectedValuePath" Value="Seconds" />
        <Setter Property="SelectedValue" Value="{Binding Source={x:Static vision:ScreenFreezeOptions.Instance}, Path=DelaySeconds, Mode=TwoWay}" />
        <Setter Property="MinWidth" Value="200" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="ToolTip" Value="When the picker freezes the screen. Immediately: it freezes as soon as you click the button. After 3s / 5s countdown: click the button, switch to your game, open the minigame or menu, and SmartMacro freezes the screen when the countdown ends. In the frozen picker, Space takes a new picture and Esc cancels." />
        <Setter Property="AutomationProperties.Name" Value="When to freeze the screen" />
    </Style>

    <!-- The live plain-English summary at the top of a step ("Searches Main Monitor every 250 ms for up to 10 s…"). -->
    <DataTemplate x:Key="SummaryBannerTemplate" DataType="{x:Type steps:StepViewModel}">
        <Border Style="{StaticResource SummaryBanner}" Visibility="{Binding PlainSummary, Converter={StaticResource NullToVisibility}}"
                ToolTip="A plain-English summary of what this step will do. It updates as you change the settings below.">
            <StackPanel>
                <TextBlock Text="What this step does" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="{Binding PlainSummary}" TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- 2. Where to look: main monitor / a specific monitor / an app window / a custom area / all monitors. -->
    <DataTemplate x:Key="SearchAreaTemplate" DataType="{x:Type steps:ScreenSearchStepViewModel}">
        <StackPanel>
            <ComboBox ItemsSource="{x:Static steps:ScreenSearchStepViewModel.Scopes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding Scope}" Margin="0,8,0,0" AutomationProperties.Name="Where to look"
                      ToolTip="Which part of the screen is searched. Main Monitor is the default: faster than all monitors, and it can't match something on a second screen (a chat app, a browser) by mistake." />
            <TextBlock Text="{Binding ScopeHelp}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" />

            <!-- Specific monitor -->
            <StackPanel Visibility="{Binding UsesMonitor, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Monitor" Style="{StaticResource FieldLabel}" ToolTip="Monitor 1 is your main monitor; the others are numbered left to right." />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding Monitors}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding MonitorNumber}" AutomationProperties.Name="Monitor to search"
                              ToolTip="The monitor to search. Its size is read again every time the step runs." />
                    <Button Grid.Column="1" Command="{Binding RefreshMonitorsCommand}" Margin="8,0,0,0" Padding="10,6"
                            ToolTip="Read the list of connected monitors again (after plugging one in or out)." AutomationProperties.Name="Refresh monitors">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" FontSize="12" />
                            <TextBlock Text="Refresh monitors" Margin="6,0,0,0" FontSize="12" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- Specific app window -->
            <StackPanel Visibility="{Binding UsesWindow, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Open windows" Style="{StaticResource FieldLabel}" ToolTip="Choose the app or game window to search in." />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding WindowTitles}" SelectedItem="{Binding SelectedWindowTitle}" AutomationProperties.Name="Window to search in"
                              ToolTip="The app windows open right now. Choosing one fills in the title below. Open your game first, then click Refresh windows." />
                    <Button Grid.Column="1" Command="{Binding RefreshWindowsCommand}" Margin="8,0,0,0" Padding="10,6"
                            ToolTip="Read the list of open windows again." AutomationProperties.Name="Refresh windows">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" FontSize="12" />
                            <TextBlock Text="Refresh windows" Margin="6,0,0,0" FontSize="12" />
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock Text="Window title contains" Style="{StaticResource FieldLabel}"
                           ToolTip="Part of the window's title, for example Roblox. Case doesn't matter. An exact match wins over a partial one." />
                <TextBox Text="{Binding WindowTitle, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. Roblox" MaxLength="260"
                         AutomationProperties.Name="Window title contains"
                         ToolTip="Part of the window's title, for example Roblox. Case doesn't matter. The window can move: its current position is used every time the step looks." />
            </StackPanel>

            <!-- Custom area -->
            <StackPanel Visibility="{Binding UsesRegion, Converter={StaticResource BoolToVisibility}}" Margin="0,6,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="X" Style="{StaticResource FieldLabel}" Margin="0,4,0,2" ToolTip="Left edge of the area (screen pixels)." />
                        <TextBox Text="{Binding RegionX, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Padding="6,5" AutomationProperties.Name="Area left"
                                 ToolTip="Left edge of the area, in screen pixels from the left of your main monitor." />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Y" Style="{StaticResource FieldLabel}" Margin="0,4,0,2" ToolTip="Top edge of the area (screen pixels)." />
                        <TextBox Text="{Binding RegionY, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Padding="6,5" AutomationProperties.Name="Area top"
                                 ToolTip="Top edge of the area, in screen pixels from the top of your main monitor." />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Width" Style="{StaticResource FieldLabel}" Margin="0,4,0,2" ToolTip="Width of the area in pixels." />
                        <TextBox Text="{Binding RegionWidth, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Padding="6,5" AutomationProperties.Name="Area width"
                                 ToolTip="Width of the area in pixels." />
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Height" Style="{StaticResource FieldLabel}" Margin="0,4,0,2" ToolTip="Height of the area in pixels." />
                        <TextBox Text="{Binding RegionHeight, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Padding="6,5" AutomationProperties.Name="Area height"
                                 ToolTip="Height of the area in pixels." />
                    </StackPanel>
                </Grid>
            </StackPanel>
            <WrapPanel Margin="0,10,0,0">
                <Button Command="{Binding PickRegionCommand}" Margin="0,0,8,6"
                        ToolTip="SmartMacro hides, the screen freezes, and you drag a rectangle around the part of the screen to search. This switches &quot;Where to look&quot; to Custom Area."
                        AutomationProperties.Name="Pick area on screen">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B0;" Style="{StaticResource IconText}" />
                        <TextBlock Text="Pick area on screen" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ShowSearchAreaCommand}" Margin="0,0,8,6"
                        ToolTip="Show search area on screen: outlines (cyan, dashed) exactly where this step will look right now, for a moment. Nothing is clicked."
                        AutomationProperties.Name="Show search area on screen">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🎯" />
                        <TextBlock Text="Show search area on screen" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
                <ComboBox Style="{StaticResource FreezeComboBox}" Margin="0,0,0,6" />
            </WrapPanel>
        </StackPanel>
    </DataTemplate>

    <!-- 4. Search timing: wait for appear / disappear, keep checking for, check every. -->
    <DataTemplate x:Key="SearchWaitTemplate" DataType="{x:Type steps:ScreenSearchStepViewModel}">
        <StackPanel>
            <StackPanel Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Wait for" Style="{StaticResource FieldLabel}" ToolTip="Wait until it shows up (then act on it), or until it goes away (e.g. a Loading… message)." />
                <ComboBox ItemsSource="{x:Static steps:ScreenSearchStepViewModel.Goals}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding Goal}" AutomationProperties.Name="Wait for"
                          ToolTip="Wait until it shows up (then act on it), or until it goes away (e.g. a Loading… message)." />
            </StackPanel>
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Keep checking for (ms)" Style="{StaticResource FieldLabel}"
                               ToolTip="How long to keep looking before giving up. 10000 = 10 seconds. 0 = look just once." />
                    <TextBox Text="{Binding TimeoutMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                             ToolTip="How long to keep looking before giving up. 10000 = 10 seconds. 0 = look just once." AutomationProperties.Name="Timeout in milliseconds" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Check every (ms)" Style="{StaticResource FieldLabel}"
                               ToolTip="Pause between two looks at the screen. 250 ms is quick; lower values use more CPU." />
                    <TextBox Text="{Binding CheckIntervalMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                             ToolTip="Pause between two looks at the screen. 250 ms is quick; lower values use more CPU." AutomationProperties.Name="Check interval in milliseconds" />
                </StackPanel>
            </Grid>
            <UniformGrid Columns="5" Margin="0,6,0,0">
                <Button Content="+100ms" Command="{Binding AddDurationCommand}" CommandParameter="+100" Padding="4,6" Margin="0,0,3,0" />
                <Button Content="+500ms" Command="{Binding AddDurationCommand}" CommandParameter="+500" Padding="4,6" Margin="2,0,2,0" />
                <Button Content="+1s" Command="{Binding AddDurationCommand}" CommandParameter="+1000" Padding="4,6" Margin="2,0,2,0" />
                <Button Content="+5s" Command="{Binding AddDurationCommand}" CommandParameter="+5000" Padding="4,6" Margin="2,0,2,0" />
                <Button Content="Reset (0)" Command="{Binding ResetDurationCommand}" Padding="4,6" Margin="3,0,0,0" />
            </UniformGrid>
        </StackPanel>
    </DataTemplate>

    <!-- 3. What to do when found (the essentials; movement and click timing are under Advanced). -->
    <DataTemplate x:Key="SearchResultTemplate" DataType="{x:Type steps:ScreenSearchStepViewModel}">
        <StackPanel>
            <StackPanel Visibility="{Binding WaitsForAppear, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="When found" Style="{StaticResource FieldLabel}"
                           ToolTip="What to do with what was found. Clicks happen at its CENTER, wherever it shows up this time." />
                <ComboBox ItemsSource="{x:Static steps:ScreenSearchStepViewModel.Actions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding Action}" AutomationProperties.Name="Action when found"
                          ToolTip="Acts on the CENTER of what was found, wherever it shows up this time, so buttons that move around (Shake buttons, shop items) are still hit. No separate Mouse click step with fixed X / Y needed." />
            </StackPanel>
            <StackPanel Margin="0,4,0,0" Visibility="{Binding IsHoldAction, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Hold the left button for (ms)" Style="{StaticResource FieldLabel}" ToolTip="How long the left button stays down on what was found." />
                <TextBox Text="{Binding ActionHoldMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="100" HorizontalAlignment="Left"
                         AutomationProperties.Name="Hold time in milliseconds" ToolTip="How long the left button stays down on what was found." />
            </StackPanel>

            <TextBlock Text="{Binding NotFoundLabel}" Style="{StaticResource FieldLabel}"
                       ToolTip="What happens when the time is up: stop the macro, carry on, or skip the step right below." />
            <ComboBox ItemsSource="{x:Static steps:ScreenSearchStepViewModel.NotFoundOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding WhenNotFound}" AutomationProperties.Name="When the time is up"
                      ToolTip="What happens when the time is up: stop the macro, carry on, or skip the step right below." />
            <TextBlock Text="{Binding NotFoundHelp}" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
    </DataTemplate>

    <!-- Advanced Tuning & Movement (shared part): how the cursor moves, click timing, parking the cursor, offsets. -->
    <DataTemplate x:Key="SearchMovementTemplate" DataType="{x:Type steps:ScreenSearchStepViewModel}">
        <StackPanel Visibility="{Binding HasPointerAction, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Movement style" Style="{StaticResource FieldLabel}"
                       ToolTip="How the cursor travels to what was found. Smooth Glide and Human Curve send real mouse movement, which games and sliders need to notice the cursor; Instant jumps." />
            <ComboBox ItemsSource="{x:Static steps:StepViewModel.MoveStyles}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding MoveStyle}" AutomationProperties.Name="Movement style"
                      ToolTip="Smooth Glide: straight line at about 120 updates per second. Human Curve: a slight natural arc that speeds up and slows down. Instant: jumps there (still with a tiny hover nudge before clicking)." />
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" IsEnabled="{Binding Glides}">
                    <TextBlock Text="Glide duration (ms)" Style="{StaticResource FieldLabel}" ToolTip="How long the glide takes. 120 ms feels natural; 0 = jump." />
                    <TextBox Text="{Binding MoveDurationMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                             AutomationProperties.Name="Glide duration in milliseconds" ToolTip="How long the glide takes. 120 ms feels natural; 0 = jump." />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Click hold duration (ms)" Style="{StaticResource FieldLabel}"
                               ToolTip="How long each click keeps the button down. 35 ms spans two frames of a 60 fps game, so the click is never missed." />
                    <TextBox Text="{Binding ClickHoldMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                             AutomationProperties.Name="Click hold duration in milliseconds"
                             ToolTip="How long each click keeps the button down. 35 ms spans two frames of a 60 fps game, so the click is never missed." />
                </StackPanel>
            </Grid>
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Wait after click (ms)" Style="{StaticResource FieldLabel}"
                               ToolTip="Pause after the click so the app or game can react before the next step looks at the screen again." />
                    <TextBox Text="{Binding PostActionDelayMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                             AutomationProperties.Name="Wait after click in milliseconds"
                             ToolTip="Pause after the click so the app or game can react before the next step looks at the screen again." />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Double-click gap (ms)" Style="{StaticResource FieldLabel}"
                               ToolTip="Pause between the two clicks of a double-click. 65 ms works in most games; 0 was too fast for Roblox." />
                    <TextBox Text="{Binding DoubleClickIntervalMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                             AutomationProperties.Name="Double-click gap in milliseconds"
                             ToolTip="Pause between the two clicks of a double-click. 65 ms works in most games; 0 was too fast for Roblox." />
                </StackPanel>
            </Grid>
            <CheckBox Content="Move cursor away after click" IsChecked="{Binding MoveCursorAwayAfterAction}" Margin="0,12,0,0"
                      ToolTip="After clicking, the cursor glides just outside the search area (or 150 px down on a whole monitor), so the cursor and its hover highlight don't cover the spot where the next button (like a game's SHAKE button) appears."
                      AutomationProperties.Name="Move cursor away after click" />
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Click offset X" Style="{StaticResource FieldLabel}" ToolTip="Click this many pixels right (+) or left (−) of the center." />
                    <TextBox Text="{Binding OffsetX, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="Offset X"
                             ToolTip="Click this many pixels right (+) or left (−) of the center of what was found." />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Click offset Y" Style="{StaticResource FieldLabel}" ToolTip="Click this many pixels below (+) or above (−) the center." />
                    <TextBox Text="{Binding OffsetY, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="Offset Y"
                             ToolTip="Click this many pixels below (+) or above (−) the center of what was found." />
                </StackPanel>
            </Grid>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="SearchTestResultTemplate" DataType="{x:Type steps:ScreenSearchStepViewModel}">
        <Border Margin="0,8,0,0" Padding="10,8" CornerRadius="6" Background="{StaticResource SurfaceAltBrush}"
                Visibility="{Binding TestResult, Converter={StaticResource NullToVisibility}}">
            <StackPanel>
                <TextBlock Text="{Binding TestResult}" TextWrapping="Wrap" FontSize="12" />
                <Button Command="{Binding ShowMatchCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="8,4" FontSize="12"
                        Visibility="{Binding HasTestMatch, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="Moves your mouse cursor onto the match so you can see exactly where it is. Nothing is clicked."
                        AutomationProperties.Name="Move the cursor to the match">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7C9;" Style="{StaticResource IconText}" FontSize="12" />
                        <TextBlock Text="Show me (move cursor to the match)" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- The numbered cards every Find step shows (2, 3, 4) around its own "1. What to find" card. -->
    <DataTemplate x:Key="SearchCardsTemplate" DataType="{x:Type steps:ScreenSearchStepViewModel}">
        <StackPanel>
            <Border Style="{StaticResource SetupCard}">
                <StackPanel>
                    <TextBlock Text="2. WHERE TO LOOK" Style="{StaticResource SetupCardTitle}"
                               ToolTip="Which part of the screen is searched: your main monitor, one monitor, one app window, an area you pick, or everything." />
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SearchAreaTemplate}" Focusable="False" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SetupCard}" Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="3. ACTION WHEN FOUND" Style="{StaticResource SetupCardTitle}"
                               ToolTip="Click it, double-click, right-click, hold, just move there, or only continue." />
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SearchResultTemplate}" Focusable="False" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SetupCard}">
                <StackPanel>
                    <TextBlock Text="{Binding TimingCardTitle, Converter={StaticResource UpperCase}}" Style="{StaticResource SetupCardTitle}"
                               ToolTip="How long to keep looking, and how often." />
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SearchWaitTemplate}" Focusable="False" />
                </StackPanel>
            </Border>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type steps:FindTextStepViewModel}">
        <StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepHeaderTemplate}" Focusable="False" Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}}" />
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SummaryBannerTemplate}" Focusable="False" />

            <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="6" Background="{StaticResource WarningSoftBrush}"
                    Visibility="{Binding OcrWarning, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{Binding OcrWarning}" TextWrapping="Wrap" FontSize="12" />
            </Border>

            <!-- Essential setup -->
            <Border Style="{StaticResource SetupCard}">
                <StackPanel>
                    <TextBlock Text="1. WHAT TO FIND" Style="{StaticResource SetupCardTitle}" ToolTip="The words to look for on screen (read with Windows text recognition)." />
                    <TextBlock Text="Text to find" Style="{StaticResource FieldLabel}" ToolTip="The words to look for, e.g. Sign in or OK." />
                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" Tag="e.g. Sign in"
                             AutomationProperties.Name="Text to find" ToolTip="The words to look for, e.g. Sign in or OK. Short, distinctive words work best." />
                    <TextBlock Text="How to match" Style="{StaticResource FieldLabel}" ToolTip="Contains: can be part of a longer word. Whole words: must be complete words." />
                    <ComboBox ItemsSource="{x:Static steps:FindTextStepViewModel.MatchModes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding MatchMode}" AutomationProperties.Name="Match mode"
                              ToolTip="Contains: &quot;Save&quot; also matches &quot;Saved&quot;. Whole words: only complete words count." />
                </StackPanel>
            </Border>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SearchCardsTemplate}" Focusable="False" />

            <!-- Advanced Tuning & Movement (collapsed by default) -->
            <Expander Header="Advanced Tuning &amp; Movement" Style="{StaticResource AdvancedExpander}"
                      ToolTip="Match accuracy, character options, how the cursor moves and click timing. The defaults work for most apps and games.">
                <StackPanel>
                    <TextBlock Text="Match accuracy (%)" Style="{StaticResource FieldLabel}"
                               ToolTip="100 = exact. Lower values tolerate OCR mistakes (like reading I as l)." />
                    <TextBox Text="{Binding MinSimilarityPercent, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="80" HorizontalAlignment="Left"
                             AutomationProperties.Name="Match accuracy percent" ToolTip="100 = exact. Lower values tolerate OCR mistakes (like reading I as l). 85 is a good start." />
                    <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0"
                               Text="Windows OCR doesn't report its own confidence, so this compares the text instead." />
                    <CheckBox Content="Match upper/lower case exactly" IsChecked="{Binding CaseSensitive}" Margin="0,10,0,0"
                              ToolTip="On: &quot;OK&quot; doesn't match &quot;ok&quot;. Off (default): case is ignored." AutomationProperties.Name="Match case exactly" />
                    <CheckBox Content="Normalize similar characters (0/O, 1/I/l)" IsChecked="{Binding NormalizeLookAlikes}" Margin="0,8,0,0"
                              ToolTip="Windows OCR often reads a capital O as zero or a capital I as 1 or l on short words like OK. With this on, those count as the same letter."
                              AutomationProperties.Name="Normalize similar characters" />
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SearchMovementTemplate}" Focusable="False"
                                    Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Expander>

            <!-- Standalone steps get this button in the pinned bar at the bottom of the Properties panel. -->
            <Button Command="{Binding TestCommand}" HorizontalAlignment="Left" Margin="0,16,0,0" Style="{StaticResource TestActionButton}"
                    Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                    ToolTip="SmartMacro hides for a moment and reads the place it would search once." AutomationProperties.Name="Test detection now">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" />
                    <TextBlock Text="Test detection now" Margin="8,0,0,0" />
                </StackPanel>
            </Button>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SearchTestResultTemplate}" Focusable="False"
                            Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />

            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepFooterTemplate}" Focusable="False" Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type steps:FindImageStepViewModel}">
        <StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepHeaderTemplate}" Focusable="False" Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}}" />
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SummaryBannerTemplate}" Focusable="False" />

            <!-- Essential setup -->
            <Border Style="{StaticResource SetupCard}">
                <StackPanel>
                    <TextBlock Text="1. WHAT TO FIND" Style="{StaticResource SetupCardTitle}" ToolTip="The picture (button, icon…) to look for on screen." />
                    <Border Padding="8" Margin="0,8,0,0" CornerRadius="6" Background="{StaticResource SurfaceBrush}" HorizontalAlignment="Left"
                            Visibility="{Binding TemplatePreview, Converter={StaticResource NullToVisibility}}">
                        <Image Source="{Binding TemplatePreview}" Stretch="Uniform" StretchDirection="Both" MaxHeight="120" MaxWidth="320"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="Image to find"
                               ToolTip="The stored picture SmartMacro looks for." />
                    </Border>
                    <TextBlock Text="{Binding TemplateInfo}" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <WrapPanel Margin="0,10,0,0">
                        <Button Command="{Binding CaptureTemplateCommand}" Margin="0,0,8,6" Style="{StaticResource PrimaryButton}"
                                ToolTip="SmartMacro hides and the screen freezes (like Win + Shift + S). Drag a box tightly around the button or icon to find. Space = new picture, Esc = cancel."
                                AutomationProperties.Name="Capture image">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE722;" Style="{StaticResource IconText}" />
                                <TextBlock Text="Capture image" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <ComboBox Style="{StaticResource FreezeComboBox}" Margin="0,0,0,6" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                               Text="Tip: for a button that pops up fast, choose a 3 s countdown, click Capture, switch to the game and make the button appear. The image must look the same size on screen as when you captured it (same display scaling and game resolution)." />
                </StackPanel>
            </Border>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SearchCardsTemplate}" Focusable="False" />

            <!-- Advanced Tuning & Movement (collapsed by default) -->
            <Expander Header="Advanced Tuning &amp; Movement" Style="{StaticResource AdvancedExpander}"
                      ToolTip="Match accuracy, see-through game UI options, how the cursor moves and click timing. The defaults work for most buttons.">
                <StackPanel>
                    <TextBlock Text="Match accuracy (%)" Style="{StaticResource FieldLabel}"
                               ToolTip="How similar a spot must be. 90 is a good start; lower it a little if the image glows or animates." />
                    <TextBox Text="{Binding MinSimilarityPercent, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="80" HorizontalAlignment="Left"
                             AutomationProperties.Name="Match accuracy percent"
                             ToolTip="How similar a spot must be. 90 is a good start; lower it a little if the image glows or animates, raise it if wrong things match." />
                    <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="&quot;Test detection now&quot; shows the best similarity it saw." />
                    <CheckBox Content="Adapt to Day/Night lighting changes" IsChecked="{Binding AdaptToLighting}" Margin="0,10,0,0"
                              ToolTip="Uses Zero-Mean Normalized Cross-Correlation (ZNCC) and normalized chroma so a button captured during the daytime still matches when the game world gets darker, brighter, or tinted at night."
                              AutomationProperties.Name="Adapt to Day/Night lighting changes" />
                    <CheckBox Content="Ignore color (match the shape only)" IsChecked="{Binding IgnoreColor}" Margin="0,8,0,0"
                              ToolTip="Normally a match must also have about the same colors, so a grey disabled button doesn't match a green one." AutomationProperties.Name="Ignore color" />
                    <CheckBox Content="Transparent Game UI / Edge Mode: ignore the edges (round buttons)" IsChecked="{Binding IgnoreEdges}" Margin="0,8,0,0"
                              ToolTip="Only the inner part of the picture is compared, so a changing background in the corners (a 3D game scene behind a round button) doesn't stop the match."
                              AutomationProperties.Name="Ignore the edges" />
                    <StackPanel Orientation="Horizontal" Margin="26,6,0,0" Visibility="{Binding IgnoreEdges, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Ignore on each side (%)" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0"
                                   ToolTip="How much of each side to ignore (0–40 %). 15 % removes the corners of a round button." />
                        <TextBox Text="{Binding IgnoreEdgesPercent, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="60"
                                 AutomationProperties.Name="Ignore edges percent" ToolTip="How much of each side to ignore (0–40 %). 15 % removes the corners of a round button." />
                    </StackPanel>
                    <CheckBox Content="Transparent Game UI: ignore background / match bright text and edges" IsChecked="{Binding MatchForeground}" Margin="0,8,0,0"
                              ToolTip="For buttons you can partly see through, like a white &quot;SHAKE&quot; ring over the game world: only the strokes that stand out (the white text and ring) are compared, so it still matches when water, wood or rocks show through it."
                              AutomationProperties.Name="Ignore background and match bright text and edges" />
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SearchMovementTemplate}" Focusable="False"
                                    Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Expander>

            <!-- Standalone steps get this button in the pinned bar at the bottom of the Properties panel. -->
            <Button Command="{Binding TestCommand}" HorizontalAlignment="Left" Margin="0,16,0,0" Style="{StaticResource TestActionButton}"
                    Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                    ToolTip="SmartMacro hides for a moment, looks once where the step would look, and shows a picture with the matches marked."
                    AutomationProperties.Name="Test detection now">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" />
                    <TextBlock Text="Test detection now" Margin="8,0,0,0" />
                </StackPanel>
            </Button>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SearchTestResultTemplate}" Focusable="False"
                            Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />

            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepFooterTemplate}" Focusable="False" Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type steps:FindColorStepViewModel}">
        <StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepHeaderTemplate}" Focusable="False" Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}}" />
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SummaryBannerTemplate}" Focusable="False" />

            <!-- Essential setup -->
            <Border Style="{StaticResource SetupCard}">
                <StackPanel>
                    <TextBlock Text="1. WHAT TO FIND" Style="{StaticResource SetupCardTitle}" ToolTip="The color to look for (e.g. a marker, a health bar, a button)." />
                    <TextBlock Text="Color (#RRGGBB)" Style="{StaticResource FieldLabel}" ToolTip="The color as #RRGGBB, e.g. #FF0000 for red. Easiest: Pick from screen." />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="30" Height="30" CornerRadius="6" Background="{Binding ColorBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ToolTip="A swatch of the color." />
                        <TextBox Grid.Column="2" Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}" MaxLength="7" Tag="#FF0000"
                                 AutomationProperties.Name="Color to find" ToolTip="The color as #RRGGBB, e.g. #FF0000 for red." />
                    </Grid>
                    <WrapPanel Margin="0,10,0,0">
                        <Button Command="{Binding PickColorCommand}" Margin="0,0,8,6" Style="{StaticResource PrimaryButton}"
                                ToolTip="SmartMacro hides and the screen freezes; click the color. The 8× magnifier shows the exact pixel, its color and position."
                                AutomationProperties.Name="Pick color from screen">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEF3C;" Style="{StaticResource IconText}" />
                                <TextBlock Text="Pick from screen" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <ComboBox Style="{StaticResource FreezeComboBox}" Margin="0,0,0,6" />
                    </WrapPanel>
                    <CheckBox Content="+ Add 2nd Color" IsChecked="{Binding UseSecondaryColor}" Margin="0,8,0,0"
                              ToolTip="Match pixels that have EITHER the primary color OR this 2nd color (useful for buttons or indicators that alternate between two colors)."
                              AutomationProperties.Name="+ Add 2nd Color" />
                    <StackPanel Visibility="{Binding UseSecondaryColor, Converter={StaticResource BoolToVisibility}}" Margin="0,6,0,0">
                        <TextBlock Text="2nd Color (#RRGGBB)" Style="{StaticResource FieldLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="30" Height="30" CornerRadius="6" Background="{Binding SecondaryColorBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ToolTip="A swatch of the 2nd color." />
                            <TextBox Grid.Column="2" Text="{Binding SecondaryColor, UpdateSourceTrigger=PropertyChanged}" MaxLength="7" Tag="#FFFFFF"
                                     AutomationProperties.Name="2nd Color to find" />
                            <Button Grid.Column="4" Command="{Binding PickSecondaryColorCommand}" ToolTip="Pick the 2nd color from the screen."
                                    AutomationProperties.Name="Pick 2nd color from screen">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEF3C;" Style="{StaticResource IconText}" />
                                    <TextBlock Text="Pick 2nd color" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                    <TextBlock Text="Tolerance (0-255)" Style="{StaticResource FieldLabel}"
                               ToolTip="How far each of red, green and blue may differ. About 20-40 is typical." />
                    <TextBox Text="{Binding Tolerance, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="80" HorizontalAlignment="Left"
                             AutomationProperties.Name="Color tolerance" ToolTip="How far each of red, green and blue may differ. About 20-40 is typical." />
                </StackPanel>
            </Border>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SearchCardsTemplate}" Focusable="False" />

            <!-- Advanced Tuning & Movement (collapsed by default) -->
            <Expander Header="Advanced Tuning &amp; Movement" Style="{StaticResource AdvancedExpander}"
                      ToolTip="Minimum patch size, how the cursor moves and click timing.">
                <StackPanel>
                    <TextBlock Text="Minimum size (pixels)" Style="{StaticResource FieldLabel}"
                               ToolTip="The patch of color must have at least this many pixels (ignores stray single pixels)." />
                    <TextBox Text="{Binding MinPixels, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="100" HorizontalAlignment="Left"
                             AutomationProperties.Name="Minimum size in pixels" ToolTip="The patch of color must have at least this many pixels (ignores stray single pixels)." />
                    <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="This only matches colors, it doesn't recognize objects: anything else with a similar color in the search place also counts, so keep it small (a custom area or an app window)." />
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SearchMovementTemplate}" Focusable="False"
                                    Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Expander>

            <WrapPanel Margin="0,16,0,0">
                <Button Command="{Binding TestCommand}" Style="{StaticResource TestActionButton}" Margin="0,0,8,6" HorizontalAlignment="Left"
                        Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                        ToolTip="SmartMacro hides for a moment, looks once where the step would look, and shows a picture with the matching patches marked."
                        AutomationProperties.Name="Test detection now">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" />
                        <TextBlock Text="Test detection now" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding TrackCommand}" Margin="0,0,0,6"
                        ToolTip="Follows the color inside a custom search area for 3 seconds (like a moving marker on a bar) and reports its positions and the frame rate."
                        AutomationProperties.Name="Track for 3 seconds">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE916;" Style="{StaticResource IconText}" />
                        <TextBlock Text="Track for 3 s" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </WrapPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SearchTestResultTemplate}" Focusable="False"
                            Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />

            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepFooterTemplate}" Focusable="False" Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type steps:InputSequenceStepViewModel}">
        <StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepHeaderTemplate}" Focusable="False" Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}}" />

            <Border Margin="0,18,0,0" Padding="12,10" CornerRadius="6" Background="{StaticResource SurfaceAltBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Length" Style="{StaticResource MutedText}" FontSize="12" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding DurationText}" FontSize="12" />
                    <TextBlock Grid.Row="1" Text="Events" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding EventCountText}" FontSize="12" Margin="0,4,0,0" />
                    <TextBlock Grid.Row="2" Text="Mouse" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding MouseText}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Grid.Row="3" Text="Keys" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding KeysText}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Grid.Row="4" Text="Buttons" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding ButtonsText}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="{Binding PlaybackExplanation}" />

            <!-- Smart recordings: how each part plays the mouse (exactly one way per part). -->
            <StackPanel Margin="0,16,0,0" Visibility="{Binding HasMouseParts, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Mouse playback" Style="{StaticResource FieldLabel}" />
                <WrapPanel Margin="0,4,0,8">
                    <Button Content="All: cursor position" Command="{Binding UseCursorEverywhereCommand}" Padding="10,4" FontSize="12" Margin="0,0,6,6"
                            ToolTip="Play every part by moving the cursor to the recorded screen positions." />
                    <Button Content="All: relative" Command="{Binding UseRelativeEverywhereCommand}" Padding="10,4" FontSize="12" Margin="0,0,6,6"
                            ToolTip="Play every part as relative mouse movement (like game mode)." />
                    <Button Content="All: automatic" Command="{Binding UseAutomaticEverywhereCommand}" Padding="10,4" FontSize="12" Margin="0,0,6,6"
                            ToolTip="Go back to what SmartMacro detected while recording." />
                </WrapPanel>
                <ItemsControl ItemsSource="{Binding MouseParts}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type steps:MouseSegmentViewModel}">
                            <Border Margin="0,0,0,8" Padding="10,8" CornerRadius="6" Background="{StaticResource SurfaceAltBrush}">
                                <StackPanel>
                                    <TextBlock FontSize="12">
                                        <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="   " /><Run Text="{Binding RangeText, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding DetectedText}" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,6" />
                                    <ComboBox ItemsSource="{x:Static steps:MouseSegmentViewModel.Choices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedMode}" AutomationProperties.Name="Mouse playback for this part" />
                                    <TextBlock Text="{Binding EffectiveText}" FontSize="11" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Visibility="{Binding IsGameModeRecording, Converter={StaticResource BoolToVisibility}}">
            <CheckBox Content="Move the cursor to where recording started, before playing" IsChecked="{Binding MoveCursorToStart}" Margin="0,16,0,0" />
            <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Useful when the game shows a free cursor (menus). Leave it off while the game locks the cursor for the camera." />
            <ContentControl Content="{Binding}" Focusable="False" Margin="0,4,0,0" IsEnabled="{Binding MoveCursorToStart}">
                <ContentControl.ContentTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Start X (pixels)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding StartX, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="Start X position" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Start Y (pixels)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding StartY, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="Start Y position" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
            </StackPanel>

            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepFooterTemplate}" Focusable="False" Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </DataTemplate>

    <!--
        Stage 3: conditions and blocks.
        A condition shows the normal Find text / image / color editor for its search settings (IsStandalone = false
        hides the parts conditions don't use), so Pick area, Capture image, Pick color and Test now work here too.
    -->
    <DataTemplate x:Key="ConditionEditorTemplate" DataType="{x:Type steps:ConditionViewModel}">
        <StackPanel>
            <StackPanel>
                <StackPanel>
                    <TextBlock Text="Look for" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{x:Static steps:ConditionViewModel.Kinds}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding Kind}" AutomationProperties.Name="What the condition looks for" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="True when it" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{x:Static steps:ConditionViewModel.NegateOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding Negate}" AutomationProperties.Name="Is or is not on screen" />
                </StackPanel>
            </StackPanel>

            <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="6" Background="{StaticResource ErrorSoftBrush}"
                    Visibility="{Binding IsDamaged, Converter={StaticResource BoolToVisibility}}">
                <TextBlock TextWrapping="Wrap" FontSize="12"
                           Text="This condition's settings are missing or damaged. Choose what to look for above to start again." />
            </Border>

            <Border Margin="0,12,0,0" Padding="10,4,10,10" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                    Visibility="{Binding CheckEditor, Converter={StaticResource NullToVisibility}}">
                <ContentControl Content="{Binding CheckEditor}" Focusable="False" />
            </Border>

            <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="&quot;Keep checking for&quot; = how long to wait for the condition to become true (0 = look once). Paused time doesn't count." />
            <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding TestHint}" />
            <Border Margin="0,6,0,0" Padding="10,6" CornerRadius="6" Background="{StaticResource AccentSoftBrush}"
                    Visibility="{Binding TestVerdict, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{Binding TestVerdict}" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold" />
            </Border>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type steps:IfStepViewModel}">
        <StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepHeaderTemplate}" Focusable="False" />

            <TextBlock Text="Condition" Style="{StaticResource FieldLabel}" Margin="0,18,0,4" />
            <ContentControl Content="{Binding Condition}" ContentTemplate="{StaticResource ConditionEditorTemplate}" Focusable="False" />

            <TextBlock Text="When true (and it was found)" Style="{StaticResource FieldLabel}" Margin="0,18,0,4" />
            <ComboBox ItemsSource="{x:Static steps:IfStepViewModel.ThenActions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding ThenAction}" AutomationProperties.Name="Action when the condition is true" />
            <StackPanel Visibility="{Binding HasThenAction, Converter={StaticResource BoolToVisibility}}">
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Offset X from center" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ThenOffsetX, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="Offset X" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Offset Y from center" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ThenOffsetY, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="Offset Y" />
                    </StackPanel>
                </Grid>
                <StackPanel Visibility="{Binding IsThenHold, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Hold the left button for (ms)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ThenHoldMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="100" HorizontalAlignment="Left"
                             AutomationProperties.Name="Hold time in milliseconds" />
                </StackPanel>
            </StackPanel>
            <TextBlock Text="{Binding ThenActionHint}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />

            <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"
                       Text="True: the steps up to Else (or End If) run. False: the steps after Else run, or nothing if there's no Else. When the condition sees the text / image / color, a later Mouse click can use &quot;the last found spot&quot;. Turning this If off skips its whole block." />

            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepFooterTemplate}" Focusable="False" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type steps:RepeatStepViewModel}">
        <StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepHeaderTemplate}" Focusable="False" />

            <TextBlock Text="Repeat" Style="{StaticResource FieldLabel}" Margin="0,18,0,4" />
            <ComboBox ItemsSource="{x:Static steps:RepeatStepViewModel.Modes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding Mode}" AutomationProperties.Name="Repeat mode" />

            <StackPanel Visibility="{Binding IsTimes, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Number of times" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Count, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="100" HorizontalAlignment="Left"
                         AutomationProperties.Name="Number of times" />
            </StackPanel>

            <StackPanel Visibility="{Binding UsesCondition, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ConditionLabel}" Style="{StaticResource FieldLabel}" />
                <ContentControl Content="{Binding Condition}" ContentTemplate="{StaticResource ConditionEditorTemplate}" Focusable="False"
                                Visibility="{Binding Condition, Converter={StaticResource NullToVisibility}}" />
                <TextBlock Text="Keep checking before leaving (ms)" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                <TextBox Text="{Binding KeepCheckingForMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="100" HorizontalAlignment="Left"
                         AutomationProperties.Name="Keep checking before leaving, in milliseconds" />
                <TextBlock Text="{Binding KeepCheckingHint}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock Text="Safety limits" Style="{StaticResource FieldLabel}" Margin="0,18,0,0" />
            <TextBlock Text="{Binding LimitHint}" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,4" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Visibility="{Binding UsesCondition, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Max turns" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding MaxIterations, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                             ToolTip="The loop stops after this many turns. 0 = no turn limit (then set Max time)." AutomationProperties.Name="Max turns" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Max time (ms)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding MaxDurationMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                             ToolTip="The loop stops after running this long. 0 = no time limit." AutomationProperties.Name="Max time in milliseconds" />
                </StackPanel>
            </Grid>
            <TextBlock Text="{Binding MaxDurationText}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" />

            <TextBlock Text="When a limit is reached" Style="{StaticResource FieldLabel}" />
            <ComboBox ItemsSource="{x:Static steps:RepeatStepViewModel.LimitOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding WhenLimitReached}" AutomationProperties.Name="When a limit is reached" />

            <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"
                       Text="The condition is checked before every turn (so a While loop may run 0 times), and checks are at least &quot;Check every&quot; apart. Example: Repeat UNTIL the reeling bar image is on screen, with a Find image &quot;Shake&quot; step set to &quot;Click its center&quot; inside. Stop, Esc and Pause work at any time inside the loop. Turning this Repeat off skips its whole block." />

            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepFooterTemplate}" Focusable="False" />
        </StackPanel>
    </DataTemplate>

    <!--
        Stage 4: Feedback loop. Sections: bar + marker, zone, rules, input, limits, stop conditions, tools.
        The stop conditions reuse the If / Repeat condition editor.
    -->
    <DataTemplate DataType="{x:Type steps:FeedbackLoopStepViewModel}">
        <StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepHeaderTemplate}" Focusable="False" />

            <!-- Guided setup, Step 1: choose the minigame type (visual preset cards) -->
            <Border Style="{StaticResource SetupCard}">
                <StackPanel>
                    <TextBlock Text="STEP 1: CHOOSE THE MINIGAME TYPE" Style="{StaticResource SetupCardTitle}"
                               ToolTip="Pick the kind of minigame. SmartMacro fills in the rules; you only pick the bar and two colors." />
                    <ListBox ItemsSource="{x:Static steps:FeedbackLoopStepViewModel.MinigameCards}" SelectedItem="{Binding SelectedMinigame}"
                             Margin="0,8,0,0" AutomationProperties.Name="Minigame type">
                        <!-- No scroll viewer of its own, so the mouse wheel keeps scrolling the Properties panel. -->
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <ItemsPresenter />
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type steps:MinigameCard}">
                                <Grid ToolTip="{Binding Description}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border MinWidth="96" Padding="6,4" CornerRadius="6" Background="{StaticResource SurfaceBrush}" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Picture}" FontFamily="Consolas, Segoe UI Emoji" FontSize="13" HorizontalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding IsGuided, Converter={StaticResource BoolToVisibility}}">
                <!-- Step 2: the bar area -->
                <Border Style="{StaticResource SetupCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding AreaStepTitle, Converter={StaticResource UpperCase}}" Style="{StaticResource SetupCardTitle}"
                                   ToolTip="The part of the screen the loop watches: drag a box tightly around the minigame's bar or track." />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Command="{Binding PickAreaCommand}" Margin="0,0,8,6" Style="{StaticResource PrimaryButton}"
                                    ToolTip="SmartMacro hides and the screen freezes; drag a box tightly around the minigame's bar or track. With a countdown you have time to start the minigame first."
                                    AutomationProperties.Name="Pick minigame bar area">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B0;" Style="{StaticResource IconText}" />
                                    <TextBlock Text="Pick minigame bar area" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ShowSearchAreaCommand}" Margin="0,0,8,6"
                                    ToolTip="Show search area on screen: outlines the bar area this loop watches (cyan, dashed) for a moment."
                                    AutomationProperties.Name="Show bar area on screen">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎯" />
                                    <TextBlock Text="Show on screen" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <ComboBox Style="{StaticResource FreezeComboBox}" Margin="0,0,0,6" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap">
                            <Run Text="Area: (" /><Run Text="{Binding RegionX, Mode=OneWay}" /><Run Text=", " /><Run Text="{Binding RegionY, Mode=OneWay}" /><Run Text="), " /><Run Text="{Binding RegionWidth, Mode=OneWay}" /><Run Text=" × " /><Run Text="{Binding RegionHeight, Mode=OneWay}" /><Run Text=" px" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Step 3: the moving target / marker color -->
                <Border Style="{StaticResource SetupCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding MarkerStepTitle, Converter={StaticResource UpperCase}}" Style="{StaticResource SetupCardTitle}"
                                   ToolTip="The color of the thing that moves on its own (the fish, the indicator, the moving marker)." />
                        <WrapPanel Margin="0,8,0,0">
                            <Border Width="30" Height="30" CornerRadius="6" Background="{Binding MarkerBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                     Margin="0,0,10,6" ToolTip="{Binding MarkerColor}" />
                            <Button Command="{Binding PickMarkerColorCommand}" Margin="0,0,8,6"
                                    ToolTip="SmartMacro hides and the screen freezes; click the moving target. The magnifier shows the exact pixel." AutomationProperties.Name="Pick moving target color">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEF3C;" Style="{StaticResource IconText}" />
                                    <TextBlock Text="Pick color" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <ComboBox Style="{StaticResource FreezeComboBox}" Margin="0,0,0,6" />
                        </WrapPanel>
                        <CheckBox Content="+ Add 2nd Target Color (optional)" IsChecked="{Binding UseSecondaryMarkerColor}" Margin="0,6,0,0"
                                  ToolTip="Optional 2nd color for the moving target (e.g. if the fish or indicator changes color or glows)."
                                  AutomationProperties.Name="+ Add 2nd Target Color (optional)" />
                        <WrapPanel Margin="0,6,0,0" Visibility="{Binding UseSecondaryMarkerColor, Converter={StaticResource BoolToVisibility}}">
                            <Border Width="30" Height="30" CornerRadius="6" Background="{Binding SecondaryMarkerBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    Margin="0,0,10,6" ToolTip="{Binding SecondaryMarkerColor}" />
                            <TextBox Text="{Binding SecondaryMarkerColor, UpdateSourceTrigger=PropertyChanged}" Width="96" MaxLength="7" Tag="#FFFFFF"
                                     Margin="0,0,8,6" AutomationProperties.Name="2nd Target Color" />
                            <Button Command="{Binding PickSecondaryMarkerColorCommand}" Margin="0,0,8,6"
                                    ToolTip="Pick the 2nd target color from screen." AutomationProperties.Name="Pick 2nd target color">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEF3C;" Style="{StaticResource IconText}" />
                                    <TextBlock Text="Pick 2nd color" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" ToolTip="How far each of red, green and blue may differ from the picked color. 20-40 is typical; raise it if the target flickers.">
                            <Run Text="Color tolerance: " /><Run Text="{Binding MarkerTolerance, Mode=OneWay}" />
                        </TextBlock>
                        <Slider Minimum="0" Maximum="150" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding MarkerTolerance}"
                                AutomationProperties.Name="Moving target color tolerance"
                                ToolTip="How far each of red, green and blue may differ from the picked color. 20-40 is typical; raise it if the target flickers." />
                    </StackPanel>
                </Border>

                <!-- Step 4: your control bar / the target zone -->
                <Border Style="{StaticResource SetupCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding ZoneStepTitle, Converter={StaticResource UpperCase}}" Style="{StaticResource SetupCardTitle}"
                                   ToolTip="The bar you move with the mouse (follow minigames), or the zone the marker must reach (timing minigames)." />
                        <StackPanel Visibility="{Binding IsDetectedZone, Converter={StaticResource BoolToVisibility}}">
                            <WrapPanel Margin="0,8,0,0">
                                <Border Width="30" Height="30" CornerRadius="6" Background="{Binding ZoneBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        Margin="0,0,10,6" ToolTip="{Binding ZoneColor}" />
                                <Button Command="{Binding PickZoneColorCommand}" Margin="0,0,8,6"
                                        ToolTip="SmartMacro hides and the screen freezes; click your control bar (or the target zone)." AutomationProperties.Name="Pick control bar or zone color">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xEF3C;" Style="{StaticResource IconText}" />
                                        <TextBlock Text="Pick color" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <ComboBox Style="{StaticResource FreezeComboBox}" Margin="0,0,0,6" />
                            </WrapPanel>
                            <CheckBox Content="+ Add 2nd Bar Color (when overlapping / active, e.g. White)" IsChecked="{Binding UseSecondaryZoneColor}" Margin="0,6,0,0"
                                      ToolTip="In games like Fisch, the Control Bar turns White when overlapping the fish. Adding that active color here keeps the bar and target locked even when overlapping."
                                      AutomationProperties.Name="+ Add 2nd Bar Color (when overlapping / active, e.g. White)" />
                            <WrapPanel Margin="0,6,0,0" Visibility="{Binding UseSecondaryZoneColor, Converter={StaticResource BoolToVisibility}}">
                                <Border Width="30" Height="30" CornerRadius="6" Background="{Binding SecondaryZoneBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        Margin="0,0,10,6" ToolTip="{Binding SecondaryZoneColor}" />
                                <TextBox Text="{Binding SecondaryZoneColor, UpdateSourceTrigger=PropertyChanged}" Width="96" MaxLength="7" Tag="#FFFFFF"
                                         Margin="0,0,8,6" AutomationProperties.Name="2nd Bar Color" />
                                <Button Command="{Binding PickSecondaryZoneColorCommand}" Margin="0,0,8,6"
                                        ToolTip="Pick the 2nd bar color (when overlapping/active) from screen." AutomationProperties.Name="Pick 2nd bar color">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xEF3C;" Style="{StaticResource IconText}" />
                                        <TextBlock Text="Pick 2nd color" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" ToolTip="How far each of red, green and blue may differ from the picked color.">
                                <Run Text="Color tolerance: " /><Run Text="{Binding ZoneTolerance, Mode=OneWay}" />
                            </TextBlock>
                            <Slider Minimum="0" Maximum="150" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ZoneTolerance}"
                                    AutomationProperties.Name="Control bar color tolerance"
                                    ToolTip="How far each of red, green and blue may differ from the picked color. 20-40 is typical." />
                        </StackPanel>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding IsFixedZone, Converter={StaticResource BoolToVisibility}}">
                            <Run Text="The target zone is a fixed part of the bar, " /><Run Text="{Binding ZoneStartPercent, Mode=OneWay}" /><Run Text="–" /><Run Text="{Binding ZoneEndPercent, Mode=OneWay}" /><Run Text=" % (change it under all settings, or switch the zone to &quot;found by its color&quot;)." />
                        </TextBlock>

                        <StackPanel Visibility="{Binding IsZoneClickPreset, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="When the marker enters the zone" Style="{StaticResource FieldLabel}"
                                       ToolTip="Click once (timing bars, skill checks) or let go of a held button (casting meters)." />
                            <ComboBox ItemsSource="{x:Static steps:FeedbackLoopStepViewModel.ZoneEntryActions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding ZoneEntryReleases}" AutomationProperties.Name="What to do when the marker enters the zone"
                                      ToolTip="Click once (timing bars, skill checks) or let go of a held button (casting meters)." />
                        </StackPanel>

                        <TextBlock Text="Max runtime (ms)" Style="{StaticResource FieldLabel}" ToolTip="The loop always stops after this long (safety limit)." />
                        <TextBox Text="{Binding MaxRuntimeMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="120" HorizontalAlignment="Left"
                                 AutomationProperties.Name="Max runtime in milliseconds" ToolTip="The loop always stops after this long (safety limit). Paused time doesn't count." />
                        <TextBlock Text="{Binding MaxRuntimeText}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <CheckBox Content="Show all settings (advanced)" IsChecked="{Binding ShowAdvanced}" Margin="0,12,0,0"
                          ToolTip="Shows every raw setting of the loop: rules, dead band, input, rate limits, stop conditions." AutomationProperties.Name="Show all settings" />
            </StackPanel>

            <!-- Plain-English rule preview: what the loop will do when it holds / releases -->
            <Border Style="{StaticResource SummaryBanner}" ToolTip="What the loop will do, in plain sentences. It updates as you change the settings.">
                <StackPanel>
                    <TextBlock Text="What the loop will do" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="{Binding PlainSummary}" TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding ShowAdvanced, Converter={StaticResource BoolToVisibility}}">
            <!-- 1. The bar and the marker -->
            <TextBlock Text="1. The bar and the moving marker" Style="{StaticResource SectionTitle}" FontSize="13" Margin="0,18,0,0" />
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="X" Style="{StaticResource FieldLabel}" Margin="0,4,0,2" />
                    <TextBox Text="{Binding RegionX, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Padding="6,5" AutomationProperties.Name="Bar area left" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Y" Style="{StaticResource FieldLabel}" Margin="0,4,0,2" />
                    <TextBox Text="{Binding RegionY, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Padding="6,5" AutomationProperties.Name="Bar area top" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Width" Style="{StaticResource FieldLabel}" Margin="0,4,0,2" />
                    <TextBox Text="{Binding RegionWidth, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Padding="6,5" AutomationProperties.Name="Bar area width" />
                </StackPanel>
                <StackPanel Grid.Column="6">
                    <TextBlock Text="Height" Style="{StaticResource FieldLabel}" Margin="0,4,0,2" />
                    <TextBox Text="{Binding RegionHeight, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Padding="6,5" AutomationProperties.Name="Bar area height" />
                </StackPanel>
            </Grid>
            <WrapPanel Margin="0,10,0,0">
                <Button Command="{Binding PickAreaCommand}" Margin="0,0,8,0"
                        ToolTip="SmartMacro hides, then you drag a box tightly around the bar the marker moves along.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B0;" Style="{StaticResource IconText}" />
                        <TextBlock Text="Pick bar area" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ShowSearchAreaCommand}"
                        ToolTip="Show search area on screen: outlines the bar area this loop watches (cyan, dashed) for a moment."
                        AutomationProperties.Name="Show bar area on screen">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🎯" />
                        <TextBlock Text="Show on screen" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
            </WrapPanel>

            <TextBlock Text="Direction the marker moves" Style="{StaticResource FieldLabel}" />
            <ComboBox ItemsSource="{x:Static steps:FeedbackLoopStepViewModel.Orientations}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding Orientation}" AutomationProperties.Name="Direction the marker moves" />

            <TextBlock Text="Marker color (#RRGGBB)" Style="{StaticResource FieldLabel}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="6" Background="{Binding MarkerBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />
                <TextBox Grid.Column="2" Text="{Binding MarkerColor, UpdateSourceTrigger=PropertyChanged}" MaxLength="7" Tag="#FF0000"
                         AutomationProperties.Name="Marker color" />
                <Button Grid.Column="4" Command="{Binding PickMarkerColorCommand}" ToolTip="SmartMacro hides, then you click the marker.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEF3C;" Style="{StaticResource IconText}" />
                        <TextBlock Text="Pick from screen" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </Grid>
            <CheckBox Content="+ Add 2nd Target Color (optional)" IsChecked="{Binding UseSecondaryMarkerColor}" Margin="0,8,0,0"
                      ToolTip="Optional 2nd color for the moving target."
                      AutomationProperties.Name="+ Add 2nd Target Color (optional)" />
            <Grid Margin="0,6,0,0" Visibility="{Binding UseSecondaryMarkerColor, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="6" Background="{Binding SecondaryMarkerBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />
                <TextBox Grid.Column="2" Text="{Binding SecondaryMarkerColor, UpdateSourceTrigger=PropertyChanged}" MaxLength="7" Tag="#FFFFFF"
                         AutomationProperties.Name="2nd Marker color" />
                <Button Grid.Column="4" Command="{Binding PickSecondaryMarkerColorCommand}" ToolTip="SmartMacro hides, then you click the 2nd marker color.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEF3C;" Style="{StaticResource IconText}" />
                        <TextBlock Text="Pick 2nd color" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </Grid>
            <StackPanel Margin="0,4,0,0">
                <StackPanel>
                    <TextBlock Text="Tolerance (0-255)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding MarkerTolerance, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="Marker color tolerance" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Min size (pixels)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding MarkerMinPixels, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="Marker minimum size" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Ignore jumps over (%)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding MaxJumpPercent, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                             ToolTip="A jump bigger than this in one frame is ignored once, in case it was a glitch. If the marker is still there next frame, the jump is accepted."
                             AutomationProperties.Name="Glitch filter percent" />
                </StackPanel>
            </StackPanel>

            <!-- 2. The target zone -->
            <TextBlock Text="2. The target zone" Style="{StaticResource SectionTitle}" FontSize="13" Margin="0,18,0,0" />
            <ComboBox ItemsSource="{x:Static steps:FeedbackLoopStepViewModel.ZoneModes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding ZoneMode}" Margin="0,6,0,0" AutomationProperties.Name="Zone type" />
            <Grid Margin="0,4,0,0" Visibility="{Binding IsFixedZone, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Zone starts at (%)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ZoneStartPercent, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="Zone start percent" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Zone ends at (%)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ZoneEndPercent, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="Zone end percent" />
                </StackPanel>
            </Grid>
            <StackPanel Visibility="{Binding IsDetectedZone, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Zone color (#RRGGBB)" Style="{StaticResource FieldLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="6" Background="{Binding ZoneBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />
                    <TextBox Grid.Column="2" Text="{Binding ZoneColor, UpdateSourceTrigger=PropertyChanged}" MaxLength="7" Tag="#FFFFFF"
                             AutomationProperties.Name="Zone color" />
                    <Button Grid.Column="4" Command="{Binding PickZoneColorCommand}" ToolTip="SmartMacro hides, then you click the zone.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEF3C;" Style="{StaticResource IconText}" />
                            <TextBlock Text="Pick from screen" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>
                <CheckBox Content="+ Add 2nd Bar Color (when overlapping / active, e.g. White)" IsChecked="{Binding UseSecondaryZoneColor}" Margin="0,8,0,0"
                          ToolTip="In games like Fisch, the Control Bar turns White when overlapping the fish. Adding that active color here keeps the bar and target locked even when overlapping."
                          AutomationProperties.Name="+ Add 2nd Bar Color (when overlapping / active, e.g. White)" />
                <Grid Margin="0,6,0,0" Visibility="{Binding UseSecondaryZoneColor, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="6" Background="{Binding SecondaryZoneBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />
                    <TextBox Grid.Column="2" Text="{Binding SecondaryZoneColor, UpdateSourceTrigger=PropertyChanged}" MaxLength="7" Tag="#FFFFFF"
                             AutomationProperties.Name="2nd Zone color" />
                    <Button Grid.Column="4" Command="{Binding PickSecondaryZoneColorCommand}" ToolTip="SmartMacro hides, then you click the 2nd zone/bar color.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEF3C;" Style="{StaticResource IconText}" />
                            <TextBlock Text="Pick 2nd color" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Tolerance (0-255)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ZoneTolerance, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="Zone color tolerance" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Min size (pixels)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ZoneMinPixels, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="Zone minimum size" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- 3. The rules -->
            <TextBlock Text="3. What to do" Style="{StaticResource SectionTitle}" FontSize="13" Margin="0,18,0,0" />
            <TextBlock Text="{Binding BeforeLabel}" Style="{StaticResource FieldLabel}" />
            <ComboBox ItemsSource="{x:Static steps:FeedbackLoopStepViewModel.Actions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding WhenBeforeZone}" AutomationProperties.Name="Rule before the zone" />
            <TextBlock Text="When the marker is INSIDE the zone" Style="{StaticResource FieldLabel}" />
            <ComboBox ItemsSource="{x:Static steps:FeedbackLoopStepViewModel.Actions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding WhenInsideZone}" AutomationProperties.Name="Rule inside the zone" />
            <TextBlock Text="{Binding AfterLabel}" Style="{StaticResource FieldLabel}" />
            <ComboBox ItemsSource="{x:Static steps:FeedbackLoopStepViewModel.Actions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding WhenAfterZone}" AutomationProperties.Name="Rule after the zone" />
            <TextBlock Text="Dead band (%)" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding DeadBandPercent, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="100" HorizontalAlignment="Left"
                     AutomationProperties.Name="Dead band percent" />
            <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="The marker must be this far past a zone edge before it counts as crossed, so the input doesn't flicker on and off at an edge. 0 = off; 1-5 is typical." />
            <StackPanel Visibility="{Binding UsesPulse, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Pulse cycle (ms)" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding PulsePeriodMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="100" HorizontalAlignment="Left"
                         AutomationProperties.Name="Pulse cycle in milliseconds"
                         ToolTip="Inside the zone the input is held for part of every cycle: more the closer the marker is to the side that holds, less toward the side that releases." />
            </StackPanel>
            <CheckBox Content="Finish the loop when the marker reaches the zone (after the INSIDE rule: Tap or Release)" IsChecked="{Binding FinishWhenInZone}" Margin="0,10,0,0"
                      AutomationProperties.Name="Finish when the marker reaches the zone" />

            <!-- 4. The input -->
            <TextBlock Text="4. Which input" Style="{StaticResource SectionTitle}" FontSize="13" Margin="0,18,0,0" />
            <ComboBox ItemsSource="{x:Static steps:FeedbackLoopStepViewModel.InputKinds}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding InputKind}" Margin="0,6,0,0" AutomationProperties.Name="Input kind" />
            <StackPanel Visibility="{Binding UsesMouseButton, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Mouse button (pressed wherever the cursor is)" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{x:Static steps:FeedbackLoopStepViewModel.MouseButtons}" SelectedItem="{Binding MouseButton}" AutomationProperties.Name="Mouse button" />
            </StackPanel>
            <StackPanel Visibility="{Binding UsesKey, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Key" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{x:Static steps:FeedbackLoopStepViewModel.Keys}" DisplayMemberPath="Name" SelectedValuePath="Code"
                          SelectedValue="{Binding VirtualKey}" IsTextSearchEnabled="True" TextSearch.TextPath="Name" AutomationProperties.Name="Key" />
            </StackPanel>
            <StackPanel Visibility="{Binding UsesTap, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Tap length (ms)" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding TapMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="100" HorizontalAlignment="Left"
                         AutomationProperties.Name="Tap length in milliseconds" />
            </StackPanel>

            <!-- 5. Limits -->
            <TextBlock Text="5. Speed and safety limits" Style="{StaticResource SectionTitle}" FontSize="13" Margin="0,18,0,0" />
            <StackPanel Margin="0,4,0,0">
                <StackPanel>
                    <TextBlock Text="Captures per second (max)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding MaxCapturesPerSecond, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                             ToolTip="How often the loop looks at the bar. Use &quot;Measure loop speed&quot; to see what your PC can do." AutomationProperties.Name="Captures per second" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Min time between changes (ms)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding MinInputChangeMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                             ToolTip="Presses / releases / taps are at least this far apart (games miss changes that are too quick)." AutomationProperties.Name="Minimum time between input changes" />
                </StackPanel>
            </StackPanel>
            <StackPanel Margin="0,4,0,0">
                <StackPanel>
                    <TextBlock Text="Max runtime (ms)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding MaxRuntimeMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="Max runtime in milliseconds" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="When the time is up" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{x:Static steps:FeedbackLoopStepViewModel.EndOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding WhenTimeUp}" AutomationProperties.Name="When the time is up" />
                </StackPanel>
            </StackPanel>
            <TextBlock Text="{Binding MaxRuntimeText}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" />
            <StackPanel Margin="0,4,0,0">
                <StackPanel>
                    <TextBlock Text="Target missing for (ms)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding LostTimeoutMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                             ToolTip="Shorter gaps (a flicker, two similar patches) just keep the input as it is." AutomationProperties.Name="Target missing time in milliseconds" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Then" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{x:Static steps:FeedbackLoopStepViewModel.LostActions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding WhenTargetLost}" AutomationProperties.Name="When the target is missing" />
                </StackPanel>
            </StackPanel>

            <!-- 6. Stop when -->
            <TextBlock Text="6. Stop when (optional)" Style="{StaticResource SectionTitle}" FontSize="13" Margin="0,18,0,0" />
            <CheckBox Content="Done when a condition is true (e.g. a &quot;caught&quot; picture appears)" IsChecked="{Binding HasCompleteCondition}" Margin="0,8,0,0" />
            <ContentControl Content="{Binding CompleteCondition}" ContentTemplate="{StaticResource ConditionEditorTemplate}" Focusable="False" Margin="0,6,0,0"
                            Visibility="{Binding CompleteCondition, Converter={StaticResource NullToVisibility}}" />
            <CheckBox Content="Failed when a condition is true (e.g. a &quot;lost&quot; message appears)" IsChecked="{Binding HasFailCondition}" Margin="0,10,0,0" />
            <StackPanel Visibility="{Binding FailCondition, Converter={StaticResource NullToVisibility}}">
                <ContentControl Content="{Binding FailCondition}" ContentTemplate="{StaticResource ConditionEditorTemplate}" Focusable="False" Margin="0,6,0,0" />
                <TextBlock Text="When it failed" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{x:Static steps:FeedbackLoopStepViewModel.EndOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding WhenFailed}" AutomationProperties.Name="When it failed" />
            </StackPanel>
            <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="Conditions are checked about every &quot;Check every&quot; while the loop runs (&quot;Keep checking for&quot; isn't used here). Image and color conditions are fast; text (OCR) pauses the loop while it reads." />

            </StackPanel>

            <!-- Tools -->
            <TextBlock Text="Try it (no input is sent)" Style="{StaticResource SectionTitle}" FontSize="13" Margin="0,18,0,0" />
            <WrapPanel Margin="0,8,0,0">
                <!-- "Test detection now" is in the pinned bar at the bottom of the Properties panel (results show there too). -->
                <Button Command="{Binding MeasureCommand}" Margin="0,0,8,8"
                        ToolTip="For 3 seconds SmartMacro captures the bar and finds the marker as fast as it can, then shows the frames per second, the time per frame and a suggested captures-per-second setting.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEC4A;" Style="{StaticResource IconText}" />
                        <TextBlock Text="Measure loop speed" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding PreviewCommand}" Margin="0,0,8,8"
                        ToolTip="Runs the loop for 10 seconds WITHOUT pressing anything. A small window shows the marker, the zone and what the loop would do.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" Style="{StaticResource IconText}" />
                        <TextBlock Text="Preview 10 s" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </WrapPanel>
            <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,0" TextWrapping="Wrap"
                       Text="Results of Test detection, Measure and Preview appear in the bar at the bottom of this panel." />

            <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"
                       Text="While it runs: Stop, Esc and Pause work every frame; pausing releases the input and presses it again on resume. When the loop ends for any reason, the key / button is released. A short marker flicker or two similar patches never trigger an action. This reacts to what it sees, a few frames late: it suits simple &quot;keep the marker in the zone&quot; bars, not every minigame." />

            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepFooterTemplate}" Focusable="False" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type steps:BlockMarkerStepViewModel}">
        <StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepHeaderTemplate}" Focusable="False" />
            <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" FontSize="12" Margin="0,18,0,0" />
            <TextBlock Text="{Binding DisableHint}" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepFooterTemplate}" Focusable="False" />
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
