<Project Sdk="Microsoft.NET.Sdk">

  <!-- Core logic with no WPF / Windows dependency, so it can be unit tested anywhere. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SmartMacro.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SmartMacro.Tests" />
  </ItemGroup>

</Project>
