<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 10 version suffix gives access to built-in Windows APIs (Windows.Media.Ocr for text recognition). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>SmartMacro</AssemblyTitle>
    <Product>SmartMacro</Product>
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets\SmartMacro.ico</ApplicationIcon>
    <Company>Riku</Company>
    <Authors>Riku</Authors>
    <Copyright>© 2026 Riku</Copyright>
    <!-- The Core library and tests live in sub-folders with their own projects; don't compile them twice. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);SmartMacro.Core\**;SmartMacro.Tests\**;artifacts\**;release\**;publish\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF projects leave System.IO out of the implicit usings (it clashes with System.Windows.Shapes.Path). -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\SmartMacro.ico" />
    <!-- KuroLogic studio logo, shown in Settings → About (source: tools/brand/kurologic-logo.svg). -->
    <Resource Include="Assets\KuroLogic-Logo.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="SmartMacro.Core\SmartMacro.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="docs\" />
  </ItemGroup>

</Project>
